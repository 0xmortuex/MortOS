// MORT OS x86-64 kernel entry.
//
// This is the first compatibility-preserving step toward the native Vex
// platform. The assembly stub only changes CPU mode; kernel policy and runtime
// code begin here in Mort.

// The bootstrap identity-maps the first GiB. Track that region in 4 KiB
// frames; later paging stages can extend this without changing the allocator
// contract. One bit per frame = 32 KiB for 262,144 frames.
let g_frame_bitmap64: [u8; 32768] = [0xFF; 32768];
let g_frame_limit64: u32 = 0;
let g_frame_free64: u32 = 0;
let g_breakpoint_seen64: bool = false;
let g_user_probe_seen64: bool = false;
let g_user_exit_seen64: bool = false;
let g_user_exit_status64: u64 = 0;
let g_user_entry64: u64 = 0;
let g_user_pt64: u64 = 0;
let g_user_mmap_pt64: u64 = 0;
let g_user_pointer_rejected64: bool = false;
let g_user_fault_seen64: bool = false;
let g_user_fault_vector64: u64 = 0;
let g_user_fault_error64: u64 = 0;
// Process states: 0 FREE, 1 READY, 2 RUNNING, 3 EXITED, 4 FAULTED, 5 WAITING.
let g_process_state64: [u8; 8] = [0; 8];
let g_process_pid64: [u64; 8] = [0; 8];
let g_process_tid64: [u64; 8] = [0; 8];
let g_process_is_thread64: [u8; 8] = [0; 8];
let g_process_root64: [u64; 8] = [0; 8];
let g_process_pt64: [u64; 8] = [0; 8];
let g_process_mmap_pt64: [u64; 8] = [0; 8];
let g_process_entry64: [u64; 8] = [0; 8];
let g_process_exit64: [u64; 8] = [0; 8];
let g_process_fault64: [u64; 8] = [0; 8];
let g_process_brk64: [u64; 8] = [0; 8];
let g_process_brk_seen64: [u8; 8] = [0; 8];
// Eighteen u64 values per saved context: all general registers followed by
// RIP, RFLAGS, and RSP. This supports both cooperative and timer preemption.
let g_process_context64: [u64; 144] = [0; 144];
let g_process_context_valid64: [u8; 8] = [0; 8];
let g_process_preemptions64: [u64; 8] = [0; 8];
let g_process_clock_seen64: [u8; 8] = [0; 8];
let g_process_mmap_seen64: [u8; 8] = [0; 8];
let g_process_fs_base64: [u64; 8] = [0; 8];
let g_process_tls_seen64: [u8; 8] = [0; 8];
let g_process_thread_seen64: [u8; 8] = [0; 8];
let g_process_handle_owner64: [u32; 8] = [0; 8];
let g_process_pipe_seen64: [u8; 8] = [0; 8];
let g_process_futex_seen64: [u8; 8] = [0; 8];
let g_process_poll_seen64: [u8; 8] = [0; 8];
let g_process_wait_address64: [u64; 8] = [0; 8];
// Eight descriptors per owning process. Types: 0 free, 2 pipe read, 3 write.
let g_handle_type64: [u8; 64] = [0; 64];
let g_handle_object64: [u32; 64] = [0; 64];
let g_pipe_used64: [u8; 4] = [0; 4];
let g_pipe_data64: [u8; 1024] = [0; 1024];
let g_pipe_read64: [u32; 4] = [0; 4];
let g_pipe_write64: [u32; 4] = [0; 4];
let g_pipe_count64: [u32; 4] = [0; 4];
let g_pipe_readers64: [u32; 4] = [0; 4];
let g_pipe_writers64: [u32; 4] = [0; 4];
let g_current_process64: u32 = 8;
let g_next_pid64: u64 = 1;
let g_timer_ticks64: u64 = 0;
let g_thread_exit_seen64: bool = false;

extern fn mort64_cpu_init() -> u64;
extern fn mort64_idt_self_test();
extern fn mort64_probe_image() -> u64;
extern fn mort64_probe_image_size() -> u64;
extern fn mort64_isolation_image() -> u64;
extern fn mort64_isolation_image_size() -> u64;
extern fn mort64_survivor_image() -> u64;
extern fn mort64_survivor_image_size() -> u64;
extern fn mort64_preempt_image() -> u64;
extern fn mort64_preempt_image_size() -> u64;
extern fn mort64_cxx_image() -> u64;
extern fn mort64_cxx_image_size() -> u64;
extern fn mort64_enter_user(entry: u64, stack_top: u64, page_root: u64);
extern fn mort64_resume_user(context: u64, page_root: u64);
extern fn mort64_flush_tlb();
extern fn mort64_set_user_fs(address: u64);

fn serial_init64() {
    outb(0x3F9, 0);       // disable UART interrupts
    outb(0x3FB, 0x80);    // enable divisor latch
    outb(0x3F8, 3);       // 38400 baud
    outb(0x3F9, 0);
    outb(0x3FB, 3);       // 8 data bits, no parity, one stop bit
    outb(0x3FA, 0xC7);    // FIFO on, clear queues, 14-byte threshold
    outb(0x3FC, 0x0B);    // IRQs enabled, RTS/DSR set
}

fn serial_put64(value: u8) {
    let spins: u32 = 0;
    while spins < 1000000 {
        if (inb(0x3FD) & 0x20) != 0 {
            outb(0x3F8, value);
            return;
        }
        spins = spins + 1;
    }
}

fn serial_write64(text: *u8) {
    let address: u64 = text as u64;
    let value: u8 = *(address as *u8);
    while value != 0 {
        serial_put64(value);
        address = address + 1;
        value = *(address as *u8);
    }
}

fn timer_init64() {
    // Remap the legacy PIC and expose only IRQ0. APIC routing replaces this
    // bootstrap path once SMP is introduced.
    outb(0x20, 0x11);
    outb(0xA0, 0x11);
    outb(0x21, 0x20);
    outb(0xA1, 0x28);
    outb(0x21, 0x04);
    outb(0xA1, 0x02);
    outb(0x21, 0x01);
    outb(0xA1, 0x01);
    outb(0x21, 0xFE);
    outb(0xA1, 0xFF);

    // PIT channel 0, rate generator, approximately 100 Hz.
    outb(0x43, 0x36);
    outb(0x40, 0x9B);
    outb(0x40, 0x2E);
}

fn frame_byte64(index: u32) -> *u8 {
    let offset: u64 = (index / 8) as u64;
    return ((&g_frame_bitmap64 as u64) + offset) as *u8;
}

fn frame_mark_used64(index: u32) {
    if index >= g_frame_limit64 {
        return;
    }
    let mask: u8 = (1 << (index % 8)) as u8;
    let cell: *u8 = frame_byte64(index);
    if ((*cell) & mask) == 0 {
        *cell = (*cell) | mask;
        if g_frame_free64 > 0 {
            g_frame_free64 = g_frame_free64 - 1;
        }
    }
}

fn frame_mark_free64(index: u32) {
    if index >= g_frame_limit64 {
        return;
    }
    let mask: u8 = (1 << (index % 8)) as u8;
    let cell: *u8 = frame_byte64(index);
    if ((*cell) & mask) != 0 {
        *cell = (*cell) & (0xFF ^ mask);
        g_frame_free64 = g_frame_free64 + 1;
    }
}

fn frame_alloc64() -> u64 {
    let index: u32 = 0;
    while index < g_frame_limit64 {
        let mask: u8 = (1 << (index % 8)) as u8;
        if ((*frame_byte64(index)) & mask) == 0 {
            frame_mark_used64(index);
            return (index as u64) * 4096;
        }
        index = index + 1;
    }
    return 0;
}

fn frame_free64(address: u64) {
    if (address & 0xFFF) != 0 {
        return;
    }
    frame_mark_free64((address / 4096) as u32);
}

fn phys_init64(multiboot_info: u64) -> bool {
    if multiboot_info == 0 {
        return false;
    }
    let flags: u32 = *((multiboot_info + 0) as *u32);
    if (flags & 0x40) == 0 {                    // Multiboot memory map present
        return false;
    }

    let i: u32 = 0;
    while i < 32768 {
        g_frame_bitmap64[i] = 0xFF;
        i = i + 1;
    }
    g_frame_limit64 = 262144;                  // first 1 GiB / 4 KiB
    g_frame_free64 = 0;

    let map_length: u32 = *((multiboot_info + 44) as *u32);
    let map_address: u64 = (*((multiboot_info + 48) as *u32)) as u64;
    let offset: u32 = 0;
    while offset < map_length {
        let entry: u64 = map_address + (offset as u64);
        let remaining: u32 = map_length - offset;
        if remaining < 4 {
            return false;
        }
        let size: u32 = *((entry + 0) as *u32);
        if size < 20 || size > remaining - 4 {
            return false;
        }
        let base: u64 = *((entry + 4) as *u64);
        let length: u64 = *((entry + 12) as *u64);
        let kind: u32 = *((entry + 20) as *u32);

        if kind == 1 && length != 0 && base < 0x40000000 {
            let first: u64 = ((base + 4095) / 4096) * 4096;
            let last: u64 = base + length;
            if last < base || last > 0x40000000 {
                last = 0x40000000;              // wrapped or beyond mapped cap
            }
            let cursor: u64 = first;
            if cursor < 0x00800000 {
                cursor = 0x00800000;            // reserve bootstrap + payload
            }
            while cursor < last {
                frame_mark_free64((cursor / 4096) as u32);
                cursor = cursor + 4096;
            }
        }
        offset = offset + size + 4;
    }
    return g_frame_free64 > 0;
}

fn phys_self_test64() -> bool {
    let before: u32 = g_frame_free64;
    let first: u64 = frame_alloc64();
    let second: u64 = frame_alloc64();
    if first == 0 || second == 0 || first == second {
        return false;
    }
    if (first & 0xFFF) != 0 || (second & 0xFFF) != 0 {
        return false;
    }
    frame_free64(first);
    frame_free64(second);
    return g_frame_free64 == before;
}

fn page_zero64(address: u64) {
    let index: u32 = 0;
    while index < 512 {
        *((address + ((index as u64) * 8)) as *u64) = 0;
        index = index + 1;
    }
}

fn page_table_alloc64() -> u64 {
    let address: u64 = frame_alloc64();
    if address != 0 {
        page_zero64(address);
    }
    return address;
}

fn page_table_set64(table: u64, index: u32, value: u64) {
    if index < 512 {
        *((table + ((index as u64) * 8)) as *u64) = value;
    }
}

fn page_copy64(destination: u64, source: u64, count: u64) {
    let offset: u64 = 0;
    while offset < count {
        *((destination + offset) as *u8) = *((source + offset) as *u8);
        offset = offset + 1;
    }
}

// Validate and load an ELF64 ET_EXEC image into an isolated address space:
//   0..16 MiB      supervisor-only identity map for kernel/runtime
//   16..18 MiB     ELF PT_LOAD segments plus a non-executable stack
//   18 MiB..1 GiB  supervisor-only identity map for kernel frame access
//
// Upper paging levels carry U/S so the leaf PTE decides access. Kernel 2 MiB
// leaves remain supervisor-only. ELF pages enforce W^X and BSS starts zeroed.
fn elf64_user_page_root(image: u64, image_size: u64) -> u64 {
    if image == 0 || image_size < 64 || image_size > 0x00100000 {
        return 0;
    }
    if *((image + 0) as *u8) != 0x7F
        || *((image + 1) as *u8) != 0x45
        || *((image + 2) as *u8) != 0x4C
        || *((image + 3) as *u8) != 0x46
        || *((image + 4) as *u8) != 2
        || *((image + 5) as *u8) != 1 {
        return 0;
    }
    if *((image + 16) as *u16) != 2
        || *((image + 18) as *u16) != 0x3E {
        return 0;
    }
    let entry: u64 = *((image + 24) as *u64);
    let program_offset: u64 = *((image + 32) as *u64);
    let program_size: u64 = (*((image + 54) as *u16)) as u64;
    let program_count: u64 = (*((image + 56) as *u16)) as u64;
    if entry < 0x01000000 || entry >= 0x011FF000
        || program_size < 56 || program_count == 0 || program_count > 32 {
        return 0;
    }
    let table_size: u64 = program_size * program_count;
    if table_size / program_count != program_size
        || program_offset > image_size
        || table_size > image_size - program_offset {
        return 0;
    }

    let pml4: u64 = page_table_alloc64();
    let pdpt: u64 = page_table_alloc64();
    let pd: u64 = page_table_alloc64();
    let user_pt: u64 = page_table_alloc64();
    let mmap_pd: u64 = page_table_alloc64();
    let mmap_pt: u64 = page_table_alloc64();
    if pml4 == 0 || pdpt == 0 || pd == 0 || user_pt == 0
        || mmap_pd == 0 || mmap_pt == 0 {
        return 0;
    }

    page_table_set64(pml4, 0, pdpt | 0x7);
    page_table_set64(pdpt, 0, pd | 0x7);
    // A separate high user arena starts at 1 GiB. It does not replace any
    // part of the kernel's low 1 GiB physical direct map.
    page_table_set64(pdpt, 1, mmap_pd | 0x7);
    page_table_set64(mmap_pd, 0, mmap_pt | 0x7);
    let directory_index: u32 = 0;
    while directory_index < 512 {
        if directory_index != 8 {
            page_table_set64(
                pd,
                directory_index,
                ((directory_index as u64) * 0x00200000) | 0x83);
        }
        directory_index = directory_index + 1;
    }
    page_table_set64(pd, 8, user_pt | 0x7);

    let loaded_segments: u32 = 0;
    let entry_is_executable: bool = false;
    let program_index: u64 = 0;
    let no_execute: u64 = (1 as u64) << 63;
    while program_index < program_count {
        let header: u64 = image + program_offset
            + (program_index * program_size);
        let segment_type: u32 = *((header + 0) as *u32);
        if segment_type == 1 {
            let flags: u32 = *((header + 4) as *u32);
            let file_offset: u64 = *((header + 8) as *u64);
            let virtual_address: u64 = *((header + 16) as *u64);
            let file_size: u64 = *((header + 32) as *u64);
            let memory_size: u64 = *((header + 40) as *u64);
            let segment_end: u64 = virtual_address + memory_size;
            let file_end: u64 = file_offset + file_size;
            if (flags & 1) != 0 && (flags & 2) != 0 {
                return 0;                         // W^X
            }
            if file_size > memory_size
                || segment_end < virtual_address
                || virtual_address < 0x01000000
                || segment_end > 0x01100000
                || file_end < file_offset
                || file_end > image_size {
                return 0;
            }

            if memory_size != 0 {
                if (flags & 1) != 0
                    && entry >= virtual_address
                    && entry < segment_end {
                    entry_is_executable = true;
                }
                let page_address: u64 = (virtual_address / 4096) * 4096;
                let page_limit: u64 = ((segment_end + 4095) / 4096) * 4096;
                while page_address < page_limit {
                    let page_index: u32 =
                        ((page_address - 0x01000000) / 4096) as u32;
                    let slot: *u64 = (user_pt
                        + ((page_index as u64) * 8)) as *u64;
                    if *slot != 0 {
                        return 0;                 // overlapping PT_LOAD pages
                    }
                    let frame: u64 = frame_alloc64();
                    if frame == 0 {
                        return 0;
                    }
                    page_zero64(frame);           // includes ELF BSS
                    let page_flags: u64 = 0x5;    // present + user
                    if (flags & 2) != 0 {
                        page_flags = page_flags | 0x2;
                    }
                    if (flags & 1) == 0 {
                        page_flags = page_flags | no_execute;
                    }
                    *slot = frame | page_flags;

                    let copy_start: u64 = page_address;
                    if copy_start < virtual_address {
                        copy_start = virtual_address;
                    }
                    let copy_limit: u64 = page_address + 4096;
                    let segment_file_limit: u64 = virtual_address + file_size;
                    if copy_limit > segment_file_limit {
                        copy_limit = segment_file_limit;
                    }
                    if copy_start < copy_limit {
                        page_copy64(
                            frame + (copy_start - page_address),
                            image + file_offset
                                + (copy_start - virtual_address),
                            copy_limit - copy_start);
                    }
                    page_address = page_address + 4096;
                }
                loaded_segments = loaded_segments + 1;
            }
        }
        program_index = program_index + 1;
    }
    if loaded_segments == 0 || !entry_is_executable {
        return 0;
    }

    let stack_frame: u64 = frame_alloc64();
    if stack_frame == 0 {
        return 0;
    }
    page_zero64(stack_frame);
    page_table_set64(
        user_pt,
        511,
        stack_frame | no_execute | 0x7); // user RW, NX
    g_user_entry64 = entry;
    g_user_pt64 = user_pt;
    g_user_mmap_pt64 = mmap_pt;
    return pml4;
}

// Create a process from a validated ELF image. Each successful process owns a
// different PML4 and different physical frames even though every executable
// uses the same virtual layout.
fn process_create64(image: u64, image_size: u64) -> u32 {
    let slot: u32 = 0;
    while slot < 8 {
        if g_process_state64[slot] == 0 {
            let root: u64 = elf64_user_page_root(image, image_size);
            if root == 0 {
                return 8;
            }
            g_process_state64[slot] = 1;
            g_process_pid64[slot] = g_next_pid64;
            g_process_tid64[slot] = g_next_pid64;
            g_process_is_thread64[slot] = 0;
            g_process_root64[slot] = root;
            g_process_pt64[slot] = g_user_pt64;
            g_process_mmap_pt64[slot] = g_user_mmap_pt64;
            g_process_entry64[slot] = g_user_entry64;
            g_process_exit64[slot] = 0;
            g_process_fault64[slot] = 0;
            g_process_brk64[slot] = 0x01100000;
            g_process_brk_seen64[slot] = 0;
            g_process_context_valid64[slot] = 0;
            g_process_preemptions64[slot] = 0;
            g_process_clock_seen64[slot] = 0;
            g_process_mmap_seen64[slot] = 0;
            g_process_fs_base64[slot] = 0;
            g_process_tls_seen64[slot] = 0;
            g_process_thread_seen64[slot] = 0;
            g_process_handle_owner64[slot] = slot;
            g_process_pipe_seen64[slot] = 0;
            g_process_futex_seen64[slot] = 0;
            g_process_poll_seen64[slot] = 0;
            g_process_wait_address64[slot] = 0;
            let descriptor: u32 = 0;
            while descriptor < 8 {
                g_handle_type64[(slot * 8) + descriptor] = 0;
                g_handle_object64[(slot * 8) + descriptor] = 0;
                descriptor = descriptor + 1;
            }
            g_next_pid64 = g_next_pid64 + 1;
            return slot;
        }
        slot = slot + 1;
    }
    return 8;
}

// Minimal non-preemptive scheduler. It establishes real lifecycle semantics
// now: READY -> RUNNING -> EXITED/FAULTED, and a failed process cannot prevent
// the next READY process from being dispatched.
fn process_schedule64() -> u32 {
    let dispatched: u32 = 0;
    let rounds: u32 = 0;
    let found_ready: bool = true;
    while found_ready && rounds < 256 {
        found_ready = false;
        let slot: u32 = 0;
        while slot < 8 {
            if g_process_state64[slot] == 1 {
                found_ready = true;
                g_current_process64 = slot;
                g_process_state64[slot] = 2;
                g_user_pt64 = g_process_pt64[slot];
                g_user_mmap_pt64 = g_process_mmap_pt64[slot];
                mort64_set_user_fs(g_process_fs_base64[slot]);
                if g_process_context_valid64[slot] != 0 {
                    let context: u64 = (&g_process_context64 as u64)
                        + ((slot as u64) * 144);
                    mort64_resume_user(context, g_process_root64[slot]);
                } else {
                    mort64_enter_user(
                        g_process_entry64[slot],
                        0x01200000,
                        g_process_root64[slot]);
                }
                if g_process_state64[slot] == 2 {
                    // Returning without exit, yield, or a contained exception
                    // violates the ring-transition contract.
                    g_process_state64[slot] = 4;
                    g_process_fault64[slot] = 0xFFFFFFFF;
                }
                dispatched = dispatched + 1;
            }
            slot = slot + 1;
        }
        rounds = rounds + 1;
    }
    g_current_process64 = 8;
    return dispatched;
}

fn user_address_executable64(address: u64) -> bool {
    let entry: *u64 = user_page_entry64(address);
    if entry == ((0 as u64) as *u64) {
        return false;
    }
    let no_execute: u64 = (1 as u64) << 63;
    return (*entry & 0x5) == 0x5 && (*entry & no_execute) == 0;
}

// Create a schedulable task that shares the caller's address space. The
// supplied return trampoline guarantees a normal thread function return
// becomes SYS_exit rather than falling into an unmapped address.
fn thread_create64(
    entry: u64,
    stack_top: u64,
    argument: u64,
    return_trampoline: u64
) -> u64 {
    if g_current_process64 >= 8
        || (stack_top & 0xF) != 0
        || stack_top < 8
        || !user_address_executable64(entry)
        || !user_address_executable64(return_trampoline)
        || !user_range_writable64(stack_top - 8, 8) {
        return ~(21 as u64);                    // -EINVAL
    }
    let parent: u32 = g_current_process64;
    let slot: u32 = 0;
    while slot < 8 {
        if g_process_state64[slot] == 0 {
            let context: u64 = (&g_process_context64 as u64)
                + ((slot as u64) * 144);
            let field: u32 = 0;
            while field < 18 {
                *((context + ((field as u64) * 8)) as *u64) = 0;
                field = field + 1;
            }
            *((stack_top - 8) as *u64) = return_trampoline;
            *((context + 72) as *u64) = argument;       // RDI
            *((context + 120) as *u64) = entry;        // RIP
            *((context + 128) as *u64) = 0x202;        // RFLAGS
            *((context + 136) as *u64) = stack_top - 8;// RSP

            g_process_state64[slot] = 1;
            g_process_pid64[slot] = g_process_pid64[parent];
            g_process_tid64[slot] = g_next_pid64;
            g_process_is_thread64[slot] = 1;
            g_process_root64[slot] = g_process_root64[parent];
            g_process_pt64[slot] = g_process_pt64[parent];
            g_process_mmap_pt64[slot] = g_process_mmap_pt64[parent];
            g_process_entry64[slot] = entry;
            g_process_brk64[slot] = g_process_brk64[parent];
            g_process_fs_base64[slot] = 0;
            g_process_handle_owner64[slot] =
                g_process_handle_owner64[parent];
            g_process_context_valid64[slot] = 1;
            g_process_exit64[slot] = 0;
            g_process_fault64[slot] = 0;
            g_process_preemptions64[slot] = 0;
            g_process_wait_address64[slot] = 0;
            g_process_thread_seen64[parent] = 1;
            g_next_pid64 = g_next_pid64 + 1;
            return g_process_tid64[slot];
        }
        slot = slot + 1;
    }
    return ~(10 as u64);                       // -EAGAIN
}

// Reclaim every user leaf and paging structure owned by a terminal process.
// The current bootstrap has one user PT under PML4[0]/PDPT[0]/PD[8].
fn process_reap64(slot: u32) -> bool {
    if slot >= 8
        || (g_process_state64[slot] != 3
            && g_process_state64[slot] != 4) {
        return false;
    }
    let root: u64 = g_process_root64[slot];
    let user_pt: u64 = g_process_pt64[slot];
    let mmap_pt: u64 = g_process_mmap_pt64[slot];
    if root == 0 || user_pt == 0 || mmap_pt == 0 {
        return false;
    }
    // Reap terminal threads sharing this address space before releasing its
    // page tables. A live sibling makes the owner non-reapable.
    let sibling: u32 = 0;
    while sibling < 8 {
        if sibling != slot && g_process_root64[sibling] == root {
            if g_process_state64[sibling] != 3
                && g_process_state64[sibling] != 4 {
                return false;
            }
            g_process_state64[sibling] = 0;
            g_process_pid64[sibling] = 0;
            g_process_tid64[sibling] = 0;
            g_process_is_thread64[sibling] = 0;
            g_process_root64[sibling] = 0;
            g_process_pt64[sibling] = 0;
            g_process_mmap_pt64[sibling] = 0;
            g_process_context_valid64[sibling] = 0;
            g_process_wait_address64[sibling] = 0;
            g_process_handle_owner64[sibling] = sibling;
        }
        sibling = sibling + 1;
    }
    let descriptor: u32 = 3;
    while descriptor < 8 {
        handle_close_owner64(
            g_process_handle_owner64[slot], descriptor);
        descriptor = descriptor + 1;
    }
    let index: u32 = 0;
    while index < 512 {
        let entry: *u64 =
            (user_pt + ((index as u64) * 8)) as *u64;
        if (*entry & 1) != 0 {
            frame_free64(*entry & 0x000FFFFFFFFFF000);
            *entry = 0;
        }
        index = index + 1;
    }
    index = 0;
    while index < 512 {
        let entry: *u64 =
            (mmap_pt + ((index as u64) * 8)) as *u64;
        if (*entry & 1) != 0 {
            frame_free64(*entry & 0x000FFFFFFFFFF000);
            *entry = 0;
        }
        index = index + 1;
    }
    let pdpt: u64 = *((root + 0) as *u64) & 0x000FFFFFFFFFF000;
    if pdpt == 0 {
        return false;
    }
    let pd: u64 = *((pdpt + 0) as *u64) & 0x000FFFFFFFFFF000;
    let mmap_pd: u64 = *((pdpt + 8) as *u64)
        & 0x000FFFFFFFFFF000;
    if pd == 0 || mmap_pd == 0 {
        return false;
    }
    frame_free64(user_pt);
    frame_free64(mmap_pt);
    frame_free64(mmap_pd);
    frame_free64(pd);
    frame_free64(pdpt);
    frame_free64(root);
    g_process_state64[slot] = 0;
    g_process_pid64[slot] = 0;
    g_process_tid64[slot] = 0;
    g_process_is_thread64[slot] = 0;
    g_process_root64[slot] = 0;
    g_process_pt64[slot] = 0;
    g_process_mmap_pt64[slot] = 0;
    g_process_entry64[slot] = 0;
    g_process_fs_base64[slot] = 0;
    g_process_wait_address64[slot] = 0;
    g_process_handle_owner64[slot] = slot;
    g_process_context_valid64[slot] = 0;
    return true;
}

// Called by the architectural SYS_yield path. The assembly saves the actual
// register values into the returned per-process context before returning to
// the scheduler.
fn on_user_yield64() -> u64 {
    if g_current_process64 >= 8 {
        return 0;
    }
    g_process_state64[g_current_process64] = 1;
    g_process_context_valid64[g_current_process64] = 1;
    return (&g_process_context64 as u64)
        + ((g_current_process64 as u64) * 144);
}

fn on_futex_wait64(address: u64, expected: u64) -> u64 {
    if g_current_process64 >= 8 || (address & 3) != 0 {
        return ~(21 as u64);                    // -EINVAL
    }
    if !user_range_readable64(address, 4) {
        return ~(13 as u64);                    // -EFAULT
    }
    if (*(address as *u32)) != (expected as u32) {
        return ~(10 as u64);                    // -EAGAIN
    }
    let slot: u32 = g_current_process64;
    g_process_state64[slot] = 5;
    g_process_wait_address64[slot] = address;
    g_process_context_valid64[slot] = 1;
    let owner: u32 = g_process_handle_owner64[slot];
    g_process_futex_seen64[owner] = 1;
    return (&g_process_context64 as u64)
        + ((slot as u64) * 144);
}

fn futex_wake64(address: u64, count: u64) -> u64 {
    if g_current_process64 >= 8 || (address & 3) != 0
        || count > 8 {
        return ~(21 as u64);
    }
    if !user_range_readable64(address, 4) {
        return ~(13 as u64);
    }
    let root: u64 = g_process_root64[g_current_process64];
    let woken: u64 = 0;
    let slot: u32 = 0;
    while slot < 8 && woken < count {
        if g_process_state64[slot] == 5
            && g_process_root64[slot] == root
            && g_process_wait_address64[slot] == address {
            g_process_wait_address64[slot] = 0;
            g_process_state64[slot] = 1;
            woken = woken + 1;
        }
        slot = slot + 1;
    }
    return woken;
}

// IRQ0 policy. Returning a context pointer asks the assembly interrupt path to
// save the complete interrupted state and return to the scheduler.
fn on_timer_tick64(code_segment: u64) -> u64 {
    g_timer_ticks64 = g_timer_ticks64 + 1;
    if (code_segment & 3) != 3
        || g_current_process64 >= 8
        || g_process_state64[g_current_process64] != 2 {
        return 0;
    }
    g_process_state64[g_current_process64] = 1;
    g_process_context_valid64[g_current_process64] = 1;
    g_process_preemptions64[g_current_process64] =
        g_process_preemptions64[g_current_process64] + 1;
    return (&g_process_context64 as u64)
        + ((g_current_process64 as u64) * 144);
}

fn on_exception64(
    vector: u64,
    error: u64,
    rip: u64,
    code_segment: u64
) -> u64 {
    if vector == 3 {
        g_breakpoint_seen64 = true;
        return 0;
    }
    if (code_segment & 3) == 3 {
        g_user_fault_seen64 = true;
        g_user_fault_vector64 = vector;
        g_user_fault_error64 = error;
        if g_current_process64 < 8 {
            g_process_state64[g_current_process64] = 4;
            g_process_fault64[g_current_process64] = vector;
            g_process_context_valid64[g_current_process64] = 0;
        }
        serial_write64("MORT64: user CPU fault contained\r\n");
        return 1;
    }
    serial_write64("MORT64 ERROR: unhandled CPU exception\r\n");
    if error != 0 || rip != 0 || code_segment != 0 {
        serial_write64("MORT64: exception frame captured\r\n");
    }
    asm("cli");
    while true {
        asm("hlt");
    }
    return 0;
}

fn user_page_entry64(address: u64) -> *u64 {
    if address >= 0x01000000 && address < 0x01200000
        && g_user_pt64 != 0 {
        let index: u32 =
            ((address - 0x01000000) / 4096) as u32;
        return (g_user_pt64 + ((index as u64) * 8)) as *u64;
    }
    if address >= 0x40000000 && address < 0x40200000
        && g_user_mmap_pt64 != 0 {
        let index: u32 =
            ((address - 0x40000000) / 4096) as u32;
        return (g_user_mmap_pt64 + ((index as u64) * 8)) as *u64;
    }
    return (0 as u64) as *u64;
}

fn user_range_readable64(address: u64, length: u64) -> bool {
    if length == 0 {
        return true;
    }
    let limit: u64 = address + length;
    if limit < address || length > 0x00200000 {
        return false;
    }
    let page: u64 = (address / 4096) * 4096;
    while page < limit {
        let slot: *u64 = user_page_entry64(page);
        if slot == ((0 as u64) as *u64) {
            return false;
        }
        let entry: u64 = *slot;
        if (entry & 0x5) != 0x5 {               // present and user-accessible
            return false;
        }
        page = page + 4096;
    }
    return true;
}

fn user_range_writable64(address: u64, length: u64) -> bool {
    if length == 0 {
        return true;
    }
    let limit: u64 = address + length;
    if limit < address || length > 0x00200000 {
        return false;
    }
    let page: u64 = (address / 4096) * 4096;
    while page < limit {
        let slot: *u64 = user_page_entry64(page);
        if slot == ((0 as u64) as *u64) {
            return false;
        }
        let entry: u64 = *slot;
        if (entry & 0x7) != 0x7 {
            return false;
        }
        page = page + 4096;
    }
    return true;
}

// Linux-compatible brk return semantics over a MortOS-native per-process heap.
// Heap pages are user RW + NX, allocated zeroed, and released on shrink.
fn process_brk64(requested: u64) -> u64 {
    if g_current_process64 >= 8 {
        return 0;
    }
    let slot: u32 = g_current_process64;
    let current: u64 = g_process_brk64[slot];
    if requested == 0 {
        return current;
    }
    if requested < 0x01100000 || requested > 0x011F0000 {
        return current;
    }
    let user_pt: u64 = g_process_pt64[slot];
    if user_pt == 0 {
        return current;
    }
    let no_execute: u64 = (1 as u64) << 63;
    if requested > current {
        let cursor: u64 = ((current + 4095) / 4096) * 4096;
        let limit: u64 = ((requested + 4095) / 4096) * 4096;
        let mapped_start: u64 = cursor;
        while cursor < limit {
            let index: u32 =
                ((cursor - 0x01000000) / 4096) as u32;
            let entry: *u64 =
                (user_pt + ((index as u64) * 8)) as *u64;
            if *entry == 0 {
                let frame: u64 = frame_alloc64();
                if frame == 0 {
                    let rollback: u64 = mapped_start;
                    while rollback < cursor {
                        let rollback_index: u32 =
                            ((rollback - 0x01000000) / 4096) as u32;
                        let rollback_entry: *u64 = (user_pt
                            + ((rollback_index as u64) * 8)) as *u64;
                        if *rollback_entry != 0 {
                            frame_free64(*rollback_entry & 0x000FFFFFFFFFF000);
                            *rollback_entry = 0;
                        }
                        rollback = rollback + 4096;
                    }
                    mort64_flush_tlb();
                    return current;
                }
                page_zero64(frame);
                *entry = frame | no_execute | 0x7;
            }
            cursor = cursor + 4096;
        }
    } else if requested < current {
        let cursor: u64 = ((requested + 4095) / 4096) * 4096;
        let limit: u64 = ((current + 4095) / 4096) * 4096;
        while cursor < limit {
            let index: u32 =
                ((cursor - 0x01000000) / 4096) as u32;
            let entry: *u64 =
                (user_pt + ((index as u64) * 8)) as *u64;
            if *entry != 0 {
                frame_free64(*entry & 0x000FFFFFFFFFF000);
                *entry = 0;
            }
            cursor = cursor + 4096;
        }
    }
    g_process_brk64[slot] = requested;
    g_process_brk_seen64[slot] = 1;
    mort64_flush_tlb();
    return requested;
}

fn mmap_range_free64(first: u32, pages: u32) -> bool {
    if first >= 512 || pages == 0 || pages > 512 - first
        || g_user_mmap_pt64 == 0 {
        return false;
    }
    let index: u32 = first;
    let limit: u32 = first + pages;
    while index < limit {
        if *((g_user_mmap_pt64 + ((index as u64) * 8)) as *u64) != 0 {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn process_mmap64(
    address: u64,
    length: u64,
    protection: u64,
    flags: u64,
    descriptor: u64,
    offset: u64
) -> u64 {
    // Bootstrap supports private anonymous mappings. MAP_FIXED is honored
    // only for aligned addresses inside the dedicated 1 GiB arena.
    if g_current_process64 >= 8 || g_user_mmap_pt64 == 0
        || length == 0 || length > 0x00200000
        || (protection & 2) != 0 && (protection & 4) != 0
        || (flags & 0x22) != 0x22
        || descriptor != ~(0 as u64)
        || offset != 0 {
        return ~(21 as u64);                    // -EINVAL
    }
    let rounded: u64 = ((length + 4095) / 4096) * 4096;
    if rounded == 0 || rounded > 0x00200000 {
        return ~(11 as u64);                    // -ENOMEM
    }
    let pages: u32 = (rounded / 4096) as u32;
    let first: u32 = 512;
    if address != 0 {
        if (address & 0xFFF) == 0
            && address >= 0x40000000
            && address < 0x40200000 {
            let hinted: u32 =
                ((address - 0x40000000) / 4096) as u32;
            if mmap_range_free64(hinted, pages) {
                first = hinted;
            }
        }
        if first == 512 && (flags & 0x10) != 0 {
            return ~(21 as u64);                // -EINVAL
        }
    }
    if first == 512 {
        let candidate: u32 = 0;
        while candidate <= 512 - pages {
            if mmap_range_free64(candidate, pages) {
                first = candidate;
                candidate = 513;
            } else {
                candidate = candidate + 1;
            }
        }
    }
    if first >= 512 {
        return ~(11 as u64);                    // -ENOMEM
    }

    let no_execute: u64 = (1 as u64) << 63;
    let mapped: u32 = 0;
    while mapped < pages {
        let frame: u64 = frame_alloc64();
        if frame == 0 {
            let rollback: u32 = 0;
            while rollback < mapped {
                let entry: *u64 = (g_user_mmap_pt64
                    + (((first + rollback) as u64) * 8)) as *u64;
                frame_free64(*entry & 0x000FFFFFFFFFF000);
                *entry = 0;
                rollback = rollback + 1;
            }
            mort64_flush_tlb();
            return ~(11 as u64);                // -ENOMEM
        }
        page_zero64(frame);
        let page_flags: u64 = 1;
        if protection != 0 {
            page_flags = page_flags | 4;
        }
        if (protection & 2) != 0 {
            page_flags = page_flags | 2;
        }
        if (protection & 4) == 0 {
            page_flags = page_flags | no_execute;
        }
        *((g_user_mmap_pt64
            + (((first + mapped) as u64) * 8)) as *u64) =
            frame | page_flags;
        mapped = mapped + 1;
    }
    g_process_mmap_seen64[g_current_process64] = 1;
    mort64_flush_tlb();
    return 0x40000000 + ((first as u64) * 4096);
}

fn process_mprotect64(
    address: u64,
    length: u64,
    protection: u64
) -> u64 {
    if g_current_process64 >= 8 || g_user_mmap_pt64 == 0
        || length == 0 || (address & 0xFFF) != 0
        || address < 0x40000000 || address >= 0x40200000
        || length > 0x00200000
        || (protection & 2) != 0 && (protection & 4) != 0 {
        return ~(21 as u64);                    // -EINVAL
    }
    let rounded: u64 = ((length + 4095) / 4096) * 4096;
    let limit: u64 = address + rounded;
    if limit < address || limit > 0x40200000 {
        return ~(11 as u64);                    // -ENOMEM
    }
    let first: u32 = ((address - 0x40000000) / 4096) as u32;
    let pages: u32 = (rounded / 4096) as u32;
    let index: u32 = 0;
    while index < pages {
        let entry: u64 = *((g_user_mmap_pt64
            + (((first + index) as u64) * 8)) as *u64);
        if (entry & 1) == 0 {
            return ~(11 as u64);                // -ENOMEM
        }
        index = index + 1;
    }
    let no_execute: u64 = (1 as u64) << 63;
    index = 0;
    while index < pages {
        let entry: *u64 = (g_user_mmap_pt64
            + (((first + index) as u64) * 8)) as *u64;
        let replacement: u64 = (*entry & 0x000FFFFFFFFFF000) | 1;
        if protection != 0 {
            replacement = replacement | 4;
        }
        if (protection & 2) != 0 {
            replacement = replacement | 2;
        }
        if (protection & 4) == 0 {
            replacement = replacement | no_execute;
        }
        *entry = replacement;
        index = index + 1;
    }
    mort64_flush_tlb();
    return 0;
}

fn process_munmap64(address: u64, length: u64) -> u64 {
    if g_current_process64 >= 8 || g_user_mmap_pt64 == 0
        || length == 0 || (address & 0xFFF) != 0
        || address < 0x40000000 || address >= 0x40200000
        || length > 0x00200000 {
        return ~(21 as u64);                    // -EINVAL
    }
    let rounded: u64 = ((length + 4095) / 4096) * 4096;
    let limit: u64 = address + rounded;
    if limit < address || limit > 0x40200000 {
        return ~(21 as u64);
    }
    let first: u32 = ((address - 0x40000000) / 4096) as u32;
    let pages: u32 = (rounded / 4096) as u32;
    let index: u32 = 0;
    while index < pages {
        let entry: *u64 = (g_user_mmap_pt64
            + (((first + index) as u64) * 8)) as *u64;
        if (*entry & 1) != 0 {
            frame_free64(*entry & 0x000FFFFFFFFFF000);
            *entry = 0;
        }
        index = index + 1;
    }
    mort64_flush_tlb();
    return 0;
}

fn handle_close_owner64(owner: u32, descriptor: u32) -> u64 {
    if owner >= 8 || descriptor >= 8 {
        return ~(8 as u64);                     // -EBADF
    }
    let index: u32 = (owner * 8) + descriptor;
    let kind: u8 = g_handle_type64[index];
    if kind == 0 {
        return ~(8 as u64);
    }
    let pipe: u32 = g_handle_object64[index];
    if pipe < 4 {
        if kind == 2 && g_pipe_readers64[pipe] > 0 {
            g_pipe_readers64[pipe] = g_pipe_readers64[pipe] - 1;
        }
        if kind == 3 && g_pipe_writers64[pipe] > 0 {
            g_pipe_writers64[pipe] = g_pipe_writers64[pipe] - 1;
        }
        if g_pipe_readers64[pipe] == 0
            && g_pipe_writers64[pipe] == 0 {
            g_pipe_used64[pipe] = 0;
            g_pipe_read64[pipe] = 0;
            g_pipe_write64[pipe] = 0;
            g_pipe_count64[pipe] = 0;
        }
    }
    g_handle_type64[index] = 0;
    g_handle_object64[index] = 0;
    return 0;
}

fn process_close64(descriptor: u64) -> u64 {
    if g_current_process64 >= 8 || descriptor >= 8 {
        return ~(8 as u64);
    }
    return handle_close_owner64(
        g_process_handle_owner64[g_current_process64],
        descriptor as u32);
}

fn process_pipe2_64(descriptors: u64, flags: u64) -> u64 {
    if g_current_process64 >= 8 || flags != 0 {
        return ~(21 as u64);                    // -EINVAL
    }
    if !user_range_writable64(descriptors, 8) {
        return ~(13 as u64);                    // -EFAULT
    }
    let owner: u32 = g_process_handle_owner64[g_current_process64];
    let read_fd: u32 = 8;
    let write_fd: u32 = 8;
    let candidate: u32 = 3;
    while candidate < 8 {
        if g_handle_type64[(owner * 8) + candidate] == 0 {
            if read_fd == 8 {
                read_fd = candidate;
            } else if write_fd == 8 {
                write_fd = candidate;
            }
        }
        candidate = candidate + 1;
    }
    let pipe: u32 = 4;
    candidate = 0;
    while candidate < 4 {
        if pipe == 4 && g_pipe_used64[candidate] == 0 {
            pipe = candidate;
        }
        candidate = candidate + 1;
    }
    if read_fd == 8 || write_fd == 8 || pipe == 4 {
        return ~(23 as u64);                    // -EMFILE
    }
    g_pipe_used64[pipe] = 1;
    g_pipe_read64[pipe] = 0;
    g_pipe_write64[pipe] = 0;
    g_pipe_count64[pipe] = 0;
    g_pipe_readers64[pipe] = 1;
    g_pipe_writers64[pipe] = 1;
    g_handle_type64[(owner * 8) + read_fd] = 2;
    g_handle_object64[(owner * 8) + read_fd] = pipe;
    g_handle_type64[(owner * 8) + write_fd] = 3;
    g_handle_object64[(owner * 8) + write_fd] = pipe;
    *(descriptors as *u32) = read_fd;
    *((descriptors + 4) as *u32) = write_fd;
    g_process_pipe_seen64[owner] = 1;
    return 0;
}

fn process_pipe_write64(
    descriptor: u64,
    buffer: u64,
    length: u64
) -> u64 {
    if g_current_process64 >= 8 || descriptor >= 8 {
        return ~(8 as u64);
    }
    let owner: u32 = g_process_handle_owner64[g_current_process64];
    let index: u32 = (owner * 8) + (descriptor as u32);
    if g_handle_type64[index] != 3 {
        return ~(8 as u64);
    }
    let pipe: u32 = g_handle_object64[index];
    if pipe >= 4 || g_pipe_readers64[pipe] == 0 {
        return ~(31 as u64);                    // -EPIPE
    }
    if length == 0 {
        return 0;
    }
    let available: u64 = (256 - g_pipe_count64[pipe]) as u64;
    let count: u64 = length;
    if count > available {
        count = available;
    }
    if count == 0 {
        return ~(10 as u64);                    // -EAGAIN
    }
    if !user_range_readable64(buffer, count) {
        return ~(13 as u64);
    }
    let offset: u64 = 0;
    while offset < count {
        let position: u32 = g_pipe_write64[pipe] % 256;
        g_pipe_data64[(pipe * 256) + position] =
            *((buffer + offset) as *u8);
        g_pipe_write64[pipe] = g_pipe_write64[pipe] + 1;
        g_pipe_count64[pipe] = g_pipe_count64[pipe] + 1;
        offset = offset + 1;
    }
    return count;
}

fn process_pipe_read64(
    descriptor: u64,
    buffer: u64,
    length: u64
) -> u64 {
    if g_current_process64 >= 8 || descriptor >= 8 {
        return ~(8 as u64);
    }
    let owner: u32 = g_process_handle_owner64[g_current_process64];
    let index: u32 = (owner * 8) + (descriptor as u32);
    if g_handle_type64[index] != 2 {
        return ~(8 as u64);
    }
    let pipe: u32 = g_handle_object64[index];
    if length == 0 {
        return 0;
    }
    let count: u64 = length;
    if count > (g_pipe_count64[pipe] as u64) {
        count = g_pipe_count64[pipe] as u64;
    }
    if count == 0 {
        if g_pipe_writers64[pipe] == 0 {
            return 0;
        }
        return ~(10 as u64);                    // -EAGAIN
    }
    if !user_range_writable64(buffer, count) {
        return ~(13 as u64);
    }
    let offset: u64 = 0;
    while offset < count {
        let position: u32 = g_pipe_read64[pipe] % 256;
        *((buffer + offset) as *u8) =
            g_pipe_data64[(pipe * 256) + position];
        g_pipe_read64[pipe] = g_pipe_read64[pipe] + 1;
        g_pipe_count64[pipe] = g_pipe_count64[pipe] - 1;
        offset = offset + 1;
    }
    return count;
}

fn process_poll64(pollfds: u64, count: u64, timeout: u64) -> u64 {
    if g_current_process64 >= 8 || count > 8 {
        return ~(21 as u64);                    // -EINVAL
    }
    if timeout != 0 {
        return ~(37 as u64);                    // -ENOSYS
    }
    if count != 0
        && !user_range_writable64(pollfds, count * 8) {
        return ~(13 as u64);                    // -EFAULT
    }
    let owner: u32 = g_process_handle_owner64[g_current_process64];
    let ready: u64 = 0;
    let item: u64 = 0;
    while item < count {
        let record: u64 = pollfds + (item * 8);
        let descriptor: i32 = *(record as *i32);
        let events: u16 = *((record + 4) as *u16);
        let returned: u16 = 0;
        if descriptor == 1 {
            if (events & 4) != 0 {
                returned = returned | 4;        // POLLOUT
            }
        } else if descriptor < 0 || descriptor >= 8 {
            returned = returned | 32;           // POLLNVAL
        } else {
            let handle: u32 = (owner * 8) + (descriptor as u32);
            let kind: u8 = g_handle_type64[handle];
            if kind == 0 {
                returned = returned | 32;
            } else {
                let pipe: u32 = g_handle_object64[handle];
                if kind == 2 {
                    if (events & 1) != 0
                        && g_pipe_count64[pipe] > 0 {
                        returned = returned | 1;// POLLIN
                    }
                    if g_pipe_writers64[pipe] == 0 {
                        returned = returned | 16;// POLLHUP
                    }
                } else if kind == 3 {
                    if g_pipe_readers64[pipe] == 0 {
                        returned = returned | 8;// POLLERR
                    } else if (events & 4) != 0
                        && g_pipe_count64[pipe] < 256 {
                        returned = returned | 4;// POLLOUT
                    }
                }
            }
        }
        *((record + 6) as *u16) = returned;
        if returned != 0 {
            ready = ready + 1;
        }
        item = item + 1;
    }
    g_process_poll_seen64[owner] = 1;
    return ready;
}

fn syscall_dispatch64(
    number: u64,
    argument0: u64,
    argument1: u64,
    argument2: u64,
    argument3: u64,
    argument4: u64,
    argument5: u64
) -> u64 {
    if number == 0 {
        return process_pipe_read64(argument0, argument1, argument2);
    }
    if number == 9 {
        return process_mmap64(
            argument0, argument1, argument2,
            argument3, argument4, argument5);
    }
    if number == 10 {
        return process_mprotect64(argument0, argument1, argument2);
    }
    if number == 11 {
        return process_munmap64(argument0, argument1);
    }
    if number == 3 {
        return process_close64(argument0);
    }
    if number == 7 {
        return process_poll64(argument0, argument1, argument2);
    }
    if number == 293 {
        return process_pipe2_64(argument0, argument1);
    }
    if number == 202 {
        if argument1 == 1 {                     // FUTEX_WAKE
            return futex_wake64(argument0, argument2);
        }
        return ~(21 as u64);
    }
    if number == 1 {
        if argument0 != 1 {
            return process_pipe_write64(
                argument0, argument1, argument2);
        }
        if argument2 > 4096
            || !user_range_readable64(argument1, argument2) {
            g_user_pointer_rejected64 = true;
            serial_write64(
                "MORT64: syscall rejected supervisor pointer\r\n");
            return ~(13 as u64);                // -EFAULT
        }
        let offset: u64 = 0;
        while offset < argument2 {
            serial_put64(*((argument1 + offset) as *u8));
            offset = offset + 1;
        }
        g_user_probe_seen64 = true;
        serial_write64("MORT64: ring 3 Mort program invoked write\r\n");
        return argument2;
    }
    if number == 39 {
        if g_current_process64 < 8 {
            return g_process_pid64[g_current_process64];
        }
        return 0;
    }
    if number == 186 {
        if g_current_process64 < 8 {
            return g_process_tid64[g_current_process64];
        }
        return 0;
    }
    if number == 400 {
        return thread_create64(
            argument0, argument1, argument2, argument3);
    }
    if number == 12 {
        return process_brk64(argument0);
    }
    if number == 228 {
        if argument0 != 1 {
            return ~(21 as u64);                // -EINVAL
        }
        if !user_range_writable64(argument1, 16) {
            return ~(13 as u64);                // -EFAULT
        }
        let ticks: u64 = g_timer_ticks64;
        *((argument1 + 0) as *u64) = ticks / 100;
        *((argument1 + 8) as *u64) =
            (ticks % 100) * 10000000;
        if g_current_process64 < 8 {
            g_process_clock_seen64[g_current_process64] = 1;
        }
        return 0;
    }
    if number == 158 {
        if g_current_process64 >= 8 {
            return ~(21 as u64);                // -EINVAL
        }
        if argument0 == 0x1002 {                // ARCH_SET_FS
            if argument1 != 0
                && !user_range_writable64(argument1, 1) {
                return ~(13 as u64);            // -EFAULT
            }
            g_process_fs_base64[g_current_process64] = argument1;
            g_process_tls_seen64[g_current_process64] = 1;
            mort64_set_user_fs(argument1);
            return 0;
        }
        if argument0 == 0x1003 {                // ARCH_GET_FS
            if !user_range_writable64(argument1, 8) {
                return ~(13 as u64);
            }
            *(argument1 as *u64) =
                g_process_fs_base64[g_current_process64];
            return 0;
        }
        return ~(21 as u64);
    }
    return ~(37 as u64); // -ENOSYS
}

fn on_user_exit64(status: u64) {
    g_user_exit_status64 = status;
    g_user_exit_seen64 = true;
    if g_current_process64 < 8 {
        g_process_exit64[g_current_process64] = status;
        g_process_state64[g_current_process64] = 3;
        g_process_context_valid64[g_current_process64] = 0;
        if g_process_is_thread64[g_current_process64] != 0
            && status == 31 {
            g_thread_exit_seen64 = true;
        }
    }
}

fn kmain64(multiboot_info: u64) {
    serial_init64();
    serial_write64("MORT64: long mode active\r\n");
    serial_write64("MORT64: kernel entry is compiled from Mort\r\n");
    if multiboot_info != 0 {
        serial_write64("MORT64: Multiboot handoff received\r\n");
    } else {
        serial_write64("MORT64 ERROR: missing Multiboot handoff\r\n");
    }
    if phys_init64(multiboot_info) {
        serial_write64("MORT64: Multiboot memory map accepted\r\n");
        if phys_self_test64() {
            serial_write64("MORT64: physical frame allocator passed\r\n");
        } else {
            serial_write64("MORT64 ERROR: physical frame allocator failed\r\n");
        }
    } else {
        serial_write64("MORT64 ERROR: physical memory map unavailable\r\n");
    }

    if mort64_cpu_init() != 0 {
        serial_write64("MORT64: GDT TSS IDT and SYSCALL active\r\n");
        mort64_idt_self_test();
        if g_breakpoint_seen64 {
            serial_write64("MORT64: IDT breakpoint self-test passed\r\n");
        } else {
            serial_write64("MORT64 ERROR: IDT breakpoint was not handled\r\n");
        }
        timer_init64();
        asm("sti");
        serial_write64("MORT64: PIT timer interrupts active\r\n");

        let frames_before_processes: u32 = g_frame_free64;
        let probe_slot: u32 = process_create64(
            mort64_probe_image(), mort64_probe_image_size());
        let isolation_slot: u32 = process_create64(
            mort64_isolation_image(), mort64_isolation_image_size());
        let survivor_slot: u32 = process_create64(
            mort64_survivor_image(), mort64_survivor_image_size());
        let preempt_slot: u32 = process_create64(
            mort64_preempt_image(), mort64_preempt_image_size());
        let cxx_slot: u32 = process_create64(
            mort64_cxx_image(), mort64_cxx_image_size());
        if probe_slot < 8 && isolation_slot < 8 && survivor_slot < 8
            && preempt_slot < 8 && cxx_slot < 8
            && g_process_root64[probe_slot]
                != g_process_root64[isolation_slot]
            && g_process_root64[probe_slot]
                != g_process_root64[survivor_slot]
            && g_process_root64[isolation_slot]
                != g_process_root64[survivor_slot]
            && g_process_root64[preempt_slot]
                != g_process_root64[probe_slot]
            && g_process_root64[preempt_slot]
                != g_process_root64[isolation_slot]
            && g_process_root64[preempt_slot]
                != g_process_root64[survivor_slot]
            && g_process_root64[cxx_slot]
                != g_process_root64[probe_slot]
            && g_process_root64[cxx_slot]
                != g_process_root64[isolation_slot]
            && g_process_root64[cxx_slot]
                != g_process_root64[survivor_slot]
            && g_process_root64[cxx_slot]
                != g_process_root64[preempt_slot] {
            serial_write64(
                "MORT64: ELF64 loader mapped five isolated processes\r\n");
            let dispatched: u32 = process_schedule64();
            if dispatched >= 9
                && g_process_state64[probe_slot] == 3
                && g_process_exit64[probe_slot] == 42
                && g_user_probe_seen64
                && g_user_pointer_rejected64
                && g_process_brk_seen64[probe_slot] != 0
                && *((g_process_pt64[probe_slot] + (256 * 8)) as *u64) == 0
                && *((g_process_pt64[probe_slot] + (257 * 8)) as *u64) == 0 {
                serial_write64(
                    "MORT64: cooperative context switch passed\r\n");
                serial_write64(
                    "MORT64: demand-paged process heap passed\r\n");
                serial_write64("MORT64: protected Mort userspace passed\r\n");
            } else {
                serial_write64("MORT64 ERROR: protected userspace failed\r\n");
            }
            if g_process_state64[isolation_slot] == 4
                && g_process_fault64[isolation_slot] == 14
                && g_user_fault_seen64
                && g_user_fault_vector64 == 14
                && (g_user_fault_error64 & 0x5) == 0x5 {
                serial_write64(
                    "MORT64: supervisor page fault isolation passed\r\n");
            } else {
                serial_write64(
                    "MORT64 ERROR: supervisor page isolation failed\r\n");
            }
            if g_process_state64[survivor_slot] == 3
                && g_process_exit64[survivor_slot] == 7 {
                serial_write64(
                    "MORT64: scheduler continued after process fault\r\n");
                serial_write64(
                    "MORT64: process lifecycle and PID ABI passed\r\n");
            } else {
                serial_write64(
                    "MORT64 ERROR: scheduler lifecycle failed\r\n");
            }
            if g_process_state64[preempt_slot] == 3
                && g_process_exit64[preempt_slot] == 11
                && g_process_preemptions64[preempt_slot] > 0
                && g_process_clock_seen64[preempt_slot] != 0
                && g_process_mmap_seen64[preempt_slot] != 0
                && *((g_process_mmap_pt64[preempt_slot] + 0) as *u64) == 0
                && g_timer_ticks64 > 0 {
                serial_write64(
                    "MORT64: W^X JIT mapping transition passed\r\n");
                serial_write64(
                    "MORT64: timer preemption context switch passed\r\n");
            } else {
                serial_write64(
                    "MORT64 ERROR: timer preemption failed\r\n");
            }
            if g_process_state64[cxx_slot] == 3
                && g_process_exit64[cxx_slot] == 23
                && g_process_mmap_seen64[cxx_slot] != 0
                && g_process_tls_seen64[cxx_slot] != 0
                && g_process_thread_seen64[cxx_slot] != 0
                && g_process_pipe_seen64[cxx_slot] != 0
                && g_process_futex_seen64[cxx_slot] != 0
                && g_process_poll_seen64[cxx_slot] != 0
                && g_thread_exit_seen64 {
                serial_write64(
                    "MORT64: poll readiness ABI passed\r\n");
                serial_write64(
                    "MORT64: futex wait and wake passed\r\n");
                serial_write64(
                    "MORT64: descriptor pipe IPC passed\r\n");
                serial_write64(
                    "MORT64: shared-address-space thread passed\r\n");
                serial_write64(
                    "MORT64: FS-base TLS and atomic ABI passed\r\n");
                serial_write64(
                    "MORT64: freestanding C++ runtime passed\r\n");
            } else {
                serial_write64(
                    "MORT64 ERROR: C++ runtime failed\r\n");
            }
            if process_reap64(probe_slot)
                && process_reap64(isolation_slot)
                && process_reap64(survivor_slot)
                && process_reap64(preempt_slot)
                && process_reap64(cxx_slot)
                && g_frame_free64 == frames_before_processes {
                serial_write64(
                    "MORT64: process address spaces reclaimed\r\n");
            } else {
                serial_write64(
                    "MORT64 ERROR: process reaper leaked frames\r\n");
            }
        } else {
            serial_write64(
                "MORT64 ERROR: isolated process creation failed\r\n");
        }
    } else {
        serial_write64("MORT64 ERROR: protected CPU setup failed\r\n");
    }
    serial_write64("MORT64: bootstrap foundation ready\r\n");

    asm("cli");
    while true {
        asm("hlt");
    }
}
