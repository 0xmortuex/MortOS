// net/mpkg.mx - mpkg, the MORT OS package manager client.
//
// apt/npm for MORT OS. Fetches a package index and packages over HTTP from the
// mort-repo server (github.com/0xmortuex/mort-repo, served with serve.py) and
// installs programs into /bin so they run by name via $PATH.
//
// Self-contained: it brings up its own short-lived TCP connection using the
// shared packet builders (eth/ip/tcp/arp) and the RTL8139 driver, so it does NOT
// depend on the browser's networking. The connection is a minimal active-open
// HTTP/1.0 client (SYN, GET, receive-to-FIN, close) - enough for a trusted repo
// on the local host through QEMU SLIRP (gateway 10.0.2.2).
//
// Commands: mpkg update | list | search <t> | install <name> | remove <name>.

let MPKG_PORT: u16 = 8000;              // serve.py listens here (host 10.0.2.2)
let MPKG_TCP_RST: u8 = 0x04;           // RST flag (not defined elsewhere)

// ---- connection + response state ----
let g_mpkg_tx: [u8; 1500] = [0; 1500];
let g_mpkg_rx: [u8; 2048] = [0; 2048];
let g_mpkg_raw: [u8; 16384] = [0; 16384];   // accumulated HTTP response
let g_mpkg_raw_len: u32 = 0;
let g_mpkg_index: [u8; 4096] = [0; 4096];   // cached index body (from `mpkg update`)
let g_mpkg_index_len: u32 = 0;
let g_mpkg_have_index: bool = false;
let g_mpkg_body: [u8; 16384] = [0; 16384];  // extracted package body (for install)
let g_mpkg_body_len: u32 = 0;
let g_mpkg_peer_mac: [u8; 6] = [0; 6];      // gateway MAC (from ARP)
let g_mpkg_snd: u32 = 0;
let g_mpkg_rcv: u32 = 0;
let g_mpkg_ipid: u16 = 0x0100;
let g_mpkg_lport: u16 = 40010;

// ---- low-level TX ----
fn mpkg_send_frame(src: u64, len: u32) {
    let tx: u64 = &g_rtl_txbuf as u64;
    let i: u32 = 0;
    while i < len {
        *((tx + (i as u64)) as *u8) = *((src + (i as u64)) as *u8);
        i = i + 1;
    }
    rtl_transmit(len);
}

// Build eth+IPv4+TCP to the gateway:8000 with the current seq/ack and send it.
fn mpkg_xmit(flags: u8, data: u64, data_len: u32) {
    let base: u64 = &g_mpkg_tx as u64;
    eth_build_header(base, &g_mpkg_peer_mac as u64, net_our_mac(), ETH_IP);
    let ip: u64 = eth_payload(base);
    let tcp: u64 = ip + 20;
    let i: u32 = 0;
    while i < data_len {
        *((tcp + 20 + (i as u64)) as *u8) = *((data + (i as u64)) as *u8);
        i = i + 1;
    }
    let total: u32 = tcp_build(tcp, g_mpkg_lport, MPKG_PORT, g_mpkg_snd, g_mpkg_rcv,
                               flags, 64240, net_our_ip(), net_gateway_ip(), data_len);
    ip_build_header(ip, net_our_ip(), net_gateway_ip(), IP_PROTO_TCP,
                    g_mpkg_ipid, total as u16);
    g_mpkg_ipid = g_mpkg_ipid + 1;
    mpkg_send_frame(base, 14 + 20 + total);
    let adv: u32 = data_len;
    if (flags & TCP_SYN) != 0 { adv = adv + 1; }
    if (flags & TCP_FIN) != 0 { adv = adv + 1; }
    g_mpkg_snd = g_mpkg_snd + adv;
}

// ARP the gateway (10.0.2.2) and cache its MAC. Returns false on timeout.
fn mpkg_arp_gateway() -> bool {
    let base: u64 = &g_mpkg_tx as u64;
    let bcast: [u8; 6] = [0; 6];
    mac_broadcast(&bcast as u64);
    eth_build_header(base, &bcast as u64, net_our_mac(), ETH_ARP);
    let alen: u32 = arp_build_request(eth_payload(base), net_our_mac(),
                                      net_our_ip(), net_gateway_ip());
    mpkg_send_frame(base, 14 + alen);
    let spins: u32 = 0;
    while spins < 20000000 {
        let n: u32 = rtl_poll_rx(&g_mpkg_rx as u64);
        if n >= 14 {
            let rxb: u64 = &g_mpkg_rx as u64;
            if eth_type(rxb) == ETH_ARP {
                let a: u64 = eth_payload(rxb);
                if arp_oper(a) == ARP_REPLY {
                    if ip4_eq(arp_spa(a), net_gateway_ip()) {
                        mac_copy(&g_mpkg_peer_mac as u64, arp_sha(a));
                        return true;
                    }
                }
            }
        }
        spins = spins + 1;
    }
    return false;
}

// ---- request building ----
fn mpkg_puts(buf: u64, pos: u32, s: u64) -> u32 {
    let i: u32 = 0;
    let c: u8 = *((s) as *u8);
    while c != 0 {
        *((buf + ((pos + i) as u64)) as *u8) = c;
        i = i + 1;
        c = *((s + (i as u64)) as *u8);
    }
    return pos + i;
}
fn mpkg_crlf(buf: u64, pos: u32) -> u32 {
    *((buf + (pos as u64)) as *u8) = 13;
    *((buf + ((pos + 1) as u64)) as *u8) = 10;
    return pos + 2;
}
fn mpkg_build_get(buf: u64, path: u64) -> u32 {
    let p: u32 = 0;
    p = mpkg_puts(buf, p, "GET " as u64);
    p = mpkg_puts(buf, p, path);
    p = mpkg_puts(buf, p, " HTTP/1.0" as u64);
    p = mpkg_crlf(buf, p);
    p = mpkg_puts(buf, p, "Host: 10.0.2.2" as u64);
    p = mpkg_crlf(buf, p);
    p = mpkg_puts(buf, p, "Connection: close" as u64);
    p = mpkg_crlf(buf, p);
    p = mpkg_crlf(buf, p);
    return p;
}

// GET http://10.0.2.2:8000<path> into g_mpkg_raw. Returns false on failure.
fn mpkg_fetch(path: u64) -> bool {
    if !g_net_up {
        if !net_dhcp() {
            return false;
        }
    }
    if !mpkg_arp_gateway() {
        return false;
    }

    let req: [u8; 256] = [0; 256];
    let rl: u32 = mpkg_build_get(&req as u64, path);

    g_mpkg_snd = 0x51000000;
    g_mpkg_rcv = 0;
    g_mpkg_raw_len = 0;
    g_mpkg_lport = g_mpkg_lport + 1;            // fresh local port each fetch
    mpkg_xmit(TCP_SYN, 0, 0);
    let state: u32 = 1;                          // 1 syn-sent, 2 established
    let spins: u32 = 0;
    while spins < 120000000 {
        let n: u32 = rtl_poll_rx(&g_mpkg_rx as u64);
        if n >= 14 {
            let rxb: u64 = &g_mpkg_rx as u64;
            if eth_type(rxb) == ETH_IP {
                let ip: u64 = eth_payload(rxb);
                if ip_proto(ip) == IP_PROTO_TCP {
                    let tcp: u64 = ip + (ip_ihl_bytes(ip) as u64);
                    if tcp_dst_port(tcp) == g_mpkg_lport {
                        let flags: u8 = tcp_flags(tcp);
                        let their_seq: u32 = tcp_seq(tcp);
                        let their_ack: u32 = tcp_ack(tcp);
                        let hdr: u32 = tcp_header_len(tcp);
                        // Guarded segment length (no underflow - the browser bug).
                        let used: u32 = ip_ihl_bytes(ip) + hdr;
                        let iptl: u32 = ip_total_len(ip) as u32;
                        let seg_len: u32 = 0;
                        if iptl > used { seg_len = iptl - used; }

                        if (flags & MPKG_TCP_RST) != 0 {
                            return false;            // connection refused / reset
                        }
                        if state == 1 && (flags & TCP_SYN) != 0 && (flags & TCP_ACK) != 0
                            && their_ack == g_mpkg_snd {
                            g_mpkg_rcv = their_seq + 1;
                            state = 2;
                            mpkg_xmit(TCP_ACK, 0, 0);
                            mpkg_xmit(TCP_PSH | TCP_ACK, &req as u64, rl);
                        } else {
                            if state == 2 {
                                if seg_len > 0 && their_seq == g_mpkg_rcv {
                                    let pay: u64 = tcp + (hdr as u64);
                                    let k: u32 = 0;
                                    while k < seg_len {
                                        if g_mpkg_raw_len < 16384 {
                                            *((&g_mpkg_raw as u64 + (g_mpkg_raw_len as u64)) as *u8)
                                                = *((pay + (k as u64)) as *u8);
                                            g_mpkg_raw_len = g_mpkg_raw_len + 1;
                                        }
                                        k = k + 1;
                                    }
                                    g_mpkg_rcv = g_mpkg_rcv + seg_len;
                                    mpkg_xmit(TCP_ACK, 0, 0);
                                }
                                if (flags & TCP_FIN) != 0 && (their_seq + seg_len) == g_mpkg_rcv {
                                    g_mpkg_rcv = g_mpkg_rcv + 1;
                                    mpkg_xmit(TCP_ACK, 0, 0);
                                    mpkg_xmit(TCP_FIN | TCP_ACK, 0, 0);
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
        }
        spins = spins + 1;
    }
    return false;
}

// ---- HTTP response parsing ----
// Offset of the body (after the CRLFCRLF header terminator) in g_mpkg_raw.
fn mpkg_body_offset() -> u32 {
    let i: u32 = 0;
    while i + 3 < g_mpkg_raw_len {
        if *((&g_mpkg_raw as u64 + (i as u64)) as *u8) == 13
            && *((&g_mpkg_raw as u64 + ((i + 1) as u64)) as *u8) == 10
            && *((&g_mpkg_raw as u64 + ((i + 2) as u64)) as *u8) == 13
            && *((&g_mpkg_raw as u64 + ((i + 3) as u64)) as *u8) == 10 {
            return i + 4;
        }
        i = i + 1;
    }
    return g_mpkg_raw_len;
}
// Was the status line "... 200 ..."? (status code sits at offset 9 of "HTTP/1.0 200").
fn mpkg_status_200() -> bool {
    if g_mpkg_raw_len < 12 {
        return false;
    }
    if *((&g_mpkg_raw as u64 + 9) as *u8) != 50 { return false; }   // '2'
    if *((&g_mpkg_raw as u64 + 10) as *u8) != 48 { return false; }  // '0'
    if *((&g_mpkg_raw as u64 + 11) as *u8) != 48 { return false; }  // '0'
    return true;
}
// Copy the response body into g_mpkg_body; returns its length.
fn mpkg_extract_body() -> u32 {
    let bo: u32 = mpkg_body_offset();
    let blen: u32 = g_mpkg_raw_len - bo;
    if blen > 16384 { blen = 16384; }
    let k: u32 = 0;
    while k < blen {
        *((&g_mpkg_body as u64 + (k as u64)) as *u8)
            = *((&g_mpkg_raw as u64 + ((bo + k) as u64)) as *u8);
        k = k + 1;
    }
    g_mpkg_body_len = blen;
    return blen;
}

// ---- index parsing (lines of name|version|file|size|description; # = comment) ----
// End offset (exclusive) of the line starting at `start` within the cached index.
fn mpkg_line_end(start: u32) -> u32 {
    let i: u32 = start;
    while i < g_mpkg_index_len {
        if *((&g_mpkg_index as u64 + (i as u64)) as *u8) == 10 { return i; }
        i = i + 1;
    }
    return g_mpkg_index_len;
}
// Copy field `n` (0-based, '|'-separated) of the line [start,end) into out (capped).
// Returns the field length, or 0 if the field is absent.
fn mpkg_field(start: u32, end: u32, n: u32, out: u64, cap: u32) -> u32 {
    let field: u32 = 0;
    let i: u32 = start;
    let len: u32 = 0;
    while i < end {
        let c: u8 = *((&g_mpkg_index as u64 + (i as u64)) as *u8);
        if c == 124 {                           // '|'
            if field == n { i = end; } else { field = field + 1; len = 0; }
        } else {
            if field == n {
                if len + 1 < cap {
                    *((out + (len as u64)) as *u8) = c;
                    len = len + 1;
                }
            }
        }
        if i < end { i = i + 1; }
    }
    *((out + (len as u64)) as *u8) = 0;
    if field < n { return 0; }
    return len;
}
// Is this line a package (non-empty, not a '#' comment)?
fn mpkg_is_pkg_line(start: u32, end: u32) -> bool {
    if start >= end { return false; }
    let c: u8 = *((&g_mpkg_index as u64 + (start as u64)) as *u8);
    if c == 35 { return false; }                // '#'
    if c == 13 { return false; }
    return true;
}

// ---- commands ----
fn mpkg_need_index() -> bool {
    if !g_mpkg_have_index {
        feed();
        print_string("mpkg: no index - run 'mpkg update' first", g_row, 12);
        return false;
    }
    return true;
}

fn mpkg_do_update() {
    feed();
    print_string("mpkg: updating from http://10.0.2.2:8000/index ...", g_row, 7);
    if !mpkg_fetch("/index" as u64) {
        feed();
        print_string("mpkg: network error (is serve.py running on the host?)", g_row, 12);
        return;
    }
    if !mpkg_status_200() {
        feed();
        print_string("mpkg: server did not return the index (HTTP != 200)", g_row, 12);
        return;
    }
    let blen: u32 = mpkg_extract_body();
    if blen > 4095 { blen = 4095; }
    let k: u32 = 0;
    while k < blen {
        *((&g_mpkg_index as u64 + (k as u64)) as *u8)
            = *((&g_mpkg_body as u64 + (k as u64)) as *u8);
        k = k + 1;
    }
    *((&g_mpkg_index as u64 + (blen as u64)) as *u8) = 0;
    g_mpkg_index_len = blen;
    g_mpkg_have_index = true;

    let count: u32 = 0;
    let pos: u32 = 0;
    while pos < g_mpkg_index_len {
        let e: u32 = mpkg_line_end(pos);
        if mpkg_is_pkg_line(pos, e) { count = count + 1; }
        pos = e + 1;
    }
    feed();
    print_at("mpkg: index updated, ", g_row, 0, 10);
    num_to_str(count, g_numbuf);
    print_at(g_numbuf, g_row, 21, 15);
    print_at(" packages available", g_row, 21 + g_numlen, 10);
    mpkg_persist_index();                       // cache to /var/mpkg so it survives reboots
}

fn mpkg_do_list() {
    if !mpkg_need_index() { return; }
    let name: [u8; 32] = [0; 32];
    let ver: [u8; 16] = [0; 16];
    let file: [u8; 48] = [0; 48];
    let desc: [u8; 64] = [0; 64];
    let pos: u32 = 0;
    while pos < g_mpkg_index_len {
        let e: u32 = mpkg_line_end(pos);
        if mpkg_is_pkg_line(pos, e) {
            mpkg_field(pos, e, 0, &name as u64, 32);
            mpkg_field(pos, e, 1, &ver as u64, 16);
            mpkg_field(pos, e, 2, &file as u64, 48);
            mpkg_field(pos, e, 4, &desc as u64, 64);
            // Installed packages (their .bin is in /bin) show their name in green.
            let nc: u8 = 15;
            if mpkg_is_installed(&file as u64) { nc = 10; }
            feed();
            print_at((&name as u64) as *u8, g_row, 0, nc);
            print_at((&ver as u64) as *u8, g_row, 16, 8);
            print_at((&desc as u64) as *u8, g_row, 24, 7);
        }
        pos = e + 1;
    }
}

fn mpkg_do_search(term: u64) {
    if !mpkg_need_index() { return; }
    let name: [u8; 32] = [0; 32];
    let desc: [u8; 64] = [0; 64];
    let pos: u32 = 0;
    while pos < g_mpkg_index_len {
        let e: u32 = mpkg_line_end(pos);
        if mpkg_is_pkg_line(pos, e) {
            mpkg_field(pos, e, 0, &name as u64, 32);
            mpkg_field(pos, e, 4, &desc as u64, 64);
            if mpkg_contains((&name as u64), term) || mpkg_contains((&desc as u64), term) {
                feed();
                print_at((&name as u64) as *u8, g_row, 0, 15);
                print_at((&desc as u64) as *u8, g_row, 16, 7);
            }
        }
        pos = e + 1;
    }
}

// Case-sensitive substring test: does haystack contain needle?
fn mpkg_contains(hay: u64, needle: u64) -> bool {
    let nl: u32 = str_len(needle as *u8);
    if nl == 0 { return true; }
    let hl: u32 = str_len(hay as *u8);
    if nl > hl { return false; }
    let i: u32 = 0;
    while i + nl <= hl {
        let j: u32 = 0;
        let ok: bool = true;
        while j < nl {
            if *((hay + ((i + j) as u64)) as *u8) != *((needle + (j as u64)) as *u8) {
                ok = false;
                j = nl;
            } else {
                j = j + 1;
            }
        }
        if ok { return true; }
        i = i + 1;
    }
    return false;
}

// Find the index line for `pkg` and copy its `file` field (field 2) into out.
// Returns true if the package is in the index.
fn mpkg_lookup_file(pkg: u64, out: u64, cap: u32) -> bool {
    let name: [u8; 32] = [0; 32];
    let pos: u32 = 0;
    while pos < g_mpkg_index_len {
        let e: u32 = mpkg_line_end(pos);
        if mpkg_is_pkg_line(pos, e) {
            mpkg_field(pos, e, 0, &name as u64, 32);
            if streq((&name as u64) as *u8, pkg as *u8) {
                mpkg_field(pos, e, 2, out, cap);
                return true;
            }
        }
        pos = e + 1;
    }
    return false;
}

// Write `len` raw bytes from `src` as the content of file entry `idx`.
fn mpkg_fs_write(idx: u32, src: u64, len: u32) -> bool {
    let base: u32 = fs_entry_addr(idx);
    let cap: u32 = *((base + 36) as *u32) * 512;
    if len > cap { return false; }
    let start: u32 = *((base + 32) as *u32);
    let sectors: u32 = (len + 511) / 512;
    let s: u32 = 0;
    while s < sectors {
        let k: u32 = 0;
        while k < 512 {
            let off: u32 = s * 512 + k;
            let b: u8 = 0;
            if off < len { b = *((src + (off as u64)) as *u8); }
            *((0x00800000 + k) as *u8) = b;
            k = k + 1;
        }
        if !ata_write(start + s, 0x00800000 as *u8) { return false; }
        s = s + 1;
    }
    *((base + 28) as *u32) = len;               // size_bytes
    return true;
}

// Save the cached index to /var/mpkg/index so it survives reboots. Best-effort:
// silently does nothing if the dir/file can't be created (e.g. run as non-root).
fn mpkg_persist_index() {
    fs_mkdir("/var/mpkg" as u64);               // no-op if it already exists
    let dir: u32 = fs_resolve("/var/mpkg" as u64);
    if dir == 64 { return; }
    let idx: u32 = fs_resolve("/var/mpkg/index" as u64);
    if idx == 64 {
        idx = fs_create_full("index", dir, 0);
        if idx == 64 { return; }
    }
    mpkg_fs_write(idx, &g_mpkg_index as u64, g_mpkg_index_len);
    fs_sync();
}

// Load a persisted index from a previous session if none is cached in RAM.
fn mpkg_load_index() {
    if g_mpkg_have_index { return; }
    let idx: u32 = fs_resolve("/var/mpkg/index" as u64);
    if idx == 64 { return; }
    if idx == 255 { return; }
    let size: u32 = fs_read_file(idx);          // content -> FILEBUF 0x00810000
    if size == 0 { return; }
    if size > 4095 { size = 4095; }
    let k: u32 = 0;
    while k < size {
        *((&g_mpkg_index as u64 + (k as u64)) as *u8) = *((0x00810000 + k) as *u8);
        k = k + 1;
    }
    *((&g_mpkg_index as u64 + (size as u64)) as *u8) = 0;
    g_mpkg_index_len = size;
    g_mpkg_have_index = true;
}

// Is package `file` (its .bin) present in /bin?
fn mpkg_is_installed(file: u64) -> bool {
    let path: [u8; 64] = [0; 64];
    let pp: u32 = mpkg_puts(&path as u64, 0, "/bin/" as u64);
    pp = mpkg_puts(&path as u64, pp, file);
    *((&path as u64 + (pp as u64)) as *u8) = 0;
    let r: u32 = fs_resolve(&path as u64);
    if r == 64 { return false; }
    if r == 255 { return false; }
    return true;
}

fn mpkg_do_install(pkg: u64) {
    if !mpkg_need_index() { return; }
    if g_uid != 0 {
        feed();
        print_string("mpkg: install needs root - try: sudo mpkg install <name>", g_row, 12);
        return;
    }
    let file: [u8; 48] = [0; 48];
    if !mpkg_lookup_file(pkg, &file as u64, 48) {
        feed();
        print_at("mpkg: no such package: ", g_row, 0, 12);
        print_at(pkg as *u8, g_row, 23, 12);
        return;
    }

    // Fetch /packages/<file>.
    let url: [u8; 96] = [0; 96];
    let up: u32 = mpkg_puts(&url as u64, 0, "/packages/" as u64);
    up = mpkg_puts(&url as u64, up, &file as u64);
    *((&url as u64 + (up as u64)) as *u8) = 0;
    feed();
    print_at("mpkg: fetching ", g_row, 0, 7);
    print_at((&file as u64) as *u8, g_row, 15, 15);
    if !mpkg_fetch(&url as u64) || !mpkg_status_200() {
        feed();
        print_string("mpkg: download failed", g_row, 12);
        return;
    }
    let blen: u32 = mpkg_extract_body();

    // Install into /bin/<file> with mode 0755.
    let dst: [u8; 64] = [0; 64];
    let dp: u32 = mpkg_puts(&dst as u64, 0, "/bin/" as u64);
    dp = mpkg_puts(&dst as u64, dp, &file as u64);
    *((&dst as u64 + (dp as u64)) as *u8) = 0;

    let bin: u32 = fs_resolve("/bin" as u64);
    if bin == 64 {
        feed();
        print_string("mpkg: /bin is missing", g_row, 12);
        return;
    }
    let idx: u32 = fs_resolve(&dst as u64);
    if idx == 64 {
        idx = fs_create_full((&file as u64) as *u8, bin, 0);
        if idx == 64 {
            feed();
            print_string("mpkg: could not create the file", g_row, 12);
            return;
        }
    }
    if !mpkg_fs_write(idx, &g_mpkg_body as u64, blen) {
        feed();
        print_string("mpkg: package too large for the filesystem", g_row, 12);
        return;
    }
    let ibase: u32 = fs_entry_addr(idx);
    *((ibase + 44) as *u32) = 0x1ED;            // mode 0755 (executable)
    *((ibase + 42) as *u8) = 0;                 // owned by root
    fs_sync();

    feed();
    print_at("mpkg: installed ", g_row, 0, 10);
    print_at((&file as u64) as *u8, g_row, 16, 15);
    print_at(" (", g_row, 16 + str_len((&file as u64) as *u8), 10);
    num_to_str(blen, g_numbuf);
    print_at(g_numbuf, g_row, 18 + str_len((&file as u64) as *u8), 15);
    print_at(" bytes)", g_row, 18 + str_len((&file as u64) as *u8) + g_numlen, 10);
}

fn mpkg_do_remove(pkg: u64) {
    if g_uid != 0 {
        feed();
        print_string("mpkg: remove needs root - try: sudo mpkg remove <name>", g_row, 12);
        return;
    }
    // Resolve /bin/<pkg>.bin and delete it.
    let dst: [u8; 64] = [0; 64];
    let dp: u32 = mpkg_puts(&dst as u64, 0, "/bin/" as u64);
    dp = mpkg_puts(&dst as u64, dp, pkg);
    dp = mpkg_puts(&dst as u64, dp, ".bin" as u64);
    *((&dst as u64 + (dp as u64)) as *u8) = 0;
    let idx: u32 = fs_resolve(&dst as u64);
    if idx == 64 || idx == 255 {
        feed();
        print_at("mpkg: not installed: ", g_row, 0, 12);
        print_at(pkg as *u8, g_row, 21, 12);
        return;
    }
    let base: u32 = fs_entry_addr(idx);
    *((base + 24) as *u32) = 0;                 // mark the entry free
    fs_sync();
    feed();
    print_at("mpkg: removed ", g_row, 0, 10);
    print_at(pkg as *u8, g_row, 14, 15);
}

fn mpkg_usage() {
    feed();
    print_string("mpkg - the MORT OS package manager", g_row, 10);
    feed();
    print_string("  mpkg update            refresh the package index", g_row, 7);
    feed();
    print_string("  mpkg list              list available packages", g_row, 7);
    feed();
    print_string("  mpkg search <term>     search names + descriptions", g_row, 7);
    feed();
    print_string("  mpkg install <name>    download + install into /bin (sudo)", g_row, 7);
    feed();
    print_string("  mpkg remove <name>     uninstall from /bin (sudo)", g_row, 7);
}

// Entry point: `args` is the text after "mpkg " (empty for a bare "mpkg").
fn mpkg_command(args: u64) {
    mpkg_load_index();                          // pick up a persisted index, if any
    if streq(args as *u8, "update") { mpkg_do_update(); return; }
    if streq(args as *u8, "list") { mpkg_do_list(); return; }
    if starts_with(args as *u8, "search ") { mpkg_do_search(args + 7); return; }
    if starts_with(args as *u8, "install ") { mpkg_do_install(args + 8); return; }
    if starts_with(args as *u8, "remove ") { mpkg_do_remove(args + 7); return; }
    mpkg_usage();
}
