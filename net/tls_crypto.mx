let g_tls_crypto_sha256_ok: bool = false;
let g_tls_crypto_hmac_ok: bool = false;
let g_tls_crypto_hkdf_ok: bool = false;
let g_tls_crypto_chacha_ok: bool = false;
let g_tls_crypto_poly1305_ok: bool = false;
let g_tls_crypto_aead_ok: bool = false;
let g_tls_crypto_aead_decrypt_ok: bool = false;
let g_tls_poly1305_test_tag: [u8; 16] = [0; 16];
// One browser connection is processed at a time.  This bounded scratch area
// holds RFC 8446's maximum ciphertext plus AEAD padding and length fields.
let g_tls_aead_auth_scratch: [u8; 16672] = [0; 16672];

fn tls_rotr32(value: u32, amount: u32) -> u32 {
    return (value >> amount) | (value << (32 - amount));
}

fn tls_load_be32(src: u64) -> u32 {
    return ((*((src + 0) as *u8) as u32) << 24)
        | ((*((src + 1) as *u8) as u32) << 16)
        | ((*((src + 2) as *u8) as u32) << 8)
        | (*((src + 3) as *u8) as u32);
}

fn tls_store_be32(dst: u64, value: u32) {
    *((dst + 0) as *u8) = (value >> 24) as u8;
    *((dst + 1) as *u8) = (value >> 16) as u8;
    *((dst + 2) as *u8) = (value >> 8) as u8;
    *((dst + 3) as *u8) = value as u8;
}

fn tls_store_be64(dst: u64, value: u64) {
    for i: u32 in 0..8 {
        *((dst + (i as u64)) as *u8) = (value >> ((7 - i) * 8)) as u8;
    }
}

fn tls_load_le32(src: u64) -> u32 {
    return (*((src + 0) as *u8) as u32)
        | ((*((src + 1) as *u8) as u32) << 8)
        | ((*((src + 2) as *u8) as u32) << 16)
        | ((*((src + 3) as *u8) as u32) << 24);
}

fn tls_store_le32(dst: u64, value: u32) {
    *((dst + 0) as *u8) = value as u8;
    *((dst + 1) as *u8) = (value >> 8) as u8;
    *((dst + 2) as *u8) = (value >> 16) as u8;
    *((dst + 3) as *u8) = (value >> 24) as u8;
}

fn tls_store_le64(dst: u64, value: u64) {
    for i: u32 in 0..8 { *((dst + (i as u64)) as *u8) = (value >> (i * 8)) as u8; }
}

fn tls_bytes_equal(a: u64, b: u64, length: u32) -> bool {
    let diff: u8 = 0;
    for i: u32 in 0..length { diff = diff | (*((a + (i as u64)) as *u8) ^ *((b + (i as u64)) as *u8)); }
    return diff == 0;
}

fn tls_sha256(input: u64, length: u32, output: u64) {
    let state: [u32; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ];
    let block: [u8; 64] = [0; 64];
    let words: [u32; 64] = [0; 64];
    let blocks: u32 = (length + 9 + 63) / 64;
    let bit_length: u64 = (length as u64) * 8;

    for block_index: u32 in 0..blocks {
        for i: u32 in 0..64 { block[i] = 0; }
        let base: u32 = block_index * 64;
        for i: u32 in 0..64 {
            let absolute: u32 = base + i;
            if absolute < length { block[i] = *((input + (absolute as u64)) as *u8); }
            else if absolute == length { block[i] = 0x80; }
        }
        if block_index + 1 == blocks { tls_store_be64(&block as u64 + 56, bit_length); }

        for i: u32 in 0..16 { words[i] = tls_load_be32(&block as u64 + ((i * 4) as u64)); }
        for i: u32 in 16..64 {
            let x: u32 = words[i - 15]; let y: u32 = words[i - 2];
            let s0: u32 = tls_rotr32(x, 7) ^ tls_rotr32(x, 18) ^ (x >> 3);
            let s1: u32 = tls_rotr32(y, 17) ^ tls_rotr32(y, 19) ^ (y >> 10);
            words[i] = words[i - 16] + s0 + words[i - 7] + s1;
        }

        let a: u32 = state[0]; let b: u32 = state[1]; let c: u32 = state[2]; let d: u32 = state[3];
        let e: u32 = state[4]; let f: u32 = state[5]; let g: u32 = state[6]; let h: u32 = state[7];
        for i: u32 in 0..64 {
            let big1: u32 = tls_rotr32(e, 6) ^ tls_rotr32(e, 11) ^ tls_rotr32(e, 25);
            let choose: u32 = (e & f) ^ ((0xffffffff ^ e) & g);
            let t1: u32 = h + big1 + choose + TLS_SHA256_K[i] + words[i];
            let big0: u32 = tls_rotr32(a, 2) ^ tls_rotr32(a, 13) ^ tls_rotr32(a, 22);
            let majority: u32 = (a & b) ^ (a & c) ^ (b & c);
            let t2: u32 = big0 + majority;
            h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        }
        state[0] = state[0] + a; state[1] = state[1] + b;
        state[2] = state[2] + c; state[3] = state[3] + d;
        state[4] = state[4] + e; state[5] = state[5] + f;
        state[6] = state[6] + g; state[7] = state[7] + h;
    }

    for i: u32 in 0..8 { tls_store_be32(output + ((i * 4) as u64), state[i]); }
}

fn tls_hmac_sha256(key: u64, key_length: u32, message: u64, message_length: u32, output: u64) -> bool {
    if message_length > 448 { return false; }
    let key_block: [u8; 64] = [0; 64]; let key_digest: [u8; 32] = [0; 32];
    if key_length > 64 {
        tls_sha256(key, key_length, &key_digest as u64);
        for i: u32 in 0..32 { key_block[i] = key_digest[i]; }
    } else {
        for i: u32 in 0..key_length { key_block[i] = *((key + (i as u64)) as *u8); }
    }
    let inner: [u8; 512] = [0; 512]; let outer: [u8; 96] = [0; 96];
    for i: u32 in 0..64 {
        inner[i] = key_block[i] ^ 0x36;
        outer[i] = key_block[i] ^ 0x5c;
    }
    for i: u32 in 0..message_length { inner[64 + i] = *((message + (i as u64)) as *u8); }
    tls_sha256(&inner as u64, 64 + message_length, &key_digest as u64);
    for i: u32 in 0..32 { outer[64 + i] = key_digest[i]; }
    tls_sha256(&outer as u64, 96, output); return true;
}

fn tls_hkdf_extract(salt: u64, salt_length: u32, ikm: u64, ikm_length: u32, prk: u64) -> bool {
    let zero_salt: [u8; 32] = [0; 32];
    if salt_length == 0 { return tls_hmac_sha256(&zero_salt as u64, 32, ikm, ikm_length, prk); }
    return tls_hmac_sha256(salt, salt_length, ikm, ikm_length, prk);
}

fn tls_hkdf_expand(prk: u64, info: u64, info_length: u32, output: u64, output_length: u32) -> bool {
    if info_length > 415 || output_length > 8160 { return false; }
    let previous: [u8; 32] = [0; 32]; let message: [u8; 512] = [0; 512];
    let previous_length: u32 = 0; let written: u32 = 0; let counter: u32 = 1;
    while written < output_length {
        for i: u32 in 0..previous_length { message[i] = previous[i]; }
        for i: u32 in 0..info_length { message[previous_length + i] = *((info + (i as u64)) as *u8); }
        message[previous_length + info_length] = counter as u8;
        if !tls_hmac_sha256(prk, 32, &message as u64, previous_length + info_length + 1, &previous as u64) { return false; }
        previous_length = 32; let take: u32 = output_length - written; if take > 32 { take = 32; }
        for i: u32 in 0..take { *((output + ((written + i) as u64)) as *u8) = previous[i]; }
        written = written + take; counter = counter + 1;
    }
    return true;
}

fn tls_rotl32(value: u32, amount: u32) -> u32 {
    return (value << amount) | (value >> (32 - amount));
}

fn tls_chacha_quarter(state: u64, ai: u32, bi: u32, ci: u32, di: u32) {
    let a: *u32 = (state + ((ai * 4) as u64)) as *u32;
    let b: *u32 = (state + ((bi * 4) as u64)) as *u32;
    let c: *u32 = (state + ((ci * 4) as u64)) as *u32;
    let d: *u32 = (state + ((di * 4) as u64)) as *u32;
    let av: u32 = *a; let bv: u32 = *b; let cv: u32 = *c; let dv: u32 = *d;
    av = av + bv; dv = tls_rotl32(dv ^ av, 16);
    cv = cv + dv; bv = tls_rotl32(bv ^ cv, 12);
    av = av + bv; dv = tls_rotl32(dv ^ av, 8);
    cv = cv + dv; bv = tls_rotl32(bv ^ cv, 7);
    *a = av; *b = bv; *c = cv; *d = dv;
}

fn tls_chacha20_block(key: u64, counter: u32, nonce: u64, output: u64) {
    let initial: [u32; 16] = [0; 16]; let work: [u32; 16] = [0; 16];
    initial[0] = 0x61707865; initial[1] = 0x3320646e;
    initial[2] = 0x79622d32; initial[3] = 0x6b206574;
    for i: u32 in 0..8 { initial[4 + i] = tls_load_le32(key + ((i * 4) as u64)); }
    initial[12] = counter;
    for i: u32 in 0..3 { initial[13 + i] = tls_load_le32(nonce + ((i * 4) as u64)); }
    for i: u32 in 0..16 { work[i] = initial[i]; }
    for round: u32 in 0..10 {
        tls_chacha_quarter(&work as u64, 0, 4, 8, 12);
        tls_chacha_quarter(&work as u64, 1, 5, 9, 13);
        tls_chacha_quarter(&work as u64, 2, 6, 10, 14);
        tls_chacha_quarter(&work as u64, 3, 7, 11, 15);
        tls_chacha_quarter(&work as u64, 0, 5, 10, 15);
        tls_chacha_quarter(&work as u64, 1, 6, 11, 12);
        tls_chacha_quarter(&work as u64, 2, 7, 8, 13);
        tls_chacha_quarter(&work as u64, 3, 4, 9, 14);
    }
    for i: u32 in 0..16 { tls_store_le32(output + ((i * 4) as u64), work[i] + initial[i]); }
}

fn tls_chacha20_xor(key: u64, counter: u32, nonce: u64, input: u64, length: u32, output: u64) {
    let stream: [u8; 64] = [0; 64]; let offset: u32 = 0; let block_counter: u32 = counter;
    while offset < length {
        tls_chacha20_block(key, block_counter, nonce, &stream as u64);
        let take: u32 = length - offset; if take > 64 { take = 64; }
        for i: u32 in 0..take {
            *((output + ((offset + i) as u64)) as *u8) = *((input + ((offset + i) as u64)) as *u8) ^ stream[i];
        }
        offset = offset + take; block_counter = block_counter + 1;
    }
}

fn tls_poly1305_auth(key: u64, message: u64, length: u32, output: u64) {
    let r0: u32 = tls_load_le32(key + 0) & 0x03ffffff;
    let r1: u32 = (tls_load_le32(key + 3) >> 2) & 0x03ffff03;
    let r2: u32 = (tls_load_le32(key + 6) >> 4) & 0x03ffc0ff;
    let r3: u32 = (tls_load_le32(key + 9) >> 6) & 0x03f03fff;
    let r4: u32 = (tls_load_le32(key + 12) >> 8) & 0x000fffff;
    let s1: u32 = r1 * 5; let s2: u32 = r2 * 5;
    let s3: u32 = r3 * 5; let s4: u32 = r4 * 5;
    let h0: u32 = 0; let h1: u32 = 0; let h2: u32 = 0; let h3: u32 = 0; let h4: u32 = 0;
    let offset: u32 = 0;
    while offset < length {
        let block: [u8; 16] = [0; 16]; let take: u32 = length - offset; if take > 16 { take = 16; }
        for i: u32 in 0..take { block[i] = *((message + ((offset + i) as u64)) as *u8); }
        let hibit: u32 = 1 << 24;
        if take < 16 { block[take] = 1; hibit = 0; }
        h0 = h0 + (tls_load_le32(&block as u64 + 0) & 0x03ffffff);
        h1 = h1 + ((tls_load_le32(&block as u64 + 3) >> 2) & 0x03ffffff);
        h2 = h2 + ((tls_load_le32(&block as u64 + 6) >> 4) & 0x03ffffff);
        h3 = h3 + ((tls_load_le32(&block as u64 + 9) >> 6) & 0x03ffffff);
        h4 = h4 + ((tls_load_le32(&block as u64 + 12) >> 8) | hibit);

        let d0: u64 = (h0 as u64) * (r0 as u64) + (h1 as u64) * (s4 as u64)
            + (h2 as u64) * (s3 as u64) + (h3 as u64) * (s2 as u64) + (h4 as u64) * (s1 as u64);
        let d1: u64 = (h0 as u64) * (r1 as u64) + (h1 as u64) * (r0 as u64)
            + (h2 as u64) * (s4 as u64) + (h3 as u64) * (s3 as u64) + (h4 as u64) * (s2 as u64);
        let d2: u64 = (h0 as u64) * (r2 as u64) + (h1 as u64) * (r1 as u64)
            + (h2 as u64) * (r0 as u64) + (h3 as u64) * (s4 as u64) + (h4 as u64) * (s3 as u64);
        let d3: u64 = (h0 as u64) * (r3 as u64) + (h1 as u64) * (r2 as u64)
            + (h2 as u64) * (r1 as u64) + (h3 as u64) * (r0 as u64) + (h4 as u64) * (s4 as u64);
        let d4: u64 = (h0 as u64) * (r4 as u64) + (h1 as u64) * (r3 as u64)
            + (h2 as u64) * (r2 as u64) + (h3 as u64) * (r1 as u64) + (h4 as u64) * (r0 as u64);
        let carry: u32 = (d0 >> 26) as u32; h0 = d0 as u32 & 0x03ffffff; d1 = d1 + (carry as u64);
        carry = (d1 >> 26) as u32; h1 = d1 as u32 & 0x03ffffff; d2 = d2 + (carry as u64);
        carry = (d2 >> 26) as u32; h2 = d2 as u32 & 0x03ffffff; d3 = d3 + (carry as u64);
        carry = (d3 >> 26) as u32; h3 = d3 as u32 & 0x03ffffff; d4 = d4 + (carry as u64);
        carry = (d4 >> 26) as u32; h4 = d4 as u32 & 0x03ffffff;
        h0 = h0 + carry * 5; carry = h0 >> 26; h0 = h0 & 0x03ffffff; h1 = h1 + carry;
        offset = offset + take;
    }

    let carry: u32 = h1 >> 26; h1 = h1 & 0x03ffffff; h2 = h2 + carry;
    carry = h2 >> 26; h2 = h2 & 0x03ffffff; h3 = h3 + carry;
    carry = h3 >> 26; h3 = h3 & 0x03ffffff; h4 = h4 + carry;
    carry = h4 >> 26; h4 = h4 & 0x03ffffff; h0 = h0 + carry * 5;
    carry = h0 >> 26; h0 = h0 & 0x03ffffff; h1 = h1 + carry;

    let g0: u32 = h0 + 5; carry = g0 >> 26; g0 = g0 & 0x03ffffff;
    let g1: u32 = h1 + carry; carry = g1 >> 26; g1 = g1 & 0x03ffffff;
    let g2: u32 = h2 + carry; carry = g2 >> 26; g2 = g2 & 0x03ffffff;
    let g3: u32 = h3 + carry; carry = g3 >> 26; g3 = g3 & 0x03ffffff;
    let g4: u32 = h4 + carry - (1 << 26);
    let mask: u32 = (g4 >> 31) - 1; let inverse: u32 = 0xffffffff ^ mask;
    h0 = (h0 & inverse) | (g0 & mask); h1 = (h1 & inverse) | (g1 & mask);
    h2 = (h2 & inverse) | (g2 & mask); h3 = (h3 & inverse) | (g3 & mask);
    h4 = (h4 & inverse) | (g4 & mask);

    let w0: u32 = h0 | (h1 << 26); let w1: u32 = (h1 >> 6) | (h2 << 20);
    let w2: u32 = (h2 >> 12) | (h3 << 14); let w3: u32 = (h3 >> 18) | (h4 << 8);
    let f0: u64 = (w0 as u64) + (tls_load_le32(key + 16) as u64);
    let f1: u64 = (w1 as u64) + (tls_load_le32(key + 20) as u64) + (f0 >> 32);
    let f2: u64 = (w2 as u64) + (tls_load_le32(key + 24) as u64) + (f1 >> 32);
    let f3: u64 = (w3 as u64) + (tls_load_le32(key + 28) as u64) + (f2 >> 32);
    tls_store_le32(output + 0, f0 as u32); tls_store_le32(output + 4, f1 as u32);
    tls_store_le32(output + 8, f2 as u32); tls_store_le32(output + 12, f3 as u32);
}

fn tls_chacha20_poly1305_encrypt(key: u64, nonce: u64, aad: u64, aad_length: u32,
                                 plaintext: u64, plaintext_length: u32,
                                 ciphertext: u64, tag: u64) -> bool {
    let aad_padded: u32 = (aad_length + 15) & 0xfffffff0;
    let text_padded: u32 = (plaintext_length + 15) & 0xfffffff0;
    let auth_length: u32 = aad_padded + text_padded + 16;
    if auth_length > 16672 { return false; }
    let first_block: [u8; 64] = [0; 64];
    for i: u32 in 0..auth_length { g_tls_aead_auth_scratch[i] = 0; }
    tls_chacha20_block(key, 0, nonce, &first_block as u64);
    tls_chacha20_xor(key, 1, nonce, plaintext, plaintext_length, ciphertext);
    for i: u32 in 0..aad_length { g_tls_aead_auth_scratch[i] = *((aad + (i as u64)) as *u8); }
    for i: u32 in 0..plaintext_length { g_tls_aead_auth_scratch[aad_padded + i] = *((ciphertext + (i as u64)) as *u8); }
    tls_store_le64(&g_tls_aead_auth_scratch as u64 + ((aad_padded + text_padded) as u64), aad_length as u64);
    tls_store_le64(&g_tls_aead_auth_scratch as u64 + ((aad_padded + text_padded + 8) as u64), plaintext_length as u64);
    tls_poly1305_auth(&first_block as u64, &g_tls_aead_auth_scratch as u64, auth_length, tag); return true;
}

fn tls_chacha20_poly1305_decrypt(key: u64, nonce: u64, aad: u64, aad_length: u32,
                                 ciphertext: u64, ciphertext_length: u32,
                                 tag: u64, plaintext: u64) -> bool {
    let aad_padded: u32 = (aad_length + 15) & 0xfffffff0;
    let text_padded: u32 = (ciphertext_length + 15) & 0xfffffff0;
    let auth_length: u32 = aad_padded + text_padded + 16;
    if auth_length > 16672 { return false; }
    let first_block: [u8; 64] = [0; 64]; let expected_tag: [u8; 16] = [0; 16];
    for i: u32 in 0..auth_length { g_tls_aead_auth_scratch[i] = 0; }
    tls_chacha20_block(key, 0, nonce, &first_block as u64);
    for i: u32 in 0..aad_length { g_tls_aead_auth_scratch[i] = *((aad + (i as u64)) as *u8); }
    for i: u32 in 0..ciphertext_length { g_tls_aead_auth_scratch[aad_padded + i] = *((ciphertext + (i as u64)) as *u8); }
    tls_store_le64(&g_tls_aead_auth_scratch as u64 + ((aad_padded + text_padded) as u64), aad_length as u64);
    tls_store_le64(&g_tls_aead_auth_scratch as u64 + ((aad_padded + text_padded + 8) as u64), ciphertext_length as u64);
    tls_poly1305_auth(&first_block as u64, &g_tls_aead_auth_scratch as u64, auth_length, &expected_tag as u64);
    // Authentication is deliberately completed before writing any plaintext.
    if !tls_bytes_equal(&expected_tag as u64, tag, 16) { return false; }
    tls_chacha20_xor(key, 1, nonce, ciphertext, ciphertext_length, plaintext); return true;
}

fn tls_crypto_self_test() {
    let digest: [u8; 32] = [0; 32];
    tls_sha256("" as u64, 0, &digest as u64);
    let empty_ok: bool = tls_bytes_equal(&digest as u64, &TLS_SHA256_EMPTY as u64, 32);
    tls_sha256("abc" as u64, 3, &digest as u64);
    let abc_ok: bool = tls_bytes_equal(&digest as u64, &TLS_SHA256_ABC as u64, 32);
    g_tls_crypto_sha256_ok = empty_ok && abc_ok;

    let hmac_key: [u8; 20] = [0; 20]; for i: u32 in 0..20 { hmac_key[i] = 0x0b; }
    let hmac_ok: bool = tls_hmac_sha256(&hmac_key as u64, 20, "Hi There" as u64, 8, &digest as u64);
    g_tls_crypto_hmac_ok = hmac_ok && tls_bytes_equal(&digest as u64, &TLS_HMAC_CASE1 as u64, 32);

    let ikm: [u8; 22] = [0; 22]; for i: u32 in 0..22 { ikm[i] = 0x0b; }
    let prk: [u8; 32] = [0; 32]; let okm: [u8; 42] = [0; 42];
    let extract_ok: bool = tls_hkdf_extract(&TLS_HKDF_SALT1 as u64, 13, &ikm as u64, 22, &prk as u64);
    let expand_ok: bool = tls_hkdf_expand(&prk as u64, &TLS_HKDF_INFO1 as u64, 10, &okm as u64, 42);
    g_tls_crypto_hkdf_ok = extract_ok && expand_ok
        && tls_bytes_equal(&prk as u64, &TLS_HKDF_PRK1 as u64, 32)
        && tls_bytes_equal(&okm as u64, &TLS_HKDF_OKM1 as u64, 42);

    let chacha_key: [u8; 32] = [0; 32]; for i: u32 in 0..32 { chacha_key[i] = i as u8; }
    let chacha_nonce: [u8; 12] = [0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00];
    let chacha_out: [u8; 64] = [0; 64];
    tls_chacha20_block(&chacha_key as u64, 1, &chacha_nonce as u64, &chacha_out as u64);
    g_tls_crypto_chacha_ok = tls_bytes_equal(&chacha_out as u64, &TLS_CHACHA_BLOCK1 as u64, 64);

    tls_poly1305_auth(&TLS_POLY1305_KEY1 as u64, "Cryptographic Forum Research Group" as u64, 34, &g_tls_poly1305_test_tag as u64);
    g_tls_crypto_poly1305_ok = tls_bytes_equal(&g_tls_poly1305_test_tag as u64, &TLS_POLY1305_TAG1 as u64, 16);

    let aead_cipher: [u8; 114] = [0; 114]; let aead_tag: [u8; 16] = [0; 16];
    let aead_ok: bool = tls_chacha20_poly1305_encrypt(
        &TLS_AEAD_KEY1 as u64, &TLS_AEAD_NONCE1 as u64, &TLS_AEAD_AAD1 as u64, 12,
        "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it." as u64,
        114, &aead_cipher as u64, &aead_tag as u64);
    g_tls_crypto_aead_ok = aead_ok
        && tls_bytes_equal(&aead_cipher as u64, &TLS_AEAD_CIPHER1 as u64, 114)
        && tls_bytes_equal(&aead_tag as u64, &TLS_AEAD_TAG1 as u64, 16);
    let decrypted: [u8; 114] = [0; 114]; let bad_tag: [u8; 16] = [0; 16];
    for i: u32 in 0..16 { bad_tag[i] = TLS_AEAD_TAG1[i]; } bad_tag[0] = bad_tag[0] ^ 1;
    for i: u32 in 0..114 { decrypted[i] = 0xa5; }
    let rejected: bool = !tls_chacha20_poly1305_decrypt(
        &TLS_AEAD_KEY1 as u64, &TLS_AEAD_NONCE1 as u64, &TLS_AEAD_AAD1 as u64, 12,
        &TLS_AEAD_CIPHER1 as u64, 114, &bad_tag as u64, &decrypted as u64);
    let untouched: bool = true; for i: u32 in 0..114 { if decrypted[i] != 0xa5 { untouched = false; } }
    let decrypted_ok: bool = tls_chacha20_poly1305_decrypt(
        &TLS_AEAD_KEY1 as u64, &TLS_AEAD_NONCE1 as u64, &TLS_AEAD_AAD1 as u64, 12,
        &TLS_AEAD_CIPHER1 as u64, 114, &TLS_AEAD_TAG1 as u64, &decrypted as u64);
    g_tls_crypto_aead_decrypt_ok = rejected && untouched && decrypted_ok
        && tls_bytes_equal(&decrypted as u64,
            "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it." as u64, 114);
    tls_x25519_self_test();
    tls13_self_test();
    tls_entropy_self_test();
}
