    draw_text_abs(g_numbuf, 650, 348, 0xffffff, 0x0b0f14); draw_text_abs(" KiB", 650 + g_numlen * 8, 348, 0x8fa1aa, 0x0b0f14);
    settings_text("Filesystem", 438, 384, false); settings_text(settings_yes_no(g_fs_ok), 650, 384, true);
    settings_text("Graphics", 438, 420, false); settings_text(settings_yes_no(g_gfx), 650, 420, true);
    settings_text("Network driver", 438, 456, false); settings_text(settings_yes_no(g_rtl_ok), 650, 456, true);
    settings_text("All values are read directly from kernel state.", 438, 500, false);
}

fn settings_sidebar_named(id: u32, y: u32) {
    if id == 0 { settings_sidebar_row("Overview", y, g_settings_section == id); }
    if id == 1 { settings_sidebar_row("Personalization", y, g_settings_section == id); }
    if id == 2 { settings_sidebar_row("Display", y, g_settings_section == id); }
    if id == 3 { settings_sidebar_row("Network", y, g_settings_section == id); }
    if id == 4 { settings_sidebar_row("Apps", y, g_settings_section == id); }
    if id == 5 { settings_sidebar_row("Time & language", y, g_settings_section == id); }
    if id == 6 { settings_sidebar_row("Accessibility", y, g_settings_section == id); }
    if id == 7 { settings_sidebar_row("Privacy & security", y, g_settings_section == id); }
    if id == 8 { settings_sidebar_row("Power", y, g_settings_section == id); }
    if id == 9 { settings_sidebar_row("Storage", y, g_settings_section == id); }
    if id == 10 { settings_sidebar_row("Hardware", y, g_settings_section == id); }
    if id == 11 { settings_sidebar_row("Update & About", y, g_settings_section == id); }
    if id == 12 { settings_sidebar_row("Diagnostics", y, g_settings_section == id); }
}

fn settings_draw_sidebar() {
    settings_text("SETTINGS", 208, 202, false);
    for row: u32 in 0..8 { settings_sidebar_named(g_settings_scroll + row, 230 + row * 32); }
    if g_settings_scroll > 0 { draw_text_abs("^ more", 316, 204, 0x61747d, 0x0b0f14); }
    if g_settings_scroll + 8 < 13 { draw_text_abs("v more", 316, 474, 0x61747d, 0x0b0f14); }
    fill_rect(208, 486, 180, 27, 0x121a20);
    draw_text_abs("/  Search", 220, 492, 0x9fb0b7, 0x121a20);
    fill_rect(402, 198, 1, 352, 0x243642);
    if g_settings_section == 0 { settings_overview(); }
    if g_settings_section == 1 { settings_personalization_preview(); }
    if g_settings_section == 2 { settings_display(); }
    if g_settings_section == 3 { settings_network(); }
    if g_settings_section == 4 { settings_apps(); }
    if g_settings_section == 5 { settings_clock_preview(); }
    if g_settings_section == 6 { settings_accessibility(); }
    if g_settings_section == 7 { settings_privacy(); }
    if g_settings_section == 8 { settings_power(); }
    if g_settings_section == 9 { settings_storage(); }
    if g_settings_section == 10 { settings_hardware(); }
    if g_settings_section == 11 { settings_update(); }
    if g_settings_section == 12 { settings_diagnostics(); }
    if g_settings_show_hints { settings_text("Up/Down: browse   Enter: open   /: search", 208, 580, false); }
}

fn settings_accent_name() -> *u8 {
    if g_settings_accent == 0 { return "Ocean"; }
    if g_settings_accent == 1 { return "Violet"; }
    if g_settings_accent == 2 { return "Forest"; }
    if g_settings_accent == 3 { return "Coral"; }
    if g_settings_accent == 4 { return "Amber"; }
    return "Ice";
}

fn settings_wall_name() -> *u8 {
    if g_settings_wall == 0 { return "Midnight"; }
    if g_settings_wall == 1 { return "Aurora"; }
    if g_settings_wall == 2 { return "Sunset"; }
    return "Graphite";
}

fn settings_draw_personalization() {
    settings_title("Personalization", "Enter cycles each live desktop style");
    settings_option_row("Accent color", settings_accent_name(), 286, g_settings_sel == 0);
    settings_option_row("Wallpaper", settings_wall_name(), 334, g_settings_sel == 1);
    fill_rect(438, 382, 330, 82, g_wall_top); fill_rect(438, 423, 330, 41, g_wall_bottom);
    fill_rect(466, 399, 274, 44, 0x0b0f14); fill_rect(466, 399, 274, 8, g_accent);
    settings_text("Up/Down: select   Enter: change   Esc/Left: back", 420, 580, false);
}

fn settings_draw_clock() {
    settings_title("Clock", "Choose how time appears in the top bar");
    settings_option_row("24-hour time", settings_on_off(g_clock_24h), 286, g_settings_sel == 0);
    settings_option_row("Show seconds", settings_on_off(g_clock_seconds), 334, g_settings_sel == 1);
    settings_text("Changes appear immediately in the top-right clock.", 438, 394, false);
    settings_text("Up/Down: select   Enter: toggle   Esc/Left: back", 420, 580, false);
}

fn settings_draw_accessibility() {
    settings_title("Accessibility", "Visual clarity and guidance controls");
    settings_option_row("High contrast", settings_on_off(g_settings_high_contrast), 286, g_settings_sel == 0);
    settings_option_row("Navigation hints", settings_on_off(g_settings_show_hints), 334, g_settings_sel == 1);
    settings_text("High contrast uses stronger black/gold edges.", 438, 394, false);
    if g_settings_show_hints { settings_text("Up/Down: select   Enter: toggle   Esc/Left: back", 420, 580, false); }
}

fn settings_draw_network_controls() {
    settings_title("Ethernet", "RTL8139 adapter and IPv4 configuration");
    settings_option_row("Connect with DHCP", "Run", 280, g_settings_sel == 0);
    settings_option_row("Disconnect adapter", "Run", 322, g_settings_sel == 1);
    settings_text("Driver", 438, 374, false); settings_text(settings_yes_no(g_rtl_ok), 650, 374, true);
    settings_text("DHCP lease", 438, 406, false); settings_text(settings_yes_no(g_net_up), 650, 406, true);
    settings_text("IPv4", 438, 438, false);
    if g_net_up { settings_draw_ip(650, 438); } else { settings_text("Not assigned", 650, 438, true); }
    settings_text("QEMU: use -netdev user and -device rtl8139.", 438, 488, false);
    settings_text("Up/Down: select   Enter: run   Esc/Left: back", 420, 580, false);
}

fn settings_draw_hardware_controls() {
    settings_title("Device Controls", "PCI discovery, speaker and AC97 audio");
    settings_option_row("Rescan PCI devices", "Run", 270, g_settings_sel == 0);
    settings_option_row("PC speaker", settings_on_off(g_speaker_enabled), 306, g_settings_sel == 1);
    settings_option_row("Test PC speaker", "Run", 342, g_settings_sel == 2);
    settings_option_row("Initialize AC97", settings_yes_no(g_ac97_ok), 378, g_settings_sel == 3);
    num_to_str(g_audio_volume, g_numbuf);
    settings_option_row("Audio volume", g_numbuf, 414, g_settings_sel == 4);
    settings_option_row("Test AC97 PCM", "Run", 450, g_settings_sel == 5);
    settings_option_row("USB device list", "Open", 486, g_settings_sel == 6);
    settings_text("Wi-Fi", 438, 530, false); settings_text(settings_yes_no(g_hw_wifi), 500, 530, true);
    settings_text("Bluetooth", 610, 530, false); settings_text(settings_bluetooth_state(), 700, 530, true);
    settings_text("Up/Down: select   Enter: run   Esc/Left: back", 420, 580, false);
}

fn settings_draw_usb_devices() {
    settings_title("USB Devices", "Assigned addresses and descriptor identities");
    settings_text("Addr", 438, 270, false); settings_text("VID / PID", 510, 270, false);
    settings_text("Class / proto", 650, 270, false);
    let shown: u32 = g_usb_devices; if shown > 6 { shown = 6; }
    for i: u32 in 0..shown {
        let y: u32 = 304 + i * 40;
        fill_rect(430, y - 7, 372, 30, 0x121a20);
        num_to_str(g_usb_device_address[i] as u32, g_numbuf); draw_text_abs(g_numbuf, 446, y, 0xffffff, 0x121a20);
        num_to_str(g_usb_device_vid[i] as u32, g_numbuf); draw_text_abs(g_numbuf, 510, y, 0xffffff, 0x121a20);
        draw_text_abs(" / ", 558, y, 0x8fa1aa, 0x121a20);
        num_to_str(g_usb_device_pid[i] as u32, g_numbuf); draw_text_abs(g_numbuf, 582, y, 0xffffff, 0x121a20);
        num_to_str(g_usb_device_class[i] as u32, g_numbuf); draw_text_abs(g_numbuf, 674, y, 0xffffff, 0x121a20);
        draw_text_abs(" / ", 714, y, 0x8fa1aa, 0x121a20);
        num_to_str(g_usb_device_protocol[i] as u32, g_numbuf); draw_text_abs(g_numbuf, 738, y, 0xffffff, 0x121a20);
        if g_usb_device_configured[i] { draw_text_abs("+", 782, y, g_accent, 0x121a20); }
    }
    if g_usb_devices == 0 { settings_text("No addressed USB devices.", 438, 320, false); }
    settings_text("+ configured   Esc/Left: back", 420, 580, false);
}

fn settings_draw() {
    if !g_gfx { return; }
    window_title("settings"); clear_window();
    if g_settings_search { settings_draw_search(); return; }
    if g_settings_view == 0 { settings_draw_sidebar(); }
    if g_settings_view == 1 { settings_draw_personalization(); }
    if g_settings_view == 2 { settings_draw_clock(); }
    if g_settings_view == 3 { settings_draw_accessibility(); }
    if g_settings_view == 4 { settings_draw_hardware_controls(); }
    if g_settings_view == 5 { settings_draw_network_controls(); }
    if g_settings_view == 6 { settings_draw_usb_devices(); }
}

fn settings_up() {
    if g_settings_view == 0 {
        if g_settings_section > 0 {
            g_settings_section = g_settings_section - 1;
            if g_settings_section < g_settings_scroll { g_settings_scroll = g_settings_section; }
            settings_draw();
        }
        return;
    }
    if g_settings_sel > 0 { g_settings_sel = g_settings_sel - 1; settings_draw(); }
}

fn settings_down() {
    if g_settings_view == 0 {
        if g_settings_section < 12 {
            g_settings_section = g_settings_section + 1;
            if g_settings_section >= g_settings_scroll + 8 { g_settings_scroll = g_settings_section - 7; }
            settings_draw();
        }
        return;
    }
    let last: u32 = 1;
    if g_settings_view == 4 { last = 6; }
    if g_settings_view == 6 { return; }
    if g_settings_sel < last { g_settings_sel = g_settings_sel + 1; settings_draw(); }
}

fn settings_apply_accent() {
    g_settings_accent = (g_settings_accent + 1) % 6;
    if g_settings_accent == 0 { g_accent = 0x2c5364; }
    if g_settings_accent == 1 { g_accent = 0x654a91; }
    if g_settings_accent == 2 { g_accent = 0x276749; }
    if g_settings_accent == 3 { g_accent = 0xa94f55; }
    if g_settings_accent == 4 { g_accent = 0xb06d18; }
    if g_settings_accent == 5 { g_accent = 0x397d96; }
    draw_desktop(); settings_draw();
}

fn settings_apply_wallpaper() {
    g_settings_wall = (g_settings_wall + 1) % 4;
    if g_settings_wall == 0 { g_wall_top = 0x0a1830; g_wall_bottom = 0x2c5364; }
    if g_settings_wall == 1 { g_wall_top = 0x102a2b; g_wall_bottom = 0x315f58; }
    if g_settings_wall == 2 { g_wall_top = 0x2b1735; g_wall_bottom = 0x7b3f48; }
    if g_settings_wall == 3 { g_wall_top = 0x11151a; g_wall_bottom = 0x303942; }
    draw_desktop(); settings_draw();
}

fn settings_enter() {
    if g_settings_view == 0 {
        if g_settings_section == 1 { g_settings_view = 1; g_settings_sel = 0; settings_draw(); }
        if g_settings_section == 5 { g_settings_view = 2; g_settings_sel = 0; settings_draw(); }
        if g_settings_section == 6 { g_settings_view = 3; g_settings_sel = 0; settings_draw(); }
        if g_settings_section == 3 { g_settings_view = 5; g_settings_sel = 0; settings_draw(); }
        if g_settings_section == 10 { g_settings_view = 4; g_settings_sel = 0; hw_scan_pci(); settings_draw(); }
        return;
    }
    if g_settings_view == 1 {
        if g_settings_sel == 0 { settings_apply_accent(); }
        if g_settings_sel == 1 { settings_apply_wallpaper(); }
        return;
    }
    if g_settings_view == 2 {
        if g_settings_sel == 0 { g_clock_24h = !g_clock_24h; }
        if g_settings_sel == 1 { g_clock_seconds = !g_clock_seconds; }
        draw_topbar(); settings_draw();
        return;
    }
    if g_settings_view == 3 {
        if g_settings_sel == 0 {
            g_settings_high_contrast = !g_settings_high_contrast;
            if g_settings_high_contrast { g_accent = 0xffc928; g_wall_top = 0x000000; g_wall_bottom = 0x171717; }
            else { g_accent = 0x2c5364; g_wall_top = 0x0a1830; g_wall_bottom = 0x2c5364; g_settings_accent = 0; g_settings_wall = 0; }
            draw_desktop(); settings_draw();
        }
        if g_settings_sel == 1 { g_settings_show_hints = !g_settings_show_hints; settings_draw(); }
        return;
    }
    if g_settings_view == 4 {
        if g_settings_sel == 0 { hw_scan_pci(); settings_draw(); }
        if g_settings_sel == 1 { g_speaker_enabled = !g_speaker_enabled; if !g_speaker_enabled { speaker_stop(); } settings_draw(); }
        if g_settings_sel == 2 { speaker_test(); settings_draw(); }
        if g_settings_sel == 3 { ac97_init(); hw_scan_pci(); settings_draw(); }
        if g_settings_sel == 4 { ac97_set_volume((g_audio_volume + 25) % 125); settings_draw(); }
        if g_settings_sel == 5 { ac97_test_tone(); settings_draw(); }
        if g_settings_sel == 6 { g_settings_view = 6; g_settings_sel = 0; settings_draw(); }
        return;
    }
    if g_settings_view == 5 {
        if g_settings_sel == 0 {
            clear_window(); window_title("settings - connecting...");
            draw_text_abs("Bringing up RTL8139 and requesting a DHCP lease...", 240, 300, 0xffffff, 0x0b0f14);
            g_net_quiet = true; net_dhcp(); g_net_quiet = false; settings_draw();
        }
        if g_settings_sel == 1 { ethernet_disconnect(); settings_draw(); }
    }
}

fn settings_open_search_result() {
    let seen: u32 = 0;
    if settings_matches("system overview") { if seen == g_settings_result_sel { g_settings_section = 0; } seen = seen + 1; }
    if settings_matches("accent color theme") { if seen == g_settings_result_sel { g_settings_section = 1; } seen = seen + 1; }
    if settings_matches("wallpaper background") { if seen == g_settings_result_sel { g_settings_section = 1; } seen = seen + 1; }
    if settings_matches("resolution display graphics") { if seen == g_settings_result_sel { g_settings_section = 2; } seen = seen + 1; }
    if settings_matches("ethernet dhcp ip network") { if seen == g_settings_result_sel { g_settings_section = 3; } seen = seen + 1; }
    if settings_matches("installed apps defaults terminal files vex") { if seen == g_settings_result_sel { g_settings_section = 4; } seen = seen + 1; }
    if settings_matches("24 hour time clock language") { if seen == g_settings_result_sel { g_settings_section = 5; } seen = seen + 1; }
    if settings_matches("show seconds") { if seen == g_settings_result_sel { g_settings_section = 5; } seen = seen + 1; }
    if settings_matches("high contrast accessibility") { if seen == g_settings_result_sel { g_settings_section = 6; } seen = seen + 1; }
    if settings_matches("navigation hints accessibility") { if seen == g_settings_result_sel { g_settings_section = 6; } seen = seen + 1; }
    if settings_matches("privacy security lock permissions") { if seen == g_settings_result_sel { g_settings_section = 7; } seen = seen + 1; }
    if settings_matches("power sleep restart shutdown") { if seen == g_settings_result_sel { g_settings_section = 8; } seen = seen + 1; }
    if settings_matches("disk files storage memory") { if seen == g_settings_result_sel { g_settings_section = 9; } seen = seen + 1; }
    if settings_matches("hardware keyboard audio bluetooth devices") { if seen == g_settings_result_sel { g_settings_section = 10; } seen = seen + 1; }
    if settings_matches("update version build about") { if seen == g_settings_result_sel { g_settings_section = 11; } seen = seen + 1; }
    if settings_matches("system diagnostics health") { if seen == g_settings_result_sel { g_settings_section = 12; } seen = seen + 1; }
    if g_settings_result_count == 0 { return; }
    if g_settings_section > 7 { g_settings_scroll = g_settings_section - 7; } else { g_settings_scroll = 0; }
    g_settings_search = false; g_settings_view = 0; settings_draw();
}

fn settings_search_key(sc: u8) {
    if sc == 42 || sc == 54 { g_shift = true; return; }
    if sc == 170 || sc == 182 { g_shift = false; return; }
    if sc == 1 { g_settings_search = false; settings_draw(); return; }
    if sc == 14 {
        if g_settings_query_len > 0 {
            g_settings_query_len = g_settings_query_len - 1;
            *((&g_settings_query as u64 + (g_settings_query_len as u64)) as *u8) = 0;
            g_settings_result_sel = 0; settings_draw();
        }
        return;
    }
    if sc == 28 { settings_open_search_result(); return; }
    if sc >= 128 { return; }
    let ch: u8 = scancode_to_ascii(sc, g_shift);
    if ch >= 32 && ch < 127 && g_settings_query_len < 22 {
        *((&g_settings_query as u64 + (g_settings_query_len as u64)) as *u8) = ch;
        g_settings_query_len = g_settings_query_len + 1;
        *((&g_settings_query as u64 + (g_settings_query_len as u64)) as *u8) = 0;
        g_settings_result_sel = 0; settings_draw();
    }
}

fn settings_back() {
    if g_settings_view != 0 { g_settings_view = 0; settings_draw(); }
}

fn settings_on_key(sc: u8) {
    if g_settings_search {
        if sc == 224 { g_settings_ext = true; return; }
        if g_settings_ext {
            g_settings_ext = false;
            if sc == 72 && g_settings_result_sel > 0 { g_settings_result_sel = g_settings_result_sel - 1; settings_draw(); }
            if sc == 80 && g_settings_result_sel + 1 < g_settings_result_count { g_settings_result_sel = g_settings_result_sel + 1; settings_draw(); }
            return;
        }
        settings_search_key(sc); return;
    }
    if sc == 224 { g_settings_ext = true; return; }
    if g_settings_ext {
        g_settings_ext = false;
        if sc == 72 { settings_up(); return; }
        if sc == 80 { settings_down(); return; }
        if sc == 75 { settings_back(); return; }
        return;
    }
    if sc >= 128 { return; }
    if sc == 53 {
        g_settings_search = true; g_settings_query_len = 0; g_settings_result_sel = 0;
        *((&g_settings_query as u64) as *u8) = 0; settings_draw(); return;
    }
    if sc == 28 { settings_enter(); return; }
    if sc == 1 { settings_back(); return; }
}
