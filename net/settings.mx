// MORT OS Settings control center. Values are in-memory for v1.
let g_accent: u32 = 0x2c5364;
let g_wall_top: u32 = 0x0a1830;
let g_wall_bottom: u32 = 0x2c5364;
let g_clock_24h: bool = true;
let g_clock_seconds: bool = true;
let g_settings_view: u32 = 0;       // 0 sidebar, 1 personalization, 2 clock
let g_settings_sel: u32 = 0;        // selection within current view
let g_settings_section: u32 = 0;    // selected sidebar section
let g_settings_accent: u32 = 0;
let g_settings_wall: u32 = 0;
let g_settings_ext: bool = false;
let g_settings_search: bool = false;
let g_settings_query: [u8; 24] = [0; 24];
let g_settings_query_len: u32 = 0;
let g_settings_result_sel: u32 = 0;
let g_settings_result_count: u32 = 0;
let g_settings_high_contrast: bool = false;
let g_settings_show_hints: bool = true;
let g_settings_scroll: u32 = 0;

fn settings_text(label: *u8, x: u32, y: u32, bright: bool) {
    let fg: u32 = 0x8fa1aa;
    if bright { fg = 0xe8f1f4; }
    draw_text_abs(label, x, y, fg, 0x0b0f14);
}

fn settings_sidebar_row(label: *u8, y: u32, selected: bool) {
    let bg: u32 = 0x0b0f14;
    let fg: u32 = 0xa9b7bd;
    if selected {
        bg = g_accent;
        fg = 0xffffff;
        fill_rect(198, y - 4, 190, 25, bg);
    }
    draw_text_abs(label, 212, y, fg, bg);
}

fn settings_option_row(label: *u8, value: *u8, y: u32, selected: bool) {
    let bg: u32 = 0x0b0f14;
    let fg: u32 = 0xc8d0d4;
    if selected {
        bg = 0x1d303a;
        fg = 0xffffff;
        fill_rect(420, y - 7, 390, 30, bg);
        fill_rect(420, y - 7, 4, 30, g_accent);
    }
    draw_text_abs(label, 438, y, fg, bg);
    draw_text_abs(value, 690, y, g_accent, bg);
}

fn settings_on_off(on: bool) -> *u8 {
    if on { return "On"; }
    return "Off";
}

fn settings_yes_no(on: bool) -> *u8 {
    if on { return "Ready"; }
    return "Unavailable";
}

fn settings_bluetooth_state() -> *u8 {
    if g_bt_hci_ready { return "Ready"; }
    if g_bt_reset_sent { return "Reset sent"; }
    if g_bt_transport_ready || g_hw_bluetooth { return "Detected"; }
    return "Unavailable";
}

fn settings_title(title: *u8, subtitle: *u8) {
    draw_text_abs(title, 420, 204, 0xffffff, 0x0b0f14);
    draw_text_abs(subtitle, 420, 228, 0x7f929b, 0x0b0f14);
    fill_rect(420, 252, 390, 1, 0x243642);
}

fn settings_lower(ch: u8) -> u8 {
    if ch >= 65 && ch <= 90 { return ch + 32; }
    return ch;
}

// Small case-insensitive substring matcher used by the settings search index.
fn settings_matches(label: *u8) -> bool {
    if g_settings_query_len == 0 { return true; }
    let ll: u32 = str_len(label);
    if g_settings_query_len > ll { return false; }
    let start: u32 = 0;
    while start + g_settings_query_len <= ll {
        let ok: bool = true;
        let j: u32 = 0;
        while j < g_settings_query_len {
            let a: u8 = settings_lower(*((label as u64 + (start as u64) + (j as u64)) as *u8));
            let b: u8 = settings_lower(*((&g_settings_query as u64 + (j as u64)) as *u8));
            if a != b { ok = false; }
            j = j + 1;
        }
        if ok { return true; }
        start = start + 1;
    }
    return false;
}

fn settings_search_item(label: *u8, section: u32, y: u32, result: u32) {
    let bg: u32 = 0x0b0f14;
    let fg: u32 = 0xc8d0d4;
    if result == g_settings_result_sel {
        bg = 0x1d303a; fg = 0xffffff;
        fill_rect(218, y - 5, 580, 27, bg);
        fill_rect(218, y - 5, 4, 27, g_accent);
    }
    draw_text_abs(label, 234, y, fg, bg);
    if section == 0 { draw_text_abs("Overview", 660, y, 0x71858e, bg); }
    if section == 1 { draw_text_abs("Personalization", 660, y, 0x71858e, bg); }
    if section == 2 { draw_text_abs("Display", 660, y, 0x71858e, bg); }
    if section == 3 { draw_text_abs("Network", 660, y, 0x71858e, bg); }
    if section == 4 { draw_text_abs("Apps", 660, y, 0x71858e, bg); }
    if section == 5 { draw_text_abs("Time", 660, y, 0x71858e, bg); }
    if section == 6 { draw_text_abs("Accessibility", 660, y, 0x71858e, bg); }
    if section == 7 { draw_text_abs("Privacy", 660, y, 0x71858e, bg); }
    if section == 8 { draw_text_abs("Power", 660, y, 0x71858e, bg); }
    if section == 9 { draw_text_abs("Storage", 660, y, 0x71858e, bg); }
    if section == 10 { draw_text_abs("Hardware", 660, y, 0x71858e, bg); }
    if section == 11 { draw_text_abs("Update", 660, y, 0x71858e, bg); }
    if section == 12 { draw_text_abs("Diagnostics", 660, y, 0x71858e, bg); }
}

fn settings_search_candidate(label: *u8, section: u32, shown: u32) -> u32 {
    if settings_matches(label) && shown < 8 {
        settings_search_item(label, section, 282 + shown * 32, shown);
        return shown + 1;
    }
    return shown;
}

fn settings_draw_search() {
    draw_text_abs("Search settings", 208, 204, 0xffffff, 0x0b0f14);
    fill_rect(208, 234, 590, 32, 0x121a20); fill_rect(208, 234, 3, 32, g_accent);
    draw_text_abs(">", 220, 242, g_accent, 0x121a20);
    if g_settings_query_len == 0 { draw_text_abs("type to search...", 242, 242, 0x61747d, 0x121a20); }
    else { draw_text_abs(&g_settings_query as *u8, 242, 242, 0xffffff, 0x121a20); }
    let n: u32 = 0;
    n = settings_search_candidate("system overview", 0, n);
    n = settings_search_candidate("accent color theme", 1, n);
    n = settings_search_candidate("wallpaper background", 1, n);
    n = settings_search_candidate("resolution display graphics", 2, n);
    n = settings_search_candidate("ethernet dhcp ip network", 3, n);
    n = settings_search_candidate("installed apps defaults terminal files vex", 4, n);
    n = settings_search_candidate("24 hour time clock language", 5, n);
    n = settings_search_candidate("show seconds", 5, n);
    n = settings_search_candidate("high contrast accessibility", 6, n);
    n = settings_search_candidate("navigation hints accessibility", 6, n);
    n = settings_search_candidate("privacy security lock permissions", 7, n);
    n = settings_search_candidate("power sleep restart shutdown", 8, n);
    n = settings_search_candidate("disk files storage memory", 9, n);
    n = settings_search_candidate("hardware keyboard audio bluetooth devices", 10, n);
    n = settings_search_candidate("update version build about", 11, n);
    n = settings_search_candidate("system diagnostics health", 12, n);
    g_settings_result_count = n;
    if n == 0 { draw_text_abs("No settings found", 234, 294, 0x8fa1aa, 0x0b0f14); }
    draw_text_abs("Up/Down: results   Enter: open   Esc: close search", 208, 580, 0x7f929b, 0x0b0f14);
}

fn settings_draw_ip(x: u32, y: u32) {
    let pos: u32 = x;
    for i: u32 in 0..4 {
        num_to_str(*((&g_our_ip as u64 + (i as u64)) as *u8) as u32, g_numbuf);
        draw_text_abs(g_numbuf, pos, y, 0xe8f1f4, 0x0b0f14);
        pos = pos + g_numlen * 8;
        if i < 3 { draw_text_abs(".", pos, y, 0x8fa1aa, 0x0b0f14); pos = pos + 8; }
    }
}

fn settings_file_count() -> u32 {
    if !g_fs_ok { return 0; }
    let count: u32 = 0;
    for i: u32 in 0..64 {
        if *((fs_entry_addr(i) + 24) as *u32) == 1 { count = count + 1; }
    }
    return count;
}

fn settings_overview() {
    settings_title("Overview", "Your MORT OS at a glance");
    draw_text_abs("MORT OS", 436, 278, g_accent, 0x0b0f14);
    settings_text("Version 1.0  /  x86 32-bit", 436, 302, false);
    fill_rect(428, 336, 174, 82, 0x121a20);
    settings_text("DISPLAY", 442, 348, false);
    num_to_str(g_fb_w, g_numbuf); draw_text_abs(g_numbuf, 442, 374, 0xffffff, 0x121a20);
    let px: u32 = 442 + g_numlen * 8;
    draw_text_abs(" x ", px, 374, 0x8fa1aa, 0x121a20);
    num_to_str(g_fb_h, g_numbuf); draw_text_abs(g_numbuf, px + 24, 374, 0xffffff, 0x121a20);
    fill_rect(620, 336, 174, 82, 0x121a20);
    settings_text("UPTIME", 634, 348, false);
    num_to_str(g_ticks / 100, g_numbuf); draw_text_abs(g_numbuf, 634, 374, 0xffffff, 0x121a20);
    draw_text_abs(" seconds", 634 + g_numlen * 8, 374, 0x8fa1aa, 0x121a20);
    settings_text("Tip: F1-F4 switches apps instantly.", 436, 452, false);
}

