fn settings_hardware() {
    if !g_hw_scanned { hw_scan_pci(); }
    settings_title("Hardware & Devices", "Detected drivers and capabilities");
    settings_text("PS/2 keyboard", 438, 270, false); settings_text("Ready", 674, 270, true);
    settings_text("Framebuffer", 438, 302, false); settings_text(settings_yes_no(g_gfx), 650, 302, true);
    settings_text("ATA storage", 438, 334, false); settings_text(settings_yes_no(g_disk_ok), 650, 334, true);
    settings_text("Ethernet controller", 438, 366, false); settings_text(settings_yes_no(g_hw_ethernet), 650, 366, true);
    settings_text("Wireless controller", 438, 398, false); settings_text(settings_yes_no(g_hw_wifi), 650, 398, true);
    settings_text("USB host / devices", 438, 430, false); settings_text(settings_yes_no(g_usb_ok), 610, 430, true);
    num_to_str(g_usb_devices, g_numbuf); draw_text_abs(g_numbuf, 770, 430, 0xffffff, 0x0b0f14);
    settings_text("USB descriptor", 438, 454, false); settings_text(settings_yes_no(g_usb_addressed), 650, 454, true);
    settings_text("USB configured", 438, 478, false); settings_text(settings_yes_no(g_usb_configured), 650, 478, true);
    settings_text("USB VID / PID", 438, 502, false); num_to_str(g_usb_vid as u32, g_numbuf);
    draw_text_abs(g_numbuf, 650, 502, 0xffffff, 0x0b0f14); draw_text_abs(" / ", 690, 502, 0x8fa1aa, 0x0b0f14);
    num_to_str(g_usb_pid as u32, g_numbuf); draw_text_abs(g_numbuf, 714, 502, 0xffffff, 0x0b0f14);
    settings_text("USB class / protocol", 438, 526, false); num_to_str(g_usb_interface_class as u32, g_numbuf);
    draw_text_abs(g_numbuf, 650, 526, 0xffffff, 0x0b0f14); draw_text_abs(" / ", 690, 526, 0x8fa1aa, 0x0b0f14);
    num_to_str(g_usb_interface_protocol as u32, g_numbuf); draw_text_abs(g_numbuf, 714, 526, 0xffffff, 0x0b0f14);
    if g_usb_devices > 1 {
        settings_text("USB #2 class / protocol", 438, 550, false); num_to_str(g_usb_device_class[1] as u32, g_numbuf);
        draw_text_abs(g_numbuf, 650, 550, 0xffffff, 0x0b0f14); draw_text_abs(" / ", 690, 550, 0x8fa1aa, 0x0b0f14);
        num_to_str(g_usb_device_protocol[1] as u32, g_numbuf); draw_text_abs(g_numbuf, 714, 550, 0xffffff, 0x0b0f14);
    } else {
        settings_text("Audio", 438, 550, false); settings_text(settings_yes_no(g_hw_audio), 500, 550, true);
        settings_text("Bluetooth", 610, 550, false); settings_text(settings_bluetooth_state(), 700, 550, true);
    }
}

