        let last: [u8; 48] = [0; 48]; browser_copy(&last as u64, browser_last_url(), 48);
        draw_text_abs(&last as *u8, 416, 494, 0xc8d0d4, 0x0b0f14);
    }
}

fn browser_draw_about() {
    draw_text_abs("About Vex", 208, 272, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("A native MortOS browser shell, text renderer, and HTTP client.", 208, 310, 0xffffff, 0x0b0f14);
    draw_text_abs("Navigation, local history, bookmarks, find, and downloads are", 208, 338, 0xc8d0d4, 0x0b0f14);
    draw_text_abs("implemented without libc, a heap-backed GUI toolkit, or telemetry.", 208, 362, 0xc8d0d4, 0x0b0f14);
    draw_text_abs("Engine limits: HTTP/1.x text only; no TLS, CSS layout, JS, or media.", 208, 410, 0xffb454, 0x0b0f14);
    draw_text_abs("TLS foundation / SHA-256 vectors", 208, 446, 0x8fa1aa, 0x0b0f14);
    draw_text_abs(settings_yes_no(g_tls_crypto_sha256_ok), 512, 446, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("HMAC-SHA256 / HKDF vectors", 208, 474, 0x8fa1aa, 0x0b0f14);
    let kdf_ok: bool = g_tls_crypto_hmac_ok && g_tls_crypto_hkdf_ok;
    draw_text_abs(settings_yes_no(kdf_ok), 512, 474, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("ChaCha20 block vector", 208, 502, 0x8fa1aa, 0x0b0f14);
    draw_text_abs(settings_yes_no(g_tls_crypto_chacha_ok), 512, 502, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("AEAD / X25519 / TLS key schedule", 208, 530, 0x8fa1aa, 0x0b0f14);
    let aead_ok: bool = g_tls_crypto_poly1305_ok && g_tls_crypto_aead_ok && g_tls_crypto_aead_decrypt_ok
        && g_tls_crypto_x25519_ok && g_tls13_key_schedule_ok && g_tls13_client_hello_ok
        && g_tls13_client_hello_test[0] == 22 && g_tls13_server_hello_ok
        && g_tls13_handshake_keys_ok && g_tls13_record_ok && g_tls13_finished_ok
        && g_tls13_reassembly_ok && g_tls13_certificate_verify_ok && g_tls13_application_keys_ok
        && g_tls13_encrypt_record_ok && g_input_bounds_ok && g_tls_x509_der_ok
        && g_tls_x509_certificate_message_ok && g_tls_x509_hostname_ok && g_tls_x509_fields_ok
        && g_tls_x509_time_test[0] != 0 && g_tls_x509_rtc_ok && g_tls_x509_rtc_test[0] != 0
        && g_tls_x509_rsa_spki_ok && g_tls_rsa_modexp_ok && g_tls_rsa_output_test[1] == 1
        && g_tls_rsa_pkcs1_ok && g_tls_rsa_pss_ok && g_tls_rsa_pss_output_test[127] == 0xbc;
    draw_text_abs(settings_yes_no(aead_ok), 512, 530, 0x4fd1c5, 0x0b0f14);
    num_to_str(g_tls13_client_hello_test_len, g_numbuf); draw_text_abs(g_numbuf, 568, 530, 0x8fa1aa, 0x0b0f14);
    draw_text_abs("CH / RNG", 600, 530, 0x8fa1aa, 0x0b0f14);
    draw_text_abs(settings_yes_no(g_tls_entropy_ready), 680, 530, 0x4fd1c5, 0x0b0f14);
}

fn browser_draw_list(base: u32, count: u32, empty: *u8) {
    if count == 0 { draw_text_abs(empty, 208, 300, 0x8fa1aa, 0x0b0f14); return; }
    for i: u32 in 0..count {
        let y: u32 = 282 + i * 42; let bg: u32 = 0x121a20; let fg: u32 = 0xc8d0d4;
        if i == g_browser_list_sel { bg = 0x1d303a; fg = 0xffffff; fill_rect(204, y - 7, 600, 30, bg); fill_rect(204, y - 7, 3, 30, g_accent); }
        else { fill_rect(204, y - 7, 600, 30, bg); }
        num_to_str(i + 1, g_numbuf); draw_text_abs(g_numbuf, 216, y, 0x4fd1c5, bg);
        draw_text_abs(browser_slot(base, i) as *u8, 240, y, fg, bg);
    }
    if base == BROWSER_BOOKMARK_BASE { draw_text_abs("Enter: open   Delete: remove", 208, 542, 0x7a8b93, 0x0b0f14); }
    else { draw_text_abs("Enter: reopen", 208, 542, 0x7a8b93, 0x0b0f14); }
}

fn browser_draw_downloads() {
    draw_text_abs("Downloads", 208, 272, 0x4fd1c5, 0x0b0f14);
    let have_download: bool = g_browser_downloaded;
    if !have_download && g_fs_ok && g_cwd <= 255 { have_download = fs_find_in("vex-page.txt", g_cwd) != 64; }
    if have_download {
        draw_text_abs("vex-page.txt", 208, 316, 0xffffff, 0x0b0f14);
        draw_text_abs("Saved into the current MortFS home directory.", 208, 344, 0x8fa1aa, 0x0b0f14);
    } else {
        draw_text_abs("No page has been saved in this session.", 208, 316, 0x8fa1aa, 0x0b0f14);
    }
    draw_text_abs("Press D on an HTTP text page to save its rendered content.", 208, 394, 0xc8d0d4, 0x0b0f14);
}

