    draw_text_abs("Vex", 208, 272, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("Browse the small web, from a kernel written in Mort.", 248, 272, 0xffffff, 0x0b0f14);
    fill_rect(208, 310, 586, 38, 0x121a20);
    draw_text_abs("/  Type a vex:// or http:// address", 224, 322, 0x9fb0b7, 0x121a20);
    draw_text_abs("1 Home", 216, 382, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("5 Bookmarks", 344, 382, 0xc8d0d4, 0x0b0f14);
    draw_text_abs("6 History", 504, 382, 0xc8d0d4, 0x0b0f14);
    draw_text_abs("7 Downloads", 632, 382, 0xc8d0d4, 0x0b0f14);
    draw_text_abs("HTTP pages render as safe text. HTTPS is blocked until TLS exists.", 208, 430, 0x7a8b93, 0x0b0f14);
    draw_text_abs("No telemetry, remote suggestions, cookies, scripts, or trackers.", 208, 454, 0x7a8b93, 0x0b0f14);
