        draw_text_abs(browser_link_slot(i) as *u8, 220, y, fg, bg);
    }
    draw_text_abs("Up/Down: select   Enter: open   Esc: return", 208, 542, 0x7a8b93, 0x0b0f14);
}

fn browser_draw_network() {
    draw_text_abs("Network", 208, 272, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("RTL8139", 208, 300, 0x8fa1aa, 0x0b0f14); draw_text_abs(settings_yes_no(g_rtl_ok), 400, 300, 0xffffff, 0x0b0f14);
    draw_text_abs("DHCP lease", 208, 332, 0x8fa1aa, 0x0b0f14); draw_text_abs(settings_yes_no(g_net_up), 400, 332, 0xffffff, 0x0b0f14);
    draw_text_abs("IPv4", 208, 364, 0x8fa1aa, 0x0b0f14);
    if g_net_up { settings_draw_ip_addr(net_our_ip(), 400, 364); }
    else { draw_text_abs("Not assigned", 400, 364, 0xffffff, 0x0b0f14); }
    draw_text_abs("Gateway", 208, 396, 0x8fa1aa, 0x0b0f14);
    if g_net_up { settings_draw_ip_addr(net_gateway_ip(), 400, 396); }
    else { draw_text_abs("Not assigned", 400, 396, 0xffffff, 0x0b0f14); }
    draw_text_abs("DNS", 208, 428, 0x8fa1aa, 0x0b0f14);
    if g_net_up { settings_draw_ip_addr(net_dns_ip(), 400, 428); }
    else { draw_text_abs("Not assigned", 400, 428, 0xffffff, 0x0b0f14); }
    draw_text_abs("Transport", 208, 460, 0x8fa1aa, 0x0b0f14); draw_text_abs("Ethernet / IPv4 / TCP", 400, 460, 0xffffff, 0x0b0f14);
    draw_text_abs("Secure transport", 208, 492, 0x8fa1aa, 0x0b0f14);
    if g_browser_tls_probe_ok { draw_text_abs("TLS 1.3 encrypted handshake / trust pending", 400, 492, 0xffb454, 0x0b0f14); }
    else { draw_text_abs("TLS trust pending", 400, 492, 0xffb454, 0x0b0f14); }
    num_to_str(g_browser_tls_probe_stage, g_numbuf); draw_text_abs(g_numbuf, 744, 492, 0x8fa1aa, 0x0b0f14);
    draw_text_abs("Open Settings > Network to renew DHCP.", 208, 532, 0xc8d0d4, 0x0b0f14);
}

fn browser_draw_error() {
    draw_text_abs(&g_browser_title as *u8, 208, 286, 0xff8b8b, 0x0b0f14);
    draw_text_abs(&g_browser_status as *u8, 208, 326, 0xc8d0d4, 0x0b0f14);
    draw_text_abs("Press / to enter another address, or 1 to return home.", 208, 382, 0x8fa1aa, 0x0b0f14);
}

fn browser_draw_remote_text() {
    let line: u32 = 0; let pos: u32 = 0; let shown: u32 = 0;
    while pos < g_browser_content_len && shown < 13 {
        let start: u32 = pos;
        while pos < g_browser_content_len && g_browser_content[pos] != 10 { pos = pos + 1; }
        if line >= g_browser_scroll {
            let saved: u8 = g_browser_content[pos]; g_browser_content[pos] = 0;
            draw_text_abs((&g_browser_content as u64 + (start as u64)) as *u8, 204, 266 + shown * 22, 0xc8d0d4, 0x0b0f14);
            g_browser_content[pos] = saved; shown = shown + 1;
        }
        if pos < g_browser_content_len { pos = pos + 1; }
        line = line + 1;
    }
}

fn browser_draw_suggestions() {
    if g_browser_mode != 1 || g_browser_suggestion_count == 0 { return; }
    fill_rect(292, 248, 514, 18 + g_browser_suggestion_count * 28, 0x11161d);
    draw_text_abs("ON THIS DEVICE", 304, 254, 0x6f828b, 0x11161d);
    for i: u32 in 0..g_browser_suggestion_count {
        let y: u32 = 274 + i * 28; let bg: u32 = 0x11161d; let fg: u32 = 0xb8c4ca;
        if g_browser_suggestion_active && i == g_browser_suggestion_sel {
            bg = 0x1d303a; fg = 0xffffff; fill_rect(296, y - 5, 506, 24, bg);
        }
        draw_text_abs(browser_suggestion_slot(i) as *u8, 304, y, fg, bg);
    }
}

fn browser_draw() {
    if !g_gfx { return; }
    if g_browser_loaded_dir != g_cwd { browser_state_load(); }
    if g_browser_tab_count == 0 {
        g_browser_tab_count = 1; g_browser_active_tab = 0;
        browser_copy(browser_tab_slot(0), "vex://home" as u64, 80);
    }
    if g_browser_url[0] == 0 {
        browser_set_url("vex://home" as u64); browser_set_title("Home"); browser_set_status("Local start page");
        browser_copy(browser_tab_title(0), "Home" as u64, 24); browser_history_add(&g_browser_url as u64);
    }
    window_title("vex browser"); clear_window(); browser_draw_toolbar();
    if g_browser_links_open { browser_draw_links(); }
    else if g_browser_remote { browser_draw_remote_text(); }
    else if g_browser_page == 0 { browser_draw_home(); }
    else if g_browser_page == 1 { browser_draw_about(); }
    else if g_browser_page == 2 { browser_draw_list(BROWSER_HISTORY_BASE, browser_history_count(), "History is empty."); }
    else if g_browser_page == 3 { browser_draw_list(BROWSER_BOOKMARK_BASE, browser_bookmark_count(), "No bookmarks yet. Press B on any page."); }
    else if g_browser_page == 4 { browser_draw_downloads(); }
    else if g_browser_page == 5 { browser_draw_settings_page(); }
    else if g_browser_page == 6 { browser_draw_network(); }
    else { browser_draw_error(); }
    browser_draw_suggestions();
    fill_rect(196, 562, 620, 22, 0x11161d);
    if g_browser_mode == 2 {
        draw_text_abs("Find: ", 204, 568, 0x4fd1c5, 0x11161d); draw_text_abs(&g_browser_find as *u8, 252, 568, 0xffffff, 0x11161d);
    } else { draw_text_abs(&g_browser_status as *u8, 204, 568, 0x7f929b, 0x11161d); }
    draw_text_abs("/:address arrows:nav B:mark F:find L:links D:save T:new Tab:switch", 196, 590, 0x6f828b, 0x0b0f14);
}

fn browser_begin_address() {
    browser_zero(&g_browser_input as u64, 80);
    g_browser_input_len = browser_copy(&g_browser_input as u64, &g_browser_url as u64, 80);
    g_browser_mode = 1; g_browser_replace_address = true; browser_suggestions_update(); browser_draw();
}

fn browser_submit_address() {
    if g_browser_input_len == 0 { g_browser_mode = 0; browser_draw(); return; }
    g_browser_mode = 0;
    if browser_prefix(&g_browser_input as u64, "vex://" as u64)
        || browser_prefix(&g_browser_input as u64, "http://" as u64)
        || browser_prefix(&g_browser_input as u64, "https://" as u64) {
        browser_load(&g_browser_input as u64, true); return;
    }
    let normalized: [u8; 80] = [0; 80]; let out: u32 = browser_copy(&normalized as u64, "http://" as u64, 80);
    browser_copy(&normalized as u64 + (out as u64), &g_browser_input as u64, 80 - out);
    browser_load(&normalized as u64, true);
}

fn browser_find_run() {
    if g_browser_find_len == 0 || !g_browser_remote { browser_set_status("Find works on loaded HTTP text"); return; }
    let pos: u32 = 0;
    while pos + g_browser_find_len <= g_browser_content_len {
        let ok: bool = true;
        for i: u32 in 0..g_browser_find_len {
            if settings_lower(g_browser_content[pos + i]) != settings_lower(g_browser_find[i]) { ok = false; }
        }
        if ok {
            let lines: u32 = 0; for k: u32 in 0..pos { if g_browser_content[k] == 10 { lines = lines + 1; } }
            g_browser_scroll = lines; browser_set_status("Match found"); return;
        }
        pos = pos + 1;
    }
    browser_set_status("No match on this page");
}

fn browser_save_page() {
    if !g_browser_remote || g_browser_content_len == 0 { browser_set_status("Nothing downloadable on this page"); browser_draw(); return; }
    if !g_fs_ok || g_cwd > 255 { browser_set_status("Download needs a writable MortFS home"); browser_draw(); return; }
    let idx: u32 = fs_find_in("vex-page.txt", g_cwd);
    if idx == 64 { idx = fs_create_full("vex-page.txt", g_cwd, 0); }
    if idx == 64 || !can_write(fs_uid(idx), fs_mode(idx)) { browser_set_status("Download permission denied"); browser_draw(); return; }
    let base: u32 = fs_entry_addr(idx); let start: u32 = *((base + 32) as *u32);
    let sectors: u32 = (g_browser_content_len + 511) / 512; let ok: bool = true;
    for s: u32 in 0..sectors {
        if !ata_write(start + s, (&g_browser_content as u64 + ((s * 512) as u64)) as *u8) { ok = false; }
    }
    if ok {
        *((base + 28) as *u32) = g_browser_content_len; *((base + 48) as *u32) = fs_now();
        ok = fs_sync();
    }
    if ok { g_browser_downloaded = true; browser_set_status("Saved as vex-page.txt"); }
    else { browser_set_status("Download write failed"); }
    browser_draw();
}

fn browser_edit_key(sc: u8) {
    if sc == 42 || sc == 54 { g_browser_shift = true; return; }
    if sc == 170 || sc == 182 { g_browser_shift = false; return; }
    if sc == 224 { g_browser_ext = true; return; }
    if g_browser_ext {
        g_browser_ext = false;
        if g_browser_suggestion_count == 0 { return; }
        if sc == 72 {
            if !g_browser_suggestion_active { g_browser_suggestion_active = true; g_browser_suggestion_sel = g_browser_suggestion_count - 1; }
            else if g_browser_suggestion_sel > 0 { g_browser_suggestion_sel = g_browser_suggestion_sel - 1; }
            browser_draw(); return;
        }
        if sc == 80 {
            if !g_browser_suggestion_active { g_browser_suggestion_active = true; g_browser_suggestion_sel = 0; }
            else if g_browser_suggestion_sel + 1 < g_browser_suggestion_count { g_browser_suggestion_sel = g_browser_suggestion_sel + 1; }
            browser_draw(); return;
        }
        return;
    }
    if sc == 1 { g_browser_mode = 0; g_browser_suggestion_count = 0; browser_draw(); return; }
    if sc == 14 {
        if g_browser_replace_address { browser_zero(&g_browser_input as u64, 80); g_browser_input_len = 0; g_browser_replace_address = false; browser_suggestions_update(); browser_draw(); return; }
        if g_browser_input_len > 0 { g_browser_input_len = g_browser_input_len - 1; g_browser_input[g_browser_input_len] = 0; browser_suggestions_update(); browser_draw(); }
        return;
    }
    if sc == 28 {
        if g_browser_suggestion_active && g_browser_suggestion_count > 0 {
            browser_zero(&g_browser_input as u64, 80);
            g_browser_input_len = browser_copy(&g_browser_input as u64, browser_suggestion_slot(g_browser_suggestion_sel), 80);
        }
        g_browser_suggestion_count = 0; browser_submit_address(); return;
    }
    if sc >= 128 { return; }
    let ch: u8 = scancode_to_ascii(sc, g_browser_shift);
    if ch >= 32 && ch < 127 && g_browser_input_len < 78 {
        if g_browser_replace_address { browser_zero(&g_browser_input as u64, 80); g_browser_input_len = 0; g_browser_replace_address = false; }
        g_browser_input[g_browser_input_len] = ch; g_browser_input_len = g_browser_input_len + 1;
        g_browser_input[g_browser_input_len] = 0; browser_suggestions_update(); browser_draw();
    }
}

fn browser_click(x: u32, y: u32) {
    if y >= 192 && y < 212 {
        for tab: u32 in 0..g_browser_tab_count {
            let left: u32 = 196 + tab * 148;
            if x >= left && x < left + 140 {
                g_browser_active_tab = tab; browser_load(browser_tab_slot(tab), false); return;
            }
        }
        if x >= 784 && x < 824 { browser_new_tab(); return; }
    }
    if y >= 218 && y < 245 {
        if x >= 188 && x < 216 { browser_back(); return; }
        if x >= 216 && x < 240 { browser_forward(); return; }
        if x >= 240 && x < 266 { browser_home(); return; }
        if x >= 266 && x < 292 { browser_reload(); return; }
        if x >= 292 && x < 806 { browser_begin_address(); return; }
    }
    if g_browser_links_open {
        for i: u32 in 0..g_browser_link_count {
            let top: u32 = 299 + i * 40;
            if x >= 204 && x < 804 && y >= top && y < top + 30 { browser_open_link(i); return; }
        }
        return;
    }
    if !g_browser_remote && (g_browser_page == 2 || g_browser_page == 3) {
        let count: u32 = browser_history_count(); let base: u32 = BROWSER_HISTORY_BASE;
        if g_browser_page == 3 { count = browser_bookmark_count(); base = BROWSER_BOOKMARK_BASE; }
        for i: u32 in 0..count {
            let top: u32 = 275 + i * 42;
            if x >= 204 && x < 804 && y >= top && y < top + 30 { browser_load(browser_slot(base, i), true); return; }
        }
    }
}

fn browser_find_key(sc: u8) {
    if sc == 42 || sc == 54 { g_browser_shift = true; return; }
    if sc == 170 || sc == 182 { g_browser_shift = false; return; }
    if sc == 1 { g_browser_mode = 0; browser_draw(); return; }
    if sc == 14 {
        if g_browser_find_len > 0 { g_browser_find_len = g_browser_find_len - 1; g_browser_find[g_browser_find_len] = 0; browser_draw(); }
        return;
    }
    if sc == 28 { g_browser_mode = 0; browser_find_run(); browser_draw(); return; }
    if sc >= 128 { return; }
    let ch: u8 = scancode_to_ascii(sc, g_browser_shift);
    if ch >= 32 && ch < 127 && g_browser_find_len < 30 {
        g_browser_find[g_browser_find_len] = ch; g_browser_find_len = g_browser_find_len + 1;
        g_browser_find[g_browser_find_len] = 0; browser_draw();
    }
}

fn browser_on_key(sc: u8) {
    if g_browser_links_open { browser_links_key(sc); return; }
    if g_browser_mode == 1 { browser_edit_key(sc); return; }
    if g_browser_mode == 2 { browser_find_key(sc); return; }
    if sc == 224 { g_browser_ext = true; return; }
    if g_browser_ext {
        g_browser_ext = false;
        if (g_browser_page == 2 || g_browser_page == 3) && !g_browser_remote {
            let count: u32 = browser_history_count(); if g_browser_page == 3 { count = browser_bookmark_count(); }
            if sc == 72 && g_browser_list_sel > 0 { g_browser_list_sel = g_browser_list_sel - 1; browser_draw(); return; }
            if sc == 80 && g_browser_list_sel + 1 < count { g_browser_list_sel = g_browser_list_sel + 1; browser_draw(); return; }
            if sc == 83 && g_browser_page == 3 { browser_bookmark_remove(); return; }
        }
        if sc == 75 { browser_back(); return; }
        if sc == 77 { browser_forward(); return; }
        if sc == 72 { if g_browser_scroll > 0 { g_browser_scroll = g_browser_scroll - 1; browser_draw(); } return; }
        if sc == 80 { g_browser_scroll = g_browser_scroll + 1; browser_draw(); return; }
        return;
    }
    if sc >= 128 { return; }
    if sc == 28 && !g_browser_remote && g_browser_page == 2 && browser_history_count() > 0 {
        browser_load(browser_slot(BROWSER_HISTORY_BASE, g_browser_list_sel), true); return;
    }
    if sc == 28 && !g_browser_remote && g_browser_page == 3 && browser_bookmark_count() > 0 {
        browser_load(browser_slot(BROWSER_BOOKMARK_BASE, g_browser_list_sel), true); return;
    }
    if sc == 53 { browser_begin_address(); return; }
    if sc == 2 { browser_home(); return; }
    if sc == 3 { browser_back(); return; }
    if sc == 4 { browser_forward(); return; }
    if sc == 5 { browser_reload(); return; }
    if sc == 6 { browser_load("vex://bookmarks" as u64, true); return; }
    if sc == 7 { browser_load("vex://history" as u64, true); return; }
    if sc == 8 { browser_load("vex://downloads" as u64, true); return; }
    if sc == 9 { browser_load("vex://settings" as u64, true); return; }
    if sc == 10 {
        if *((browser_last_url()) as *u8) != 0 { browser_load(browser_last_url(), true); }
        else { browser_set_status("No normal browsing session to restore"); browser_draw(); }
        return;
    }
    if sc == 48 { browser_bookmark_add(); return; } // B
    if sc == 33 { g_browser_mode = 2; g_browser_find_len = 0; browser_zero(&g_browser_find as u64, 32); browser_draw(); return; } // F
    if sc == 32 { browser_save_page(); return; } // D
    if sc == 38 { g_browser_links_open = true; g_browser_link_sel = 0; browser_draw(); return; } // L
    if sc == 20 { browser_new_tab(); return; } // T
    if sc == 45 { browser_close_tab(); return; } // X
    if sc == 15 { browser_switch_tab(); return; } // Tab
    if sc == 25 { browser_toggle_private(); return; } // P
    if sc == 37 { browser_pin_approve(); return; } // K
    if sc == 46 && g_browser_page == 5 { browser_clear_history(); return; } // C in settings
    if sc == 1 { browser_home(); return; }
}
