    draw_text_abs("Address suggestions", 208, 406, 0x8fa1aa, 0x0b0f14); draw_text_abs("Local history + bookmarks", 400, 406, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("Session recovery", 208, 438, 0x8fa1aa, 0x0b0f14); draw_text_abs("Manual / normal mode only", 400, 438, 0x4fd1c5, 0x0b0f14);
    draw_text_abs("State", 208, 470, 0x8fa1aa, 0x0b0f14);
    if g_browser_state_saved { draw_text_abs("Saved to MortFS", 400, 470, 0xffffff, 0x0b0f14); }
