// Synchronous HTTP/1.x client for the Vex browser. It uses the existing
// RTL8139, ARP, IPv4, UDP/DNS and TCP format layers, including the subnet,
// gateway, and DNS configuration learned from DHCP.

let g_browser_net_host: [u8; 64] = [0; 64];
let g_browser_net_path: [u8; 96] = [0; 96];
let g_browser_net_ip: [u8; 4] = [0; 4];
let g_browser_net_mac: [u8; 6] = [0; 6];
let g_browser_http_request: [u8; 384] = [0; 384];
let g_browser_http_raw: [u8; 12288] = [0; 12288];
let g_browser_http_redirect: [u8; 80] = [0; 80];
let g_browser_http_raw_len: u32 = 0;
let g_browser_net_port: u16 = 80;
let g_browser_tcp_source_port: u16 = 49152;
let g_browser_tcp_seq: u32 = 0;
let g_browser_tcp_ack: u32 = 0;
let g_browser_tcp_ipid: u16 = 0x4400;
let g_browser_tcp_nonce: u32 = 0;
let g_input_bounds_ok: bool = false;
let g_browser_net_secure: bool = false;
let g_browser_tls_stream: [u8; 32768] = [0; 32768];
let g_browser_tls_stream_len: u32 = 0;
let g_browser_tls_peer_closed: bool = false;
let g_browser_tls_record: [u8; 16645] = [0; 16645];
let g_browser_tls_plaintext: [u8; 16624] = [0; 16624];
let g_browser_tls_transcript: [u8; 65536] = [0; 65536];
let g_browser_tls_transcript_len: u32 = 0;
let g_browser_tls_probe_ok: bool = false;
let g_browser_tls_probe_stage: u32 = 0;
let g_browser_tls_probe_server_key: [u8; 32] = [0; 32];
let g_browser_tls_leaf_fingerprint: [u8; 32] = [0; 32];
let g_browser_tls_pending_host: [u8; 64] = [0; 64];
let g_browser_tls_pending_port: u16 = 0;
let g_browser_tls_pending: bool = false;
let g_browser_tls_pin_matched: bool = false;
let g_browser_tls_application_ready: bool = false;
let g_browser_tls_client_app_key: [u8; 32] = [0; 32];
let g_browser_tls_server_app_key: [u8; 32] = [0; 32];
let g_browser_tls_client_app_iv: [u8; 12] = [0; 12];
let g_browser_tls_server_app_iv: [u8; 12] = [0; 12];
let g_browser_tls_client_app_sequence: u64 = 0;
let g_browser_tls_server_app_sequence: u64 = 0;
let g_browser_tls_http_ok: bool = false;

fn browser_tls_application_clear() {
    g_browser_tls_application_ready = false;
    browser_zero(&g_browser_tls_client_app_key as u64, 32);
    browser_zero(&g_browser_tls_server_app_key as u64, 32);
    browser_zero(&g_browser_tls_client_app_iv as u64, 12);
    browser_zero(&g_browser_tls_server_app_iv as u64, 12);
    g_browser_tls_client_app_sequence = 0; g_browser_tls_server_app_sequence = 0;
}

fn browser_net_lower(ch: u8) -> u8 { if ch >= 65 && ch <= 90 { return ch + 32; } return ch; }

fn browser_match_ci(buf: u64, pos: u32, limit: u32, text: u64) -> bool {
    let i: u32 = 0;
    while *((text + (i as u64)) as *u8) != 0 {
        if pos + i >= limit { return false; }
        if browser_net_lower(*((buf + ((pos + i) as u64)) as *u8))
            != browser_net_lower(*((text + (i as u64)) as *u8)) { return false; }
        i = i + 1;
    }
    return true;
}

fn browser_request_append(pos: u32, text: u64) -> u32 {
    let out: u32 = pos; let i: u32 = 0;
    while out < 382 && *((text + (i as u64)) as *u8) != 0 {
        g_browser_http_request[out] = *((text + (i as u64)) as *u8);
        out = out + 1; i = i + 1;
    }
    g_browser_http_request[out] = 0;
    return out;
}

fn browser_parse_url(url: u64) -> bool {
    browser_zero(&g_browser_net_host as u64, 64); browser_zero(&g_browser_net_path as u64, 96);
    let pos: u32 = 0; g_browser_net_secure = false;
    if browser_prefix(url, "https://" as u64) { pos = 8; g_browser_net_port = 443; g_browser_net_secure = true; }
    else if browser_prefix(url, "http://" as u64) { pos = 7; g_browser_net_port = 80; }
    else { return false; }
    let hlen: u32 = 0;
    while *((url + (pos as u64)) as *u8) != 0 && *((url + (pos as u64)) as *u8) != 47
        && *((url + (pos as u64)) as *u8) != 58 {
        if hlen + 1 >= 64 { return false; }
        g_browser_net_host[hlen] = *((url + (pos as u64)) as *u8); hlen = hlen + 1; pos = pos + 1;
    }
    if hlen == 0 { return false; }
    g_browser_net_host[hlen] = 0;
    if *((url + (pos as u64)) as *u8) == 58 {
        pos = pos + 1; let port: u32 = 0; let digits: u32 = 0;
        while *((url + (pos as u64)) as *u8) >= 48 && *((url + (pos as u64)) as *u8) <= 57 {
            port = port * 10 + ((*((url + (pos as u64)) as *u8) as u32) - 48);
            digits = digits + 1; pos = pos + 1;
        }
        if digits == 0 || port == 0 || port > 65535 { return false; }
        g_browser_net_port = port as u16;
    }
    if *((url + (pos as u64)) as *u8) == 0 {
        g_browser_net_path[0] = 47; g_browser_net_path[1] = 0;
    } else if *((url + (pos as u64)) as *u8) == 47 {
        browser_copy(&g_browser_net_path as u64, url + (pos as u64), 96);
    } else { return false; }
    return true;
}

fn browser_parse_ipv4(text: u64, out: u64) -> bool {
    let pos: u32 = 0;
    for part: u32 in 0..4 {
        let value: u32 = 0; let digits: u32 = 0;
        while *((text + (pos as u64)) as *u8) >= 48 && *((text + (pos as u64)) as *u8) <= 57 {
            value = value * 10 + ((*((text + (pos as u64)) as *u8) as u32) - 48);
            digits = digits + 1; pos = pos + 1;
        }
        if digits == 0 || value > 255 { return false; }
        *((out + (part as u64)) as *u8) = value as u8;
        if part < 3 {
            if *((text + (pos as u64)) as *u8) != 46 { return false; }
            pos = pos + 1;
        }
    }
    return *((text + (pos as u64)) as *u8) == 0;
}

fn browser_net_aux(rx: u64, length: u32) {
    let reply: u32 = net_handle_frame(rx, length, &g_net_tx as u64);
    if reply > 0 { net_send(&g_net_tx as u64, reply); }
}

fn browser_arp_resolve(target_ip: u64, out_mac: u64) -> bool {
    let base: u64 = &g_net_tx as u64; let broadcast: [u8; 6] = [0; 6]; mac_broadcast(&broadcast as u64);
    eth_build_header(base, &broadcast as u64, net_our_mac(), ETH_ARP);
    arp_build_request(eth_payload(base), net_our_mac(), net_our_ip(), target_ip);
    net_send(base, 14 + ARP_LEN);
    for spin: u32 in 0..8000000 {
        let n: u32 = rtl_poll_rx(&g_net_rx as u64);
        if n >= 42 {
            let rx: u64 = &g_net_rx as u64; browser_net_aux(rx, n);
            if eth_type(rx) == ETH_ARP {
                let arp: u64 = eth_payload(rx);
                if arp_oper(arp) == ARP_REPLY && ip4_eq(arp_spa(arp), target_ip) {
                    mac_copy(out_mac, arp_sha(arp)); return true;
                }
            }
        }
    }
    return false;
}

fn browser_route_ip(destination: u64) -> u64 {
    if net_same_subnet(destination) { return destination; }
    if net_ip_present(net_gateway_ip()) { return net_gateway_ip(); }
    return 0;
}

fn browser_dns_resolve(host: u64, out_ip: u64) -> bool {
    if browser_parse_ipv4(host, out_ip) { return true; }
    let dns_ip: u64 = net_dns_ip(); let dns_mac: [u8; 6] = [0; 6];
    if !net_ip_present(dns_ip) { browser_set_status("DHCP did not provide a DNS server"); return false; }
    let arp_ip: u64 = browser_route_ip(dns_ip);
    if arp_ip == 0 { browser_set_status("DHCP did not provide a default gateway"); return false; }
    if !browser_arp_resolve(arp_ip, &dns_mac as u64) { browser_set_status("DNS route ARP failed"); return false; }
    let base: u64 = &g_net_tx as u64; let ip: u64 = eth_payload(base); let udp: u64 = ip + 20;
    let query: u64 = udp + 8; let id: u16 = (0x5600 | ((g_ticks as u16) & 0xff));
    let qlen: u32 = dns_build_query(query, id, host);
    eth_build_header(base, &dns_mac as u64, net_our_mac(), ETH_IP);
    let ulen: u32 = udp_build(udp, 53000, DNS_PORT, net_our_ip(), dns_ip, qlen);
    ip_build_header(ip, net_our_ip(), dns_ip, IP_PROTO_UDP, 0x5500, ulen as u16);
    net_send(base, 14 + 20 + ulen);
    for spin: u32 in 0..12000000 {
        let n: u32 = rtl_poll_rx(&g_net_rx as u64);
        if n >= 42 {
            let rx: u64 = &g_net_rx as u64; browser_net_aux(rx, n);
            if eth_type(rx) == ETH_IP {
                let rip: u64 = eth_payload(rx);
                if ip_proto(rip) == IP_PROTO_UDP {
                    let rudp: u64 = rip + (ip_ihl_bytes(rip) as u64);
                    if udp_dst_port(rudp) == 53000 && udp_src_port(rudp) == DNS_PORT {
                        let msg: u64 = udp_payload(rudp); let mlen: u32 = (udp_length(rudp) as u32) - 8;
                        if dns_id(msg) == id && dns_first_a(msg, mlen, out_ip) { return true; }
                    }
                }
            }
        }
    }
    browser_set_status("DNS lookup timed out"); return false;
}

fn browser_tcp_send(flags: u8, data: u64, data_len: u32) {
    let base: u64 = &g_net_tx as u64; eth_build_header(base, &g_browser_net_mac as u64, net_our_mac(), ETH_IP);
    let ip: u64 = eth_payload(base); let tcp: u64 = ip + 20;
    for i: u32 in 0..data_len { *((tcp + 20 + (i as u64)) as *u8) = *((data + (i as u64)) as *u8); }
    let total: u32 = tcp_build(tcp, g_browser_tcp_source_port, g_browser_net_port,
        g_browser_tcp_seq, g_browser_tcp_ack, flags, 8192, net_our_ip(), &g_browser_net_ip as u64, data_len);
    ip_build_header(ip, net_our_ip(), &g_browser_net_ip as u64, IP_PROTO_TCP, g_browser_tcp_ipid, total as u16);
    g_browser_tcp_ipid = g_browser_tcp_ipid + 1; net_send(base, 14 + 20 + total);
    let advance: u32 = data_len;
    if (flags & TCP_SYN) != 0 { advance = advance + 1; }
    if (flags & TCP_FIN) != 0 { advance = advance + 1; }
    g_browser_tcp_seq = g_browser_tcp_seq + advance;
}

fn browser_tcp_segment(rx: u64, length: u32) -> u64 {
    if length < 54 || eth_type(rx) != ETH_IP { return 0; }
    let ip: u64 = eth_payload(rx);
    let ihl: u32 = ip_ihl_bytes(ip); let total: u32 = ip_total_len(ip) as u32;
    if (*((ip + 0) as *u8) >> 4) != 4 || !browser_tcp_lengths_valid(length, ihl, total, 20) { return 0; }
    let fragment: u32 = ((*((ip + 6) as *u8) as u32) << 8) | (*((ip + 7) as *u8) as u32);
    if (fragment & 0x3fff) != 0 || ip_proto(ip) != IP_PROTO_TCP
        || !ip4_eq(ip_src(ip), &g_browser_net_ip as u64) || !ip4_eq(ip_dst(ip), net_our_ip()) { return 0; }
    let tcp: u64 = ip + (ihl as u64); let tcp_header: u32 = tcp_header_len(tcp);
    if !browser_tcp_lengths_valid(length, ihl, total, tcp_header) { return 0; }
    if tcp_dst_port(tcp) != g_browser_tcp_source_port || tcp_src_port(tcp) != g_browser_net_port { return 0; }
    return tcp;
}

fn browser_tcp_lengths_valid(frame_length: u32, ihl: u32, total: u32, tcp_header: u32) -> bool {
    if frame_length < 14 || ihl < 20 || ihl > 60 || (ihl & 3) != 0 || total < ihl
        || total > frame_length - 14 || tcp_header < 20 || (tcp_header & 3) != 0 { return false; }
    return tcp_header <= total - ihl;
}

fn browser_tcp_connect() -> bool {
    g_browser_tcp_nonce = g_browser_tcp_nonce + 1;
    g_browser_tcp_source_port = (49152 + ((g_ticks + g_browser_tcp_nonce) % 4096)) as u16;
    g_browser_tcp_seq = 0x76000000 + g_ticks + g_browser_tcp_nonce * 4099; g_browser_tcp_ack = 0;
    browser_tcp_send(TCP_SYN, 0, 0);
    for spin: u32 in 0..16000000 {
        let n: u32 = rtl_poll_rx(&g_net_rx as u64);
        if n > 0 {
            let rx: u64 = &g_net_rx as u64; browser_net_aux(rx, n);
            let tcp: u64 = browser_tcp_segment(rx, n);
            if tcp != 0 {
                let flags: u8 = tcp_flags(tcp);
                if (flags & TCP_RST) != 0 { browser_set_status("Connection refused"); return false; }
                if (flags & (TCP_SYN | TCP_ACK)) == (TCP_SYN | TCP_ACK) && tcp_ack(tcp) == g_browser_tcp_seq {
                    g_browser_tcp_ack = tcp_seq(tcp) + 1; browser_tcp_send(TCP_ACK, 0, 0); return true;
                }
            }
        }
    }
    browser_set_status("TCP connection timed out"); return false;
}

fn browser_tcp_receive() -> bool {
    g_browser_http_raw_len = 0; let received: bool = false; let idle: u32 = 0;
    while idle < 10000000 {
        let n: u32 = rtl_poll_rx(&g_net_rx as u64);
        if n == 0 {
            idle = idle + 1;
            if received && idle > 1500000 { return true; }
        } else {
            idle = 0; let rx: u64 = &g_net_rx as u64; browser_net_aux(rx, n);
            let tcp: u64 = browser_tcp_segment(rx, n);
            if tcp != 0 {
                let flags: u8 = tcp_flags(tcp); if (flags & TCP_RST) != 0 { return false; }
                let ip: u64 = eth_payload(rx); let header: u32 = tcp_header_len(tcp);
                let payload_len: u32 = (ip_total_len(ip) as u32) - ip_ihl_bytes(ip) - header;
                let their_seq: u32 = tcp_seq(tcp);
                if payload_len > 0 && their_seq == g_browser_tcp_ack {
                    if g_browser_http_raw_len > 12287 { return false; }
                    let take: u32 = payload_len;
                    let remaining: u32 = 12287 - g_browser_http_raw_len;
                    if take > remaining { take = remaining; }
                    for i: u32 in 0..take {
                        g_browser_http_raw[g_browser_http_raw_len + i] = *((tcp + (header as u64) + (i as u64)) as *u8);
                    }
                    g_browser_http_raw_len = g_browser_http_raw_len + take;
                    g_browser_tcp_ack = g_browser_tcp_ack + payload_len; received = true;
                    browser_tcp_send(TCP_ACK, 0, 0);
                } else if payload_len > 0 && their_seq < g_browser_tcp_ack { browser_tcp_send(TCP_ACK, 0, 0); }
                if (flags & TCP_FIN) != 0 {
                    let fin_seq: u32 = their_seq + payload_len;
                    if fin_seq == g_browser_tcp_ack { g_browser_tcp_ack = g_browser_tcp_ack + 1; }
                    browser_tcp_send(TCP_ACK, 0, 0); return received;
                }
            }
        }
    }
    return received;
}

fn browser_tls_stream_reset() { g_browser_tls_stream_len = 0; g_browser_tls_peer_closed = false; }

fn browser_tls_transcript_reset() { g_browser_tls_transcript_len = 0; }

fn browser_tls_transcript_append(input: u64, length: u32) -> bool {
    if length > 65536 - g_browser_tls_transcript_len { return false; }
    for i: u32 in 0..length {
        g_browser_tls_transcript[g_browser_tls_transcript_len + i] = *((input + (i as u64)) as *u8);
    }
    g_browser_tls_transcript_len = g_browser_tls_transcript_len + length; return true;
}

fn browser_tls_transcript_hash(output: u64) {
    tls_sha256(&g_browser_tls_transcript as u64, g_browser_tls_transcript_len, output);
}

fn browser_tls_receive_record() -> u32 {
    let idle: u32 = 0;
    while idle < 12000000 {
        if g_browser_tls_stream_len >= 5 {
            let encrypted_length: u32 = tls13_read_u16(&g_browser_tls_stream as u64, 3);
            if encrypted_length > 16640 { return 0; }
            let record_length: u32 = encrypted_length + 5;
            if record_length > 16645 { return 0; }
            if g_browser_tls_stream_len >= record_length {
                for i: u32 in 0..record_length { g_browser_tls_record[i] = g_browser_tls_stream[i]; }
                let remaining: u32 = g_browser_tls_stream_len - record_length;
                for i: u32 in 0..remaining { g_browser_tls_stream[i] = g_browser_tls_stream[record_length + i]; }
                g_browser_tls_stream_len = remaining; return record_length;
            }
        }
        if g_browser_tls_peer_closed { return 0; }
        let n: u32 = rtl_poll_rx(&g_net_rx as u64);
        if n == 0 { idle = idle + 1; }
        else {
            idle = 0; let rx: u64 = &g_net_rx as u64; browser_net_aux(rx, n);
            let tcp: u64 = browser_tcp_segment(rx, n);
            if tcp != 0 {
                let flags: u8 = tcp_flags(tcp); if (flags & TCP_RST) != 0 { return 0; }
                let ip: u64 = eth_payload(rx); let header: u32 = tcp_header_len(tcp);
                let payload_length: u32 = (ip_total_len(ip) as u32) - ip_ihl_bytes(ip) - header;
                let their_sequence: u32 = tcp_seq(tcp);
                if payload_length > 0 && their_sequence == g_browser_tcp_ack {
                    if payload_length > 32768 - g_browser_tls_stream_len { return 0; }
                    for i: u32 in 0..payload_length {
                        g_browser_tls_stream[g_browser_tls_stream_len + i] =
                            *((tcp + (header as u64) + (i as u64)) as *u8);
                    }
                    g_browser_tls_stream_len = g_browser_tls_stream_len + payload_length;
                    g_browser_tcp_ack = g_browser_tcp_ack + payload_length; browser_tcp_send(TCP_ACK, 0, 0);
                } else if payload_length > 0 && their_sequence < g_browser_tcp_ack {
                    browser_tcp_send(TCP_ACK, 0, 0);
                }
                if (flags & TCP_FIN) != 0 {
                    let fin_sequence: u32 = their_sequence + payload_length;
                    if fin_sequence == g_browser_tcp_ack { g_browser_tcp_ack = g_browser_tcp_ack + 1; }
                    browser_tcp_send(TCP_ACK, 0, 0); g_browser_tls_peer_closed = true;
                }
            }
        }
    }
    return 0;
}

fn browser_tls_leaf_rsa(message: u64, message_length: u32,
                        modulus: u64, modulus_length: u64, exponent: u64) -> bool {
    let certificate_offset: u32 = 0; let certificate_length: u32 = 0;
    if !tls13_parse_certificate_message(message, message_length,
        &certificate_offset as u64, &certificate_length as u64) { return false; }
    let certificate: u64 = message + (certificate_offset as u64);
    let tbs_offset: u32 = 0; let tbs_length: u32 = 0;
    let signature_offset: u32 = 0; let signature_length: u32 = 0;
    if !tls_x509_certificate_shape(certificate, certificate_length,
        &tbs_offset as u64, &tbs_length as u64,
        &signature_offset as u64, &signature_length as u64) { return false; }
    let validity_offset: u32 = 0; let validity_length: u32 = 0;
    let spki_offset: u32 = 0; let spki_length: u32 = 0;
    let extensions_offset: u32 = 0; let extensions_length: u32 = 0;
    if !tls_x509_tbs_fields(certificate, tbs_offset, tbs_length,
        &validity_offset as u64, &validity_length as u64,
        &spki_offset as u64, &spki_length as u64,
        &extensions_offset as u64, &extensions_length as u64) { return false; }
    let not_before: u64 = 0; let not_after: u64 = 0; let now: u64 = 0;
    if !tls_x509_parse_validity(certificate + (validity_offset as u64), validity_length,
        &not_before as u64, &not_after as u64) || !tls_x509_rtc_snapshot(&now as u64)
        || !tls_x509_valid_at(not_before, not_after, now) { return false; }
    let modulus_offset: u32 = 0; let found_length: u32 = 0; let found_exponent: u32 = 0;
    if !tls_x509_spki_rsa(certificate + (spki_offset as u64), spki_length,
        &modulus_offset as u64, &found_length as u64, &found_exponent as u64)
        || found_length > 512 { return false; }
    for i: u32 in 0..found_length {
        *((modulus + (i as u64)) as *u8) =
            *((certificate + ((spki_offset + modulus_offset + i) as u64)) as *u8);
    }
    let certificate_count: u32 = tls13_certificate_count(message, message_length);
    if certificate_count == 0 { return false; }
    let chain_now: u64 = 0;
    if !tls_x509_rtc_snapshot(&chain_now as u64) { return false; }
    for index: u32 in 0..certificate_count {
        let current_offset: u32 = 0; let current_length: u32 = 0;
        if !tls13_certificate_at(message, message_length, index,
            &current_offset as u64, &current_length as u64) { return false; }
        let current: u64 = message + (current_offset as u64);
        let current_tbs_offset: u32 = 0; let current_tbs_length: u32 = 0;
        let current_signature_offset: u32 = 0; let current_signature_length: u32 = 0;
        let current_validity_offset: u32 = 0; let current_validity_length: u32 = 0;
        let current_spki_offset: u32 = 0; let current_spki_length: u32 = 0;
        let current_extensions_offset: u32 = 0; let current_extensions_length: u32 = 0;
        let current_not_before: u64 = 0; let current_not_after: u64 = 0;
        if !tls_x509_certificate_shape(current, current_length,
            &current_tbs_offset as u64, &current_tbs_length as u64,
            &current_signature_offset as u64, &current_signature_length as u64)
            || !tls_x509_tbs_fields(current, current_tbs_offset, current_tbs_length,
                &current_validity_offset as u64, &current_validity_length as u64,
                &current_spki_offset as u64, &current_spki_length as u64,
                &current_extensions_offset as u64, &current_extensions_length as u64)
            || !tls_x509_parse_validity(current + (current_validity_offset as u64),
                current_validity_length, &current_not_before as u64, &current_not_after as u64)
            || !tls_x509_valid_at(current_not_before, current_not_after, chain_now) { return false; }
        if index + 1 < certificate_count {
            let issuer_offset: u32 = 0; let issuer_length: u32 = 0;
            if !tls13_certificate_at(message, message_length, index + 1,
                &issuer_offset as u64, &issuer_length as u64)
                || !tls_x509_verify_rsa_issuer(current, current_length,
                    message + (issuer_offset as u64), issuer_length) { return false; }
        } else {
            tls_sha256(current, current_length, &g_browser_tls_leaf_fingerprint as u64);
        }
    }
    *((modulus_length) as *u32) = found_length;
    *((exponent) as *u32) = found_exponent; return true;
}

fn browser_tls_receive_server_flight(server_key: u64, server_iv: u64,
                                     server_traffic: u64) -> bool {
    let sequence: u64 = 0; let expected_type: u8 = 8;
    let modulus: [u8; 512] = [0; 512]; let modulus_length: u32 = 0; let exponent: u32 = 0;
    tls13_handshake_reset();
    for attempt: u32 in 0..16 {
        let record_length: u32 = browser_tls_receive_record();
        if record_length == 0 { return false; }
        // TLS 1.3 servers may send one unencrypted compatibility CCS after
        // ServerHello. It is not part of the transcript or record sequence.
        if g_browser_tls_record[0] == 20 {
            if record_length != 6 || g_browser_tls_record[1] != 3 || g_browser_tls_record[2] != 3
                || g_browser_tls_record[3] != 0 || g_browser_tls_record[4] != 1
                || g_browser_tls_record[5] != 1 { return false; }
        } else {
            let content_type: u8 = 0;
            let plaintext_length: u32 = tls13_decrypt_record(
                server_key, server_iv, sequence, &g_browser_tls_record as u64, record_length,
                &g_browser_tls_plaintext as u64, 16624, &content_type as u64);
            if plaintext_length == 0xffffffff || content_type != 22 {
                browser_zero(&g_browser_tls_plaintext as u64, 16624); return false;
            }
            let fed: bool = tls13_handshake_feed(&g_browser_tls_plaintext as u64, plaintext_length);
            browser_zero(&g_browser_tls_plaintext as u64, 16624);
            if !fed { return false; }
            sequence = sequence + 1;
            while tls13_handshake_ready() {
                let message: u64 = &g_tls13_handshake_reassembly as u64;
                let message_length: u32 = tls13_handshake_size();
                if tls13_handshake_type() != expected_type { return false; }
                if expected_type == 8 {
                    if message_length < 6 || tls13_read_u16(message, 4) != message_length - 6 { return false; }
                    if !browser_tls_transcript_append(message, message_length) { return false; }
                    expected_type = 11; g_browser_tls_probe_stage = 7;
                } else if expected_type == 11 {
                    if !browser_tls_leaf_rsa(message, message_length, &modulus as u64,
                        &modulus_length as u64, &exponent as u64)
                        || !browser_tls_transcript_append(message, message_length) { return false; }
                    expected_type = 15;
                } else if expected_type == 15 {
                    let transcript_hash: [u8; 32] = [0; 32]; browser_tls_transcript_hash(&transcript_hash as u64);
                    if !tls13_verify_rsa_certificate_verify(message, message_length,
                        &transcript_hash as u64, &modulus as u64, modulus_length, exponent)
                        || !browser_tls_transcript_append(message, message_length) { return false; }
                    expected_type = 20;
                } else {
                    let transcript_hash: [u8; 32] = [0; 32]; browser_tls_transcript_hash(&transcript_hash as u64);
                    if message_length != 36 || !tls13_finished_verify(
                        server_traffic, &transcript_hash as u64, message + 4)
                        || !browser_tls_transcript_append(message, message_length) { return false; }
                    tls13_handshake_consume(); browser_zero(&modulus as u64, 512); return true;
                }
                if !tls13_handshake_consume() { return false; }
            }
        }
    }
    return false;
}

fn browser_network_open(url: u64, secure: bool) -> bool {
    if !browser_parse_url(url) || g_browser_net_secure != secure {
        browser_set_status("Address scheme does not match transport"); return false;
    }
    if !g_net_up {
        browser_set_status("Requesting a DHCP lease"); browser_draw();
        g_net_quiet = true; let up: bool = net_dhcp(); g_net_quiet = false;
        if !up { browser_set_status("Network unavailable: DHCP failed"); return false; }
    }
    browser_set_status("Resolving host name"); browser_draw();
    if !browser_dns_resolve(&g_browser_net_host as u64, &g_browser_net_ip as u64) { return false; }
    let arp_ip: u64 = browser_route_ip(&g_browser_net_ip as u64);
    if arp_ip == 0 { browser_set_status("DHCP did not provide a default gateway"); return false; }
    browser_set_status("Resolving Ethernet route"); browser_draw();
    if !browser_arp_resolve(arp_ip, &g_browser_net_mac as u64) {
        browser_set_status("Gateway ARP timed out"); return false;
    }
    browser_set_status("Opening TCP connection"); browser_draw();
    return browser_tcp_connect();
}

fn browser_tls_finish_client(handshake_secret: u64, client_traffic: u64,
                             client_key: u64, client_iv: u64) -> bool {
    let transcript_hash: [u8; 32] = [0; 32]; browser_tls_transcript_hash(&transcript_hash as u64);
    let master_secret: [u8; 32] = [0; 32];
    let client_app: [u8; 32] = [0; 32]; let server_app: [u8; 32] = [0; 32];
    let finished: [u8; 32] = [0; 32];
    let ok: bool = tls13_master_secret(handshake_secret, &master_secret as u64)
        && tls13_application_traffic(&master_secret as u64, &transcript_hash as u64,
                                     &client_app as u64, &server_app as u64)
        && tls13_traffic_key(&client_app as u64, &g_browser_tls_client_app_key as u64,
                             32, &g_browser_tls_client_app_iv as u64)
        && tls13_traffic_key(&server_app as u64, &g_browser_tls_server_app_key as u64,
                             32, &g_browser_tls_server_app_iv as u64)
        && tls13_finished_calculate(client_traffic, &transcript_hash as u64, &finished as u64);
    if !ok {
        for i: u32 in 0..32 {
            master_secret[i] = 0; client_app[i] = 0; server_app[i] = 0; finished[i] = 0;
        }
        browser_tls_application_clear(); return false;
    }
    let message: [u8; 36] = [0; 36]; message[0] = 20; message[3] = 32;
    for i: u32 in 0..32 { message[4 + i] = finished[i]; }
    let record: [u8; 64] = [0; 64];
    let record_length: u32 = tls13_encrypt_record(
        client_key, client_iv, 0, &message as u64, 36, 22, 0, &record as u64, 64);
    if record_length == 0 || !browser_tls_transcript_append(&message as u64, 36) {
        for i: u32 in 0..32 {
            master_secret[i] = 0; client_app[i] = 0; server_app[i] = 0; finished[i] = 0;
        }
        browser_tls_application_clear(); return false;
    }
    browser_tcp_send(TCP_PSH | TCP_ACK, &record as u64, record_length);
    g_browser_tls_client_app_sequence = 0; g_browser_tls_server_app_sequence = 0;
    for i: u32 in 0..32 {
        master_secret[i] = 0; client_app[i] = 0; server_app[i] = 0; finished[i] = 0;
    }
    g_browser_tls_application_ready = true; return true;
}

fn browser_http_build_request() -> u32 {
    browser_zero(&g_browser_http_request as u64, 384); let req: u32 = 0;
    req = browser_request_append(req, "GET " as u64);
    req = browser_request_append(req, &g_browser_net_path as u64);
    req = browser_request_append(req, " HTTP/1.0\r\nHost: " as u64);
    req = browser_request_append(req, &g_browser_net_host as u64);
    req = browser_request_append(req,
        "\r\nUser-Agent: MortOS-Vex/1.0\r\nAccept: text/html,text/plain\r\nConnection: close\r\n\r\n" as u64);
    return req;
}

fn browser_tls_http_receive() -> bool {
    g_browser_http_raw_len = 0; tls13_handshake_reset();
    for record_count: u32 in 0..64 {
        let record_length: u32 = browser_tls_receive_record();
        if record_length == 0 { return g_browser_http_raw_len > 0; }
        let content_type: u8 = 0;
        let plaintext_length: u32 = tls13_decrypt_record(
            &g_browser_tls_server_app_key as u64, &g_browser_tls_server_app_iv as u64,
            g_browser_tls_server_app_sequence, &g_browser_tls_record as u64, record_length,
            &g_browser_tls_plaintext as u64, 16624, &content_type as u64);
        if plaintext_length == 0xffffffff {
            browser_zero(&g_browser_tls_plaintext as u64, 16624); return false;
        }
        g_browser_tls_server_app_sequence = g_browser_tls_server_app_sequence + 1;
        if content_type == 22 {
            if !tls13_handshake_feed(&g_browser_tls_plaintext as u64, plaintext_length) {
                browser_zero(&g_browser_tls_plaintext as u64, 16624); return false;
            }
            while tls13_handshake_ready() {
                if tls13_handshake_type() != 4 || !tls13_handshake_consume() {
                    browser_zero(&g_browser_tls_plaintext as u64, 16624); return false;
                }
            }
        } else if content_type == 23 {
            if plaintext_length > 12287 - g_browser_http_raw_len {
                browser_zero(&g_browser_tls_plaintext as u64, 16624); return false;
            }
            for i: u32 in 0..plaintext_length {
                g_browser_http_raw[g_browser_http_raw_len + i] = g_browser_tls_plaintext[i];
            }
            g_browser_http_raw_len = g_browser_http_raw_len + plaintext_length;
            g_browser_http_raw[g_browser_http_raw_len] = 0;
        } else if content_type == 21 {
            browser_zero(&g_browser_tls_plaintext as u64, 16624);
            return g_browser_http_raw_len > 0;
        } else {
            browser_zero(&g_browser_tls_plaintext as u64, 16624); return false;
        }
        browser_zero(&g_browser_tls_plaintext as u64, 16624);
    }
    return false;
}

fn browser_tls_http_exchange() -> bool {
    if !g_browser_tls_application_ready { return false; }
    let request_length: u32 = browser_http_build_request();
    let record: [u8; 512] = [0; 512];
    let record_length: u32 = tls13_encrypt_record(
        &g_browser_tls_client_app_key as u64, &g_browser_tls_client_app_iv as u64,
        g_browser_tls_client_app_sequence, &g_browser_http_request as u64, request_length,
        23, 0, &record as u64, 512);
    if record_length == 0 { return false; }
    browser_tcp_send(TCP_PSH | TCP_ACK, &record as u64, record_length);
    g_browser_tls_client_app_sequence = g_browser_tls_client_app_sequence + 1;
    browser_set_status("Downloading authenticated HTTPS response"); browser_draw();
    return browser_tls_http_receive() && browser_http_parse();
}

fn browser_tls_probe(url: u64) -> bool {
    g_browser_tls_probe_ok = false; g_browser_tls_probe_stage = 0;
    g_browser_tls_pending = false; g_browser_tls_pin_matched = false;
    g_browser_tls_http_ok = false;
    browser_tls_application_clear();
    browser_zero(&g_browser_tls_probe_server_key as u64, 32);
    browser_zero(&g_browser_tls_leaf_fingerprint as u64, 32);
    if !g_tls_entropy_ready { g_browser_tls_probe_stage = 101; return false; }
    if !g_tls_crypto_aead_ok { g_browser_tls_probe_stage = 102; return false; }
    if !g_tls_crypto_x25519_ok { g_browser_tls_probe_stage = 103; return false; }
    if !g_tls13_client_hello_ok { g_browser_tls_probe_stage = 104; return false; }
    g_browser_tls_probe_stage = 110;
    if !browser_network_open(url, true) { return false; }
    g_browser_tls_probe_stage = 1;
    let private_key: [u8; 32] = [0; 32]; let public_key: [u8; 32] = [0; 32];
    let random: [u8; 32] = [0; 32]; let basepoint: [u8; 32] = [0; 32]; basepoint[0] = 9;
    if !tls_entropy_fill(&private_key as u64, 32) || !tls_entropy_fill(&random as u64, 32) { return false; }
    g_browser_tls_probe_stage = 2;
    tls_x25519(&private_key as u64, &basepoint as u64, &public_key as u64);
    let hello: [u8; 512] = [0; 512];
    let hello_length: u32 = tls13_build_client_hello(
        &g_browser_net_host as u64, str_len(&g_browser_net_host as *u8),
        &random as u64, &public_key as u64, &hello as u64, 512);
    if hello_length == 0 { browser_zero(&private_key as u64, 32); return false; }
    g_browser_tls_probe_stage = 3;
    browser_tls_stream_reset(); browser_set_status("Negotiating TLS 1.3"); browser_draw();
    browser_tcp_send(TCP_PSH | TCP_ACK, &hello as u64, hello_length);
    let server_record_length: u32 = browser_tls_receive_record();
    if server_record_length > 0 { g_browser_tls_probe_stage = 4; }
    if server_record_length == 0 || !tls13_parse_server_hello(
        &g_browser_tls_record as u64, server_record_length, 0x1303,
        &g_browser_tls_probe_server_key as u64) {
        browser_zero(&private_key as u64, 32); return false;
    }
    if hello_length < 5 || server_record_length < 5 {
        browser_zero(&private_key as u64, 32); return false;
    }
    g_browser_tls_probe_stage = 5;
    browser_tls_transcript_reset();
    if !browser_tls_transcript_append(&hello as u64 + 5, hello_length - 5)
        || !browser_tls_transcript_append(&g_browser_tls_record as u64 + 5, server_record_length - 5) {
        browser_zero(&private_key as u64, 32); return false;
    }
    let transcript_hash: [u8; 32] = [0; 32]; let handshake_secret: [u8; 32] = [0; 32];
    let client_traffic: [u8; 32] = [0; 32]; let server_traffic: [u8; 32] = [0; 32];
    let client_key: [u8; 32] = [0; 32]; let server_key: [u8; 32] = [0; 32];
    let client_iv: [u8; 12] = [0; 12]; let server_iv: [u8; 12] = [0; 12];
    browser_tls_transcript_hash(&transcript_hash as u64);
    let derived: bool = tls13_handshake_secret(
        &private_key as u64, &g_browser_tls_probe_server_key as u64, &handshake_secret as u64)
        && tls13_handshake_traffic(&handshake_secret as u64, &transcript_hash as u64,
                                   &client_traffic as u64, &server_traffic as u64)
        && tls13_traffic_key(&client_traffic as u64, &client_key as u64, 32, &client_iv as u64)
        && tls13_traffic_key(&server_traffic as u64, &server_key as u64, 32, &server_iv as u64);
    if derived { g_browser_tls_probe_stage = 6; }
    let server_flight_ok: bool = false;
    if derived {
        server_flight_ok = browser_tls_receive_server_flight(
            &server_key as u64, &server_iv as u64, &server_traffic as u64);
        if server_flight_ok { g_browser_tls_probe_stage = 8; }
    }
    g_browser_tls_probe_ok = derived && server_flight_ok;
    if g_browser_tls_probe_ok {
        g_browser_tls_pin_matched = browser_pin_matches(
            &g_browser_net_host as u64, g_browser_net_port, &g_browser_tls_leaf_fingerprint as u64);
        if g_browser_tls_pin_matched {
            if browser_tls_finish_client(&handshake_secret as u64, &client_traffic as u64,
                                         &client_key as u64, &client_iv as u64) {
                g_browser_tls_probe_stage = 9;
                g_browser_tls_http_ok = browser_tls_http_exchange();
                if g_browser_tls_http_ok { g_browser_tls_probe_stage = 10; }
                browser_tls_application_clear();
            } else { g_browser_tls_probe_ok = false; }
        } else {
            browser_zero(&g_browser_tls_pending_host as u64, 64);
            browser_copy(&g_browser_tls_pending_host as u64, &g_browser_net_host as u64, 64);
            g_browser_tls_pending_port = g_browser_net_port; g_browser_tls_pending = true;
            browser_tcp_send(TCP_FIN | TCP_ACK, 0, 0);
        }
    }
    for i: u32 in 0..32 {
        private_key[i] = 0; handshake_secret[i] = 0; client_traffic[i] = 0; server_traffic[i] = 0;
        client_key[i] = 0; server_key[i] = 0;
    }
    for i: u32 in 0..12 { client_iv[i] = 0; server_iv[i] = 0; }
    return g_browser_tls_probe_ok;
}

fn browser_text_newline() {
    if g_browser_content_len == 0 || g_browser_content[g_browser_content_len - 1] != 10 {
        if g_browser_content_len < 8191 { g_browser_content[g_browser_content_len] = 10; g_browser_content_len = g_browser_content_len + 1; }
    }
}

fn browser_text_char(ch: u8, col: u32) -> u32 {
    let next: u32 = col;
    if ch == 10 { browser_text_newline(); return 0; }
    if ch == 32 || ch == 9 || ch == 13 {
        if g_browser_content_len > 0 && g_browser_content[g_browser_content_len - 1] != 32
            && g_browser_content[g_browser_content_len - 1] != 10 {
            if g_browser_content_len < 8191 { g_browser_content[g_browser_content_len] = 32; g_browser_content_len = g_browser_content_len + 1; next = next + 1; }
        }
        return next;
    }
    if next >= 72 { browser_text_newline(); next = 0; }
    if g_browser_content_len < 8191 { g_browser_content[g_browser_content_len] = ch; g_browser_content_len = g_browser_content_len + 1; next = next + 1; }
    return next;
}

fn browser_extract_title(body: u32) {
    browser_set_title("HTTP document"); let pos: u32 = body;
    while pos + 7 < g_browser_http_raw_len {
        if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<title>" as u64) {
            pos = pos + 7; let out: u32 = 0; browser_zero(&g_browser_title as u64, 40);
            while pos < g_browser_http_raw_len && g_browser_http_raw[pos] != 60 && out < 38 {
                let ch: u8 = g_browser_http_raw[pos]; if ch >= 32 { g_browser_title[out] = ch; out = out + 1; }
                pos = pos + 1;
            }
            g_browser_title[out] = 0; return;
        }
        pos = pos + 1;
    }
}

fn browser_extract_link(tag: u32) {
    let pos: u32 = tag; let end: u32 = tag;
    while end < g_browser_http_raw_len && g_browser_http_raw[end] != 62 { end = end + 1; }
    while pos + 4 < end {
        if browser_match_ci(&g_browser_http_raw as u64, pos, end, "href" as u64) {
            pos = pos + 4;
            while pos < end && (g_browser_http_raw[pos] == 32 || g_browser_http_raw[pos] == 9) { pos = pos + 1; }
            if pos < end && g_browser_http_raw[pos] == 61 { pos = pos + 1; }
            while pos < end && (g_browser_http_raw[pos] == 32 || g_browser_http_raw[pos] == 9) { pos = pos + 1; }
            let quote: u8 = 0;
            if pos < end && (g_browser_http_raw[pos] == 34 || g_browser_http_raw[pos] == 39) { quote = g_browser_http_raw[pos]; pos = pos + 1; }
            let start: u32 = pos;
            while pos < end && ((quote != 0 && g_browser_http_raw[pos] != quote)
                || (quote == 0 && g_browser_http_raw[pos] != 32 && g_browser_http_raw[pos] != 9)) { pos = pos + 1; }
            browser_link_add(&g_browser_http_raw as u64 + (start as u64), pos - start); return;
        }
        pos = pos + 1;
    }
}

fn browser_http_to_text(body: u32) {
    browser_zero(&g_browser_content as u64, 8192); g_browser_content_len = 0;
    browser_links_reset(); browser_extract_title(body); let pos: u32 = body; let col: u32 = 0;
    while pos < g_browser_http_raw_len && g_browser_content_len < 8190 {
        if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<script" as u64) {
            while pos < g_browser_http_raw_len && !browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "</script>" as u64) { pos = pos + 1; }
            if pos < g_browser_http_raw_len { pos = pos + 9; }
        } else if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<style" as u64) {
            while pos < g_browser_http_raw_len && !browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "</style>" as u64) { pos = pos + 1; }
            if pos < g_browser_http_raw_len { pos = pos + 8; }
        } else if g_browser_http_raw[pos] == 60 {
            if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<a " as u64) {
                browser_extract_link(pos);
                if g_browser_link_count > 0 {
                    col = browser_text_char(91, col); // [n]
                    let digit: u8 = (48 + g_browser_link_count) as u8; col = browser_text_char(digit, col);
                    col = browser_text_char(93, col); col = browser_text_char(32, col);
                }
            }
            if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<p" as u64)
                || browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "</p" as u64)
                || browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<br" as u64)
                || browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<div" as u64)
                || browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<h" as u64)
                || browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "<li" as u64) {
                browser_text_newline(); col = 0;
            }
            while pos < g_browser_http_raw_len && g_browser_http_raw[pos] != 62 { pos = pos + 1; }
            if pos < g_browser_http_raw_len { pos = pos + 1; }
        } else if g_browser_http_raw[pos] == 38 {
            if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "&amp;" as u64) { col = browser_text_char(38, col); pos = pos + 5; }
            else if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "&lt;" as u64) { col = browser_text_char(60, col); pos = pos + 4; }
            else if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "&gt;" as u64) { col = browser_text_char(62, col); pos = pos + 4; }
            else if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "&nbsp;" as u64) { col = browser_text_char(32, col); pos = pos + 6; }
            else if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "&quot;" as u64) { col = browser_text_char(34, col); pos = pos + 6; }
            else { col = browser_text_char(38, col); pos = pos + 1; }
        } else { col = browser_text_char(g_browser_http_raw[pos], col); pos = pos + 1; }
    }
    if g_browser_content_len < 8192 { g_browser_content[g_browser_content_len] = 0; }
}

fn browser_header_line_contains(body: u32, header: u64, value: u64) -> bool {
    let pos: u32 = 0;
    while pos < body {
        if browser_match_ci(&g_browser_http_raw as u64, pos, body, header) {
            let end: u32 = pos;
            while end < body && g_browser_http_raw[end] != 10 { end = end + 1; }
            let scan: u32 = pos;
            while scan < end {
                if browser_match_ci(&g_browser_http_raw as u64, scan, end, value) { return true; }
                scan = scan + 1;
            }
            return false;
        }
        pos = pos + 1;
    }
    return false;
}

fn browser_content_kind(body: u32) -> u32 {
    let pos: u32 = 0; let found: bool = false;
    while pos + 13 < body {
        if browser_match_ci(&g_browser_http_raw as u64, pos, body, "content-type:" as u64) { found = true; break; }
        pos = pos + 1;
    }
    if !found { return 0; } // HTTP/0.9-style and minimal servers default to HTML.
    if browser_header_line_contains(body, "content-type:" as u64, "text/plain" as u64) { return 1; }
    if browser_header_line_contains(body, "content-type:" as u64, "text/html" as u64)
        || browser_header_line_contains(body, "content-type:" as u64, "application/xhtml+xml" as u64) { return 0; }
    return 2;
}

fn browser_plain_to_text(body: u32) {
    browser_zero(&g_browser_content as u64, 8192); g_browser_content_len = 0;
    browser_links_reset(); browser_set_title("Text document"); let pos: u32 = body; let col: u32 = 0;
    while pos < g_browser_http_raw_len && g_browser_content_len < 8190 {
        let ch: u8 = g_browser_http_raw[pos];
        if ch != 13 { col = browser_text_char(ch, col); }
        pos = pos + 1;
    }
    if g_browser_content_len < 8192 { g_browser_content[g_browser_content_len] = 0; }
}

fn browser_hex_digit(ch: u8) -> u32 {
    if ch >= 48 && ch <= 57 { return (ch - 48) as u32; }
    let lower: u8 = browser_net_lower(ch);
    if lower >= 97 && lower <= 102 { return (lower - 97 + 10) as u32; }
    return 16;
}

fn browser_chunk_size_add(current: u32, digit: u32) -> u32 {
    if digit >= 16 || current > (12287 - digit) / 16 { return 0xffffffff; }
    return current * 16 + digit;
}

fn browser_headers_chunked(body: u32) -> bool {
    let pos: u32 = 0;
    while pos + 18 < body {
        if browser_match_ci(&g_browser_http_raw as u64, pos, body, "transfer-encoding:" as u64) {
            let end: u32 = pos;
            while end < body && g_browser_http_raw[end] != 10 { end = end + 1; }
            let scan: u32 = pos + 18;
            while scan + 7 <= end {
                if browser_match_ci(&g_browser_http_raw as u64, scan, end, "chunked" as u64) { return true; }
                scan = scan + 1;
            }
            return false;
        }
        pos = pos + 1;
    }
    return false;
}

fn browser_decode_chunked(body: u32) -> bool {
    if body > 12287 || body > g_browser_http_raw_len { browser_set_status("Invalid chunked HTTP body"); return false; }
    let read: u32 = body; let write: u32 = body;
    while read < g_browser_http_raw_len {
        let size: u32 = 0; let digits: u32 = 0;
        while read < g_browser_http_raw_len && g_browser_http_raw[read] != 13 && g_browser_http_raw[read] != 10 {
            if g_browser_http_raw[read] == 59 { // optional chunk extension
                while read < g_browser_http_raw_len && g_browser_http_raw[read] != 13 && g_browser_http_raw[read] != 10 { read = read + 1; }
                break;
            }
            let digit: u32 = browser_hex_digit(g_browser_http_raw[read]);
            if digit >= 16 { browser_set_status("Invalid chunked HTTP response"); return false; }
            let next_size: u32 = browser_chunk_size_add(size, digit);
            if next_size == 0xffffffff { browser_set_status("HTTP chunk exceeds receive limit"); return false; }
            size = next_size; digits = digits + 1; read = read + 1;
        }
        if digits == 0 { browser_set_status("Invalid chunked HTTP response"); return false; }
        if read < g_browser_http_raw_len && g_browser_http_raw[read] == 13 { read = read + 1; }
        if read >= g_browser_http_raw_len || g_browser_http_raw[read] != 10 { browser_set_status("Incomplete chunk header"); return false; }
        read = read + 1;
        if size == 0 { g_browser_http_raw_len = write; g_browser_http_raw[write] = 0; return true; }
        let available: u32 = g_browser_http_raw_len - read;
        if size > available { browser_set_status("Incomplete chunked HTTP body"); return false; }
        if write > 12287 || size > 12287 - write { browser_set_status("Decoded HTTP body exceeds receive limit"); return false; }
        for i: u32 in 0..size { g_browser_http_raw[write + i] = g_browser_http_raw[read + i]; }
        write = write + size; read = read + size;
        if read < g_browser_http_raw_len && g_browser_http_raw[read] == 13 { read = read + 1; }
        if read >= g_browser_http_raw_len || g_browser_http_raw[read] != 10 { browser_set_status("Invalid chunk boundary"); return false; }
        read = read + 1;
    }
    browser_set_status("Chunked HTTP body ended early"); return false;
}

fn input_bounds_self_test() {
    let chunk_ok: bool = browser_chunk_size_add(0x2ff, 0xf) == 0x2fff
        && browser_chunk_size_add(0x300, 0) == 0xffffffff
        && browser_chunk_size_add(0xffffffff, 0xf) == 0xffffffff;
    let tcp_ok: bool = browser_tcp_lengths_valid(54, 20, 40, 20)
        && !browser_tcp_lengths_valid(54, 20, 19, 20)
        && !browser_tcp_lengths_valid(54, 20, 41, 20)
        && !browser_tcp_lengths_valid(54, 20, 40, 24);
    let history_ok: bool = browser_history_state_valid(0, 0, 0)
        && browser_history_state_valid(6, 5, 4)
        && !browser_history_state_valid(1, 255, 0);
    let usb_ok: bool = usb_descriptor_fits(9, 9, 18)
        && !usb_descriptor_fits(60, 9, 64);
    g_input_bounds_ok = chunk_ok && tcp_ok && history_ok && usb_ok;
}

fn browser_http_parse() -> bool {
    if g_browser_http_raw_len < 12 || !browser_match_ci(&g_browser_http_raw as u64, 0, g_browser_http_raw_len, "HTTP/" as u64) {
        browser_set_status("Invalid HTTP response"); return false;
    }
    let code: u32 = ((g_browser_http_raw[9] as u32) - 48) * 100
        + ((g_browser_http_raw[10] as u32) - 48) * 10 + ((g_browser_http_raw[11] as u32) - 48);
    let body: u32 = 0; let pos: u32 = 0;
    while pos + 3 < g_browser_http_raw_len && body == 0 {
        if g_browser_http_raw[pos] == 13 && g_browser_http_raw[pos + 1] == 10
            && g_browser_http_raw[pos + 2] == 13 && g_browser_http_raw[pos + 3] == 10 { body = pos + 4; }
        pos = pos + 1;
    }
    if body == 0 { browser_set_status("HTTP headers incomplete"); return false; }
    if code < 200 || code >= 300 {
        browser_set_status("HTTP server returned a non-success status"); return false;
    }
    let kind: u32 = browser_content_kind(body);
    if kind == 2 { browser_set_status("Unsupported HTTP content type"); return false; }
    if browser_headers_chunked(body) && !browser_decode_chunked(body) { return false; }
    if kind == 1 { browser_plain_to_text(body); }
    else { browser_http_to_text(body); }
    return g_browser_content_len > 0;
}

fn browser_http_redirect_location() -> bool {
    browser_zero(&g_browser_http_redirect as u64, 80);
    if g_browser_http_raw_len < 12 { return false; }
    let code: u32 = ((g_browser_http_raw[9] as u32) - 48) * 100
        + ((g_browser_http_raw[10] as u32) - 48) * 10 + ((g_browser_http_raw[11] as u32) - 48);
    if code < 300 || code >= 400 { return false; }
    let pos: u32 = 12;
    while pos + 9 < g_browser_http_raw_len {
        if g_browser_http_raw[pos] == 13 && g_browser_http_raw[pos + 1] == 10
            && g_browser_http_raw[pos + 2] == 13 && g_browser_http_raw[pos + 3] == 10 { return false; }
        if browser_match_ci(&g_browser_http_raw as u64, pos, g_browser_http_raw_len, "location:" as u64) {
            pos = pos + 9; while pos < g_browser_http_raw_len && (g_browser_http_raw[pos] == 32 || g_browser_http_raw[pos] == 9) { pos = pos + 1; }
            let start: u32 = pos;
            while pos < g_browser_http_raw_len && g_browser_http_raw[pos] != 13 && g_browser_http_raw[pos] != 10 { pos = pos + 1; }
            let take: u32 = pos - start; if take == 0 { return false; }
            let copy: u32 = take; if copy > 78 { copy = 78; }
            for i: u32 in 0..copy { g_browser_http_redirect[i] = g_browser_http_raw[start + i]; }
            g_browser_http_redirect[copy] = 0; return true;
        }
        while pos < g_browser_http_raw_len && g_browser_http_raw[pos] != 10 { pos = pos + 1; }
        if pos < g_browser_http_raw_len { pos = pos + 1; }
    }
    return false;
}

fn browser_http_fetch_inner(url: u64, redirects: u32) -> bool {
    if !browser_network_open(url, false) { return false; }
    let req: u32 = browser_http_build_request();
    browser_set_status("Downloading HTTP response"); browser_draw();
    browser_tcp_send(TCP_PSH | TCP_ACK, &g_browser_http_request as u64, req);
    if !browser_tcp_receive() { browser_set_status("No HTTP response data"); return false; }
    if browser_http_redirect_location() {
        if redirects >= 3 { browser_set_status("Too many HTTP redirects"); return false; }
        let next: [u8; 80] = [0; 80];
        if !browser_resolve_link(&g_browser_http_redirect as u64, &next as u64) { browser_set_status("Invalid redirect address"); return false; }
        browser_set_url(&next as u64); browser_set_status("Following HTTP redirect"); browser_draw();
        return browser_http_fetch_inner(&next as u64, redirects + 1);
    }
    return browser_http_parse();
}

fn browser_http_fetch(url: u64) -> bool { return browser_http_fetch_inner(url, 0); }
