// Bounds-checked DER and TLS 1.3 Certificate container parsing.  No certificate
// is trusted here: this layer only establishes canonical, fully-contained byte
// ranges for the later X.509 name, validity, key, and signature checks.

let g_tls_x509_der_ok: bool = false;
let g_tls_x509_certificate_message_ok: bool = false;
let g_tls_x509_signature_test: [u8; 2] = [0; 2];
let g_tls_x509_hostname_ok: bool = false;
let g_tls_x509_fields_ok: bool = false;
let g_tls_x509_time_test: [u8; 8] = [0; 8];
let g_tls_x509_rtc_ok: bool = false;
let g_tls_x509_rtc_test: [u8; 8] = [0; 8];
let g_tls_x509_rsa_spki_ok: bool = false;
let g_tls_x509_rsa_edge_test: [u8; 2] = [0; 2];

fn tls_der_read(input: u64, available: u32, expected_tag: u8,
                content_offset: u64, content_length: u64) -> u32 {
    if available < 2 || *((input + 0) as *u8) != expected_tag
        || (expected_tag & 0x1f) == 0x1f { return 0; }
    let first: u32 = *((input + 1) as *u8) as u32;
    let header: u32 = 2; let length: u32 = 0;
    if first < 128 { length = first; }
    else {
        let count: u32 = first & 0x7f;
        if count == 0 || count > 4 || count > available - 2
            || *((input + 2) as *u8) == 0 { return 0; }
        header = 2 + count;
        for i: u32 in 0..count {
            length = (length << 8) | (*((input + ((2 + i) as u64)) as *u8) as u32);
        }
        if length < 128 { return 0; } // DER requires the shortest length form.
    }
    if header > available || length > available - header { return 0; }
    *((content_offset) as *u32) = header;
    *((content_length) as *u32) = length;
    return header + length;
}

fn tls_x509_certificate_shape(certificate: u64, certificate_length: u32,
                              tbs_offset: u64, tbs_length: u64,
                              signature_offset: u64, signature_length: u64) -> bool {
    let outer_offset: u32 = 0; let outer_length: u32 = 0;
    let outer_total: u32 = tls_der_read(certificate, certificate_length, 0x30,
        &outer_offset as u64, &outer_length as u64);
    if outer_total == 0 || outer_total != certificate_length { return false; }
    let pos: u32 = outer_offset; let end: u32 = outer_offset + outer_length;

    let item_offset: u32 = 0; let item_length: u32 = 0;
    let tbs_total: u32 = tls_der_read(certificate + (pos as u64), end - pos, 0x30,
        &item_offset as u64, &item_length as u64);
    if tbs_total == 0 { return false; }
    *((tbs_offset) as *u32) = pos; *((tbs_length) as *u32) = tbs_total; pos = pos + tbs_total;

    let algorithm_total: u32 = tls_der_read(certificate + (pos as u64), end - pos, 0x30,
        &item_offset as u64, &item_length as u64);
    if algorithm_total == 0 { return false; }
    pos = pos + algorithm_total;

    let bits_total: u32 = tls_der_read(certificate + (pos as u64), end - pos, 0x03,
        &item_offset as u64, &item_length as u64);
    if bits_total == 0 || item_length < 2
        || *((certificate + ((pos + item_offset) as u64)) as *u8) != 0
        || pos + bits_total != end { return false; }
    *((signature_offset) as *u32) = pos + item_offset + 1;
    *((signature_length) as *u32) = item_length - 1;
    return true;
}

fn tls13_parse_certificate_message(message: u64, message_length: u32,
                                   first_certificate_offset: u64,
                                   first_certificate_length: u64) -> bool {
    if message_length < 12 || *((message + 0) as *u8) != 11
        || tls13_read_u24(message, 1) + 4 != message_length { return false; }
    let pos: u32 = 4; let context_length: u32 = *((message + (pos as u64)) as *u8) as u32; pos = pos + 1;
    if context_length > message_length - pos { return false; }
    pos = pos + context_length;
    if message_length - pos < 3 { return false; }
    let list_length: u32 = tls13_read_u24(message, pos); pos = pos + 3;
    if list_length == 0 || list_length != message_length - pos { return false; }
    let end: u32 = message_length; let count: u32 = 0;
    while pos < end {
        if count >= 16 || end - pos < 5 { return false; }
        let certificate_length: u32 = tls13_read_u24(message, pos); pos = pos + 3;
        if certificate_length == 0 || certificate_length > end - pos { return false; }
        let der_offset: u32 = 0; let der_length: u32 = 0;
        if tls_der_read(message + (pos as u64), certificate_length, 0x30,
                        &der_offset as u64, &der_length as u64) != certificate_length { return false; }
        if count == 0 {
            *((first_certificate_offset) as *u32) = pos;
            *((first_certificate_length) as *u32) = certificate_length;
        }
        pos = pos + certificate_length;
        if end - pos < 2 { return false; }
        let extensions_length: u32 = tls13_read_u16(message, pos); pos = pos + 2;
        if extensions_length > end - pos { return false; }
        pos = pos + extensions_length; count = count + 1;
    }
    return pos == end && count > 0;
}

fn tls_x509_dns_lower(ch: u8) -> u8 {
    if ch >= 65 && ch <= 90 { return ch + 32; }
    return ch;
}

fn tls_x509_dns_char(ch: u8) -> bool {
    let lower: u8 = tls_x509_dns_lower(ch);
    return (lower >= 97 && lower <= 122) || (ch >= 48 && ch <= 57) || ch == 45 || ch == 46;
}

fn tls_x509_dns_equal(a: u64, b: u64, length: u32) -> bool {
    let diff: u8 = 0;
    for i: u32 in 0..length {
        diff = diff | (tls_x509_dns_lower(*((a + (i as u64)) as *u8))
            ^ tls_x509_dns_lower(*((b + (i as u64)) as *u8)));
    }
    return diff == 0;
}

fn tls_x509_dns_name_matches(pattern: u64, pattern_length: u32,
                             host: u64, host_length: u32) -> bool {
    if pattern_length == 0 || pattern_length > 253 || host_length == 0 || host_length > 253 { return false; }
    for i: u32 in 0..pattern_length {
        let ch: u8 = *((pattern + (i as u64)) as *u8);
        if ch == 42 {
            if i != 0 || pattern_length < 5 || *((pattern + 1) as *u8) != 46 { return false; }
        } else if !tls_x509_dns_char(ch) { return false; }
        if ch == 46 {
            if i == 0 || i + 1 == pattern_length || *((pattern + ((i - 1) as u64)) as *u8) == 46
                || *((pattern + ((i - 1) as u64)) as *u8) == 45
                || *((pattern + ((i + 1) as u64)) as *u8) == 45 { return false; }
        }
        if ch == 45 && (i == 0 || i + 1 == pattern_length
            || *((pattern + ((i - 1) as u64)) as *u8) == 46
            || *((pattern + ((i + 1) as u64)) as *u8) == 46) { return false; }
    }
    for i: u32 in 0..host_length {
        let ch: u8 = *((host + (i as u64)) as *u8);
        if !tls_x509_dns_char(ch) { return false; }
        if ch == 46 {
            if i == 0 || i + 1 == host_length || *((host + ((i - 1) as u64)) as *u8) == 46
                || *((host + ((i - 1) as u64)) as *u8) == 45
                || *((host + ((i + 1) as u64)) as *u8) == 45 { return false; }
        }
        if ch == 45 && (i == 0 || i + 1 == host_length
            || *((host + ((i - 1) as u64)) as *u8) == 46
            || *((host + ((i + 1) as u64)) as *u8) == 46) { return false; }
    }

    if *((pattern + 0) as *u8) != 42 {
        return pattern_length == host_length && tls_x509_dns_equal(pattern, host, host_length);
    }
    let suffix_length: u32 = pattern_length - 2; let suffix_has_dot: bool = false;
    for i: u32 in 0..suffix_length {
        if *((pattern + ((2 + i) as u64)) as *u8) == 46 { suffix_has_dot = true; }
    }
    if !suffix_has_dot || host_length <= suffix_length + 1 { return false; }
    let separator: u32 = host_length - suffix_length - 1;
    if *((host + (separator as u64)) as *u8) != 46 { return false; }
    for i: u32 in 0..separator { if *((host + (i as u64)) as *u8) == 46 { return false; } }
    return tls_x509_dns_equal(pattern + 2, host + ((separator + 1) as u64), suffix_length);
}

fn tls_x509_general_names_match(general_names: u64, general_names_length: u32,
                                host: u64, host_length: u32) -> bool {
    let content_offset: u32 = 0; let content_length: u32 = 0;
    let total: u32 = tls_der_read(general_names, general_names_length, 0x30,
        &content_offset as u64, &content_length as u64);
    if total == 0 || total != general_names_length { return false; }
    let pos: u32 = content_offset; let end: u32 = content_offset + content_length;
    while pos < end {
        let tag: u8 = *((general_names + (pos as u64)) as *u8);
        let item_offset: u32 = 0; let item_length: u32 = 0;
        let item_total: u32 = tls_der_read(general_names + (pos as u64), end - pos, tag,
            &item_offset as u64, &item_length as u64);
        if item_total == 0 { return false; }
        if tag == 0x82 && tls_x509_dns_name_matches(
            general_names + ((pos + item_offset) as u64), item_length, host, host_length) { return true; }
        pos = pos + item_total;
    }
    return false;
}

fn tls_x509_integer_valid(integer: u64, length: u32) -> bool {
    if length == 0 || (*((integer + 0) as *u8) & 0x80) != 0 { return false; }
    if length > 1 && *((integer + 0) as *u8) == 0 && (*((integer + 1) as *u8) & 0x80) == 0 { return false; }
    return true;
}

fn tls_x509_time_digit(ch: u8) -> u32 {
    if ch < 48 || ch > 57 { return 10; }
    return (ch - 48) as u32;
}

fn tls_x509_time_pair(input: u64, offset: u32) -> u32 {
    let a: u32 = tls_x509_time_digit(*((input + (offset as u64)) as *u8));
    let b: u32 = tls_x509_time_digit(*((input + ((offset + 1) as u64)) as *u8));
    if a > 9 || b > 9 { return 100; }
    return a * 10 + b;
}

fn tls_x509_leap_year(year: u32) -> bool {
    return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
}

fn tls_x509_days_in_month(year: u32, month: u32) -> u32 {
    if month == 0 || month > 12 { return 0; }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30; }
    if month == 2 { if tls_x509_leap_year(year) { return 29; } return 28; }
    return 31;
}

fn tls_x509_parse_time(input: u64, length: u32, tag: u8, output: u64) -> bool {
    let year: u32 = 0; let month_offset: u32 = 0;
    if tag == 0x17 {
        if length != 13 { return false; }
        let short_year: u32 = tls_x509_time_pair(input, 0); if short_year > 99 { return false; }
        if short_year >= 50 { year = 1900 + short_year; } else { year = 2000 + short_year; }
        month_offset = 2;
    } else if tag == 0x18 {
        if length != 15 { return false; }
        let century: u32 = tls_x509_time_pair(input, 0); let short_year: u32 = tls_x509_time_pair(input, 2);
        if century > 99 || short_year > 99 { return false; }
        year = century * 100 + short_year; month_offset = 4;
    } else { return false; }
    if *((input + ((length - 1) as u64)) as *u8) != 90 { return false; } // Zulu only
    let month: u32 = tls_x509_time_pair(input, month_offset);
    let day: u32 = tls_x509_time_pair(input, month_offset + 2);
    let hour: u32 = tls_x509_time_pair(input, month_offset + 4);
    let minute: u32 = tls_x509_time_pair(input, month_offset + 6);
    let second: u32 = tls_x509_time_pair(input, month_offset + 8);
    if month == 0 || month > 12 || hour > 23 || minute > 59 || second > 59 { return false; }
    let days: u32 = tls_x509_days_in_month(year, month);
    if day == 0 || day > days { return false; }
    *((output) as *u64) = (year as u64) * 10000000000 + (month as u64) * 100000000
        + (day as u64) * 1000000 + (hour as u64) * 10000 + (minute as u64) * 100 + (second as u64);
    return true;
}

fn tls_x509_rtc_snapshot(output: u64) -> bool {
    for attempt: u32 in 0..10000 {
        if (rtc_reg(0x0a) & 0x80) != 0 { continue; }
        let second1: u8 = rtc_reg(0); let minute1: u8 = rtc_reg(2); let hour1: u8 = rtc_reg(4);
        let day1: u8 = rtc_reg(7); let month1: u8 = rtc_reg(8); let year1: u8 = rtc_reg(9);
        let century1: u8 = rtc_reg(0x32); let status1: u8 = rtc_reg(0x0b);
        if (rtc_reg(0x0a) & 0x80) != 0 { continue; }
        let second2: u8 = rtc_reg(0); let minute2: u8 = rtc_reg(2); let hour2: u8 = rtc_reg(4);
        let day2: u8 = rtc_reg(7); let month2: u8 = rtc_reg(8); let year2: u8 = rtc_reg(9);
        let century2: u8 = rtc_reg(0x32); let status2: u8 = rtc_reg(0x0b);
        if second1 != second2 || minute1 != minute2 || hour1 != hour2 || day1 != day2
            || month1 != month2 || year1 != year2 || century1 != century2 || status1 != status2 { continue; }
        let binary: bool = (status1 & 4) != 0;
        let second: u32 = rtc_conv(second1, binary) as u32;
        let minute: u32 = rtc_conv(minute1, binary) as u32;
        let pm: bool = (hour1 & 0x80) != 0;
        let hour: u32 = rtc_conv(hour1 & 0x7f, binary) as u32;
        if (status1 & 2) == 0 {
            if hour == 0 || hour > 12 { return false; }
            hour = hour % 12; if pm { hour = hour + 12; }
        }
        let day: u32 = rtc_conv(day1, binary) as u32;
        let month: u32 = rtc_conv(month1, binary) as u32;
        let short_year: u32 = rtc_conv(year1, binary) as u32;
        let century: u32 = rtc_conv(century1, binary) as u32;
        let year: u32 = century * 100 + short_year;
        if century < 19 || century > 99 || second > 59 || minute > 59 || hour > 23
            || day == 0 || day > tls_x509_days_in_month(year, month) { return false; }
        *((output) as *u64) = (year as u64) * 10000000000 + (month as u64) * 100000000
            + (day as u64) * 1000000 + (hour as u64) * 10000 + (minute as u64) * 100 + (second as u64);
        return true;
    }
    return false;
}

fn tls_x509_valid_at(not_before: u64, not_after: u64, now: u64) -> bool {
    return not_before <= now && now <= not_after;
}

fn tls_x509_parse_validity(validity: u64, validity_length: u32,
                           not_before: u64, not_after: u64) -> bool {
    let outer_offset: u32 = 0; let outer_length: u32 = 0;
    let outer_total: u32 = tls_der_read(validity, validity_length, 0x30,
        &outer_offset as u64, &outer_length as u64);
    if outer_total == 0 || outer_total != validity_length { return false; }
    let pos: u32 = outer_offset; let end: u32 = outer_offset + outer_length;
    let item_offset: u32 = 0; let item_length: u32 = 0; let tag: u8 = *((validity + (pos as u64)) as *u8);
    let item_total: u32 = tls_der_read(validity + (pos as u64), end - pos, tag,
        &item_offset as u64, &item_length as u64);
    if item_total == 0 || !tls_x509_parse_time(validity + ((pos + item_offset) as u64),
                                               item_length, tag, not_before) { return false; }
    pos = pos + item_total; if pos >= end { return false; }
    tag = *((validity + (pos as u64)) as *u8);
    item_total = tls_der_read(validity + (pos as u64), end - pos, tag,
        &item_offset as u64, &item_length as u64);
    if item_total == 0 || pos + item_total != end
        || !tls_x509_parse_time(validity + ((pos + item_offset) as u64),
                                item_length, tag, not_after) { return false; }
    return *((not_before) as *u64) <= *((not_after) as *u64);
}

fn tls_x509_tbs_fields(certificate: u64, tbs_offset: u32, tbs_length: u32,
                       validity_offset: u64, validity_length: u64,
                       spki_offset: u64, spki_length: u64,
                       extensions_offset: u64, extensions_length: u64) -> bool {
    let content_offset: u32 = 0; let content_length: u32 = 0;
    if tls_der_read(certificate + (tbs_offset as u64), tbs_length, 0x30,
                    &content_offset as u64, &content_length as u64) != tbs_length { return false; }
    let pos: u32 = tbs_offset + content_offset; let end: u32 = pos + content_length;
    let item_offset: u32 = 0; let item_length: u32 = 0; let item_total: u32 = 0;

    if pos < end && *((certificate + (pos as u64)) as *u8) == 0xa0 {
        item_total = tls_der_read(certificate + (pos as u64), end - pos, 0xa0,
            &item_offset as u64, &item_length as u64);
        if item_total == 0 { return false; }
        let version_offset: u32 = 0; let version_length: u32 = 0;
        if tls_der_read(certificate + ((pos + item_offset) as u64), item_length, 0x02,
                        &version_offset as u64, &version_length as u64) != item_length
            || version_length != 1 || *((certificate + ((pos + item_offset + version_offset) as u64)) as *u8) > 2 {
            return false;
        }
        pos = pos + item_total;
    }

    item_total = tls_der_read(certificate + (pos as u64), end - pos, 0x02,
        &item_offset as u64, &item_length as u64);
    if item_total == 0 || !tls_x509_integer_valid(certificate + ((pos + item_offset) as u64), item_length) { return false; }
    pos = pos + item_total;
    for field: u32 in 0..2 { // signature AlgorithmIdentifier, then issuer Name
        item_total = tls_der_read(certificate + (pos as u64), end - pos, 0x30,
            &item_offset as u64, &item_length as u64);
        if item_total == 0 { return false; } pos = pos + item_total;
    }
    item_total = tls_der_read(certificate + (pos as u64), end - pos, 0x30,
        &item_offset as u64, &item_length as u64);
    if item_total == 0 { return false; }
    *((validity_offset) as *u32) = pos; *((validity_length) as *u32) = item_total; pos = pos + item_total;
    for field: u32 in 0..2 { // subject Name, then SubjectPublicKeyInfo
        item_total = tls_der_read(certificate + (pos as u64), end - pos, 0x30,
            &item_offset as u64, &item_length as u64);
        if item_total == 0 { return false; }
        if field == 1 { *((spki_offset) as *u32) = pos; *((spki_length) as *u32) = item_total; }
        pos = pos + item_total;
    }

    *((extensions_offset) as *u32) = 0; *((extensions_length) as *u32) = 0;
    while pos < end {
        let tag: u8 = *((certificate + (pos as u64)) as *u8);
        if tag != 0x81 && tag != 0x82 && tag != 0xa3 { return false; }
        item_total = tls_der_read(certificate + (pos as u64), end - pos, tag,
            &item_offset as u64, &item_length as u64);
        if item_total == 0 { return false; }
        if tag == 0xa3 {
            if *((extensions_length) as *u32) != 0 { return false; }
            let sequence_offset: u32 = 0; let sequence_length: u32 = 0;
            if tls_der_read(certificate + ((pos + item_offset) as u64), item_length, 0x30,
                            &sequence_offset as u64, &sequence_length as u64) != item_length { return false; }
            *((extensions_offset) as *u32) = pos + item_offset;
            *((extensions_length) as *u32) = item_length;
        }
        pos = pos + item_total;
    }
    return pos == end;
}

fn tls_x509_find_san(certificate: u64, extensions_offset: u32, extensions_length: u32,
                     san_offset: u64, san_length: u64) -> bool {
    let content_offset: u32 = 0; let content_length: u32 = 0;
    if extensions_length == 0 || tls_der_read(certificate + (extensions_offset as u64),
        extensions_length, 0x30, &content_offset as u64, &content_length as u64) != extensions_length { return false; }
    let pos: u32 = extensions_offset + content_offset; let end: u32 = pos + content_length; let found: bool = false;
    while pos < end {
        let ext_offset: u32 = 0; let ext_length: u32 = 0;
        let ext_total: u32 = tls_der_read(certificate + (pos as u64), end - pos, 0x30,
            &ext_offset as u64, &ext_length as u64);
        if ext_total == 0 { return false; }
        let scan: u32 = pos + ext_offset; let ext_end: u32 = scan + ext_length;
        let item_offset: u32 = 0; let item_length: u32 = 0;
        let oid_total: u32 = tls_der_read(certificate + (scan as u64), ext_end - scan, 0x06,
            &item_offset as u64, &item_length as u64);
        if oid_total == 0 { return false; }
        let is_san: bool = item_length == 3
            && *((certificate + ((scan + item_offset) as u64)) as *u8) == 0x55
            && *((certificate + ((scan + item_offset + 1) as u64)) as *u8) == 0x1d
            && *((certificate + ((scan + item_offset + 2) as u64)) as *u8) == 0x11;
        scan = scan + oid_total;
        if scan < ext_end && *((certificate + (scan as u64)) as *u8) == 0x01 {
            let bool_total: u32 = tls_der_read(certificate + (scan as u64), ext_end - scan, 0x01,
                &item_offset as u64, &item_length as u64);
            if bool_total == 0 || item_length != 1 { return false; }
            let value: u8 = *((certificate + ((scan + item_offset) as u64)) as *u8);
            if value != 0 && value != 0xff { return false; } scan = scan + bool_total;
        }
        let value_total: u32 = tls_der_read(certificate + (scan as u64), ext_end - scan, 0x04,
            &item_offset as u64, &item_length as u64);
        if value_total == 0 || scan + value_total != ext_end { return false; }
        if is_san {
            if found { return false; } found = true;
            *((san_offset) as *u32) = scan + item_offset; *((san_length) as *u32) = item_length;
        }
        pos = pos + ext_total;
    }
    return found;
}

fn tls_x509_rsa_oid(input: u64, length: u32) -> bool {
    let oid: [u8; 9] = [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01];
    return length == 9 && tls_bytes_equal(input, &oid as u64, 9);
}

fn tls_x509_spki_rsa(spki: u64, spki_length: u32,
                     modulus_offset: u64, modulus_length: u64, exponent_output: u64) -> bool {
    let outer_offset: u32 = 0; let outer_length: u32 = 0;
    if tls_der_read(spki, spki_length, 0x30, &outer_offset as u64, &outer_length as u64) != spki_length {
        return false;
    }
    let pos: u32 = outer_offset; let end: u32 = outer_offset + outer_length;
    let algorithm_offset: u32 = 0; let algorithm_length: u32 = 0;
    let algorithm_total: u32 = tls_der_read(spki + (pos as u64), end - pos, 0x30,
        &algorithm_offset as u64, &algorithm_length as u64);
    if algorithm_total == 0 { return false; }
    let scan: u32 = pos + algorithm_offset; let algorithm_end: u32 = scan + algorithm_length;
    let item_offset: u32 = 0; let item_length: u32 = 0;
    let oid_total: u32 = tls_der_read(spki + (scan as u64), algorithm_end - scan, 0x06,
        &item_offset as u64, &item_length as u64);
    if oid_total == 0 || !tls_x509_rsa_oid(spki + ((scan + item_offset) as u64), item_length) { return false; }
    scan = scan + oid_total;
    let null_total: u32 = tls_der_read(spki + (scan as u64), algorithm_end - scan, 0x05,
        &item_offset as u64, &item_length as u64);
    if null_total == 0 || item_length != 0 || scan + null_total != algorithm_end { return false; }
    pos = pos + algorithm_total;

    let bits_offset: u32 = 0; let bits_length: u32 = 0;
    let bits_total: u32 = tls_der_read(spki + (pos as u64), end - pos, 0x03,
        &bits_offset as u64, &bits_length as u64);
    if bits_total == 0 || bits_length < 2 || pos + bits_total != end
        || *((spki + ((pos + bits_offset) as u64)) as *u8) != 0 { return false; }
    let rsa: u32 = pos + bits_offset + 1; let rsa_available: u32 = bits_length - 1;
    let rsa_offset: u32 = 0; let rsa_length: u32 = 0;
    if tls_der_read(spki + (rsa as u64), rsa_available, 0x30,
                    &rsa_offset as u64, &rsa_length as u64) != rsa_available { return false; }
    scan = rsa + rsa_offset; let rsa_end: u32 = scan + rsa_length;

    let integer_offset: u32 = 0; let integer_length: u32 = 0;
    let modulus_total: u32 = tls_der_read(spki + (scan as u64), rsa_end - scan, 0x02,
        &integer_offset as u64, &integer_length as u64);
    if modulus_total == 0 || !tls_x509_integer_valid(spki + ((scan + integer_offset) as u64), integer_length) {
        return false;
    }
    let raw_modulus: u32 = scan + integer_offset; let raw_length: u32 = integer_length;
    if raw_length > 1 && *((spki + (raw_modulus as u64)) as *u8) == 0 {
        raw_modulus = raw_modulus + 1; raw_length = raw_length - 1;
    }
    if raw_length < 256 || raw_length > 512 || (*((spki + (raw_modulus as u64)) as *u8) & 0x80) == 0
        || (*((spki + ((raw_modulus + raw_length - 1) as u64)) as *u8) & 1) == 0 {
        return false;
    }
    scan = scan + modulus_total;
    let exponent_total: u32 = tls_der_read(spki + (scan as u64), rsa_end - scan, 0x02,
        &integer_offset as u64, &integer_length as u64);
    if exponent_total == 0 || scan + exponent_total != rsa_end || integer_length == 0 || integer_length > 4
        || !tls_x509_integer_valid(spki + ((scan + integer_offset) as u64), integer_length) { return false; }
    let exponent: u32 = 0;
    for i: u32 in 0..integer_length {
        exponent = (exponent << 8) | (*((spki + ((scan + integer_offset + i) as u64)) as *u8) as u32);
    }
    if exponent < 3 || (exponent & 1) == 0 || (exponent & 0x80000000) != 0 { return false; }
    *((modulus_offset) as *u32) = raw_modulus;
    *((modulus_length) as *u32) = raw_length;
    *((exponent_output) as *u32) = exponent;
    return true;
}

fn tls_x509_self_test() {
    let certificate: [u8; 17] = [
        0x30, 0x0f,
        0x30, 0x03, 0x02, 0x01, 0x01,
        0x30, 0x03, 0x06, 0x01, 0x2a,
        0x03, 0x03, 0x00, 0xaa, 0xbb
    ];
    let tbs_offset: u32 = 0; let tbs_length: u32 = 0;
    let signature_offset: u32 = 0; let signature_length: u32 = 0;
    let shape_ok: bool = tls_x509_certificate_shape(
        &certificate as u64, 17, &tbs_offset as u64, &tbs_length as u64,
        &signature_offset as u64, &signature_length as u64);
    let noncanonical: [u8; 3] = [0x30, 0x81, 0x00];
    let off: u32 = 0; let len: u32 = 0;
    g_tls_x509_der_ok = shape_ok && tbs_offset == 2 && tbs_length == 5
        && signature_offset == 15 && signature_length == 2
        && tls_der_read(&noncanonical as u64, 3, 0x30, &off as u64, &len as u64) == 0
        && tls_der_read(&certificate as u64, 16, 0x30, &off as u64, &len as u64) == 0;

    let handshake: [u8; 30] = [0; 30];
    handshake[0] = 11; handshake[1] = 0; handshake[2] = 0; handshake[3] = 26;
    handshake[4] = 0; handshake[5] = 0; handshake[6] = 0; handshake[7] = 22;
    handshake[8] = 0; handshake[9] = 0; handshake[10] = 17;
    for i: u32 in 0..17 { handshake[11 + i] = certificate[i]; }
    handshake[28] = 0; handshake[29] = 0;
    let certificate_offset: u32 = 0; let certificate_size: u32 = 0;
    let message_ok: bool = tls13_parse_certificate_message(
        &handshake as u64, 30, &certificate_offset as u64, &certificate_size as u64);
    for i: u32 in 0..2 { g_tls_x509_signature_test[i] = certificate[15 + i]; }
    handshake[10] = 18; // Claimed certificate now crosses the list boundary.
    let malformed_rejected: bool = !tls13_parse_certificate_message(
        &handshake as u64, 30, &certificate_offset as u64, &certificate_size as u64);
    g_tls_x509_certificate_message_ok = message_ok && certificate_offset == 11
        && certificate_size == 17 && malformed_rejected
        && tls_bytes_equal(&g_tls_x509_signature_test as u64, &certificate as u64 + 15, 2);

    let names: [u8; 28] = [
        0x30, 0x1a,
        0x82, 0x0b, 0x65, 0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x2e, 0x63, 0x6f, 0x6d,
        0x82, 0x0b, 0x2a, 0x2e, 0x6d, 0x6f, 0x72, 0x74, 0x2e, 0x74, 0x65, 0x73, 0x74
    ];
    g_tls_x509_hostname_ok = tls_x509_general_names_match(
        &names as u64, 28, "EXAMPLE.COM" as u64, 11)
        && tls_x509_general_names_match(&names as u64, 28, "api.mort.test" as u64, 13)
        && !tls_x509_general_names_match(&names as u64, 28, "deep.api.mort.test" as u64, 18)
        && !tls_x509_general_names_match(&names as u64, 28, "mort.test" as u64, 9)
        && !tls_x509_dns_name_matches("*.com" as u64, 5, "example.com" as u64, 11)
        && !tls_x509_dns_name_matches("www.*.test" as u64, 10, "www.mort.test" as u64, 13)
        && !tls_x509_dns_name_matches("www..test" as u64, 9, "www..test" as u64, 9)
        && !tls_x509_dns_name_matches("-bad.test" as u64, 9, "-bad.test" as u64, 9);

    let tbs: [u8; 84] = [
        0x30, 0x52, 0xa0, 0x03, 0x02, 0x01, 0x02, 0x02, 0x01, 0x01,
        0x30, 0x03, 0x06, 0x01, 0x2a, 0x30, 0x00,
        0x30, 0x1e,
        0x17, 0x0d, 0x32, 0x36, 0x30, 0x37, 0x32, 0x32, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x5a,
        0x17, 0x0d, 0x32, 0x37, 0x30, 0x37, 0x32, 0x32, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x5a,
        0x30, 0x00, 0x30, 0x03, 0x03, 0x01, 0x00,
        0xa3, 0x1a, 0x30, 0x18, 0x30, 0x16, 0x06, 0x03, 0x55, 0x1d, 0x11, 0x04, 0x0f,
        0x30, 0x0d, 0x82, 0x0b, 0x65, 0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x2e, 0x63, 0x6f, 0x6d
    ];
    let validity_offset: u32 = 0; let validity_length: u32 = 0;
    let spki_offset: u32 = 0; let spki_length: u32 = 0;
    let extensions_offset: u32 = 0; let extensions_length: u32 = 0;
    let fields_ok: bool = tls_x509_tbs_fields(&tbs as u64, 0, 84,
        &validity_offset as u64, &validity_length as u64, &spki_offset as u64, &spki_length as u64,
        &extensions_offset as u64, &extensions_length as u64);
    let not_before: u64 = 0; let not_after: u64 = 0;
    let validity_ok: bool = fields_ok && tls_x509_parse_validity(
        &tbs as u64 + (validity_offset as u64), validity_length, &not_before as u64, &not_after as u64);
    let san_offset: u32 = 0; let san_length: u32 = 0;
    let san_ok: bool = fields_ok && tls_x509_find_san(
        &tbs as u64, extensions_offset, extensions_length, &san_offset as u64, &san_length as u64)
        && tls_x509_general_names_match(&tbs as u64 + (san_offset as u64), san_length,
                                        "example.com" as u64, 11);
    *(&g_tls_x509_time_test as *u64) = not_before;
    g_tls_x509_fields_ok = fields_ok && validity_ok && san_ok
        && validity_offset == 17 && validity_length == 32 && spki_offset == 51 && spki_length == 5
        && not_before == 20260722000000 && not_after == 20270722000000
        && !tls_x509_parse_time("230229000000Z" as u64, 13, 0x17, &not_before as u64);
    let rtc_now: u64 = 0; let rtc_read: bool = tls_x509_rtc_snapshot(&rtc_now as u64);
    *(&g_tls_x509_rtc_test as *u64) = rtc_now;
    g_tls_x509_rtc_ok = rtc_read && rtc_now >= 20200101000000
        && tls_x509_valid_at(20200101000000, 99991231235959, rtc_now)
        && !tls_x509_valid_at(rtc_now + 1, 99991231235959, rtc_now);

    let rsa_spki: [u8; 294] = [0; 294];
    rsa_spki[0] = 0x30; rsa_spki[1] = 0x82; rsa_spki[2] = 0x01; rsa_spki[3] = 0x22;
    let algorithm: [u8; 15] = [
        0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01, 0x05, 0x00
    ];
    for i: u32 in 0..15 { rsa_spki[4 + i] = algorithm[i]; }
    rsa_spki[19] = 0x03; rsa_spki[20] = 0x82; rsa_spki[21] = 0x01; rsa_spki[22] = 0x0f;
    rsa_spki[23] = 0;
    rsa_spki[24] = 0x30; rsa_spki[25] = 0x82; rsa_spki[26] = 0x01; rsa_spki[27] = 0x0a;
    rsa_spki[28] = 0x02; rsa_spki[29] = 0x82; rsa_spki[30] = 0x01; rsa_spki[31] = 0x01;
    rsa_spki[32] = 0; for i: u32 in 0..256 { rsa_spki[33 + i] = (i + 1) as u8; }
    rsa_spki[33] = 0x80; rsa_spki[288] = 1;
    rsa_spki[289] = 0x02; rsa_spki[290] = 0x03; rsa_spki[291] = 0x01; rsa_spki[292] = 0x00; rsa_spki[293] = 0x01;
    let modulus_offset: u32 = 0; let modulus_length: u32 = 0; let exponent: u32 = 0;
    let rsa_ok: bool = tls_x509_spki_rsa(&rsa_spki as u64, 294,
        &modulus_offset as u64, &modulus_length as u64, &exponent as u64);
    g_tls_x509_rsa_edge_test[0] = rsa_spki[modulus_offset];
    g_tls_x509_rsa_edge_test[1] = rsa_spki[modulus_offset + modulus_length - 1];
    rsa_spki[293] = 2; // even exponent
    g_tls_x509_rsa_spki_ok = rsa_ok && modulus_offset == 33 && modulus_length == 256
        && exponent == 65537 && g_tls_x509_rsa_edge_test[0] == 0x80 && g_tls_x509_rsa_edge_test[1] == 1
        && !tls_x509_spki_rsa(&rsa_spki as u64, 294,
                              &modulus_offset as u64, &modulus_length as u64, &exponent as u64);
}
