let TLS_RSA_PSS_MESSAGE_HASH1: [u8; 32] = [
    0xbe, 0xed, 0x95, 0xaf, 0x40, 0x4e, 0x23, 0xdd, 0x55, 0x3e, 0xbc, 0xfb, 0x4a, 0x00, 0xb8, 0xdb,
    0xbf, 0x22, 0x44, 0xdb, 0x2a, 0x9a, 0xa3, 0x9a, 0x37, 0x92, 0x56, 0x51, 0x26, 0x7c, 0x14, 0x1f
];

let g_tls_rsa_modexp_ok: bool = false;
let g_tls_rsa_output_test: [u8; 128] = [0; 128];
let g_tls_rsa_pkcs1_ok: bool = false;
let g_tls_rsa_pss_ok: bool = false;
let g_tls_rsa_pss_output_test: [u8; 128] = [0; 128];

fn tls_rsa_zero(value: u64, limbs: u32) {
    for i: u32 in 0..limbs { *((value + ((i * 4) as u64)) as *u32) = 0; }
}

fn tls_rsa_copy(output: u64, input: u64, limbs: u32) {
    for i: u32 in 0..limbs {
        *((output + ((i * 4) as u64)) as *u32) = *((input + ((i * 4) as u64)) as *u32);
    }
}

fn tls_rsa_ge(a: u64, b: u64, limbs: u32) -> bool {
    let i: u32 = limbs;
    while i > 0 {
        i = i - 1;
        let av: u32 = *((a + ((i * 4) as u64)) as *u32);
        let bv: u32 = *((b + ((i * 4) as u64)) as *u32);
        if av > bv { return true; } if av < bv { return false; }
    }
    return true;
}

fn tls_rsa_sub(value: u64, modulus: u64, limbs: u32) {
    let borrow: u64 = 0;
    for i: u32 in 0..limbs {
        let av: u64 = *((value + ((i * 4) as u64)) as *u32) as u64;
        let bv: u64 = (*((modulus + ((i * 4) as u64)) as *u32) as u64) + borrow;
        *((value + ((i * 4) as u64)) as *u32) = (av - bv) as u32;
        borrow = 0; if av < bv { borrow = 1; }
    }
}

fn tls_rsa_mod_double(value: u64, modulus: u64, limbs: u32) {
    let carry: u64 = 0;
    for i: u32 in 0..limbs {
        let doubled: u64 = ((*((value + ((i * 4) as u64)) as *u32) as u64) << 1) | carry;
        *((value + ((i * 4) as u64)) as *u32) = doubled as u32; carry = doubled >> 32;
    }
    if carry != 0 || tls_rsa_ge(value, modulus, limbs) { tls_rsa_sub(value, modulus, limbs); }
}

fn tls_rsa_n0_inverse(n0: u32) -> u32 {
    let inverse: u32 = 1;
    for i: u32 in 0..5 { inverse = inverse * (2 - n0 * inverse); }
    return 0 - inverse;
}

fn tls_rsa_montgomery(a: u64, b: u64, modulus: u64, limbs: u32,
                      n0_inverse: u32, output: u64) {
    let t: [u32; 130] = [0; 130];
    for i: u32 in 0..limbs {
        let carry: u64 = 0; let bi: u64 = *((b + ((i * 4) as u64)) as *u32) as u64;
        for j: u32 in 0..limbs {
            let product: u64 = (t[j] as u64)
                + (*((a + ((j * 4) as u64)) as *u32) as u64) * bi + carry;
            t[j] = product as u32; carry = product >> 32;
        }
        let sum: u64 = (t[limbs] as u64) + carry;
        t[limbs] = sum as u32; t[limbs + 1] = (sum >> 32) as u32;

        let factor: u32 = t[0] * n0_inverse; carry = 0;
        for j: u32 in 0..limbs {
            let product: u64 = (t[j] as u64)
                + (factor as u64) * (*((modulus + ((j * 4) as u64)) as *u32) as u64) + carry;
            if j > 0 { t[j - 1] = product as u32; }
            carry = product >> 32;
        }
        let reduced: u64 = (t[limbs] as u64) + carry;
        t[limbs - 1] = reduced as u32;
        t[limbs] = t[limbs + 1] + ((reduced >> 32) as u32); t[limbs + 1] = 0;
    }
    for i: u32 in 0..limbs { *((output + ((i * 4) as u64)) as *u32) = t[i]; }
    if t[limbs] != 0 || tls_rsa_ge(output, modulus, limbs) { tls_rsa_sub(output, modulus, limbs); }
}

fn tls_rsa_import_be(input: u64, length: u32, limbs: u32, output: u64) {
    tls_rsa_zero(output, limbs);
    for i: u32 in 0..length {
        let byte: u32 = *((input + ((length - 1 - i) as u64)) as *u8) as u32;
        let limb: u32 = i / 4; let shift: u32 = (i % 4) * 8;
        *((output + ((limb * 4) as u64)) as *u32) =
            *((output + ((limb * 4) as u64)) as *u32) | (byte << shift);
    }
}

fn tls_rsa_export_be(input: u64, length: u32, output: u64) {
    for i: u32 in 0..length {
        let limb: u32 = i / 4; let shift: u32 = (i % 4) * 8;
        *((output + ((length - 1 - i) as u64)) as *u8) =
            (*((input + ((limb * 4) as u64)) as *u32) >> shift) as u8;
    }
}

fn tls_rsa_public(signature: u64, signature_length: u32,
                  modulus_bytes: u64, modulus_length: u32,
                  exponent: u32, output: u64) -> bool {
    if signature_length != modulus_length || modulus_length % 4 != 0
        || modulus_length < 128 || modulus_length > 512 || exponent < 3 || (exponent & 1) == 0 { return false; }
    let limbs: u32 = modulus_length / 4;
    let modulus: [u32; 128] = [0; 128]; let base: [u32; 128] = [0; 128];
    let r2: [u32; 128] = [0; 128]; let one: [u32; 128] = [0; 128];
    let base_montgomery: [u32; 128] = [0; 128]; let result: [u32; 128] = [0; 128];
    let temporary: [u32; 128] = [0; 128];
    tls_rsa_import_be(modulus_bytes, modulus_length, limbs, &modulus as u64);
    tls_rsa_import_be(signature, signature_length, limbs, &base as u64);
    if (modulus[0] & 1) == 0 || tls_rsa_ge(&base as u64, &modulus as u64, limbs) { return false; }
    let n0_inverse: u32 = tls_rsa_n0_inverse(modulus[0]);
    one[0] = 1; r2[0] = 1;
    for i: u32 in 0..(limbs * 64) { tls_rsa_mod_double(&r2 as u64, &modulus as u64, limbs); }
    tls_rsa_montgomery(&base as u64, &r2 as u64, &modulus as u64, limbs, n0_inverse, &base_montgomery as u64);
    tls_rsa_montgomery(&one as u64, &r2 as u64, &modulus as u64, limbs, n0_inverse, &result as u64);
    let bit: u32 = 31;
    while bit > 0 && ((exponent >> bit) & 1) == 0 { bit = bit - 1; }
    let remaining: u32 = bit + 1;
    while remaining > 0 {
        let current: u32 = remaining - 1;
        tls_rsa_montgomery(&result as u64, &result as u64, &modulus as u64, limbs, n0_inverse, &temporary as u64);
        tls_rsa_copy(&result as u64, &temporary as u64, limbs);
        if ((exponent >> current) & 1) != 0 {
            tls_rsa_montgomery(&result as u64, &base_montgomery as u64, &modulus as u64, limbs,
                               n0_inverse, &temporary as u64);
            tls_rsa_copy(&result as u64, &temporary as u64, limbs);
        }
        remaining = remaining - 1;
    }
    tls_rsa_montgomery(&result as u64, &one as u64, &modulus as u64, limbs, n0_inverse, &temporary as u64);
    tls_rsa_export_be(&temporary as u64, modulus_length, output); return true;
}

fn tls_rsa_pkcs1_sha256_block(encoded: u64, encoded_length: u32, digest: u64) -> bool {
    if encoded_length < 62 || *((encoded + 0) as *u8) != 0 || *((encoded + 1) as *u8) != 1 { return false; }
    let separator: u32 = 2;
    while separator < encoded_length && *((encoded + (separator as u64)) as *u8) == 0xff {
        separator = separator + 1;
    }
    if separator < 10 || separator >= encoded_length || *((encoded + (separator as u64)) as *u8) != 0
        || encoded_length - separator - 1 != 51 { return false; }
    let prefix: [u8; 19] = [
        0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01,
        0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20
    ];
    return tls_bytes_equal(encoded + ((separator + 1) as u64), &prefix as u64, 19)
        && tls_bytes_equal(encoded + ((separator + 20) as u64), digest, 32);
}

fn tls_rsa_pkcs1_sha256_verify_hash(signature: u64, signature_length: u32,
                                    modulus: u64, modulus_length: u32, exponent: u32,
                                    digest: u64) -> bool {
    let encoded: [u8; 512] = [0; 512];
    return tls_rsa_public(signature, signature_length, modulus, modulus_length, exponent, &encoded as u64)
        && tls_rsa_pkcs1_sha256_block(&encoded as u64, modulus_length, digest);
}

fn tls_rsa_mgf1_sha256(seed: u64, output: u64, output_length: u32) -> bool {
    if output_length > 512 { return false; }
    let message: [u8; 36] = [0; 36]; let digest: [u8; 32] = [0; 32];
    for i: u32 in 0..32 { message[i] = *((seed + (i as u64)) as *u8); }
    let written: u32 = 0; let counter: u32 = 0;
    while written < output_length {
        message[32] = (counter >> 24) as u8; message[33] = (counter >> 16) as u8;
        message[34] = (counter >> 8) as u8; message[35] = counter as u8;
        tls_sha256(&message as u64, 36, &digest as u64);
        let take: u32 = output_length - written; if take > 32 { take = 32; }
        for i: u32 in 0..take { *((output + ((written + i) as u64)) as *u8) = digest[i]; }
        written = written + take; counter = counter + 1;
    }
    return true;
}

fn tls_rsa_pss_sha256_block(encoded: u64, encoded_length: u32, message_digest: u64) -> bool {
    if encoded_length < 66 || encoded_length > 512 || *((encoded + ((encoded_length - 1) as u64)) as *u8) != 0xbc
        || (*((encoded + 0) as *u8) & 0x80) != 0 { return false; }
    let db_length: u32 = encoded_length - 33; let hash: u64 = encoded + (db_length as u64);
    let mask: [u8; 512] = [0; 512];
    if !tls_rsa_mgf1_sha256(hash, &mask as u64, db_length) { return false; }
    let padding_length: u32 = encoded_length - 66; let salt: [u8; 32] = [0; 32];
    for i: u32 in 0..db_length {
        let value: u8 = *((encoded + (i as u64)) as *u8) ^ mask[i];
        if i == 0 { value = value & 0x7f; }
        if i < padding_length {
            if value != 0 { return false; }
        } else if i == padding_length {
            if value != 1 { return false; }
        } else {
            salt[i - padding_length - 1] = value;
        }
    }
    let verify_input: [u8; 72] = [0; 72]; let expected_hash: [u8; 32] = [0; 32];
    for i: u32 in 0..32 { verify_input[8 + i] = *((message_digest + (i as u64)) as *u8); }
    for i: u32 in 0..32 { verify_input[40 + i] = salt[i]; }
    tls_sha256(&verify_input as u64, 72, &expected_hash as u64);
    return tls_bytes_equal(&expected_hash as u64, hash, 32);
}

fn tls_rsa_pss_sha256_verify_hash(signature: u64, signature_length: u32,
                                  modulus: u64, modulus_length: u32, exponent: u32,
                                  message_digest: u64) -> bool {
    let encoded: [u8; 512] = [0; 512];
    return tls_rsa_public(signature, signature_length, modulus, modulus_length, exponent, &encoded as u64)
        && tls_rsa_pss_sha256_block(&encoded as u64, modulus_length, message_digest);
}

fn tls_rsa_self_test() {
    let expected: [u8; 128] = [0; 128];
    expected[0] = 0; expected[1] = 1; for i: u32 in 2..76 { expected[i] = 0xff; } expected[76] = 0;
    let digest_info: [u8; 19] = [
        0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01,
        0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20
    ];
    for i: u32 in 0..19 { expected[77 + i] = digest_info[i]; }
    for i: u32 in 0..32 { expected[96 + i] = TLS_RSA_DIGEST1[i]; }
    let operation_ok: bool = tls_rsa_public(&TLS_RSA_SIGNATURE1 as u64, 128,
        &TLS_RSA_MODULUS1 as u64, 128, 65537, &g_tls_rsa_output_test as u64);
    g_tls_rsa_modexp_ok = operation_ok
        && tls_bytes_equal(&g_tls_rsa_output_test as u64, &expected as u64, 128);
    let bad_digest: [u8; 32] = [0; 32];
    for i: u32 in 0..32 { bad_digest[i] = TLS_RSA_DIGEST1[i]; } bad_digest[0] = bad_digest[0] ^ 1;
    g_tls_rsa_pkcs1_ok = g_tls_rsa_modexp_ok
        && tls_rsa_pkcs1_sha256_block(&g_tls_rsa_output_test as u64, 128, &TLS_RSA_DIGEST1 as u64)
        && !tls_rsa_pkcs1_sha256_block(&g_tls_rsa_output_test as u64, 128, &bad_digest as u64);
    let pss_operation_ok: bool = tls_rsa_public(&TLS_RSA_PSS_SIGNATURE1 as u64, 128,
        &TLS_RSA_MODULUS1 as u64, 128, 65537, &g_tls_rsa_pss_output_test as u64);
    for i: u32 in 0..32 { bad_digest[i] = TLS_RSA_PSS_MESSAGE_HASH1[i]; } bad_digest[0] = bad_digest[0] ^ 1;
    g_tls_rsa_pss_ok = pss_operation_ok
        && tls_rsa_pss_sha256_block(&g_tls_rsa_pss_output_test as u64, 128, &TLS_RSA_PSS_MESSAGE_HASH1 as u64)
        && !tls_rsa_pss_sha256_block(&g_tls_rsa_pss_output_test as u64, 128, &bad_digest as u64);
}
