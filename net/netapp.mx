// net/netapp.mx — the bridge between mortnet and the MORT OS shell.
//
// The files alongside this one are the vendored, host-tested mortnet stack
// (endian .. tcp/http) plus the RTL8139 driver. This file wires them to the
// kernel: it prints with the kernel's print_string/feed, and exposes two shell
// verbs — `net` (bring the card up and get an address via DHCP) and `httpd`
// (serve a page on port 80). Everything compiles into the kernel as one unit,
// so these call print_string/feed/g_row defined in kmain.mx directly.

let g_net_up: bool = false;
let g_net_quiet: bool = false;       // GUI callers suppress terminal progress text
let g_net_tx: [u8; 1024] = [0; 1024];
let g_net_rx: [u8; 2048] = [0; 2048];
let g_net_resp: [u8; 1024] = [0; 1024];
let g_ipstr: [u8; 20] = [0; 20];

fn net_send(src: u64, len: u32) {
    let tx: u64 = &g_rtl_txbuf as u64;
    for i: u32 in 0..len {
        let s: *u8 = (src + (i as u64)) as *u8;
        let d: *u8 = (tx + (i as u64)) as *u8;
        *d = *s;
    }
    rtl_transmit(len);
}

// Format an IPv4 address (4 bytes at ip) as "a.b.c.d" into g_ipstr, NUL-term.
fn net_ip_to_str(ip: u64) {
    let base: u64 = &g_ipstr as u64;
    let out: u32 = 0;
    for o: u32 in 0..4 {
        let v: u32 = *((ip + (o as u64)) as *u8) as u32;
        out = out + u32_to_dec(base + (out as u64), v);
        if o < 3 {
            let dot: *u8 = (base + (out as u64)) as *u8;
            *dot = 46;                      // '.'
            out = out + 1;
        }
    }
    let term: *u8 = (base + (out as u64)) as *u8;
    *term = 0;
}

// Bring up the RTL8139 and lease an address via DHCP. Returns true and sets our
// IP on success. Prints progress on the shell.
fn net_dhcp() -> bool {
    if !rtl_init() {
        if !g_net_quiet {
            feed();
            print_string("no RTL8139 NIC found (need vendor 10EC device 8139)", g_row, 12);
        }
        return false;
    }
    let mymac: [u8; 6] = [0; 6];
    rtl_mac(&mymac as u64);
    net_set_mac(&mymac as u64);
    let noip: [u8; 4] = [0, 0, 0, 0];
    net_set_ip(&noip as u64);

    if !g_net_quiet {
        feed();
        print_string("NIC up. DHCP: DISCOVER...", g_row, 7);
    }

    // Build the DHCP body at the payload slot, wrap and send (DISCOVER).
    let xid: u32 = 0x6D6F7274;
    let body: u64 = (&g_net_tx as u64) + 14 + 20 + 8;
    let dlen: u32 = dhcp_build_discover(body, xid, net_our_mac());
    net_dhcp_send(dlen);

    let offer_ip: [u8; 4] = [0; 4];
    let server_ip: [u8; 4] = [0; 4];
    let have_offer: bool = false;
    let requested: bool = false;

    let spins: u32 = 0;
    while spins < 30000000 {
        let rxb: u64 = &g_net_rx as u64;
        let n: u32 = rtl_poll_rx(rxb);
        if n >= 42 && eth_type(rxb) == ETH_IP {
            let ip: u64 = eth_payload(rxb);
            if ip_proto(ip) == IP_PROTO_UDP {
                let udp: u64 = ip + (ip_ihl_bytes(ip) as u64);
                if udp_dst_port(udp) == 68 {
                    let dhcp: u64 = udp_payload(udp);
                    let dhcp_len: u32 = (udp_length(udp) as u32) - 8;
                    let mt: u8 = dhcp_msg_type(dhcp, dhcp_len);
                    if mt == DHCP_OFFER && !have_offer {
                        ip4_copy(&offer_ip as u64, dhcp_yiaddr(dhcp));
                        let sid: u64 = dhcp_find_option(dhcp, dhcp_len, 54);
                        if sid != 0 { ip4_copy(&server_ip as u64, sid); }
                        have_offer = true;
                    }
                    if mt == DHCP_ACK && requested {
                        net_set_ip(dhcp_yiaddr(dhcp));
                        net_ip_to_str(net_our_ip());
                        if !g_net_quiet {
                            feed();
                            print_string("DHCP: bound to ", g_row, 10);
                            print_at(&g_ipstr as *u8, g_row, 15, 11);
                        }
                        g_net_up = true;
                        return true;
                    }
                }
            }
        }
        if have_offer && !requested {
            let rlen: u32 = dhcp_build_request(body, xid, net_our_mac(),
                                               &offer_ip as u64, &server_ip as u64);
            net_dhcp_send(rlen);
            requested = true;
        }
        spins = spins + 1;
    }
    if !g_net_quiet {
        feed();
        print_string("DHCP: no response (timeout)", g_row, 12);
    }
    return false;
}

// Wrap a DHCP body (already at the payload slot) in UDP+IP+broadcast Ethernet.
fn net_dhcp_send(dhcp_len: u32) {
    let base: u64 = &g_net_tx as u64;
    let zero_ip: [u8; 4] = [0, 0, 0, 0];
    let bcast_ip: [u8; 4] = [255, 255, 255, 255];
    let bcast_mac: [u8; 6] = [0; 6];
    mac_broadcast(&bcast_mac as u64);
    eth_build_header(base, &bcast_mac as u64, net_our_mac(), ETH_IP);
    let ip: u64 = eth_payload(base);
    let udp: u64 = ip + 20;
    let udp_total: u32 = udp_build(udp, 68, 67, &zero_ip as u64, &bcast_ip as u64,
                                   dhcp_len);
    ip_build_header(ip, &zero_ip as u64, &bcast_ip as u64, IP_PROTO_UDP,
                    0x0001, udp_total as u16);
    net_send(base, 14 + 20 + udp_total);
}

// The served page.
fn net_page() -> u64 {
    return "<!doctype html><html><head><meta charset=utf-8><title>MORT OS</title></head><body style=\"background:#0d1117;color:#e6edf3;font-family:monospace;text-align:center;padding:48px 16px\"><h1 style=\"color:#3fb950\">Served by MORT OS</h1><p>This page came from a web server written in Mort, running on an operating system written in Mort, over a TCP/IP stack written in Mort &mdash; on real hardware.</p><p style=\"color:#8b949e\">NIC driver &rarr; ARP &rarr; IPv4 &rarr; ICMP &rarr; UDP &rarr; DHCP &rarr; DNS &rarr; TCP &rarr; HTTP.<br>Every layer, from scratch.</p><p style=\"color:#22d3ee\">mortnet &middot; 0xmortuex</p></body></html>" as u64;
}

// TCP server connection state for httpd.
let g_h_mac: [u8; 6] = [0; 6];
let g_h_ip: [u8; 4] = [0; 4];
let g_h_port: u16 = 0;
let g_h_snd: u32 = 0;
let g_h_rcv: u32 = 0;
let g_h_ipid: u16 = 0x0100;

fn httpd_xmit(flags: u8, data: u64, data_len: u32) {
    let base: u64 = &g_net_tx as u64;
    eth_build_header(base, &g_h_mac as u64, net_our_mac(), ETH_IP);
    let ip: u64 = eth_payload(base);
    let tcp: u64 = ip + 20;
    for i: u32 in 0..data_len {
        let s: *u8 = (data + (i as u64)) as *u8;
        let d: *u8 = (tcp + 20 + (i as u64)) as *u8;
        *d = *s;
    }
    let total: u32 = tcp_build(tcp, 80, g_h_port, g_h_snd, g_h_rcv, flags, 64240,
                               net_our_ip(), &g_h_ip as u64, data_len);
    ip_build_header(ip, net_our_ip(), &g_h_ip as u64, IP_PROTO_TCP,
                    g_h_ipid, total as u16);
    g_h_ipid = g_h_ipid + 1;
    net_send(base, 14 + 20 + total);
    let adv: u32 = data_len;
    if (flags & TCP_SYN) != 0 { adv = adv + 1; }
    if (flags & TCP_FIN) != 0 { adv = adv + 1; }
    g_h_snd = g_h_snd + adv;
}

// Serve HTTP on port 80 until reboot. Requires `net` to have run first.
fn net_httpd() {
    if !g_net_up {
        feed();
        print_string("run 'net' first to get an address", g_row, 12);
        return;
    }
    net_ip_to_str(net_our_ip());
    let iplen: u32 = http_strlen(&g_ipstr as u64);
    feed();
    print_string("httpd: serving on http://", g_row, 10);
    print_at(&g_ipstr as *u8, g_row, 25, 11);
    print_at("/  (reboot to stop)", g_row, 25 + iplen, 7);

    let state: u32 = 0;
    let responded: bool = false;
    let served: u32 = 0;

    while true {
        let rxb: u64 = &g_net_rx as u64;
        let n: u32 = rtl_poll_rx(rxb);
        if n >= 14 {
            let reply: u32 = net_handle_frame(rxb, n, &g_net_tx as u64);
            if reply > 0 {
                net_send(&g_net_tx as u64, reply);
            }
            if eth_type(rxb) == ETH_IP {
                let ip: u64 = eth_payload(rxb);
                if ip_proto(ip) == IP_PROTO_TCP {
                    let tcp: u64 = ip + (ip_ihl_bytes(ip) as u64);
                    if tcp_dst_port(tcp) == 80 {
                        let flags: u8 = tcp_flags(tcp);
                        let their_seq: u32 = tcp_seq(tcp);
                        let their_ack: u32 = tcp_ack(tcp);
                        let hdr: u32 = tcp_header_len(tcp);
                        let seg_len: u32 = (ip_total_len(ip) as u32)
                                           - ip_ihl_bytes(ip) - hdr;
                        let sport: u16 = tcp_src_port(tcp);
                        if state == 0 && (flags & TCP_SYN) != 0 && (flags & TCP_ACK) == 0 {
                            mac_copy(&g_h_mac as u64, eth_src(rxb));
                            ip4_copy(&g_h_ip as u64, ip_src(ip));
                            g_h_port = sport;
                            g_h_rcv = their_seq + 1;
                            g_h_snd = 0x30000000;
                            responded = false;
                            httpd_xmit(TCP_SYN | TCP_ACK, 0, 0);
                            state = 1;
                        } else {
                            if sport == g_h_port {
                                if state == 1 && (flags & TCP_ACK) != 0
                                    && their_ack == g_h_snd {
                                    state = 2;
                                }
                                if state == 2 {
                                    if seg_len > 0 && their_seq == g_h_rcv {
                                        let payload: u64 = tcp + (hdr as u64);
                                        g_h_rcv = g_h_rcv + seg_len;
                                        httpd_xmit(TCP_ACK, 0, 0);
                                        if !responded && http_is_get(payload) {
                                            let rlen: u32 = http_build_response(
                                                &g_net_resp as u64, net_page());
                                            httpd_xmit(TCP_PSH | TCP_ACK,
                                                       &g_net_resp as u64, rlen);
                                            httpd_xmit(TCP_FIN | TCP_ACK, 0, 0);
                                            responded = true;
                                            served = served + 1;
                                            feed();
                                            print_string("served request #", g_row, 10);
                                            num_to_str(served, g_numbuf);
                                            print_at(g_numbuf, g_row, 16, 11);
                                        }
                                    }
                                    if (flags & TCP_FIN) != 0 && their_seq == g_h_rcv {
                                        g_h_rcv = g_h_rcv + 1;
                                        httpd_xmit(TCP_ACK, 0, 0);
                                        state = 0;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
