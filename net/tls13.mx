fn tls13_write_u16(output: u64, position: u32, value: u32) {
    *((output + (position as u64)) as *u8) = (value >> 8) as u8;
    *((output + ((position + 1) as u64)) as *u8) = value as u8;
}

fn tls13_write_u24(output: u64, position: u32, value: u32) {
    *((output + (position as u64)) as *u8) = (value >> 16) as u8;
    *((output + ((position + 1) as u64)) as *u8) = (value >> 8) as u8;
    *((output + ((position + 2) as u64)) as *u8) = value as u8;
}

fn tls13_build_client_hello(host: u64, host_length: u32, random: u64,
                            public_key: u64, output: u64, capacity: u32) -> u32 {
    if host_length == 0 || host_length > 200 || capacity < host_length + 128 { return 0; }
    for i: u32 in 0..capacity { *((output + (i as u64)) as *u8) = 0; }
    let pos: u32 = 0;
    *((output + (pos as u64)) as *u8) = 22; pos = pos + 1; // handshake record
    *((output + (pos as u64)) as *u8) = 3; *((output + ((pos + 1) as u64)) as *u8) = 1; pos = pos + 4;
    *((output + (pos as u64)) as *u8) = 1; pos = pos + 4; // ClientHello + u24 length
    *((output + (pos as u64)) as *u8) = 3; *((output + ((pos + 1) as u64)) as *u8) = 3; pos = pos + 2;
    for i: u32 in 0..32 { *((output + ((pos + i) as u64)) as *u8) = *((random + (i as u64)) as *u8); }
    pos = pos + 32; *((output + (pos as u64)) as *u8) = 0; pos = pos + 1; // no legacy session ID
    tls13_write_u16(output, pos, 2); pos = pos + 2; tls13_write_u16(output, pos, 0x1303); pos = pos + 2;
    *((output + (pos as u64)) as *u8) = 1; *((output + ((pos + 1) as u64)) as *u8) = 0; pos = pos + 2;
    let extensions_length_pos: u32 = pos; pos = pos + 2; let extensions_start: u32 = pos;

    tls13_write_u16(output, pos, 0x0000); tls13_write_u16(output, pos + 2, 5 + host_length); pos = pos + 4;
    tls13_write_u16(output, pos, 3 + host_length); pos = pos + 2; *((output + (pos as u64)) as *u8) = 0; pos = pos + 1;
    tls13_write_u16(output, pos, host_length); pos = pos + 2;
    for i: u32 in 0..host_length { *((output + ((pos + i) as u64)) as *u8) = *((host + (i as u64)) as *u8); }
    pos = pos + host_length;

    tls13_write_u16(output, pos, 0x002b); tls13_write_u16(output, pos + 2, 3); pos = pos + 4;
    *((output + (pos as u64)) as *u8) = 2; tls13_write_u16(output, pos + 1, 0x0304); pos = pos + 3;
    tls13_write_u16(output, pos, 0x000a); tls13_write_u16(output, pos + 2, 4); pos = pos + 4;
    tls13_write_u16(output, pos, 2); tls13_write_u16(output, pos + 2, 0x001d); pos = pos + 4;
    tls13_write_u16(output, pos, 0x000d); tls13_write_u16(output, pos + 2, 8); pos = pos + 4;
    tls13_write_u16(output, pos, 6); tls13_write_u16(output, pos + 2, 0x0403);
    tls13_write_u16(output, pos + 4, 0x0804); tls13_write_u16(output, pos + 6, 0x0807); pos = pos + 8;
    tls13_write_u16(output, pos, 0x0033); tls13_write_u16(output, pos + 2, 38); pos = pos + 4;
    tls13_write_u16(output, pos, 36); tls13_write_u16(output, pos + 2, 0x001d); tls13_write_u16(output, pos + 4, 32); pos = pos + 6;
    for i: u32 in 0..32 { *((output + ((pos + i) as u64)) as *u8) = *((public_key + (i as u64)) as *u8); }
    pos = pos + 32;

    tls13_write_u16(output, extensions_length_pos, pos - extensions_start);
    tls13_write_u24(output, 6, pos - 9); tls13_write_u16(output, 3, pos - 5); return pos;
}

fn tls13_read_u16(input: u64, position: u32) -> u32 {
    return ((*((input + (position as u64)) as *u8) as u32) << 8)
        | (*((input + ((position + 1) as u64)) as *u8) as u32);
}

fn tls13_read_u24(input: u64, position: u32) -> u32 {
    return ((*((input + (position as u64)) as *u8) as u32) << 16)
        | ((*((input + ((position + 1) as u64)) as *u8) as u32) << 8)
        | (*((input + ((position + 2) as u64)) as *u8) as u32);
}

fn tls13_parse_server_hello(record: u64, record_length: u32, expected_cipher: u32, server_key: u64) -> bool {
    if record_length < 50 || *((record + 0) as *u8) != 22 || tls13_read_u16(record, 3) + 5 != record_length
        || *((record + 5) as *u8) != 2 || tls13_read_u24(record, 6) + 9 != record_length
        || tls13_read_u16(record, 9) != 0x0303 { return false; }
    let session_length: u32 = *((record + 43) as *u8) as u32;
    let pos: u32 = 44 + session_length;
    if pos + 5 > record_length || tls13_read_u16(record, pos) != expected_cipher
        || *((record + ((pos + 2) as u64)) as *u8) != 0 { return false; }
    pos = pos + 3; let extensions_length: u32 = tls13_read_u16(record, pos); pos = pos + 2;
    if pos + extensions_length != record_length { return false; }
    let end: u32 = record_length; let have_version: bool = false; let have_key: bool = false;
    while pos + 4 <= end {
        let kind: u32 = tls13_read_u16(record, pos); let size: u32 = tls13_read_u16(record, pos + 2); pos = pos + 4;
        if pos + size > end { return false; }
        if kind == 0x002b {
            if size != 2 || tls13_read_u16(record, pos) != 0x0304 { return false; }
            have_version = true;
        }
        if kind == 0x0033 {
            if size != 36 || tls13_read_u16(record, pos) != 0x001d || tls13_read_u16(record, pos + 2) != 32 { return false; }
            for i: u32 in 0..32 { *((server_key + (i as u64)) as *u8) = *((record + ((pos + 4 + i) as u64)) as *u8); }
            have_key = true;
        }
        pos = pos + size;
    }
    return pos == end && have_version && have_key;
}

fn tls13_expand_label(secret: u64, label: u64, label_length: u32,
                      context: u64, context_length: u32,
                      output: u64, output_length: u32) -> bool {
    if label_length > 249 || context_length > 255 || output_length > 65535
        || 10 + label_length + context_length > 415 { return false; }
    let info: [u8; 416] = [0; 416];
    info[0] = (output_length >> 8) as u8; info[1] = output_length as u8;
    info[2] = (6 + label_length) as u8;
    info[3] = 116; info[4] = 108; info[5] = 115; info[6] = 49; info[7] = 51; info[8] = 32; // "tls13 "
    for i: u32 in 0..label_length { info[9 + i] = *((label + (i as u64)) as *u8); }
    let context_pos: u32 = 9 + label_length; info[context_pos] = context_length as u8;
    for i: u32 in 0..context_length { info[context_pos + 1 + i] = *((context + (i as u64)) as *u8); }
    return tls_hkdf_expand(secret, &info as u64, context_pos + 1 + context_length, output, output_length);
}

fn tls13_derive_secret(secret: u64, label: u64, label_length: u32,
                       transcript: u64, transcript_length: u32, output: u64) -> bool {
    let transcript_hash: [u8; 32] = [0; 32]; tls_sha256(transcript, transcript_length, &transcript_hash as u64);
    return tls13_expand_label(secret, label, label_length, &transcript_hash as u64, 32, output, 32);
}

// RFC 8446 section 7.1 through the handshake traffic-secret branch.  An
// all-zero X25519 result is rejected as required by RFC 7748 section 6.1.
fn tls13_handshake_secret(client_private: u64, server_public: u64, output: u64) -> bool {
    let zeros: [u8; 32] = [0; 32]; let early: [u8; 32] = [0; 32];
    let derived: [u8; 32] = [0; 32]; let shared: [u8; 32] = [0; 32];
    if !tls_hkdf_extract(&zeros as u64, 32, &zeros as u64, 32, &early as u64)
        || !tls13_expand_label(&early as u64, "derived" as u64, 7,
                               &TLS_SHA256_EMPTY as u64, 32, &derived as u64, 32) { return false; }
    tls_x25519(client_private, server_public, &shared as u64);
    let nonzero: u8 = 0; for i: u32 in 0..32 { nonzero = nonzero | shared[i]; }
    if nonzero == 0 { return false; }
    return tls_hkdf_extract(&derived as u64, 32, &shared as u64, 32, output);
}

fn tls13_handshake_traffic(handshake_secret: u64, transcript_hash: u64,
                           client_traffic: u64, server_traffic: u64) -> bool {
    return tls13_expand_label(handshake_secret, "c hs traffic" as u64, 12,
                              transcript_hash, 32, client_traffic, 32)
        && tls13_expand_label(handshake_secret, "s hs traffic" as u64, 12,
                              transcript_hash, 32, server_traffic, 32);
}

fn tls13_traffic_key(traffic_secret: u64, key: u64, key_length: u32, iv: u64) -> bool {
    if key_length != 16 && key_length != 32 { return false; }
    return tls13_expand_label(traffic_secret, "key" as u64, 3, "" as u64, 0, key, key_length)
        && tls13_expand_label(traffic_secret, "iv" as u64, 2, "" as u64, 0, iv, 12);
}

fn tls13_master_secret(handshake_secret: u64, output: u64) -> bool {
    let derived: [u8; 32] = [0; 32]; let zeros: [u8; 32] = [0; 32];
    return tls13_expand_label(handshake_secret, "derived" as u64, 7,
                              &TLS_SHA256_EMPTY as u64, 32, &derived as u64, 32)
        && tls_hkdf_extract(&derived as u64, 32, &zeros as u64, 32, output);
}

fn tls13_application_traffic(master_secret: u64, transcript_hash: u64,
                             client_traffic: u64, server_traffic: u64) -> bool {
    return tls13_expand_label(master_secret, "c ap traffic" as u64, 12,
                              transcript_hash, 32, client_traffic, 32)
        && tls13_expand_label(master_secret, "s ap traffic" as u64, 12,
                              transcript_hash, 32, server_traffic, 32);
}

fn tls13_record_nonce(write_iv: u64, sequence: u64, nonce: u64) {
    for i: u32 in 0..12 { *((nonce + (i as u64)) as *u8) = *((write_iv + (i as u64)) as *u8); }
    for i: u32 in 0..8 {
        *((nonce + ((11 - i) as u64)) as *u8) = *((nonce + ((11 - i) as u64)) as *u8)
            ^ ((sequence >> (i * 8)) as u8);
    }
}

// Returns the authenticated TLSInnerPlaintext content length, or 0xffffffff
// on failure.  The AEAD helper does not write plaintext unless the tag passes.
fn tls13_decrypt_record(key: u64, write_iv: u64, sequence: u64,
                        record: u64, record_length: u32,
                        plaintext: u64, plaintext_capacity: u32,
                        content_type: u64) -> u32 {
    if record_length < 22 || record_length > 16645 || *((record + 0) as *u8) != 23
        || tls13_read_u16(record, 1) != 0x0303 || tls13_read_u16(record, 3) + 5 != record_length { return 0xffffffff; }
    let encrypted_length: u32 = record_length - 5; if encrypted_length < 17 { return 0xffffffff; }
    let ciphertext_length: u32 = encrypted_length - 16;
    if ciphertext_length > plaintext_capacity { return 0xffffffff; }
    let nonce: [u8; 12] = [0; 12]; tls13_record_nonce(write_iv, sequence, &nonce as u64);
    if !tls_chacha20_poly1305_decrypt(key, &nonce as u64, record, 5, record + 5,
                                     ciphertext_length, record + 5 + (ciphertext_length as u64), plaintext) {
        return 0xffffffff;
    }
    let end: u32 = ciphertext_length;
    while end > 0 && *((plaintext + ((end - 1) as u64)) as *u8) == 0 { end = end - 1; }
    if end == 0 { return 0xffffffff; }
    let kind: u8 = *((plaintext + ((end - 1) as u64)) as *u8);
    if kind != 21 && kind != 22 && kind != 23 { return 0xffffffff; }
    *((content_type) as *u8) = kind;
    for i: u32 in (end - 1)..ciphertext_length { *((plaintext + (i as u64)) as *u8) = 0; }
    return end - 1;
}

fn tls13_encrypt_record(key: u64, write_iv: u64, sequence: u64,
                        content: u64, content_length: u32, content_type: u8,
                        padding_length: u32, record: u64, record_capacity: u32) -> u32 {
    if content_length > 16384 || padding_length > 255
        || content_length > 16623 - padding_length { return 0; }
    let inner_length: u32 = content_length + 1 + padding_length;
    let encrypted_length: u32 = inner_length + 16; let record_length: u32 = encrypted_length + 5;
    if record_length > record_capacity { return 0; }
    for i: u32 in 0..content_length {
        g_tls13_record_encrypt_scratch[i] = *((content + (i as u64)) as *u8);
    }
    g_tls13_record_encrypt_scratch[content_length] = content_type;
    for i: u32 in 0..padding_length { g_tls13_record_encrypt_scratch[content_length + 1 + i] = 0; }
    *((record + 0) as *u8) = 23; *((record + 1) as *u8) = 3; *((record + 2) as *u8) = 3;
    tls13_write_u16(record, 3, encrypted_length);
    let nonce: [u8; 12] = [0; 12]; let tag: [u8; 16] = [0; 16];
    tls13_record_nonce(write_iv, sequence, &nonce as u64);
    if !tls_chacha20_poly1305_encrypt(key, &nonce as u64, record, 5,
        &g_tls13_record_encrypt_scratch as u64, inner_length, record + 5, &tag as u64) { return 0; }
    for i: u32 in 0..16 { *((record + ((5 + inner_length + i) as u64)) as *u8) = tag[i]; }
    return record_length;
}

fn tls13_finished_calculate(handshake_traffic_secret: u64, transcript_hash: u64,
                            output: u64) -> bool {
    let finished_key: [u8; 32] = [0; 32];
    return tls13_expand_label(handshake_traffic_secret, "finished" as u64, 8,
                              "" as u64, 0, &finished_key as u64, 32)
        && tls_hmac_sha256(&finished_key as u64, 32, transcript_hash, 32, output);
}

fn tls13_finished_verify(handshake_traffic_secret: u64, transcript_hash: u64,
                         received: u64) -> bool {
    let expected: [u8; 32] = [0; 32];
    return tls13_finished_calculate(handshake_traffic_secret, transcript_hash, &expected as u64)
        && tls_bytes_equal(&expected as u64, received, 32);
}

// TLS handshake messages form one byte stream and are independent of record
// boundaries.  Keep a bounded 64 KiB queue so split headers, split bodies, and
// multiple messages in one record are handled without trusting partial input.
fn tls13_handshake_reset() { g_tls13_handshake_buffered = 0; }

fn tls13_handshake_feed(input: u64, input_length: u32) -> bool {
    if input_length > 65536 - g_tls13_handshake_buffered { g_tls13_handshake_buffered = 0; return false; }
    for i: u32 in 0..input_length {
        g_tls13_handshake_reassembly[g_tls13_handshake_buffered + i] = *((input + (i as u64)) as *u8);
    }
    g_tls13_handshake_buffered = g_tls13_handshake_buffered + input_length;
    if g_tls13_handshake_buffered >= 4 && tls13_read_u24(&g_tls13_handshake_reassembly as u64, 1) > 65532 {
        g_tls13_handshake_buffered = 0; return false;
    }
    return true;
}

fn tls13_handshake_ready() -> bool {
    if g_tls13_handshake_buffered < 4 { return false; }
    let payload_length: u32 = tls13_read_u24(&g_tls13_handshake_reassembly as u64, 1);
    return payload_length <= 65532 && payload_length + 4 <= g_tls13_handshake_buffered;
}

fn tls13_handshake_type() -> u8 {
    if !tls13_handshake_ready() { return 0; }
    return g_tls13_handshake_reassembly[0];
}

fn tls13_handshake_size() -> u32 {
    if !tls13_handshake_ready() { return 0; }
    return tls13_read_u24(&g_tls13_handshake_reassembly as u64, 1) + 4;
}

fn tls13_handshake_payload() -> u64 { return &g_tls13_handshake_reassembly as u64 + 4; }

fn tls13_handshake_consume() -> bool {
    let size: u32 = tls13_handshake_size(); if size == 0 { return false; }
    let remaining: u32 = g_tls13_handshake_buffered - size;
    for i: u32 in 0..remaining { g_tls13_handshake_reassembly[i] = g_tls13_handshake_reassembly[size + i]; }
    g_tls13_handshake_buffered = remaining; return true;
}

fn tls13_parse_certificate_verify(message: u64, message_length: u32, expected_scheme: u32,
                                  signature_offset: u64, signature_length: u64) -> bool {
    if message_length < 72 || message_length > 520 || *((message + 0) as *u8) != 15
        || tls13_read_u24(message, 1) + 4 != message_length
        || tls13_read_u16(message, 4) != expected_scheme { return false; }
    let length: u32 = tls13_read_u16(message, 6);
    if length < 64 || length > 512 || length + 8 != message_length { return false; }
    *((signature_offset) as *u32) = 8; *((signature_length) as *u32) = length; return true;
}

fn tls13_certificate_verify_hash(transcript_hash: u64, output: u64) {
    let input: [u8; 130] = [0; 130];
    for i: u32 in 0..64 { input[i] = 32; }
    let context: u64 = "TLS 1.3, server CertificateVerify" as u64;
    for i: u32 in 0..33 { input[64 + i] = *((context + (i as u64)) as *u8); }
    input[97] = 0;
    for i: u32 in 0..32 { input[98 + i] = *((transcript_hash + (i as u64)) as *u8); }
    tls_sha256(&input as u64, 130, output);
}

fn tls13_verify_rsa_certificate_verify(message: u64, message_length: u32,
                                       transcript_hash: u64, modulus: u64,
                                       modulus_length: u32, exponent: u32) -> bool {
    let signature_offset: u32 = 0; let signature_length: u32 = 0;
    if !tls13_parse_certificate_verify(message, message_length, 0x0804,
        &signature_offset as u64, &signature_length as u64) { return false; }
    let digest: [u8; 32] = [0; 32]; tls13_certificate_verify_hash(transcript_hash, &digest as u64);
    return tls_rsa_pss_sha256_verify_hash(message + (signature_offset as u64), signature_length,
                                          modulus, modulus_length, exponent, &digest as u64);
}

fn tls13_self_test() {
    let derived: [u8; 32] = [0; 32];
    let ok: bool = tls13_derive_secret(&TLS13_DERIVED_PRK1 as u64, "derived" as u64, 7, "" as u64, 0, &derived as u64);
    g_tls13_key_schedule_ok = ok && tls_bytes_equal(&derived as u64, &TLS13_DERIVED_OUTPUT1 as u64, 32);
    let random: [u8; 32] = [0; 32]; for i: u32 in 0..32 { random[i] = i as u8; }
    g_tls13_client_hello_test_len = tls13_build_client_hello(
        "example.com" as u64, 11, &random as u64, &TLS_X25519_ALICE_PUBLIC as u64,
        &g_tls13_client_hello_test as u64, 512);
    g_tls13_client_hello_ok = g_tls13_client_hello_test_len > 128
        && g_tls13_client_hello_test[0] == 22 && g_tls13_client_hello_test[5] == 1
        && g_tls13_client_hello_test[46] == 0x13 && g_tls13_client_hello_test[47] == 0x03;
    g_tls13_server_hello_ok = tls13_parse_server_hello(
        &TLS13_SERVER_HELLO1 as u64, 95, 0x1301, &g_tls13_server_key_test as u64)
        && tls_bytes_equal(&g_tls13_server_key_test as u64, &TLS13_SERVER_KEY1 as u64, 32);
    let client_traffic: [u8; 32] = [0; 32]; let client_key: [u8; 16] = [0; 16]; let client_iv: [u8; 12] = [0; 12];
    let secrets_ok: bool = tls13_handshake_secret(
        &TLS13_CLIENT_PRIVATE1 as u64, &TLS13_SERVER_KEY1 as u64, &g_tls13_handshake_secret_test as u64)
        && tls13_handshake_traffic(&g_tls13_handshake_secret_test as u64, &TLS13_TRANSCRIPT_HASH1 as u64,
                                   &client_traffic as u64, &g_tls13_server_traffic_test as u64)
        && tls13_traffic_key(&client_traffic as u64, &client_key as u64, 16, &client_iv as u64)
        && tls13_traffic_key(&g_tls13_server_traffic_test as u64, &g_tls13_server_write_key_test as u64,
                             16, &g_tls13_server_write_iv_test as u64);
    g_tls13_handshake_keys_ok = secrets_ok
        && tls_bytes_equal(&g_tls13_handshake_secret_test as u64, &TLS13_HANDSHAKE_SECRET1 as u64, 32)
        && tls_bytes_equal(&client_traffic as u64, &TLS13_CLIENT_HS_TRAFFIC1 as u64, 32)
        && tls_bytes_equal(&g_tls13_server_traffic_test as u64, &TLS13_SERVER_HS_TRAFFIC1 as u64, 32)
        && tls_bytes_equal(&g_tls13_server_write_key_test as u64, &TLS13_SERVER_WRITE_KEY1 as u64, 16)
        && tls_bytes_equal(&g_tls13_server_write_iv_test as u64, &TLS13_SERVER_WRITE_IV1 as u64, 12);
    // Exercise the complete TLS record nonce/AAD/inner-content path with the
    // RFC 8439 ChaCha20-Poly1305 key and a sequence number of zero.
    let record: [u8; 27] = [0; 27]; let inner: [u8; 6] = [0x68, 0x65, 0x6c, 0x6c, 0x6f, 22];
    record[0] = 23; record[1] = 3; record[2] = 3; record[3] = 0; record[4] = 22;
    let record_tag: [u8; 16] = [0; 16]; let record_nonce: [u8; 12] = [0; 12];
    tls13_record_nonce(&TLS_AEAD_NONCE1 as u64, 0, &record_nonce as u64);
    let record_encrypted: bool = tls_chacha20_poly1305_encrypt(
        &TLS_AEAD_KEY1 as u64, &record_nonce as u64, &record as u64, 5,
        &inner as u64, 6, &record as u64 + 5, &record_tag as u64);
    for i: u32 in 0..16 { record[11 + i] = record_tag[i]; }
    g_tls13_record_plaintext_len = tls13_decrypt_record(
        &TLS_AEAD_KEY1 as u64, &TLS_AEAD_NONCE1 as u64, 0, &record as u64, 27,
        &g_tls13_record_plaintext_test as u64, 16, &g_tls13_record_content_type as u64);
    g_tls13_record_ok = record_encrypted && g_tls13_record_plaintext_len == 5
        && g_tls13_record_content_type == 22
        && tls_bytes_equal(&g_tls13_record_plaintext_test as u64, "hello" as u64, 5);
    let finished_calculated: bool = tls13_finished_calculate(
        &TLS13_SERVER_HS_TRAFFIC1 as u64, &TLS13_SERVER_FINISHED_HASH1 as u64,
        &g_tls13_finished_test as u64);
    g_tls13_finished_ok = finished_calculated
        && tls_bytes_equal(&g_tls13_finished_test as u64, &TLS13_SERVER_FINISHED1 as u64, 32)
        && tls13_finished_verify(&TLS13_SERVER_HS_TRAFFIC1 as u64,
                                 &TLS13_SERVER_FINISHED_HASH1 as u64, &TLS13_SERVER_FINISHED1 as u64);
    let fragment1: [u8; 2] = [8, 0];
    let fragment2: [u8; 7] = [0, 2, 0, 0, 11, 0, 0];
    let fragment3: [u8; 4] = [3, 1, 2, 3];
    tls13_handshake_reset();
    let first_partial: bool = tls13_handshake_feed(&fragment1 as u64, 2) && !tls13_handshake_ready();
    let first_ready: bool = tls13_handshake_feed(&fragment2 as u64, 7) && tls13_handshake_ready()
        && tls13_handshake_type() == 8 && tls13_handshake_size() == 6
        && *((tls13_handshake_payload() + 0) as *u8) == 0 && *((tls13_handshake_payload() + 1) as *u8) == 0;
    let consumed: bool = tls13_handshake_consume() && !tls13_handshake_ready();
    let second_ready: bool = tls13_handshake_feed(&fragment3 as u64, 4) && tls13_handshake_ready()
        && tls13_handshake_type() == 11 && tls13_handshake_size() == 7;
    if second_ready {
        g_tls13_reassembly_type_test = tls13_handshake_type();
        for i: u32 in 0..3 { g_tls13_reassembly_payload_test[i] = *((tls13_handshake_payload() + (i as u64)) as *u8); }
    }
    let oversized: [u8; 4] = [11, 1, 0, 0]; tls13_handshake_reset();
    let oversized_rejected: bool = !tls13_handshake_feed(&oversized as u64, 4);
    g_tls13_reassembly_ok = first_partial && first_ready && consumed && second_ready && oversized_rejected
        && tls_bytes_equal(&g_tls13_reassembly_payload_test as u64, &fragment3 as u64 + 1, 3);
    tls13_handshake_reset();
    let certificate_verify: [u8; 136] = [0; 136];
    certificate_verify[0] = 15; certificate_verify[1] = 0; certificate_verify[2] = 0; certificate_verify[3] = 132;
    certificate_verify[4] = 0x08; certificate_verify[5] = 0x04;
    certificate_verify[6] = 0; certificate_verify[7] = 128;
    for i: u32 in 0..128 { certificate_verify[8 + i] = TLS_RSA_PSS_SIGNATURE1[i]; }
    tls13_certificate_verify_hash(&TLS13_CERT_VERIFY_TRANSCRIPT1 as u64,
                                  &g_tls13_certificate_verify_hash_test as u64);
    let verify_ok: bool = tls13_verify_rsa_certificate_verify(
        &certificate_verify as u64, 136, &TLS13_CERT_VERIFY_TRANSCRIPT1 as u64,
        &TLS_RSA_MODULUS1 as u64, 128, 65537);
    certificate_verify[5] = 0x05; // rsa_pss_rsae_sha384 was not negotiated.
    let bad_offset: u32 = 0; let bad_length: u32 = 0;
    g_tls13_certificate_verify_ok = verify_ok
        && tls_bytes_equal(&g_tls13_certificate_verify_hash_test as u64, &TLS13_CERT_VERIFY_HASH1 as u64, 32)
        && !tls13_parse_certificate_verify(&certificate_verify as u64, 136, 0x0804,
                                           &bad_offset as u64, &bad_length as u64);
    let client_app_key: [u8; 16] = [0; 16]; let client_app_iv: [u8; 12] = [0; 12];
    let server_app_key: [u8; 16] = [0; 16]; let server_app_iv: [u8; 12] = [0; 12];
    let application_ok: bool = tls13_master_secret(
        &TLS13_HANDSHAKE_SECRET1 as u64, &g_tls13_master_secret_test as u64)
        && tls13_application_traffic(&g_tls13_master_secret_test as u64,
            &TLS13_SERVER_FINISHED_TRANSCRIPT1 as u64,
            &g_tls13_client_app_test as u64, &g_tls13_server_app_test as u64)
        && tls13_traffic_key(&g_tls13_client_app_test as u64, &client_app_key as u64, 16, &client_app_iv as u64)
        && tls13_traffic_key(&g_tls13_server_app_test as u64, &server_app_key as u64, 16, &server_app_iv as u64)
        && tls13_finished_calculate(&TLS13_CLIENT_HS_TRAFFIC1 as u64,
            &TLS13_SERVER_FINISHED_TRANSCRIPT1 as u64, &g_tls13_client_finished_test as u64);
    g_tls13_application_keys_ok = application_ok
        && tls_bytes_equal(&g_tls13_master_secret_test as u64, &TLS13_MASTER_SECRET1 as u64, 32)
        && tls_bytes_equal(&g_tls13_client_app_test as u64, &TLS13_CLIENT_APP_TRAFFIC1 as u64, 32)
        && tls_bytes_equal(&g_tls13_server_app_test as u64, &TLS13_SERVER_APP_TRAFFIC1 as u64, 32)
        && tls_bytes_equal(&g_tls13_client_finished_test as u64, &TLS13_CLIENT_FINISHED1 as u64, 32);
    let encrypted_record: [u8; 64] = [0; 64]; let decrypted_record: [u8; 32] = [0; 32];
    let encrypted_record_length: u32 = tls13_encrypt_record(
        &TLS_AEAD_KEY1 as u64, &TLS_AEAD_NONCE1 as u64, 7,
        "finished" as u64, 8, 22, 3, &encrypted_record as u64, 64);
    let decrypted_type: u8 = 0;
    let decrypted_length: u32 = tls13_decrypt_record(
        &TLS_AEAD_KEY1 as u64, &TLS_AEAD_NONCE1 as u64, 7,
        &encrypted_record as u64, encrypted_record_length,
        &decrypted_record as u64, 32, &decrypted_type as u64);
    g_tls13_encrypt_record_ok = encrypted_record_length == 33 && decrypted_length == 8
        && decrypted_type == 22 && tls_bytes_equal(&decrypted_record as u64, "finished" as u64, 8)
        && tls13_encrypt_record(&TLS_AEAD_KEY1 as u64, &TLS_AEAD_NONCE1 as u64, 7,
                                "finished" as u64, 8, 22, 3, &encrypted_record as u64, 32) == 0;
}
