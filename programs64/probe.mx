// First protected x86-64 MortOS userspace program.
//
// The first write deliberately supplies a supervisor-only pointer and must
// return -EFAULT. The second writes from the executable's mapped RX segment.
// Returning 42 reaches pstart.s, which performs SYS_exit.

extern fn mortos_write(text: *u8, length: u64) -> u64;
extern fn mortos_getpid() -> u64;
extern fn mortos_yield() -> u64;

fn main() -> int {
    if mortos_getpid() != 1 {
        return 3;
    }
    let denied: u64 = mortos_write((0x00200000 as u64) as *u8, 4);
    if denied != ~(13 as u64) {
        return 1;
    }
    if mortos_yield() != 0 || mortos_getpid() != 1 {
        return 4;
    }
    if mortos_write("MORT64 PROCESS 1 RESUMED\r\n", 26) != 26 {
        return 5;
    }
    let written: u64 = mortos_write("MORT64 USERSPACE OK\r\n", 21);
    if written != 21 {
        return 2;
    }
    return 42;
}
