// hwtest/ahci_demo.mx — standalone verification kernel for net/ahci.mx.
//
// Not part of the OS build. hwtest/build_ahci_demo.py concatenates net/ahci.mx
// with this file into a minimal multiboot kernel. Booted with an ich9-ahci
// controller and a raw test disk, it inits the controller, brings up the disk's
// port, and reads sectors 0 and 1 over DMA, printing them on COM1. If the bytes
// match the known on-disk pattern the harness wrote, the driver really reads the
// hardware. This file supplies its own PCI accessors so the demo needs nothing
// from the rest of the tree (the full kernel uses net/rtl8139.mx's copies).

let COM1: u16 = 0x3F8;

// ---- PCI config space (mechanism #1: ports 0xCF8 / 0xCFC) ----
fn pci_addr(bus: u8, slot: u8, func: u8, off: u8) -> u32 {
    return 0x80000000
        | ((bus as u32) << 16)
        | ((slot as u32) << 11)
        | ((func as u32) << 8)
        | ((off as u32) & 0xFC);
}
fn pci_read32(bus: u8, slot: u8, func: u8, off: u8) -> u32 {
    outl(0xCF8, pci_addr(bus, slot, func, off));
    return inl(0xCFC);
}
fn pci_write32(bus: u8, slot: u8, func: u8, off: u8, val: u32) {
    outl(0xCF8, pci_addr(bus, slot, func, off));
    outl(0xCFC, val);
}

// ---- COM1 serial (proof log) ----
fn serial_init() {
    outb(COM1 + 1, 0x00);
    outb(COM1 + 3, 0x80);
    outb(COM1 + 0, 0x03);
    outb(COM1 + 1, 0x00);
    outb(COM1 + 3, 0x03);
    outb(COM1 + 2, 0xC7);
    outb(COM1 + 4, 0x0B);
}
fn serial_putc(c: u8) {
    while (inb(COM1 + 5) & 0x20) == 0 {
    }
    outb(COM1, c);
}
fn serial_puts(s: u64) {
    let i: u64 = 0;
    let c: u8 = *((s) as *u8);
    while c != 0 {
        serial_putc(c);
        i = i + 1;
        c = *((s + i) as *u8);
    }
}
fn hexdig(v: u8) -> u8 {
    if v < 10 {
        return 48 + v;
    }
    return 87 + v;
}
fn serial_hex8(b: u8) {
    serial_putc(hexdig((b >> 4) & 0xF));
    serial_putc(hexdig(b & 0xF));
}
fn serial_hex32(v: u32) {
    serial_hex8(((v >> 24) & 0xFF) as u8);
    serial_hex8(((v >> 16) & 0xFF) as u8);
    serial_hex8(((v >> 8) & 0xFF) as u8);
    serial_hex8((v & 0xFF) as u8);
}
fn yn(b: bool) -> u8 {
    if b {
        return 121;          // 'y'
    }
    return 110;              // 'n'
}
fn serial_ascii(addr: u64, n: u32) {
    let i: u32 = 0;
    while i < n {
        let c: u8 = *((addr + (i as u64)) as *u8);
        if c >= 32 && c < 127 {
            serial_putc(c);
        } else {
            serial_putc(46);    // '.'
        }
        i = i + 1;
    }
}

// DMA target for the sector reads (512 bytes, even address = DMA-safe).
let g_demo_buf: [u8; 512] = [0; 512];

fn kmain(mb: u64) {
    serial_init();
    serial_puts("=== ahci driver demo ===" as u64);
    serial_putc(10);

    let ok: bool = ahci_init();

    serial_puts("present=" as u64);
    serial_putc(yn(g_ahci_present));
    serial_puts(" ready=" as u64);
    serial_putc(yn(g_ahci_ready));
    serial_puts(" error=" as u64);
    serial_hex8(g_ahci_error as u8);
    serial_putc(10);

    serial_puts("abar=" as u64);
    serial_hex32((g_ahci_abar & 0xFFFFFFFF) as u32);
    serial_puts(" pi=" as u64);
    serial_hex32(g_ahci_pi);
    serial_puts(" disk_port=" as u64);
    serial_hex8(g_ahci_disk_port as u8);
    serial_puts(" sig=" as u64);
    serial_hex32(g_ahci_sig);
    serial_putc(10);

    if ok {
        let r0: bool = ahci_read(0, 1, &g_demo_buf as u64);
        serial_puts("read lba0=" as u64);
        serial_putc(yn(r0));
        serial_puts(" s0:[" as u64);
        serial_ascii(&g_demo_buf as u64, 40);
        serial_puts("]" as u64);
        serial_putc(10);

        let r1: bool = ahci_read(1, 1, &g_demo_buf as u64);
        serial_puts("read lba1=" as u64);
        serial_putc(yn(r1));
        serial_puts(" s1:[" as u64);
        serial_ascii(&g_demo_buf as u64, 40);
        serial_puts("]" as u64);
        serial_putc(10);
    }

    serial_puts("demo done" as u64);
    serial_putc(10);

    outb(0xf4, 0x00);            // isa-debug-exit: ask QEMU to quit

    let hang: u32 = 1;
    while hang == 1 {
        asm("hlt");
    }
}
