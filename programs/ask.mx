// An interactive MORT OS program: it asks for your name, reads a line of
// keyboard input through a syscall, and greets you.

fn main() -> int {
    puts("what is your name? ");
    let name: *u8 = read_line();
    puts("hello, ");
    puts(name);
    putln("! welcome to a program running on mort os.");
    return 0;
}
