// kill: terminate a process by pid. There is no scheduler, so the only process
// that can be alive besides the kernel is this program (see docs/programs.md).

fn main() -> int {
    if argc() != 2 {
        putln("usage: kill <pid>");
        return 2;
    }
    let pid: u32 = str_to_u32(argv(1));
    if pid == NOT_A_NUMBER {
        putln("usage: kill <pid>");
        return 2;
    }
    let r: u32 = kill(pid);
    if is_err(r) {
        putf("kill: %s: %s\n", argv(1) as u32, err_str(err_of(r)) as u32, 0);
        return 1;
    }
    return 0;
}
