// ----- linear framebuffer (graphics mode) -----
//
// If the bootloader honored the multiboot graphics request (see boot.s), the
// info struct carries a linear framebuffer: flags bit 12 set, and at these
// offsets — addr(88, u64), pitch(96), width(100), height(104), bpp(108, u8),
// type(109, u8). We use 32-bpp direct-RGB (type 1) only; anything else stays
// in text mode. Colors are 0x00RRGGBB.
fn fb_init() {
    let flags: u32 = *(g_mbinfo as *u32);
    if (flags & 4096) == 0 {                 // bit 12: framebuffer info present
        return;
    }
    let bpp: u8 = *((g_mbinfo + 108) as *u8);
    let kind: u8 = *((g_mbinfo + 109) as *u8);
    if bpp != 32 || kind != 1 {              // only 32-bpp direct RGB
        return;
    }
    g_fb = *((g_mbinfo + 88) as *u32);       // low 32 bits of the address
    g_fb_pitch = *((g_mbinfo + 96) as *u32);
    g_fb_w = *((g_mbinfo + 100) as *u32);
    g_fb_h = *((g_mbinfo + 104) as *u32);
    g_gfx = true;
}

fn put_pixel(x: u32, y: u32, color: u32) {
    *((g_fb + y * g_fb_pitch + x * 4) as *u32) = color;
}

// Fill the rectangle [x, x+w) x [y, y+h) with a solid color.
fn fill_rect(x: u32, y: u32, w: u32, h: u32, color: u32) {
    let yy: u32 = 0;
    while yy < h {
        let row: u32 = g_fb + (y + yy) * g_fb_pitch + x * 4;
        let xx: u32 = 0;
        while xx < w {
            *((row + xx * 4) as *u32) = color;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

// Small software-rounded rectangle used by the MortuexOS chrome.  The kernel
// has no compositor or alpha channel yet, so rounded surfaces are rasterized
// directly into the framebuffer with progressively inset edge scanlines.
fn fill_round_rect(x: u32, y: u32, w: u32, h: u32, radius: u32, color: u32) {
    if w == 0 || h == 0 { return; }
    if radius == 0 { fill_rect(x, y, w, h, color); return; }
    let yy: u32 = 0;
    while yy < h {
        let edge: u32 = yy;
        let bottom: u32 = h - 1 - yy;
        if bottom < edge { edge = bottom; }
        let inset: u32 = 0;
        if edge < radius {
            let left: u32 = radius - edge;
            inset = (left * left + radius - 1) / (radius * 2);
        }
        if inset * 2 < w { fill_rect(x + inset, y + yy, w - inset * 2, 1, color); }
        yy = yy + 1;
    }
}

fn outline_round_rect(x: u32, y: u32, w: u32, h: u32, radius: u32, border: u32, inside: u32) {
    fill_round_rect(x, y, w, h, radius, border);
    if w > 2 && h > 2 {
        let inner_radius: u32 = radius;
        if inner_radius > 1 { inner_radius = inner_radius - 1; }
        fill_round_rect(x + 1, y + 1, w - 2, h - 2, inner_radius, inside);
    }
}

// Integer line rasterizer for compact vector marks and app glyphs.
fn draw_line(x0: u32, y0: u32, x1: u32, y1: u32, thickness: u32, color: u32) {
    let ax: i32 = x0 as i32;
    let ay: i32 = y0 as i32;
    let dx: i32 = (x1 as i32) - ax;
    let dy: i32 = (y1 as i32) - ay;
    let adx: i32 = dx; if adx < 0 { adx = 0 - adx; }
    let ady: i32 = dy; if ady < 0 { ady = 0 - ady; }
    let steps: i32 = adx; if ady > steps { steps = ady; }
    if steps == 0 { fill_rect(x0, y0, thickness, thickness, color); return; }
    let i: i32 = 0;
    while i <= steps {
        let px: i32 = ax + dx * i / steps;
        let py: i32 = ay + dy * i / steps;
        if px >= 0 && py >= 0 {
            fill_rect(px as u32, py as u32, thickness, thickness, color);
        }
        i = i + 1;
    }
}

// The MortuexOS mark from the desktop design: an iris tile and open M path.
fn draw_brand_mark(cx: u32, cy: u32) {
    fill_round_rect(cx - 18, cy - 18, 36, 36, 9, 0x877bff);
    draw_line(cx - 10, cy + 9, cx - 10, cy - 9, 3, 0x0a0b12);
    draw_line(cx - 10, cy - 9, cx - 4, cy + 1, 3, 0x0a0b12);
    draw_line(cx - 4, cy + 1, cx, cy - 4, 3, 0x0a0b12);
    draw_line(cx, cy - 4, cx + 4, cy + 1, 3, 0x0a0b12);
    draw_line(cx + 4, cy + 1, cx + 10, cy - 9, 3, 0x0a0b12);
    draw_line(cx + 10, cy - 9, cx + 10, cy + 9, 3, 0x0a0b12);
}

fn mouse_hide() {
    if !g_gfx || !g_mouse_visible { return; }
    for yy: u32 in 0..18 {
        for xx: u32 in 0..12 {
            *((g_fb + (g_mouse_y + yy) * g_fb_pitch + (g_mouse_x + xx) * 4) as *u32) = g_mouse_save[yy * 12 + xx];
        }
    }
    g_mouse_visible = false;
}

fn mouse_show() {
    if !g_gfx || !g_mouse_present || g_mouse_visible { return; }
    for yy: u32 in 0..18 {
        for xx: u32 in 0..12 {
            let addr: u32 = g_fb + (g_mouse_y + yy) * g_fb_pitch + (g_mouse_x + xx) * 4;
            g_mouse_save[yy * 12 + xx] = *(addr as *u32);
            let arrow: bool = false;
            let edge: bool = false;
            if yy < 12 && xx <= yy / 2 {
                arrow = true;
                edge = xx == 0 || xx == yy / 2 || yy == 11;
            }
            if yy >= 9 && yy < 17 && xx >= 3 && xx <= 5 { arrow = true; if xx == 3 || xx == 5 || yy == 16 { edge = true; } }
            if arrow { *(addr as *u32) = 0xffffff; if edge { *(addr as *u32) = 0x101820; } }
        }
    }
    g_mouse_visible = true;
}

fn mouse_click() {
    if g_gfx && (g_overlay == 0 || g_overlay == 4) {
        let dock_x: u32 = (g_fb_w - 520) / 2;
        let dock_y: u32 = g_fb_h - 72;
        if g_mouse_y >= dock_y && g_mouse_y < dock_y + 56 {
            if g_mouse_x >= dock_x && g_mouse_x < dock_x + 246 {
                if g_overlay == 0 { open_launcher(); }
                return;
            }
            for app: u32 in 0..4 {
                let cx: u32 = dock_x + 278 + app * 50;
                if g_mouse_x >= cx - 22 && g_mouse_x < cx + 22 {
                    g_overlay = 0;
                    g_app = app;
                    restore_desktop();
                    return;
                }
            }
            if g_mouse_x >= dock_x + 460 && g_mouse_x < dock_x + 504 {
                if g_overlay == 4 { g_overlay = 0; restore_desktop(); }
                open_power_menu();
                return;
            }
        }
    }
    if g_overlay == 4 {
        let startx: u32 = 164;
        if g_mouse_y >= 320 && g_mouse_y < 464 && g_mouse_x >= startx - 2 {
            let tile: u32 = (g_mouse_x - (startx - 2)) / 140;
            if tile < 5 && g_mouse_x < startx + tile * 140 + 126 {
                g_launch_sel = tile;
                launcher_on_key(28);
            }
        }
        return;
    }
    if g_overlay == 0 && g_app == 2 { browser_click(g_mouse_x, g_mouse_y); return; }
    if g_overlay == 0 && g_app == 3 && g_mouse_x >= 198 && g_mouse_x < 390 && g_mouse_y >= 230 && g_mouse_y < 486 {
        let row: u32 = (g_mouse_y - 230) / 32;
        let section: u32 = g_settings_scroll + row;
        if section < 13 { g_settings_section = section; settings_draw(); }
    }
}

fn mouse_apply_report() {
    if !g_gfx { return; }
    mouse_hide();
    g_mouse_present = true;
    let nx: i32 = (g_mouse_x as i32) + g_usb_mouse_dx;
    let ny: i32 = (g_mouse_y as i32) + g_usb_mouse_dy;
    if nx < 0 { g_mouse_x = 0; } else if nx > (g_fb_w as i32) - 12 { g_mouse_x = g_fb_w - 12; } else { g_mouse_x = nx as u32; }
    if ny < 0 { g_mouse_y = 0; } else if ny > (g_fb_h as i32) - 18 { g_mouse_y = g_fb_h - 18; } else { g_mouse_y = ny as u32; }
    let clicked: bool = (g_usb_mouse_buttons & 1) != 0 && (g_mouse_buttons & 1) == 0;
    g_mouse_buttons = g_usb_mouse_buttons;
    if clicked { mouse_click(); }
    mouse_show();
}

// A vertical gradient background from `top` to `bottom` (per-channel lerp).
fn fill_gradient(top: u32, bottom: u32) {
    let tr: u32 = (top >> 16) & 255;
    let tg: u32 = (top >> 8) & 255;
    let tb: u32 = top & 255;
    let br: u32 = (bottom >> 16) & 255;
    let bg: u32 = (bottom >> 8) & 255;
    let bb: u32 = bottom & 255;
    let y: u32 = 0;
    while y < g_fb_h {
        let r: u32 = tr + (br - tr) * y / g_fb_h;
        let g: u32 = tg + (bg - tg) * y / g_fb_h;
        let b: u32 = tb + (bb - tb) * y / g_fb_h;
        fill_rect(0, y, g_fb_w, 1, (r << 16) | (g << 8) | b);
        y = y + 1;
    }
}

// ----- graphics console (8x16 font on the framebuffer) -----
//
// The 80x25 console lives inside a desktop window. These are its top-left text
// pixel and background; the shell keeps using (row, col) — put_cell_at maps
// them to pixels here when g_gfx is set. CONSOLE_X=192, CONSOLE_Y=196, cell 8x16.

// The 16 standard VGA colors as 0x00RRGGBB (the shell passes these attributes).
fn vga_rgb(idx: u8) -> u32 {
    if idx == 0  { return 0x0b0f14; }   // black -> console background
    if idx == 1  { return 0x2a3fb8; }   // blue
    if idx == 2  { return 0x2ea043; }   // green
    if idx == 3  { return 0x2bb0c4; }   // cyan
    if idx == 4  { return 0xd03b3b; }   // red
    if idx == 5  { return 0xb050c0; }   // magenta
    if idx == 6  { return 0xc08040; }   // brown
    if idx == 7  { return 0xc8d0d4; }   // light grey (normal text)
    if idx == 8  { return 0x556068; }   // dark grey
    if idx == 9  { return 0x5580ff; }   // light blue
    if idx == 10 { return 0x5fd98a; }   // light green (banner)
    if idx == 11 { return 0x66e0ff; }   // light cyan
    if idx == 12 { return 0xff6b6b; }   // light red (errors)
    if idx == 13 { return 0xff77dd; }   // light magenta
    if idx == 14 { return 0xffd24a; }   // yellow
    return 0xffffff;                    // 15 white (input)
}

// Draw one 8x16 glyph at absolute pixel (px, py): set bits get fg, clear get bg.
fn draw_glyph(ch: u8, px: u32, py: u32, fg: u32, bg: u32) {
    let base: u32 = (ch as u32) * 16;
    let row: u32 = 0;
    while row < 16 {
        let bits: u8 = g_font[base + row];
        let line: u32 = g_fb + (py + row) * g_fb_pitch + px * 4;
        let col: u32 = 0;
        while col < 8 {
            let color: u32 = bg;
            if ((bits >> (7 - col)) & 1) == 1 {
                color = fg;
            }
            *((line + col * 4) as *u32) = color;
            col = col + 1;
        }
        row = row + 1;
    }
}

// Draw a NUL-terminated string at absolute pixel coords (for desktop chrome).
fn draw_text_abs(s: *u8, px: u32, py: u32, fg: u32, bg: u32) {
    let i: u32 = 0;
    while true {
        let ch: u8 = *((s as u32 + i) as *u8);
        if ch == 0 {
            return;
        }
        draw_glyph(ch, px + i * 8, py, fg, bg);
        i = i + 1;
    }
}

// One clickable-looking app tab in the top bar; the active app is highlighted.
fn draw_tab(label: *u8, x: u32, id: u32) {
    let w: u32 = str_len(label) * 8 + 12;
    let bg: u32 = 0x0d141c;
    let fg: u32 = 0x7a8b93;
    if g_app == id {
        bg = g_accent;
        fg = 0xffffff;
    }
    fill_rect(x - 6, 2, w, 20, bg);
    draw_text_abs(label, x, 4, fg, bg);
}

// The top bar: the OS name, app switcher tabs (F1/F2/F3), a power hint, and the
// clock (drawn by draw_clock, called at the end).
fn draw_topbar() {
    fill_rect(0, 0, g_fb_w, 44, 0x0b0d14);
    fill_rect(0, 43, g_fb_w, 1, 0x262a3a);
    draw_brand_mark(28, 22);
    draw_text_abs("mortuexOS", 56, 14, 0xe9ebf5, 0x0b0d14);
    draw_text_abs("bare metal / Mort native", 152, 14, 0x5d6379, 0x0b0d14);
    draw_clock();
}

// Set the window title bar text (each app names its own window).
fn window_title(s: *u8) {
    fill_rect(182, 162, 660, 24, 0x191c28);
    fill_rect(182, 185, 660, 1, 0x262a3a);
    fill_round_rect(192, 169, 10, 10, 3, g_accent);
    draw_text_abs(s, 212, 166, 0xe9ebf5, 0x191c28);
    draw_text_abs("-", 776, 166, 0x969cb3, 0x191c28);
    draw_text_abs("[ ]", 792, 166, 0x969cb3, 0x191c28);
    draw_text_abs("x", 828, 166, 0x969cb3, 0x191c28);
}

// Clear the window interior (shared by every app).
fn clear_window() {
    fill_rect(184, 188, 656, 424, 0x08090e);
}

// Paint the whole desktop: gradient wallpaper, top bar, and the window frame.
// Called once at boot when a framebuffer is present; the active app fills the
// interior. Defaults to the terminal.
fn draw_desktop() {
    fill_gradient(g_wall_top, g_wall_bottom);
    draw_topbar();
    fill_round_rect(188, 170, 664, 456, 14, 0x05060a);         // soft offset shadow
    outline_round_rect(180, 160, 664, 456, 14, 0x363b4f, 0x12141d);
    window_title("terminal");
    clear_window();
    draw_dock();
}

// ----- text output (framebuffer glyphs when g_gfx, else VGA text memory) -----

fn put_index(index: u32, ch: u8, color: u8) {
    let addr: u32 = 0xB8000 + index * 2;
    *(addr as *u8) = ch;
    *((addr + 1) as *u8) = color;
}

fn put_cell_at(row: u32, col: u32, ch: u8, color: u8) {
    if g_gfx {
        let fg: u32 = vga_rgb(color & 15);
        let bghi: u8 = (color >> 4) & 15;
        let bg: u32 = 0x0b0f14;                 // console background
        if bghi != 0 {
            bg = vga_rgb(bghi);
        }
        draw_glyph(ch, 192 + col * 8, 196 + row * 16, fg, bg);
        return;
    }
    put_index(row * 80 + col, ch, color);
}

fn print_at(s: *u8, row: u32, col: u32, color: u8) {
    let i: u32 = 0;
    while true {
        let ch: u8 = *((s as u32 + i) as *u8);
        if ch == 0 {
            return;
        }
        put_cell_at(row, col + i, ch, color);
        i = i + 1;
    }
}

fn print_string(s: *u8, row: u32, color: u8) {
    print_at(s, row, 0, color);
}

// Write n's decimal digits into buf (NUL-terminated); g_numlen = digit count.
fn write_num(n: u32, buf: *u8) {
    if n >= 10 {
        write_num(n / 10, buf);
    }
    let d: u8 = (n % 10) as u8;
    *((buf as u32 + g_numlen) as *u8) = 48 + d;   // '0' + d
    g_numlen = g_numlen + 1;
}

fn num_to_str(n: u32, buf: *u8) {
    g_numlen = 0;
    write_num(n, buf);
    *((buf as u32 + g_numlen) as *u8) = 0;
}

fn clear_screen() {
    if g_gfx {
        fill_rect(192, 196, 640, 400, 0x0b0f14);   // console interior only
        return;
    }
    for i: u32 in 0..2000 {
        put_index(i, 32, 7);
    }
}

// Scroll the console up by one text line (16 px), blanking the last row. Lets
// output flow like a real terminal.
fn scroll_up() {
    if g_gfx {
        let y: u32 = 0;
        while y < 384 {                            // 24 rows * 16 px, moved up 16
            let dst: u32 = g_fb + (196 + y) * g_fb_pitch + 192 * 4;
            let src: u32 = g_fb + (196 + 16 + y) * g_fb_pitch + 192 * 4;
            let x: u32 = 0;
            while x < 640 {
                *((dst + x * 4) as *u32) = *((src + x * 4) as *u32);
                x = x + 1;
            }
            y = y + 1;
        }
        fill_rect(192, 196 + 384, 640, 16, 0x0b0f14);   // blank the last row
        return;
    }
    let dst: u32 = 0xB8000;
    let src: u32 = 0xB8000 + 160;      // one row = 80 cells * 2 bytes
    let i: u32 = 0;
    while i < 3840 {                    // 24 rows * 160 bytes
        *((dst + i) as *u8) = *((src + i) as *u8);
        i = i + 1;
    }
    let base: u32 = 0xB8000 + 24 * 160; // clear row 24
    let j: u32 = 0;
    while j < 80 {
        *((base + j * 2) as *u8) = 32;
        *((base + j * 2 + 1) as *u8) = 7;
        j = j + 1;
    }
}

// Move to the next line, scrolling when we're already at the bottom row.
fn feed() {
    if g_row >= 24 {
        scroll_up();
    } else {
        g_row = g_row + 1;
    }
}

// ----- scancode -> ASCII (Shift-aware) -----

fn scancode_to_ascii(sc: u8, shift: bool) -> u8 {
    if sc >= 16 && sc <= 25 {
        let c: u8 = *(("qwertyuiop" as u32 + (sc - 16) as u32) as *u8);
        if shift { return c - 32; }
        return c;
    }
    if sc >= 30 && sc <= 38 {
        let c: u8 = *(("asdfghjkl" as u32 + (sc - 30) as u32) as *u8);
        if shift { return c - 32; }
        return c;
    }
    if sc >= 44 && sc <= 50 {
        let c: u8 = *(("zxcvbnm" as u32 + (sc - 44) as u32) as *u8);
        if shift { return c - 32; }
        return c;
    }
    if sc >= 2 && sc <= 11 {
        if shift {
            return *(("!@#$%^&*()" as u32 + (sc - 2) as u32) as *u8);
        }
        return *(("1234567890" as u32 + (sc - 2) as u32) as *u8);
    }
    if sc == 57 { return 32; }
    if sc == 12 { if shift { return 95; } return 45; }   // -  _
    if sc == 13 { if shift { return 43; } return 61; }   // =  +
    if sc == 26 { if shift { return 123; } return 91; }  // [  {
    if sc == 27 { if shift { return 125; } return 93; }  // ]  }
    if sc == 39 { if shift { return 58; } return 59; }   // ;  :
    if sc == 40 { if shift { return 34; } return 39; }   // '  "
    if sc == 41 { if shift { return 126; } return 96; }  // `  ~
    if sc == 43 { if shift { return 124; } return 92; }  // \  |
    if sc == 51 { if shift { return 60; } return 44; }   // ,  <
    if sc == 52 { if shift { return 62; } return 46; }   // .  >
    if sc == 53 { if shift { return 63; } return 47; }   // /  ?
    return 0;
}

// ----- shell -----

fn streq(a: *u8, b: *u8) -> bool {
    let i: u32 = 0;
    while true {
        let ca: u8 = *((a as u32 + i) as *u8);
        let cb: u8 = *((b as u32 + i) as *u8);
        if ca != cb {
            return false;
        }
        if ca == 0 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Move the cursor to (row, col). In graphics mode we draw our own underline
// (there is no hardware cursor): erase the previous one, draw the new one.
fn move_cursor(row: u32, col: u32) {
    if g_gfx {
        fill_rect(192 + g_cur_c * 8, 196 + g_cur_r * 16 + 14, 8, 2, 0x0b0f14);
        fill_rect(192 + col * 8, 196 + row * 16 + 14, 8, 2, 0xc8d0d4);
        g_cur_r = row;
        g_cur_c = col;
        return;
    }
    let pos: u32 = row * 80 + col;
    outb(0x3D4, 14);                    // cursor location high register
    outb(0x3D5, (pos / 256) as u8);
    outb(0x3D4, 15);                    // cursor location low register
    outb(0x3D5, (pos % 256) as u8);
}

// Make the cursor a visible underline (scanlines 14-15, enable bit clear).
// No-op in graphics mode — move_cursor draws the cursor itself.
fn enable_cursor() {
    if g_gfx {
        return;
    }
    outb(0x3D4, 10);
    outb(0x3D5, 14);
    outb(0x3D4, 11);
    outb(0x3D5, 15);
}

// Does `s` begin with `prefix`? (used for commands that take an argument)
fn starts_with(s: *u8, prefix: *u8) -> bool {
    let i: u32 = 0;
    while true {
        let pc: u8 = *((prefix as u32 + i) as *u8);
        if pc == 0 {
            return true;
        }
        let sc: u8 = *((s as u32 + i) as *u8);
        if sc != pc {
            return false;
        }
        i = i + 1;
    }
    return false;
}

// Draw the shell prompt: the current directory (home shown as "~") then "$ ".
// Records its width in g_prompt_len so the input line starts in the right place.
fn draw_prompt(row: u32) {
    let disp: [u8; 64] = [0; 64];
    let home: [u8; 40] = [0; 40];
    str_copy((&home as u64) as *u8, "/home/");
    str_copy(((&home as u64) + 6) as *u8, (&g_username as u64) as *u8);
    if starts_with((&g_cwdpath as u64) as *u8, (&home as u64) as *u8) {
        let hl: u32 = str_len((&home as u64) as *u8);
        *((&disp as u64) as *u8) = 126;                        // '~'
        str_copy(((&disp as u64) + 1) as *u8, ((&g_cwdpath as u64) + (hl as u64)) as *u8);
    } else {
        str_copy((&disp as u64) as *u8, (&g_cwdpath as u64) as *u8);
    }
    let pl: u32 = str_len((&disp as u64) as *u8);
    print_at((&disp as u64) as *u8, row, 0, 11);              // path in cyan
    put_cell_at(row, pl, 32, 7);
    put_cell_at(row, pl + 1, 36, 10);                         // '$' in green
    put_cell_at(row, pl + 2, 32, 7);
    g_prompt_len = pl + 3;
}

// ----- command history (ring of 8 x 40-byte slots) -----

fn str_len(s: *u8) -> u32 {
    let i: u32 = 0;
    while *((s as u32 + i) as *u8) != 0 {
        i = i + 1;
    }
    return i;
}

fn str_copy(dst: *u8, src: *u8) {
    let i: u32 = 0;
    while true {
        let c: u8 = *((src as u32 + i) as *u8);
        *((dst as u32 + i) as *u8) = c;
        if c == 0 {
            return;
        }
        i = i + 1;
    }
}

// Address of the k-th most recent command (k >= 1).
fn hist_slot(k: u32) -> *u8 {
    let idx: u32 = (g_hist_n - k) % 8;
    return (g_history as u32 + idx * 80) as *u8;
}

fn hist_store(cmd: *u8) {
    let slot: *u8 = (g_history as u32 + (g_hist_n % 8) * 80) as *u8;
    str_copy(slot, cmd);
    g_hist_n = g_hist_n + 1;
}

// Replace the current input line (on screen and in g_buf) with `s`.
fn set_input(s: *u8) {
    let i: u32 = 0;
    while i < g_len {                          // erase what's typed now
        put_cell_at(g_row, g_prompt_len + i, 32, 7);
        i = i + 1;
    }
    str_copy(g_buf, s);
    g_len = str_len(g_buf);
    if g_len > 76 {                            // MAXLINE = 76
        g_len = 76;
        *((g_buf as u32 + 76) as *u8) = 0;
    }
    let j: u32 = 0;
    while j < g_len {
        put_cell_at(g_row, g_prompt_len + j, *((g_buf as u32 + j) as *u8), 15);
        j = j + 1;
    }
    g_col = g_prompt_len + g_len;
    move_cursor(g_row, g_col);
}

fn history_up() {
    let max: u32 = g_hist_n;
    if max > 8 { max = 8; }
    if g_hist_nav < max {
        g_hist_nav = g_hist_nav + 1;
        set_input(hist_slot(g_hist_nav));
    }
}

fn history_down() {
    if g_hist_nav > 1 {
        g_hist_nav = g_hist_nav - 1;
        set_input(hist_slot(g_hist_nav));
    } else {
        g_hist_nav = 0;
        set_input("");
    }
}

// Print a byte range as text, handling newlines and scrolling.
fn print_range(start: u32, end: u32, color: u8) {
    let col: u32 = 0;
    let p: u32 = start;
    while p < end {
        let ch: u8 = *(p as *u8);
        if ch == 10 {                 // newline
            feed();
            col = 0;
        } else {
            if ch != 13 {             // ignore carriage returns
                put_cell_at(g_row, col, ch, color);
                col = col + 1;
            }
        }
        p = p + 1;
    }
}

// Start address of multiboot module `index`, or 0 if there aren't that many.
// The info struct has mods_count at offset 20 and mods_addr at 24; each module
// entry is [mod_start, mod_end, string, reserved] (16 bytes).
fn module_start(index: u32) -> u32 {
    let count: u32 = *((g_mbinfo + 20) as *u32);
    if count <= index {
        return 0;
    }
    let mods_addr: u32 = *((g_mbinfo + 24) as *u32);
    return *((mods_addr + index * 16) as *u32);
}

fn module_end(index: u32) -> u32 {
    let mods_addr: u32 = *((g_mbinfo + 24) as *u32);
    return *((mods_addr + index * 16 + 4) as *u32);
}

// Show module 0 — the readme file loaded from disk.
fn show_module() {
    let start: u32 = module_start(0);
    if start == 0 {
        feed();
        print_string("no file loaded (boot the ISO to load one)", g_row, 12);
        return;
    }
    feed();
    print_range(start, module_end(0), 7);
}

// Execute each line of [start, end) as a shell command, echoing it at a
// prompt first. Shared by boot-time script modules and `run <file>`.
fn run_range_lines(start: u32, end: u32) {
    let p: u32 = start;
    let len: u32 = 0;
    while p <= end {
        let ch: u8 = 10;                 // treat one-past-end as a final newline
        if p < end {
            ch = *(p as *u8);
        }
        if ch == 10 {                    // end of line -> run it
            if len > 0 {
                *((g_buf as u32 + len) as *u8) = 0;
                feed();
                draw_prompt(g_row);
                print_at(g_buf, g_row, g_prompt_len, 15);   // echo the command
                run_command(g_buf);
            }
            len = 0;
        } else {
            if ch != 13 {
                if len < 76 {                // MAXLINE = 76
                    *((g_buf as u32 + len) as *u8) = ch;
                    len = len + 1;
                }
            }
        }
        p = p + 1;
    }
}

// Run a script module: this is how MORT OS runs its startup script at boot.
fn run_script(index: u32) {
    let start: u32 = module_start(index);
    if start == 0 {
        return;
    }
    run_range_lines(start, module_end(index));
}

// `run <name>`: execute a MortFS file as shell commands. The name points into
// g_buf, so the whole file must land in FILEBUF before lines reuse g_buf.
fn run_file(name: *u8) {
    if g_run_depth > 0 {                 // a script's `run` would clobber FILEBUF
        feed();
        print_string("run: nested run not allowed", g_row, 12);
        return;
    }
    let i: u32 = fs_find(name);
    if i == 64 {
        feed();
        print_at("not found: ", g_row, 0, 12);
        print_at(name, g_row, 11, 12);
        return;
    }
    let size: u32 = fs_read_file(i);
    g_run_depth = g_run_depth + 1;
    run_range_lines(0x00810000, 0x00810000 + size);    // FILEBUF
    g_run_depth = g_run_depth - 1;
}

// Total available RAM, from the multiboot memory map (flags bit 6). Each mmap
// entry is [size, base(u64), length(u64), type]; the size field excludes itself,
// so advance by size+4. Type 1 = available. We sum the low 32 bits of length
// (enough for the RAM sizes we run on).
fn mem() {
    let flags: u32 = *(g_mbinfo as *u32);
    if (flags & 64) == 0 {           // multiboot flags bit 6 = memory map present
        feed();
        print_string("memory map unavailable", g_row, 12);
        return;
    }
    let len: u32 = *((g_mbinfo + 44) as *u32);
    let addr: u32 = *((g_mbinfo + 48) as *u32);
    let total: u32 = 0;
    let p: u32 = addr;
    let stop: u32 = addr + len;
    while p < stop {
        let size: u32 = *(p as *u32);
        let typ: u32 = *((p + 20) as *u32);
        if typ == 1 {
            total = total + *((p + 12) as *u32);   // length low 32 bits
        }
        p = p + size + 4;
    }
    feed();
    print_at("RAM: ", g_row, 0, 7);
    num_to_str(total / 1048576, g_numbuf);          // bytes -> MiB
    print_at(g_numbuf, g_row, 5, 7);
    print_at(" MB", g_row, 5 + g_numlen, 7);
}

// List the multiboot modules loaded at boot, with their sizes.
fn mods() {
    let count: u32 = *((g_mbinfo + 20) as *u32);
    feed();
    print_at("modules: ", g_row, 0, 7);
    num_to_str(count, g_numbuf);
    print_at(g_numbuf, g_row, 9, 7);
    let mods_addr: u32 = *((g_mbinfo + 24) as *u32);
    let i: u32 = 0;
    while i < count {
        let start: u32 = *((mods_addr + i * 16) as *u32);
        let end: u32 = *((mods_addr + i * 16 + 4) as *u32);
        feed();
        put_cell_at(g_row, 2, 91, 7);               // '['
        num_to_str(i, g_numbuf);
        print_at(g_numbuf, g_row, 3, 7);
        put_cell_at(g_row, 4, 93, 7);               // ']' (module count is small)
        num_to_str(end - start, g_numbuf);
        print_at(g_numbuf, g_row, 6, 7);
        print_at(" bytes", g_row, 6 + g_numlen, 7);
        i = i + 1;
    }
}

// Exercise the heap: allocate, verify writes survive, free, confirm reuse and
// coalescing. Prints a line per check plus a final PASS/FAIL — the smoke test
// for kmalloc/kfree.
fn memtest() {
    feed();
    if !g_heap_ok {
        print_string("heap: unavailable", g_row, 12);
        return;
    }
    let pass: bool = true;

    // 1. Two allocations are distinct and writable.
    let a: u32 = kmalloc(100);
    let b: u32 = kmalloc(200);
    if a == 0 || b == 0 || a == b {
        pass = false;
    }
    *(a as *u32) = 0xCAFE1234;
    *(b as *u32) = 0x00C0FFEE;
    if *(a as *u32) != 0xCAFE1234 || *(b as *u32) != 0x00C0FFEE {
        pass = false;
    }

    // 2. Freeing `a` and allocating a smaller block reuses that space.
    kfree(a);
    let c: u32 = kmalloc(50);
    if c != a {                                  // first-fit should hand back a's slot
        pass = false;
    }

    // 3. b's data is untouched by all of that.
    if *(b as *u32) != 0x00C0FFEE {
        pass = false;
    }

    kfree(b);
    kfree(c);

    feed();
    print_string("heap base ", g_row, 7);
    num_to_str(g_heap_base / 1048576, g_numbuf);
    print_at(g_numbuf, g_row, 10, 15);
    print_at("MB, size ", g_row, 10 + g_numlen, 7);
    num_to_str((g_heap_end - g_heap_base) / 1048576, g_numbuf);
    print_at(g_numbuf, g_row, 19 + g_numlen, 15);
    print_at("MB", g_row, 19 + g_numlen + g_numlen, 7);

    feed();
    if pass {
        print_string("memtest: PASS (alloc, write, free, reuse, coalesce)", g_row, 10);
    } else {
        print_string("memtest: FAIL", g_row, 12);
    }
}

// Reboot by pulsing the CPU reset line through the 8042 keyboard controller.
fn reboot() {
    outb(0x64, 0xFE);
    while true {
        asm("hlt");
    }
}

// ----- kernel heap: a first-fit allocator with block headers -----
//
// MORT OS has no dynamic memory yet — everything is fixed buffers. This is the
// foundation the shell, the package manager, and the rest need. We carve a heap
// out of the RAM above the kernel/program area: base at 16 MB, top from the
// multiboot memory map (mem_upper). Each block is prefixed with an 8-byte header
// [size(u32) | used(u32)]; kmalloc first-fits over the blocks (splitting a large
// free one) and bumps the break when nothing fits; kfree marks a block free and
// coalesces it forward into any following free blocks.

fn heap_init() {
    let flags: u32 = *(g_mbinfo as *u32);
    let base: u32 = 0x01000000;                     // 16 MB — above the program load area
    let top: u32 = 0x04000000;                      // fallback: assume 64 MB
    if (flags & 1) != 0 {                           // bit 0: mem_lower/upper present
        let mem_upper: u32 = *((g_mbinfo + 8) as *u32);   // KiB above 1 MB
        if mem_upper < 0x00300000 {                 // guard against overflow (~3 GB cap)
            top = 0x00100000 + mem_upper * 1024;
        } else {
            top = 0x20000000;                       // clamp to 512 MB
        }
    }
    if top > base + 0x00100000 {                    // need at least 1 MB of heap
        g_heap_base = base;
        g_heap_end = top;
        g_heap_brk = base;
        g_heap_ok = true;
    }
}

// Allocate `size` bytes, 8-byte aligned. Returns the address, or 0 on failure.
fn kmalloc(size: u32) -> u32 {
    if !g_heap_ok {
        return 0;
    }
    let need: u32 = (size + 8 + 7) & 0xFFFFFFF8;     // header + payload, rounded to 8

    // First fit over already-allocated blocks (reuse freed space).
    let p: u32 = g_heap_base;
    while p < g_heap_brk {
        let bsize: u32 = *(p as *u32);
        let used: u32 = *((p + 4) as *u32);
        if used == 0 && bsize >= need {
            if bsize >= need + 16 {                  // split off the remainder
                let rem: u32 = p + need;
                *(rem as *u32) = bsize - need;
                *((rem + 4) as *u32) = 0;
                *(p as *u32) = need;
            }
            *((p + 4) as *u32) = 1;
            return p + 8;
        }
        p = p + bsize;
    }

    // Nothing fit — grow the heap.
    if g_heap_brk + need > g_heap_end {
        return 0;                                    // out of memory
    }
    let blk: u32 = g_heap_brk;
    *(blk as *u32) = need;
    *((blk + 4) as *u32) = 1;
    g_heap_brk = g_heap_brk + need;
    return blk + 8;
}

// Free a block from kmalloc, coalescing forward into adjacent free blocks.
fn kfree(ptr: u32) {
    if ptr == 0 {
        return;
    }
    let blk: u32 = ptr - 8;
    *((blk + 4) as *u32) = 0;
    let done: bool = false;
    while !done {
        let bsize: u32 = *(blk as *u32);
        let next: u32 = blk + bsize;
        if next < g_heap_brk {
            if *((next + 4) as *u32) == 0 {          // next block is free — absorb it
                *(blk as *u32) = bsize + *(next as *u32);
            } else {
                done = true;
            }
        } else {
            done = true;
        }
    }
}

// Bytes currently handed out (sum of used block payloads), for `mem`.
fn heap_used() -> u32 {
    let total: u32 = 0;
    let p: u32 = g_heap_base;
    while p < g_heap_brk {
        let bsize: u32 = *(p as *u32);
        if *((p + 4) as *u32) == 1 {
            total = total + bsize;
        }
        p = p + bsize;
    }
    return total;
}

// ----- ATA PIO disk driver (primary bus, master drive, LBA28, polling) -----
//
// No IRQs: the PIC leaves IRQ14 masked and we set nIEN too. All ops poll the
// status register with a bounded counter so a missing/broken drive fails
// cleanly instead of hanging the keyboard ISR forever.

// After selecting a drive, its status needs ~400ns to become valid: four reads
// of the alternate-status port (0x3F6, same bits as 0x1F7, no side effects).
fn ata_delay() {
    inb(0x3F6);
    inb(0x3F6);
    inb(0x3F6);
    inb(0x3F6);
}

// Poll until BSY (0x80) clears; false on timeout (~1s on real hardware).
fn ata_wait_bsy() -> bool {
    let i: u32 = 0;
    while i < 1000000 {
        let st: u8 = inb(0x1F7);
        if (st & 0x80) == 0 { return true; }
        i = i + 1;
    }
    return false;
}

// Poll until DRQ (0x08) sets; fail fast on ERR (0x01) or DF (0x20).
fn ata_wait_drq() -> bool {
    let i: u32 = 0;
    while i < 1000000 {
        let st: u8 = inb(0x1F7);
        if (st & 0x80) == 0 {                       // BSY clear -> bits valid
            if (st & 0x21) != 0 { return false; }   // ERR or DF
            if (st & 0x08) != 0 { return true; }    // DRQ
        }
        i = i + 1;
    }
    return false;
}

// Detect the drive once at boot. A floating bus reads 0xFF = no drive.
fn ata_init() -> bool {
    outb(0x1F6, 0xE0);                  // select master, LBA mode
    ata_delay();
    let st: u8 = inb(0x1F7);
    if st == 0xFF {                     // floating bus: nothing attached
        g_disk_ok = false;
        return false;
    }
    if !ata_wait_bsy() {
        g_disk_ok = false;
        return false;
    }
    st = inb(0x1F7);
    if (st & 0x40) == 0 {               // RDY clear: absent or broken
        g_disk_ok = false;
        return false;
    }
    outb(0x3F6, 2);                     // nIEN: no ATA interrupts
    g_disk_ok = true;
    return true;
}

// Read one 512-byte sector at `lba` into buf. Data port is 16-bit, LE.
fn ata_read(lba: u32, buf: *u8) -> bool {
    if !g_disk_ok { return false; }
    if !ata_wait_bsy() { return false; }
    outb(0x1F6, (0xE0 | ((lba >> 24) & 0x0F)) as u8);
    ata_delay();
    outb(0x1F2, 1);                     // sector count = 1
    outb(0x1F3, (lba & 0xFF) as u8);
    outb(0x1F4, ((lba >> 8) & 0xFF) as u8);
    outb(0x1F5, ((lba >> 16) & 0xFF) as u8);
    outb(0x1F7, 0x20);                  // READ SECTORS
    if !ata_wait_drq() { return false; }
    let i: u32 = 0;
    while i < 256 {
        let w: u32 = inw(0x1F0) as u32;
        *((buf as u32 + i * 2) as *u8) = (w & 0xFF) as u8;
        *((buf as u32 + i * 2 + 1) as *u8) = ((w >> 8) & 0xFF) as u8;
        i = i + 1;
    }
    return true;
}

// Write one 512-byte sector from buf to `lba`, then flush the drive cache.
fn ata_write(lba: u32, buf: *u8) -> bool {
    if !g_disk_ok { return false; }
    if !ata_wait_bsy() { return false; }
    outb(0x1F6, (0xE0 | ((lba >> 24) & 0x0F)) as u8);
    ata_delay();
    outb(0x1F2, 1);
    outb(0x1F3, (lba & 0xFF) as u8);
    outb(0x1F4, ((lba >> 8) & 0xFF) as u8);
    outb(0x1F5, ((lba >> 16) & 0xFF) as u8);
    outb(0x1F7, 0x30);                  // WRITE SECTORS
    if !ata_wait_drq() { return false; }
    let i: u32 = 0;
    while i < 256 {
        let lo: u32 = *((buf as u32 + i * 2) as *u8) as u32;
        let hi: u32 = *((buf as u32 + i * 2 + 1) as *u8) as u32;
        outw(0x1F0, (lo | (hi << 8)) as u16);
        i = i + 1;
    }
    if !ata_wait_bsy() { return false; }
    outb(0x1F7, 0xE7);                  // CACHE FLUSH
    if !ata_wait_bsy() { return false; }
    return true;
}

// ----- MortFS v1 -----
//
// Sector 0: superblock (magic "MFS1", version, file_count, next_free_sector,
// total_sectors). Sectors 1..8: 64 entries x 64 bytes (name[24], used u32,
// size u32, start_sector u32, capacity_sectors u32). Data from sector 16;
// every file gets a fixed 128-sector (64 KiB) extent from a bump allocator.
// All metadata lives in a RAM cache at TABCACHE and is parsed with raw offset
// arithmetic, same idiom as the multiboot code above. Buffers (fixed, no heap):
//   0x00800000  SECBUF    512 B    sector scratch
//   0x00801000  TABCACHE  4608 B   superblock + file table cache
//   0x00810000  FILEBUF   64 KiB   whole-file reads (cat/run)

// Byte address of entry i's first field inside the table cache.
fn fs_entry_addr(i: u32) -> u32 {
    return 0x00801000 + 512 + i * 64;   // TABCACHE
}

// ----- MortFS v2 metadata (the spare bytes 40..63 of each 64-byte entry) -----
//   type   @40 u8   0 = file, 1 = directory
//   parent @41 u8   parent directory's entry index; 255 = root
//   uid    @42 u8   owner user id
//   mode   @44 u32  permission bits (low 9 = rwx rwx rwx, Unix-style)
//   mtime  @48 u32  last-modified time, seconds since midnight (from the RTC)
// Root is implicit: it is not a table entry, it is "everything with parent 255".

fn fs_type(i: u32) -> u8 { return *((fs_entry_addr(i) + 40) as *u8); }
fn fs_parent(i: u32) -> u8 { return *((fs_entry_addr(i) + 41) as *u8); }
fn fs_uid(i: u32) -> u8 { return *((fs_entry_addr(i) + 42) as *u8); }
fn fs_mode(i: u32) -> u32 { return *((fs_entry_addr(i) + 44) as *u32); }
fn fs_mtime(i: u32) -> u32 { return *((fs_entry_addr(i) + 48) as *u32); }

// Seconds since midnight, read from the CMOS RTC (for file timestamps).
fn fs_now() -> u32 {
    let stb: u8 = rtc_reg(0x0B);
    let bin: bool = (stb & 4) != 0;
    let h: u32 = rtc_conv(rtc_reg(4), bin) as u32;
    let m: u32 = rtc_conv(rtc_reg(2), bin) as u32;
    let s: u32 = rtc_conv(rtc_reg(0), bin) as u32;
    return h * 3600 + m * 60 + s;
}

// Stamp an entry's v2 metadata (type, parent, owner, mode) + current time.
fn fs_set_meta(base: u32, typ: u8, parent: u8, uid: u8, mode: u32) {
    *((base + 40) as *u8) = typ;
    *((base + 41) as *u8) = parent;
    *((base + 42) as *u8) = uid;
    *((base + 43) as *u8) = 0;
    *((base + 44) as *u32) = mode;
    *((base + 48) as *u32) = fs_now();
}

// Detect the disk, cache sectors 0..8, verify the superblock. Sets g_fs_ok.
fn fs_init() -> bool {
    if !ata_init() {
        return false;
    }
    let s: u32 = 0;
    while s < 9 {
        if !ata_read(s, (0x00801000 + s * 512) as *u8) {    // TABCACHE
            return false;
        }
        s = s + 1;
    }
    if *(0x00801000 as *u32) != 0x3153464D {   // "MFS1" little-endian
        return false;
    }
    let ver: u32 = *((0x00801000 + 4) as *u32);
    if ver == 1 {
        // Upgrade a v1 disk in place: every existing file becomes a root-level
        // file owned by root with default (0644) permissions, then bump to v2.
        let i: u32 = 0;
        while i < 64 {
            let base: u32 = fs_entry_addr(i);
            if *((base + 24) as *u32) == 1 {
                fs_set_meta(base, 0, 255, 0, 0x1A4);
            }
            i = i + 1;
        }
        *((0x00801000 + 4) as *u32) = 2;
        g_fs_ok = true;
        fs_sync();
        return true;
    }
    if ver != 2 {
        return false;
    }
    g_fs_ok = true;
    return true;
}

// Write the metadata cache back to sectors 0..8.
fn fs_sync() -> bool {
    let s: u32 = 0;
    while s < 9 {
        if !ata_write(s, (0x00801000 + s * 512) as *u8) {   // TABCACHE
            return false;
        }
        s = s + 1;
    }
    return true;
}

// Index of the used entry named `name` directly inside directory `parent`
// (255 = root), else 64.
fn fs_find_in(name: *u8, parent: u32) -> u32 {
    let i: u32 = 0;
    while i < 64 {
        let base: u32 = fs_entry_addr(i);
        if *((base + 24) as *u32) == 1 {           // used
            if (fs_parent(i) as u32) == parent {
                if streq(name, base as *u8) {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return 64;
}

// Resolve an absolute ("/a/b") or root-relative ("a") path to an entry index.
// Returns 0..63 for an entry, 255 for the root directory itself, or 64 if any
// component is missing. Walks the parent tree component by component.
fn fs_resolve(path: u64) -> u32 {
    let p: u32 = path as u32;
    let cur: u32 = g_cwd;                           // relative paths start at the cwd
    if *(p as *u8) == 47 {                          // leading '/' -> absolute, start at root
        p = p + 1;
        cur = 255;
    }
    if *(p as *u8) == 0 {                           // "" (the cwd) or "/" (the root)
        return cur;
    }
    let result: u32 = 64;
    let done: bool = false;
    while !done {
        let comp: [u8; 24] = [0; 24];               // this path component
        let clen: u32 = 0;
        while *(p as *u8) != 0 && *(p as *u8) != 47 {
            if clen < 23 {
                *(((&comp as u64) + (clen as u64)) as *u8) = *(p as *u8);
                clen = clen + 1;
            }
            p = p + 1;
        }
        *(((&comp as u64) + (clen as u64)) as *u8) = 0;
        let idx: u32 = 64;
        if streq((&comp as u64) as *u8, ".") {
            idx = cur;                              // "." stays put
        } else if streq((&comp as u64) as *u8, "..") {
            if cur == 255 {
                idx = 255;                          // ".." at root stays at root
            } else {
                idx = fs_parent(cur) as u32;        // up one level
            }
        } else {
            idx = fs_find_in((&comp as u64) as *u8, cur);
        }
        if idx == 64 {
            done = true;                            // component not found
        } else {
            if *(p as *u8) == 47 {
                p = p + 1;                          // consume the separator
            }
            if *(p as *u8) == 0 {
                result = idx;                       // that was the last component
                done = true;
            } else {
                if idx != 255 && fs_type(idx) != 1 {   // more path, but not a directory
                    done = true;
                } else {
                    cur = idx;
                }
            }
        }
    }
    return result;
}

// Build the absolute path of directory `idx` (255 = root) into `buf` by walking
// the parent chain.
fn path_of(idx: u32, buf: u64) {
    if idx == 255 {
        *(buf as *u8) = 47;                         // "/"
        *((buf + 1) as *u8) = 0;
        return;
    }
    path_of(fs_parent(idx) as u32, buf);           // parent path first
    let len: u32 = str_len(buf as *u8);
    if len > 1 {                                    // separator, unless parent is "/"
        *((buf + (len as u64)) as *u8) = 47;
        len = len + 1;
    }
    let nm: u32 = fs_entry_addr(idx);              // append this directory's name
    let j: u32 = 0;
    while *((nm + j) as *u8) != 0 {
        *((buf + (len as u64) + (j as u64)) as *u8) = *((nm + j) as *u8);
        j = j + 1;
    }
    *((buf + (len as u64) + (j as u64)) as *u8) = 0;
}

// Split `path` into its parent directory (returned: 255 root, 0..63 a dir, or 64
// if that directory doesn't exist) and its final component (written to `leaf`).
fn fs_parent_of(path: u64, leaf: u64) -> u32 {
    let p: u32 = path as u32;
    let last_slash: u32 = 0xFFFFFFFF;               // none seen yet
    let i: u32 = 0;
    while *((p + i) as *u8) != 0 {
        if *((p + i) as *u8) == 47 {
            last_slash = i;
        }
        i = i + 1;
    }
    let total: u32 = i;
    if last_slash == 0xFFFFFFFF {                   // bare name: parent is the cwd
        str_copy(leaf as *u8, path as *u8);
        return g_cwd;
    }
    let ls: u32 = last_slash + 1;                   // copy the leaf out
    let j: u32 = 0;
    while ls + j < total {
        *((leaf + (j as u64)) as *u8) = *((p + ls + j) as *u8);
        j = j + 1;
    }
    *((leaf + (j as u64)) as *u8) = 0;
    if last_slash == 0 {                            // "/leaf" -> root parent
        return 255;
    }
    let ppath: [u8; 64] = [0; 64];                  // resolve the parent path
    let k: u32 = 0;
    while k < last_slash {
        *(((&ppath as u64) + (k as u64)) as *u8) = *((p + k) as *u8);
        k = k + 1;
    }
    *(((&ppath as u64) + (last_slash as u64)) as *u8) = 0;
    let pidx: u32 = fs_resolve(&ppath as u64);
    if pidx == 64 {
        return 64;
    }
    if pidx != 255 {
        if fs_type(pidx) != 1 {                     // parent isn't a directory
            return 64;
        }
    }
    return pidx;
}

// Backward-compatible name lookup: resolve a bare name or a path to a file/dir
// index, or 64. (The root directory itself is not a findable "file".)
fn fs_find(name: *u8) -> u32 {
    let r: u32 = fs_resolve(name as u64);
    if r == 255 {
        return 64;
    }
    return r;
}

// True if directory `dir` (index, or 255 for root) contains no entries.
fn fs_dir_empty(dir: u32) -> bool {
    let k: u32 = 0;
    while k < 64 {
        if *((fs_entry_addr(k) + 24) as *u32) == 1 {
            if (fs_parent(k) as u32) == dir {
                return false;
            }
        }
        k = k + 1;
    }
    return true;
}

// Index of the first free table slot, else 64.
fn fs_free_slot() -> u32 {
    let i: u32 = 0;
    while i < 64 {
        if *((fs_entry_addr(i) + 24) as *u32) == 0 {
            return i;
        }
        i = i + 1;
    }
    return 64;
}

// Claim a slot and a fresh 128-sector extent for `name`. Prints its own
// error (color 12) and returns 64 on failure.
// Create an entry `name` inside directory `parent` (255 = root). typ 0 = file
// (gets a 128-sector data extent), typ 1 = directory (no extent). Prints its own
// error (color 12) and returns 64 on failure.
fn fs_create_full(name: *u8, parent: u32, typ: u8) -> u32 {
    let n: u32 = str_len(name);
    if n == 0 || n > 23 {
        feed();
        print_string("name too long (max 23 chars)", g_row, 12);
        return 64;
    }
    if !can_write(dir_owner(parent), dir_mode(parent)) {
        feed();
        print_string("permission denied", g_row, 12);
        return 64;
    }
    let slot: u32 = fs_free_slot();
    if slot == 64 {
        feed();
        print_string("file table full (max 64 entries)", g_row, 12);
        return 64;
    }
    let base: u32 = fs_entry_addr(slot);
    let k: u32 = 0;
    while k < 24 {                                     // NUL-pad the name field
        *((base + k) as *u8) = 0;
        k = k + 1;
    }
    str_copy(base as *u8, name);
    *((base + 24) as *u32) = 1;                        // used
    *((base + 28) as *u32) = 0;                        // size_bytes
    let mode: u32 = 0x1A4;                             // 0644 for files
    if typ == 1 {
        *((base + 32) as *u32) = 0;                    // directories hold no data
        *((base + 36) as *u32) = 0;
        mode = 0x1ED;                                  // 0755 for directories
    } else {
        let next: u32 = *((0x00801000 + 12) as *u32);  // next_free_sector
        let total: u32 = *((0x00801000 + 16) as *u32); // total_sectors
        if next + 128 > total {
            *((base + 24) as *u32) = 0;                // release the slot we took
            feed();
            print_string("disk full (rm does not reclaim; re-run mkfs)", g_row, 12);
            return 64;
        }
        *((base + 32) as *u32) = next;                 // start_sector
        *((base + 36) as *u32) = 128;                  // capacity_sectors
        *((0x00801000 + 12) as *u32) = next + 128;     // bump the extent allocator
    }
    fs_set_meta(base, typ, parent as u8, g_uid, mode);
    *((0x00801000 + 8) as *u32) = *((0x00801000 + 8) as *u32) + 1;   // count++
    if !fs_sync() {
        return 64;
    }
    return slot;
}

// A file at the root (the pre-directories default; used by `write`'s fast path).
fn fs_create(name: *u8) -> u32 {
    return fs_create_full(name, 255, 0);
}

// mkdir: create the directory named by `path`. Returns the new index, or a
// sentinel: 64 = a parent directory is missing, 65 = it already exists.
fn fs_mkdir(path: u64) -> u32 {
    let leaf: [u8; 24] = [0; 24];
    let parent: u32 = fs_parent_of(path, &leaf as u64);
    if parent == 64 {
        return 64;
    }
    if fs_find_in((&leaf as u64) as *u8, parent) != 64 {
        return 65;
    }
    return fs_create_full((&leaf as u64) as *u8, parent, 1);
}

// Ensure a top-level directory exists (used to seed the standard layout).
fn fs_ensure_dir(name: *u8) {
    if fs_find_in(name, 255) == 64 {
        fs_create_full(name, 255, 1);
    }
}

// Create the standard filesystem layout on first boot: /bin /etc /home /var.
fn fs_ensure_layout() {
    if !g_fs_ok {
        return;
    }
    fs_ensure_dir("bin");
    fs_ensure_dir("etc");
    fs_ensure_dir("home");
    fs_ensure_dir("var");
}

// Does `name` end in ".bin"? (our convention for a runnable flat binary)
fn ends_with_bin(name: *u8) -> bool {
    let n: u32 = str_len(name);
    if n < 4 {
        return false;
    }
    let b: u32 = name as u32 + n - 4;
    return *(b as *u8) == 46 && *((b + 1) as *u8) == 98
        && *((b + 2) as *u8) == 105 && *((b + 3) as *u8) == 110;   // ".bin"
}

// Move the seeded *.bin programs from the root into /bin and mark them
// executable, so they can be launched by name via $PATH. Idempotent: after the
// first boot they already live in /bin, so nothing is re-moved.
fn fs_populate_bin() {
    let bin: u32 = fs_resolve("/bin" as u64);
    if bin == 64 || bin == 255 {
        return;
    }
    let changed: bool = false;
    let i: u32 = 0;
    while i < 64 {
        let base: u32 = fs_entry_addr(i);
        if *((base + 24) as *u32) == 1 {
            if (fs_parent(i) as u32) == 255 && fs_type(i) == 0 && ends_with_bin(base as *u8) {
                *((base + 41) as *u8) = bin as u8;     // reparent into /bin
                *((base + 44) as *u32) = 0x1ED;        // 0755 (executable)
                changed = true;
            }
        }
        i = i + 1;
    }
    if changed {
        fs_sync();
    }
}

// Read entry i's live sectors into FILEBUF; returns size_bytes (0 on error
// or empty file).
fn fs_read_file(i: u32) -> u32 {
    let base: u32 = fs_entry_addr(i);
    let size: u32 = *((base + 28) as *u32);
    if size == 0 {
        return 0;
    }
    let start: u32 = *((base + 32) as *u32);
    let nsec: u32 = (size + 511) / 512;
    let s: u32 = 0;
    while s < nsec {
        if !ata_read(start + s, (0x00810000 + s * 512) as *u8) {   // FILEBUF
            return 0;
        }
        s = s + 1;
    }
    return size;
}

// Append text + '\n' to entry i, sector-at-a-time through SECBUF so a partial
// last sector is read-modify-written correctly.
fn fs_append_line(i: u32, text: *u8) -> bool {
    let base: u32 = fs_entry_addr(i);
    let size: u32 = *((base + 28) as *u32);
    let cap: u32 = *((base + 36) as *u32) * 512;
    let n: u32 = str_len(text);
    if size + n + 1 > cap {
        return false;
    }
    let start: u32 = *((base + 32) as *u32);
    let sec: u32 = start + size / 512;      // sector being filled
    let off: u32 = size % 512;              // write position within it
    if off != 0 {                           // partial sector: fetch it first
        if !ata_read(sec, 0x00800000 as *u8) {          // SECBUF
            return false;
        }
    } else {
        for k: u32 in 0..512 {
            *((0x00800000 + k) as *u8) = 0;
        }
    }
    let j: u32 = 0;
    while j <= n {                          // n text bytes, then one '\n'
        let b: u8 = 10;
        if j < n {
            b = *((text as u32 + j) as *u8);
        }
        *((0x00800000 + off) as *u8) = b;   // SECBUF
        off = off + 1;
        j = j + 1;
        if off == 512 {                     // sector filled: flush, move on
            if !ata_write(sec, 0x00800000 as *u8) {
                return false;
            }
            sec = sec + 1;
            off = 0;
            for k: u32 in 0..512 {
                *((0x00800000 + k) as *u8) = 0;
            }
        }
    }
    if off != 0 {                           // flush the trailing partial sector
        if !ata_write(sec, 0x00800000 as *u8) {
            return false;
        }
    }
    *((base + 28) as *u32) = size + n + 1;
    return fs_sync();
}

// Mark `name` unused. The extent is NOT reclaimed (v1 limitation).
fn fs_remove(name: *u8) -> bool {
    let i: u32 = fs_find(name);
    if i == 64 {
        return false;
    }
    *((fs_entry_addr(i) + 24) as *u32) = 0;            // used = 0
    *((0x00801000 + 8) as *u32) = *((0x00801000 + 8) as *u32) - 1;   // file_count--
    return fs_sync();
}

// Shared preamble for every FS command: explain what's missing, in order.
fn fs_guard() -> bool {
    if !g_disk_ok {
        feed();
        print_string("no disk (boot with -hda disk.img)", g_row, 12);
        return false;
    }
    if !g_fs_ok {
        feed();
        print_string("bad filesystem (host: python kernel/mkfs.py disk.img)", g_row, 12);
        return false;
    }
    return true;
}

// Offset of the first `ch` in s, or of the trailing NUL if absent.
fn find_char(s: *u8, ch: u8) -> u32 {
    let i: u32 = 0;
    while true {
        let c: u8 = *((s as u32 + i) as *u8);
        if c == ch {
            return i;
        }
        if c == 0 {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

// ----- programs: exec + the syscall interface -----
//
// A program is a flat 32-bit binary compiled from Mort, loaded at 0x00A00000
// and entered with a call. It shares no symbols with the kernel; it asks the
// kernel to do things through a mailbox + `int 0x80`:
//   0x009F0000  syscall number     0x009F0004  arg0
//   0x009F000C  return value        0x009F0010  entry addr (kernel-internal)

// Print a string inline at (g_row, g_pcol), advancing the program cursor and
// wrapping to a fresh line at the screen edge. Program output uses this cursor
// so prompts and typed input can share a line.
fn print_inline(s: *u8) {
    let i: u32 = 0;
    while true {
        let ch: u8 = *((s as u32 + i) as *u8);
        if ch == 0 {
            return;
        }
        if g_pcol >= 80 {
            feed();
            g_pcol = 0;
        }
        put_cell_at(g_row, g_pcol, ch, 7);
        g_pcol = g_pcol + 1;
        i = i + 1;
    }
}

// Read a line of input by polling the PS/2 controller directly. We run inside
// int 0x80 with interrupts off, so the IRQ-driven keyboard path is unavailable
// — we read status port 0x64 (bit 0 = output buffer full) and data port 0x60
// ourselves. Echoes inline, handles Shift and Backspace, stops at Enter. The
// line is written NUL-terminated to 0x009F0100 (the syscall input buffer).
fn read_line() {
    let buf: u32 = 0x009F0100;
    let len: u32 = 0;
    let shift: bool = false;
    move_cursor(g_row, g_pcol);
    while true {
        while (inb(0x64) & 1) == 0 {                // wait for a byte
        }
        let sc: u8 = inb(0x60);
        if sc == 42 || sc == 54 {                   // Shift down
            shift = true;
        } else {
            if sc == 170 || sc == 182 {             // Shift up
                shift = false;
            } else {
                if sc == 28 {                       // Enter: finish the line
                    *((buf + len) as *u8) = 0;
                    feed();
                    g_pcol = 0;
                    return;
                } else {
                    if sc == 14 {                   // Backspace
                        if len > 0 {
                            len = len - 1;
                            if g_pcol > 0 {
                                g_pcol = g_pcol - 1;
                            }
                            put_cell_at(g_row, g_pcol, 32, 7);
                            move_cursor(g_row, g_pcol);
                        }
                    } else {
                        if sc < 128 {               // a key press (ignore releases)
                            let ch: u8 = scancode_to_ascii(sc, shift);
                            if ch != 0 {
                                if len < 120 {
                                    *((buf + len) as *u8) = ch;
                                    len = len + 1;
                                    put_cell_at(g_row, g_pcol, ch, 15);
                                    g_pcol = g_pcol + 1;
                                    move_cursor(g_row, g_pcol);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The int 0x80 handler (called from syscall_isr in idt.s). Runs synchronously
// while the program is on the stack, so it can use the shell's VGA state.
//   1 = print string + newline   2 = print string inline (no newline)
//   3 = uptime seconds -> return  4 = read a line -> return pointer (0x009F0100)
fn on_syscall() {
    let num: u32 = *(0x009F0000 as *u32);
    if num == 1 {                                  // print a string, then newline
        print_inline((*(0x009F0004 as *u32)) as *u8);
        feed();
        g_pcol = 0;
        return;
    }
    if num == 2 {                                  // print a string inline
        print_inline((*(0x009F0004 as *u32)) as *u8);
        return;
    }
    if num == 3 {                                  // uptime seconds -> return slot
        *(0x009F000C as *u32) = g_ticks / 100;
        return;
    }
    if num == 4 {                                  // read a line -> return its address
        read_line();
        *(0x009F000C as *u32) = 0x009F0100;
        return;
    }
}

// Enter the loaded program via an indirect call through the entry slot.
// Isolated in its own function so the call's register clobber can't reach
// live kernel state.
fn exec_enter() {
    asm("call *0x009F0010");
}

// `exec <name>`: load a flat program image off the disk to 0x00A00000 and run
// it. It talks back only through on_syscall above.
fn exec_file(name: *u8) {
    let i: u32 = fs_find(name);
    if i == 64 {
        feed();
        print_at("not found: ", g_row, 0, 12);
        print_at(name, g_row, 11, 12);
        return;
    }
    let size: u32 = fs_read_file(i);               // file bytes -> FILEBUF
    if size == 0 {
        feed();
        print_string("empty program", g_row, 12);
        return;
    }
    let k: u32 = 0;                                // zero the 64 KiB program region
    while k < 65536 {
        *((0x00A00000 + k) as *u8) = 0;
        k = k + 1;
    }
    let j: u32 = 0;                                // copy the image into place
    while j < size {
        *((0x00A00000 + j) as *u8) = *((0x00810000 + j) as *u8);   // FILEBUF -> base
        j = j + 1;
    }
    *(0x009F0010 as *u32) = 0x00A00000;            // entry for the trampoline
    feed();                                        // program output starts on a fresh line
    g_pcol = 0;
    exec_enter();
}

// Run a command, printing any output on new (scrolling) lines. Returns true if
// it cleared the screen (so the caller knows not to add another blank line).
// ----- environment variables -----

fn env_find(name: *u8) -> u32 {
    let i: u32 = 0;
    while i < g_env_count {
        let base: u64 = (&g_env_name as u64) + ((i * 32) as u64);
        if streq(name, base as *u8) {
            return i;
        }
        i = i + 1;
    }
    return 64;
}

fn env_set(name: *u8, val: *u8) {
    let i: u32 = env_find(name);
    if i == 64 {
        if g_env_count >= 8 {
            return;
        }
        i = g_env_count;
        g_env_count = g_env_count + 1;
        let nb: u64 = (&g_env_name as u64) + ((i * 32) as u64);
        let k: u32 = 0;
        while k < 32 { *((nb + (k as u64)) as *u8) = 0; k = k + 1; }
        str_copy(nb as *u8, name);
    }
    let vb: u64 = (&g_env_val as u64) + ((i * 64) as u64);
    let k: u32 = 0;
    while k < 64 { *((vb + (k as u64)) as *u8) = 0; k = k + 1; }
    str_copy(vb as *u8, val);
}

// Return the value (as an address) of `name` — a computed built-in (USER, HOME,
// PATH, PWD) or a custom variable, or an empty string.
fn env_get(name: *u8) -> u64 {
    if streq(name, "USER") { return &g_username as u64; }
    if streq(name, "PWD") { return &g_cwdpath as u64; }
    if streq(name, "PATH") { return "/bin" as u64; }
    if streq(name, "HOME") {
        str_copy((&g_envscratch as u64) as *u8, "/home/");
        str_copy(((&g_envscratch as u64) + 6) as *u8, (&g_username as u64) as *u8);
        return &g_envscratch as u64;
    }
    let i: u32 = env_find(name);
    if i != 64 {
        return (&g_env_val as u64) + ((i * 64) as u64);
    }
    *((&g_envscratch as u64) as *u8) = 0;                       // unknown -> ""
    return &g_envscratch as u64;
}

fn is_name_char(c: u8) -> bool {
    if c >= 48 && c <= 57 { return true; }                      // 0-9
    if c >= 65 && c <= 90 { return true; }                      // A-Z
    if c >= 97 && c <= 122 { return true; }                     // a-z
    if c == 95 { return true; }                                // _
    return false;
}

// Copy src to dst, expanding $NAME references to their values.
fn expand_vars(src: u64, dst: u64) {
    let si: u32 = 0;
    let di: u32 = 0;
    let done: bool = false;
    while !done {
        let c: u8 = *((src + (si as u64)) as *u8);
        if c == 0 {
            done = true;
        } else if c == 36 {                                    // '$'
            let nc: u8 = *((src + ((si + 1) as u64)) as *u8);
            if is_name_char(nc) {
                si = si + 1;
                let vn: [u8; 32] = [0; 32];
                let nl: u32 = 0;
                while is_name_char(*((src + (si as u64)) as *u8)) && nl < 30 {
                    *(((&vn as u64) + (nl as u64)) as *u8) = *((src + (si as u64)) as *u8);
                    nl = nl + 1;
                    si = si + 1;
                }
                *(((&vn as u64) + (nl as u64)) as *u8) = 0;
                let val: u64 = env_get((&vn as u64) as *u8);
                let vi: u32 = 0;
                while *((val + (vi as u64)) as *u8) != 0 && di < 250 {
                    *((dst + (di as u64)) as *u8) = *((val + (vi as u64)) as *u8);
                    di = di + 1;
                    vi = vi + 1;
                }
            } else {
                if di < 250 { *((dst + (di as u64)) as *u8) = 36; di = di + 1; }
                si = si + 1;
            }
        } else {
            if di < 250 { *((dst + (di as u64)) as *u8) = c; di = di + 1; }
            si = si + 1;
        }
    }
    *((dst + (di as u64)) as *u8) = 0;
}

fn env_print(name: *u8) {
    feed();
    print_at(name, g_row, 0, 11);
    let nl: u32 = str_len(name);
    print_at("=", g_row, nl, 7);
    print_at(env_get(name) as *u8, g_row, nl + 1, 15);
}

// Run `path` if it resolves to an executable file (any exec bit). A ".bin" is
// loaded as a flat binary (exec_file); anything else runs as a script
// (run_file). Returns true if it launched something.
fn exec_if_program(path: *u8) -> bool {
    let idx: u32 = fs_resolve(path as u64);
    if idx == 64 || idx == 255 {
        return false;
    }
    if fs_type(idx) == 1 {
        return false;                                   // a directory
    }
    if (fs_mode(idx) & 0x49) == 0 {
        return false;                                   // no execute bit
    }
    if ends_with_bin(path) {
        exec_file(path);
    } else {
        run_file(path);
    }
    return true;
}

// $PATH resolution: an unknown command might be a program. Take its first token
// and look for an executable as: <name>, /bin/<name>, <name>.bin, /bin/<name>.bin.
fn try_exec_path(cmd: *u8) -> bool {
    let name: [u8; 64] = [0; 64];
    let len: u32 = 0;
    let done: bool = false;
    while !done && len < 60 {
        let c: u8 = *((cmd as u32 + len) as *u8);
        if c == 0 || c == 32 {
            done = true;
        } else {
            *(((&name as u64) + (len as u64)) as *u8) = c;
            len = len + 1;
        }
    }
    *(((&name as u64) + (len as u64)) as *u8) = 0;
    if len == 0 {
        return false;
    }

    if exec_if_program((&name as u64) as *u8) { return true; }        // as typed

    let p: [u8; 96] = [0; 96];
    str_copy((&p as u64) as *u8, "/bin/");
    str_copy(((&p as u64) + 5) as *u8, (&name as u64) as *u8);
    if exec_if_program((&p as u64) as *u8) { return true; }           // /bin/<name>

    let nb: [u8; 72] = [0; 72];
    str_copy((&nb as u64) as *u8, (&name as u64) as *u8);
    str_copy(((&nb as u64) + (len as u64)) as *u8, ".bin");
    if exec_if_program((&nb as u64) as *u8) { return true; }          // <name>.bin

    str_copy((&p as u64) as *u8, "/bin/");
    str_copy(((&p as u64) + 5) as *u8, (&nb as u64) as *u8);
    if exec_if_program((&p as u64) as *u8) { return true; }           // /bin/<name>.bin

    return false;
}

// Expand $VARs in the command line, then dispatch. Every caller (the shell,
// scripts, sudo) goes through here, so expansion happens everywhere.
fn run_command(cmd: *u8) -> bool {
    expand_vars(cmd as u64, &g_cmdexp as u64);
    return run_command_impl((&g_cmdexp as u64) as *u8);
}

fn run_command_impl(cmd: *u8) -> bool {
    if streq(cmd, "") {
        return false;
    }
    if streq(cmd, "help") {
        feed();
        print_string("help clear about echo uptime crash readme mem", g_row, 7);
        feed();
        print_string("files: pwd cd ls cat write rm mkdir rmdir run exec", g_row, 7);
        feed();
        print_string("net: net (DHCP)  httpd (serve a page on :80)", g_row, 7);
        feed();
        print_string("power: F12 menu, or lock sleep restart shutdown", g_row, 7);
        feed();
        print_string("users: whoami su sudo passwd chmod chown", g_row, 7);
        feed();
        print_string("env: env export unset  ($VAR expands in commands)", g_row, 7);
        return false;
    }
    if streq(cmd, "readme") {
        show_module();
        return false;
    }
    if streq(cmd, "mem") {
        mem();
        return false;
    }
    if streq(cmd, "mods") {
        mods();
        return false;
    }
    if streq(cmd, "net") {
        net_dhcp();
        return false;
    }
    if streq(cmd, "httpd") {
        net_httpd();
        return false;
    }
    if streq(cmd, "pwd") {
        feed();
        print_string((&g_cwdpath as u64) as *u8, g_row, 15);
        return false;
    }
    if streq(cmd, "cd") || starts_with(cmd, "cd ") {
        if !fs_guard() { return false; }
        let target: u64 = (cmd as u32 + 3) as u64;
        let hb: [u8; 64] = [0; 64];
        if streq(cmd, "cd") {                           // no arg -> home
            str_copy((&hb as u64) as *u8, "/home/");
            str_copy(((&hb as u64) + 6) as *u8, (&g_username as u64) as *u8);
            target = &hb as u64;
        }
        let idx: u32 = fs_resolve(target);
        if idx == 64 {
            feed();
            print_string("cd: no such directory", g_row, 12);
            return false;
        }
        if idx != 255 {
            if fs_type(idx) != 1 {
                feed();
                print_string("cd: not a directory", g_row, 12);
                return false;
            }
        }
        g_cwd = idx;
        path_of(idx, &g_cwdpath as u64);
        return false;
    }
    if streq(cmd, "ls") || starts_with(cmd, "ls ") {
        if !fs_guard() { return false; }
        let dir: u32 = g_cwd;                           // default: the current directory
        if starts_with(cmd, "ls ") {
            let r: u32 = fs_resolve((cmd as u32 + 3) as u64);
            if r == 64 {
                feed();
                print_at("not found: ", g_row, 0, 12);
                print_at((cmd as u32 + 3) as *u8, g_row, 11, 12);
                return false;
            }
            if r != 255 {
                if fs_type(r) != 1 {
                    feed();
                    print_string("not a directory", g_row, 12);
                    return false;
                }
            }
            dir = r;
        }
        let shown: u32 = 0;
        let i: u32 = 0;
        while i < 64 {
            let base: u32 = fs_entry_addr(i);
            if *((base + 24) as *u32) == 1 {            // used
                if (fs_parent(i) as u32) == dir {       // ...and lives in this dir
                    feed();
                    // type marker + octal permission bits, e.g. "d 755" / "- 644"
                    let mode: u32 = fs_mode(i);
                    let tc: u8 = 45;                     // '-'
                    if fs_type(i) == 1 { tc = 100; }    // 'd'
                    put_cell_at(g_row, 0, tc, 10);
                    put_cell_at(g_row, 2, (48 + ((mode >> 6) & 7)) as u8, 7);
                    put_cell_at(g_row, 3, (48 + ((mode >> 3) & 7)) as u8, 7);
                    put_cell_at(g_row, 4, (48 + (mode & 7)) as u8, 7);
                    print_at(base as *u8, g_row, 7, 15);   // name
                    num_to_str(*((base + 28) as *u32), g_numbuf);
                    print_at(g_numbuf, g_row, 34, 7);
                    print_at(" bytes  uid ", g_row, 34 + g_numlen, 7);
                    num_to_str(fs_uid(i) as u32, g_numbuf);
                    print_at(g_numbuf, g_row, 47 + g_numlen, 7);
                    shown = shown + 1;
                }
            }
            i = i + 1;
        }
        if shown == 0 {
            feed();
            print_string("(empty)", g_row, 7);
        }
        return false;
    }
    if starts_with(cmd, "mkdir ") {
        if !fs_guard() { return false; }
        let r: u32 = fs_mkdir((cmd as u32 + 6) as u64);
        if r == 64 {
            feed();
            print_string("mkdir: parent directory does not exist", g_row, 12);
        }
        if r == 65 {
            feed();
            print_string("mkdir: already exists", g_row, 12);
        }
        return false;
    }
    if starts_with(cmd, "rmdir ") {
        if !fs_guard() { return false; }
        let r: u32 = fs_resolve((cmd as u32 + 6) as u64);
        if r == 64 || r == 255 {
            feed();
            print_string("rmdir: no such directory", g_row, 12);
            return false;
        }
        if fs_type(r) != 1 {
            feed();
            print_string("rmdir: not a directory", g_row, 12);
            return false;
        }
        if !fs_dir_empty(r) {
            feed();
            print_string("rmdir: directory not empty", g_row, 12);
            return false;
        }
        *((fs_entry_addr(r) + 24) as *u32) = 0;         // free the slot
        *((0x00801000 + 8) as *u32) = *((0x00801000 + 8) as *u32) - 1;
        fs_sync();
        return false;
    }
    if starts_with(cmd, "cat ") {
        if !fs_guard() { return false; }
        let name: *u8 = (cmd as u32 + 4) as *u8;
        let i: u32 = fs_find(name);
        if i == 64 {
            feed();
            print_at("not found: ", g_row, 0, 12);
            print_at(name, g_row, 11, 12);
            return false;
        }
        if fs_type(i) == 1 {
            feed();
            print_string("cat: is a directory", g_row, 12);
            return false;
        }
        let size: u32 = fs_read_file(i);
        feed();
        print_range(0x00810000, 0x00810000 + size, 7);   // FILEBUF
        return false;
    }
    if starts_with(cmd, "write ") {
        if !fs_guard() { return false; }
        let name: *u8 = (cmd as u32 + 6) as *u8;
        let sp: u32 = find_char(name, 32);               // name/text separator
        if sp == 0 || *((name as u32 + sp) as *u8) == 0 {
            feed();
            print_string("usage: write <name> <text>", g_row, 12);
            return false;
        }
        *((name as u32 + sp) as *u8) = 0;                // terminate the name in place
        let text: *u8 = (name as u32 + sp + 1) as *u8;
        let i: u32 = fs_find(name);
        if i != 64 {
            if fs_type(i) == 1 {
                feed();
                print_string("write: is a directory", g_row, 12);
                return false;
            }
            if !can_write(fs_uid(i), fs_mode(i)) {
                feed();
                print_string("permission denied", g_row, 12);
                return false;
            }
        }
        if i == 64 {                                     // create it in the right directory
            let leaf: [u8; 24] = [0; 24];
            let parent: u32 = fs_parent_of(name as u64, &leaf as u64);
            if parent == 64 {
                feed();
                print_string("write: parent directory does not exist", g_row, 12);
                return false;
            }
            i = fs_create_full((&leaf as u64) as *u8, parent, 0);   // prints its own error
            if i == 64 { return false; }
        }
        if !fs_append_line(i, text) {
            feed();
            print_string("file full (max 64 KB)", g_row, 12);
        }
        return false;                                    // success is Unix-quiet
    }
    if starts_with(cmd, "rm ") {
        if !fs_guard() { return false; }
        let name: *u8 = (cmd as u32 + 3) as *u8;
        let i: u32 = fs_find(name);
        if i == 64 {
            feed();
            print_at("not found: ", g_row, 0, 12);
            print_at(name, g_row, 11, 12);
            return false;
        }
        if fs_type(i) == 1 {
            feed();
            print_string("rm: is a directory (use rmdir)", g_row, 12);
            return false;
        }
        if !can_write(fs_uid(i), fs_mode(i)) {
            feed();
            print_string("permission denied", g_row, 12);
            return false;
        }
        fs_remove(name);
        return false;
    }
    if starts_with(cmd, "run ") {
        if !fs_guard() { return false; }
        run_file((cmd as u32 + 4) as *u8);
        return false;
    }
    if starts_with(cmd, "exec ") {
        if !fs_guard() { return false; }
        exec_file((cmd as u32 + 5) as *u8);
        return false;
    }
    if streq(cmd, "whoami") {
        feed();
        print_at((&g_username as u64) as *u8, g_row, 0, 15);
        let ul: u32 = str_len((&g_username as u64) as *u8);
        print_at(" (uid ", g_row, ul, 7);
        num_to_str(g_uid as u32, g_numbuf);
        print_at(g_numbuf, g_row, ul + 6, 15);
        print_at(")", g_row, ul + 6 + g_numlen, 7);
        return false;
    }
    if starts_with(cmd, "export ") {
        let arg: u64 = (cmd as u32 + 7) as u64;
        let eq: u32 = find_char(arg as *u8, 61);               // '='
        if eq == 0 {
            feed();
            print_string("usage: export NAME=value", g_row, 12);
            return false;
        }
        let nm: [u8; 32] = [0; 32];
        let k: u32 = 0;
        while k < eq && k < 30 {
            *(((&nm as u64) + (k as u64)) as *u8) = *((arg + (k as u64)) as *u8);
            k = k + 1;
        }
        *(((&nm as u64) + (k as u64)) as *u8) = 0;
        env_set((&nm as u64) as *u8, (arg + (eq as u64) + 1) as *u8);
        return false;
    }
    if streq(cmd, "env") {
        env_print("USER");
        env_print("HOME");
        env_print("PATH");
        env_print("PWD");
        let i: u32 = 0;
        while i < g_env_count {
            env_print(((&g_env_name as u64) + ((i * 32) as u64)) as *u8);
            i = i + 1;
        }
        return false;
    }
    if starts_with(cmd, "unset ") {
        let i: u32 = env_find((cmd as u32 + 6) as *u8);
        if i != 64 {
            let last: u32 = g_env_count - 1;
            if i != last {
                str_copy(((&g_env_name as u64) + ((i * 32) as u64)) as *u8,
                         ((&g_env_name as u64) + ((last * 32) as u64)) as *u8);
                str_copy(((&g_env_val as u64) + ((i * 64) as u64)) as *u8,
                         ((&g_env_val as u64) + ((last * 64) as u64)) as *u8);
            }
            g_env_count = last;
        }
        return false;
    }
    if streq(cmd, "su") || starts_with(cmd, "su ") {
        let target: u64 = "root" as u64;
        if starts_with(cmd, "su ") {
            target = (cmd as u32 + 3) as u64;
        }
        let ai: u32 = acct_find(target as *u8);
        if ai == 64 {
            feed();
            print_string("su: no such user", g_row, 12);
            return false;
        }
        feed();
        print_at("password: ", g_row, 0, 7);
        g_col = 10;
        let pw: [u8; 64] = [0; 64];
        kread_line(&pw as u64, true);
        if g_acct_hash[ai] == hash_pw((&pw as u64) as *u8) {
            g_uid = g_acct_uid[ai] as u8;
            str_copy((&g_username as u64) as *u8, target as *u8);
        } else {
            feed();
            print_string("su: authentication failure", g_row, 12);
        }
        return false;
    }
    if starts_with(cmd, "sudo ") {
        let rest: u64 = (cmd as u32 + 5) as u64;
        if g_uid == 0 {
            run_command(rest as *u8);           // already root
            return false;
        }
        feed();
        print_at("[sudo] password for ", g_row, 0, 7);
        let ul: u32 = str_len((&g_username as u64) as *u8);
        print_at((&g_username as u64) as *u8, g_row, 20, 7);
        print_at(": ", g_row, 20 + ul, 7);
        g_col = 22 + ul;
        let pw: [u8; 64] = [0; 64];
        kread_line(&pw as u64, true);
        let ai: u32 = acct_find((&g_username as u64) as *u8);
        if ai != 64 && g_acct_hash[ai] == hash_pw((&pw as u64) as *u8) {
            let saved: u8 = g_uid;
            g_uid = 0;                           // run this one command as root
            run_command(rest as *u8);
            g_uid = saved;
        } else {
            feed();
            print_string("sudo: authentication failure", g_row, 12);
        }
        return false;
    }
    if streq(cmd, "passwd") {
        feed();
        print_at("new password: ", g_row, 0, 7);
        g_col = 14;
        let pw: [u8; 64] = [0; 64];
        kread_line(&pw as u64, true);
        let ai: u32 = acct_find((&g_username as u64) as *u8);
        if ai != 64 {
            g_acct_hash[ai] = hash_pw((&pw as u64) as *u8);
            feed();
            print_string("password updated (this session)", g_row, 10);
        }
        return false;
    }
    if starts_with(cmd, "chmod ") {
        if !fs_guard() { return false; }
        let arg: u64 = (cmd as u32 + 6) as u64;
        let sp: u32 = find_char(arg as *u8, 32);
        if sp == 0 {
            feed();
            print_string("usage: chmod <octal> <path>", g_row, 12);
            return false;
        }
        let mode: u32 = 0;
        let k: u32 = 0;
        while k < sp {
            let d: u8 = *((arg + (k as u64)) as *u8);
            if d >= 48 && d <= 55 {
                mode = mode * 8 + ((d - 48) as u32);
            }
            k = k + 1;
        }
        let idx: u32 = fs_resolve(arg + (sp as u64) + 1);
        if idx == 64 || idx == 255 {
            feed();
            print_string("chmod: not found", g_row, 12);
            return false;
        }
        if g_uid != 0 && (g_uid as u32) != (fs_uid(idx) as u32) {
            feed();
            print_string("chmod: not permitted", g_row, 12);
            return false;
        }
        *((fs_entry_addr(idx) + 44) as *u32) = mode;
        fs_sync();
        return false;
    }
    if starts_with(cmd, "chown ") {
        if !fs_guard() { return false; }
        if g_uid != 0 {
            feed();
            print_string("chown: not permitted (root only)", g_row, 12);
            return false;
        }
        let arg: u64 = (cmd as u32 + 6) as u64;
        let sp: u32 = find_char(arg as *u8, 32);
        if sp == 0 {
            feed();
            print_string("usage: chown <uid> <path>", g_row, 12);
            return false;
        }
        let uid: u32 = 0;
        let k: u32 = 0;
        while k < sp {
            let d: u8 = *((arg + (k as u64)) as *u8);
            if d >= 48 && d <= 57 {
                uid = uid * 10 + ((d - 48) as u32);
            }
            k = k + 1;
        }
        let idx: u32 = fs_resolve(arg + (sp as u64) + 1);
        if idx == 64 || idx == 255 {
            feed();
            print_string("chown: not found", g_row, 12);
            return false;
        }
        *((fs_entry_addr(idx) + 42) as *u8) = uid as u8;
        fs_sync();
        return false;
    }
    if streq(cmd, "reboot") {
        reboot();
        return false;         // not reached
    }
    if streq(cmd, "restart") {
        reboot();
        return false;         // not reached
    }
    if streq(cmd, "shutdown") {
        poweroff();
        return false;         // not reached
    }
    if streq(cmd, "poweroff") {
        poweroff();
        return false;         // not reached
    }
    if streq(cmd, "power") {
        open_power_menu();
        return false;
    }
    if streq(cmd, "memtest") {
        memtest();
        return false;
    }
    if streq(cmd, "lock") {
        open_lock();
        return false;
    }
    if streq(cmd, "sleep") {
        open_sleep();
        return false;
    }
    if streq(cmd, "crash") {
        asm("ud2");           // raise #UD (vector 6) to demo exception reporting
        return false;         // not reached
    }
    if streq(cmd, "uptime") {
        feed();
        print_at("uptime: ", g_row, 0, 7);
        num_to_str(g_ticks / 100, g_numbuf);        // 100 ticks per second
        print_at(g_numbuf, g_row, 8, 7);
        print_at(" s", g_row, 8 + g_numlen, 7);
        return false;
    }
    if streq(cmd, "clear") {
        clear_screen();
        g_row = 0;
        return true;
    }
    if streq(cmd, "about") {
        feed();
        print_string("MORT OS -- written in Mort, a language built from scratch", g_row, 7);
        return false;
    }
    if starts_with(cmd, "echo ") {
        feed();
        print_string((cmd as u32 + 5) as *u8, g_row, 15);   // print past "echo "
        return false;
    }
    if try_exec_path(cmd) {          // maybe it's a program on the $PATH
        return false;
    }
    feed();
    print_string("unknown command", g_row, 12);
    return false;
}

// Program the PIT channel 0 to raise IRQ0 at ~100 Hz (divisor 1193182/100).
fn init_pit() {
    let divisor: u32 = 11932;
    outb(0x43, 0x36);                    // channel 0, lo/hi byte, mode 3
    outb(0x40, (divisor % 256) as u8);   // low byte
    outb(0x40, (divisor / 256) as u8);   // high byte
}

// Timer interrupt handler (IRQ0) — called ~100x/second from timer_isr.
fn on_tick() {
    g_ticks = g_ticks + 1;
    let usb_sc: u8 = usb_hid_poll_scancode();
    if usb_sc != 0 {
        if g_usb_hid_extended { on_scancode(224); }
        g_shift = g_usb_hid_shift;
        on_scancode(usb_sc);
        g_shift = false;
    }
    if usb_hid_poll_mouse() { mouse_apply_report(); }
    if g_gfx {
        if (g_ticks % 100) == 0 {        // once a second: refresh the top-bar clock
            mouse_hide();
            draw_clock();
            mouse_show();
        }
    }
}

// CPU exception handler — called by isr_common (idt.s) with the faulting vector.
// We have no recovery path, so report which fault it was on the last row; the
// assembly stub halts afterwards.
fn on_exception(vec: u32) {
    let row: u32 = 24;
    print_at("*** CPU EXCEPTION #", row, 0, 79);   // white on red
    num_to_str(vec, g_numbuf);
    print_at(g_numbuf, row, 19, 79);
    print_at(" -- HALTED ***", row, 19 + g_numlen, 79);
}

// The keyboard interrupt handler. Called by keyboard_isr (idt.s) on each IRQ1.
// ----- desktop apps (graphics mode): Terminal, Files, Vex -----

// Render bytes [start, end) as text inside the window, wrapping at the right
// edge and honoring newlines; stops at the window bottom.
fn draw_page_text(start: u32, end: u32, x0: u32, y0: u32) {
    let x: u32 = x0;
    let y: u32 = y0;
    let p: u32 = start;
    while p < end {
        let ch: u8 = *(p as *u8);
        if ch == 10 {
            x = x0;
            y = y + 18;
        } else {
            if ch != 13 {
                draw_glyph(ch, x, y, 0xc8d0d4, 0x0b0f14);
                x = x + 8;
                if x > 824 {
                    x = x0;
                    y = y + 18;
                }
            }
        }
        if y > 578 {
            return;
        }
        p = p + 1;
    }
}

// The actual table index of the g_files_sel-th used file, or 64 if none.
fn files_selected_entry() -> u32 {
    let seen: u32 = 0;
    let i: u32 = 0;
    while i < 64 {
        if *((fs_entry_addr(i) + 24) as *u32) == 1 {
            if seen == g_files_sel {
                return i;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return 64;
}

// Files: show the selected file's contents (read into FILEBUF, then rendered).
fn files_draw_content() {
    let base: u32 = fs_entry_addr(g_files_entry);
    draw_text_abs("file:", 200, 200, 0x9fd0d8, 0x0b0f14);
    draw_text_abs(base as *u8, 248, 200, 0xffffff, 0x0b0f14);
    let size: u32 = fs_read_file(g_files_entry);
    draw_page_text(0x00810000, 0x00810000 + size, 200, 232);   // FILEBUF
    draw_text_abs("Esc: back   F1: terminal", 200, 580, 0x7a8b93, 0x0b0f14);
}

// Files: the graphical MortFS browser (list of files, or a file's contents).
fn files_draw() {
    window_title("files");
    clear_window();
    if !g_fs_ok {
        draw_text_abs("no disk / no MortFS -- boot with a disk attached", 200, 220, 0xff6b6b, 0x0b0f14);
        draw_text_abs("F1: terminal", 200, 580, 0x7a8b93, 0x0b0f14);
        return;
    }
    if g_files_view == 1 {
        files_draw_content();
        return;
    }
    draw_text_abs("Files on MortFS", 200, 200, 0x9fd0d8, 0x0b0f14);
    let shown: u32 = 0;
    let i: u32 = 0;
    while i < 64 {
        let base: u32 = fs_entry_addr(i);
        if *((base + 24) as *u32) == 1 {
            let y: u32 = 234 + shown * 20;
            let bg: u32 = 0x0b0f14;
            let fg: u32 = 0xc8d0d4;
            if shown == g_files_sel {
                bg = 0x243642;
                fg = 0xffffff;
                fill_rect(196, y - 2, 632, 20, bg);
            }
            draw_text_abs(base as *u8, 210, y, fg, bg);
            num_to_str(*((base + 28) as *u32), g_numbuf);
            draw_text_abs(g_numbuf, 640, y, fg, bg);
            draw_text_abs("bytes", 640 + g_numlen * 8 + 6, y, fg, bg);
            shown = shown + 1;
        }
        i = i + 1;
    }
    g_files_count = shown;
    if shown == 0 {
        draw_text_abs("(no files)", 210, 234, 0xc8d0d4, 0x0b0f14);
    }
    draw_text_abs("Up/Down: select   Enter: open   F1: terminal", 200, 580, 0x7a8b93, 0x0b0f14);
}

fn files_up() {
    if g_files_sel > 0 {
        g_files_sel = g_files_sel - 1;
        files_draw();
    }
}

fn files_down() {
    if g_files_sel + 1 < g_files_count {
        g_files_sel = g_files_sel + 1;
        files_draw();
    }
}

fn files_open() {
    let e: u32 = files_selected_entry();
    if e == 64 {
        return;
    }
    g_files_entry = e;
    g_files_view = 1;
    files_draw();
}

fn files_back() {
    g_files_view = 0;
    files_draw();
}

fn files_on_key(sc: u8) {
    if sc == 224 {
        g_ext = true;
        return;
    }
    if g_ext {
        g_ext = false;
        if sc == 72 { files_up(); }        // Up
        if sc == 80 { files_down(); }      // Down
        return;
    }
    if sc == 28 { files_open(); return; }  // Enter
    if sc == 1  { files_back(); return; }  // Esc
}

// Terminal: redraw a fresh window and prompt (its scrollback isn't preserved
// across app switches, but command history is).
fn terminal_activate() {
    window_title("terminal");
    clear_window();
    g_row = 0;
    print_string("MORT OS terminal -- type 'help', Enter", 0, 10);
    g_row = 2;
    g_len = 0;
    g_pcol = 0;
    draw_prompt(g_row);
    g_col = g_prompt_len;
    move_cursor(g_row, g_col);
}

// Switch the active app: highlight its tab and redraw its window.
fn switch_app(app: u32) {
    g_app = app;
    draw_topbar();
    if app == 0 { terminal_activate(); }
    if app == 1 {
        g_files_view = 0;
        g_files_sel = 0;
        files_draw();
    }
    if app == 2 { browser_draw(); }
    if app == 3 { settings_draw(); }
    draw_dock();
}

// ----- users, authentication & permissions -----
//
// An in-memory account table (root + a normal user) with djb2-hashed passwords
// — not cryptographically strong, but no worse than a toy /etc/passwd, and it
// keeps plaintext off the disk. The current user is g_uid/g_username. Password
// prompts read the keyboard directly (kread_line), the same polling trick the
// program syscall path uses, so they work from inside a shell command.

fn hash_pw(s: *u8) -> u32 {
    let h: u32 = 5381;
    let i: u32 = 0;
    while *((s as u32 + i) as *u8) != 0 {
        h = h * 33 + (*((s as u32 + i) as *u8) as u32);
        i = i + 1;
    }
    return h;
}

fn acct_add(name: *u8, uid: u32, hash: u32) {
    if g_acct_count >= 8 {
        return;
    }
    let slot: u32 = g_acct_count;
    let base: u64 = (&g_acct_name as u64) + ((slot * 24) as u64);
    let k: u32 = 0;
    while k < 24 {
        *((base + (k as u64)) as *u8) = 0;
        k = k + 1;
    }
    str_copy(base as *u8, name);
    g_acct_uid[slot] = uid;
    g_acct_hash[slot] = hash;
    g_acct_count = slot + 1;
}

fn acct_find(name: *u8) -> u32 {
    let i: u32 = 0;
    while i < g_acct_count {
        let base: u64 = (&g_acct_name as u64) + ((i * 24) as u64);
        if streq(name, base as *u8) {
            return i;
        }
        i = i + 1;
    }
    return 64;
}

// The default accounts: root (uid 0) and a normal user (uid 1).
fn acct_init() {
    g_acct_count = 0;
    acct_add("root", 0, hash_pw("toor"));
    acct_add("mortuex", 1, hash_pw("mort"));
}

fn login_default() {
    g_uid = 1;                                  // auto-login as the normal user
    str_copy((&g_username as u64) as *u8, "mortuex");
}

// Start the shell in the user's home directory (falling back to root).
fn cwd_init() {
    let hb: [u8; 64] = [0; 64];
    str_copy((&hb as u64) as *u8, "/home/");
    str_copy(((&hb as u64) + 6) as *u8, (&g_username as u64) as *u8);
    let idx: u32 = fs_resolve(&hb as u64);
    if idx == 64 {
        idx = 255;
    }
    if idx != 255 {
        if fs_type(idx) != 1 {
            idx = 255;
        }
    }
    g_cwd = idx;
    path_of(g_cwd, &g_cwdpath as u64);
}

// Read a line from the keyboard by polling (interrupts are off inside a shell
// command). Echoes each character, or '*' when mask is true. Returns length.
fn kread_line(buf: u64, mask: bool) -> u32 {
    let len: u32 = 0;
    let shift: bool = false;
    move_cursor(g_row, g_col);
    while true {
        while (inb(0x64) & 1) == 0 {
        }
        let sc: u8 = inb(0x60);
        if sc == 42 || sc == 54 {
            shift = true;
        } else if sc == 170 || sc == 182 {
            shift = false;
        } else if sc == 28 {                    // Enter
            *((buf + (len as u64)) as *u8) = 0;
            feed();
            g_col = 2;
            return len;
        } else if sc == 14 {                    // Backspace
            if len > 0 {
                len = len - 1;
                if g_col > 0 { g_col = g_col - 1; }
                put_cell_at(g_row, g_col, 32, 7);
                move_cursor(g_row, g_col);
            }
        } else if sc < 128 {
            let ch: u8 = scancode_to_ascii(sc, shift);
            if ch != 0 && len < 60 {
                *((buf + (len as u64)) as *u8) = ch;
                len = len + 1;
                let disp: u8 = ch;
                if mask { disp = 42; }          // '*'
                put_cell_at(g_row, g_col, disp, 15);
                g_col = g_col + 1;
                move_cursor(g_row, g_col);
            }
        }
    }
    return len;
}

// May the current user write something owned by `uid` with permission `mode`?
// root always may; the owner needs the owner-write bit; everyone else the
// other-write bit.
fn can_write(uid: u8, mode: u32) -> bool {
    if g_uid == 0 {
        return true;
    }
    if (g_uid as u32) == (uid as u32) {
        return (mode & 0x80) != 0;              // 0200 octal: owner write
    }
    return (mode & 0x2) != 0;                   // 0002 octal: other write
}

// Owner/mode of a directory index, treating root (255) as root-owned 0755.
fn dir_owner(dir: u32) -> u8 {
    if dir == 255 { return 0; }
    return fs_uid(dir);
}
fn dir_mode(dir: u32) -> u32 {
    if dir == 255 { return 0x1ED; }
    return fs_mode(dir);
}

// Give the normal user a home directory they own: /home/<user>, chowned to
// them. Created as root during boot (before login).
fn ensure_home() {
    if fs_resolve("/home/mortuex" as u64) != 64 {
        return;
    }
    let home: u32 = fs_resolve("/home" as u64);
    if home == 64 {
        return;
    }
    let idx: u32 = fs_create_full("mortuex", home, 1);
    if idx != 64 {
        *((fs_entry_addr(idx) + 42) as *u8) = 1;    // chown to uid 1
        fs_sync();
    }
}

// ----- session & power (clock, power menu, lock, sleep, shutdown) -----
//
// A small session layer over the desktop. A clock ticks in the top bar (read
// from the CMOS RTC); F12 opens a power flyout (Lock / Sleep / Restart / Shut
// down); the lock screen wants a password; sleep blanks the screen until a key.
// Overlays own the keyboard while active (see on_key) and draw with the same
// framebuffer primitives as the rest of the desktop.

// Centered text at horizontal center cx (glyphs are 8px wide).
fn draw_center(s: *u8, cx: u32, y: u32, fg: u32, bg: u32) {
    let w: u32 = str_len(s) * 8;
    draw_text_abs(s, cx - w / 2, y, fg, bg);
}

// ---- clock (CMOS RTC) ----

fn rtc_reg(reg: u8) -> u8 {
    outb(0x70, reg);
    return inb(0x71);
}

fn rtc_conv(v: u8, binmode: bool) -> u8 {
    if binmode {
        return v;
    }
    return ((v >> 4) * 10) + (v & 15);      // BCD -> binary
}

// Write v as two decimal digits at buf+off.
fn write2(buf: u64, off: u32, v: u8) {
    let t: *u8 = (buf + (off as u64)) as *u8;
    *t = (48 + (v / 10)) as u8;
    let o: *u8 = (buf + (off as u64) + 1) as *u8;
    *o = (48 + (v % 10)) as u8;
}

// Draw the configured time format at the top-right of the top bar.
fn draw_clock() {
    if !g_gfx {
        return;
    }
    if g_overlay != 0 {
        return;
    }
    let stb: u8 = rtc_reg(0x0B);
    let binmode: bool = (stb & 4) != 0;
    let s: u8 = rtc_conv(rtc_reg(0), binmode);
    let m: u8 = rtc_conv(rtc_reg(2), binmode);
    let h: u8 = rtc_conv(rtc_reg(4), binmode);
    let buf: [u8; 12] = [0; 12];
    let b: u64 = &buf as u64;
    let shown_h: u8 = h;
    if !g_clock_24h {
        shown_h = h % 12;
        if shown_h == 0 { shown_h = 12; }
    }
    write2(b, 0, shown_h);
    let c0: *u8 = (b + 2) as *u8; *c0 = 58;         // ':'
    write2(b, 3, m);
    let pos: u32 = 5;
    if g_clock_seconds {
        let c1: *u8 = (b + 5) as *u8; *c1 = 58;
        write2(b, 6, s);
        pos = 8;
    }
    if !g_clock_24h {
        let sp: *u8 = (b + (pos as u64)) as *u8; *sp = 32;
        let ap: *u8 = (b + (pos as u64) + 1) as *u8;
        if h < 12 { *ap = 65; } else { *ap = 80; }
        let mp: *u8 = (b + (pos as u64) + 2) as *u8; *mp = 77;
        pos = pos + 3;
    }
    let term: *u8 = (b + (pos as u64)) as *u8; *term = 0;
    outline_round_rect(g_fb_w - 132, 7, 116, 30, 10, 0x262a3a, 0x191c28);
    draw_text_abs(&buf as *u8, g_fb_w - 122, 14, 0xe9ebf5, 0x191c28);
}

// ---- power flyout ----

// Save / restore the 260x200 framebuffer region under the flyout, so cancelling
// it leaves whatever was underneath (terminal, an app) exactly as it was.
fn save_box() {
    let dst: u64 = &g_boxsave as u64;
    let yy: u32 = 0;
    while yy < 200 {
        let srow: u32 = g_fb + (g_box_y + yy) * g_fb_pitch + g_box_x * 4;
        let drow: u64 = dst + ((yy * 260 * 4) as u64);
        let xx: u32 = 0;
        while xx < 260 {
            *((drow + (xx as u64) * 4) as *u32) = *((srow + xx * 4) as *u32);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

fn restore_box() {
    let src: u64 = &g_boxsave as u64;
    let yy: u32 = 0;
    while yy < 200 {
        let drow: u32 = g_fb + (g_box_y + yy) * g_fb_pitch + g_box_x * 4;
        let srow: u64 = src + ((yy * 260 * 4) as u64);
        let xx: u32 = 0;
        while xx < 260 {
            *((drow + xx * 4) as *u32) = *((srow + (xx as u64) * 4) as *u32);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

fn draw_power_item(idx: u32, label: *u8, x: u32, iy: u32) {
    let bg: u32 = 0x11202b;
    let fg: u32 = 0xc8d0d4;
    if idx == g_power_sel {
        bg = 0x2c5364;
        fg = 0xffffff;
    }
    fill_rect(x + 12, iy - 5, 236, 28, bg);
    draw_text_abs(label, x + 28, iy, fg, bg);
}

fn draw_power_menu() {
    let x: u32 = g_box_x;
    let y: u32 = g_box_y;
    fill_rect(x, y, 260, 200, 0x11202b);            // panel
    fill_rect(x, y, 260, 3, 0x3fb950);              // accent bar
    draw_text_abs("Power", x + 20, y + 16, 0x9fd0d8, 0x11202b);
    draw_power_item(0, "Lock", x, y + 52);
    draw_power_item(1, "Sleep", x, y + 88);
    draw_power_item(2, "Restart", x, y + 124);
    draw_power_item(3, "Shut down", x, y + 160);
}

fn open_power_menu() {
    if !g_gfx {
        return;
    }
    g_box_x = (g_fb_w - 260) / 2;
    g_box_y = (g_fb_h - 200) / 2;
    save_box();
    g_power_sel = 0;
    g_ov_ext = false;
    g_overlay = 1;
    draw_power_menu();
}

// Repaint the desktop and re-render the active app after a full-screen overlay.
fn restore_desktop() {
    fill_gradient(g_wall_top, g_wall_bottom);
    fill_round_rect(188, 170, 664, 456, 14, 0x05060a);
    outline_round_rect(180, 160, 664, 456, 14, 0x363b4f, 0x12141d);
    switch_app(g_app);                              // top bar + active app content
    draw_clock();
}

// ---- lock screen ----

fn draw_lock() {
    fill_gradient(0x081327, 0x14324a);
    let cx: u32 = g_fb_w / 2;
    let cy: u32 = g_fb_h / 2;
    fill_rect(cx - 190, cy - 120, 380, 240, 0x11202b);
    fill_rect(cx - 190, cy - 120, 380, 3, 0x2c5364);
    draw_center("MORT OS", cx, cy - 92, 0xffffff, 0x11202b);
    draw_center("Locked", cx, cy - 66, 0x9fd0d8, 0x11202b);

    // password field with masked characters
    fill_rect(cx - 130, cy - 20, 260, 30, 0x0b0f14);
    let stars: [u8; 24] = [0; 24];
    let n: u32 = g_lock_len;
    if n > 16 {
        n = 16;
    }
    for i: u32 in 0..n {
        let d: *u8 = ((&stars as u64) + (i as u64)) as *u8;
        *d = 42;                                    // '*'
    }
    let term: *u8 = ((&stars as u64) + (n as u64)) as *u8;
    *term = 0;
    draw_center(&stars as *u8, cx, cy - 13, 0xdfeef2, 0x0b0f14);

    if g_lock_err {
        draw_center("wrong password", cx, cy + 30, 0xff6b6b, 0x11202b);
    } else {
        draw_center("type your password, then Enter", cx, cy + 30, 0x5a6b73, 0x11202b);
    }
}

fn open_lock() {
    if !g_gfx {
        feed();
        print_string("lock needs the graphical desktop", g_row, 12);
        return;
    }
    g_lock_len = 0;
    g_lock_err = false;
    g_overlay = 2;
    draw_lock();
}

// Unlock if the typed password matches the current user's account password.
fn lock_ok() -> bool {
    let ai: u32 = acct_find((&g_username as u64) as *u8);
    if ai == 64 {
        return false;
    }
    *(((&g_lockbuf as u64) + (g_lock_len as u64)) as *u8) = 0;   // NUL-terminate the entry
    return g_acct_hash[ai] == hash_pw((&g_lockbuf as u64) as *u8);
}

// ---- sleep ----

fn draw_sleep() {
    fill_rect(0, 0, g_fb_w, g_fb_h, 0x02060a);
    draw_center("Sleeping", g_fb_w / 2, g_fb_h / 2 - 10, 0x46575f, 0x02060a);
    draw_center("press any key to wake", g_fb_w / 2, g_fb_h / 2 + 14, 0x30414a, 0x02060a);
}

fn open_sleep() {
    if !g_gfx {
        feed();
        print_string("sleep needs the graphical desktop", g_row, 12);
        return;
    }
    g_overlay = 3;
    draw_sleep();
}

// ---- shutdown ----

fn poweroff() {
    if g_gfx {
        fill_rect(0, 0, g_fb_w, g_fb_h, 0x0a1020);
        draw_center("MORT OS", g_fb_w / 2, g_fb_h / 2 - 30, 0xffffff, 0x0a1020);
        draw_center("It is now safe to turn off your computer.",
                    g_fb_w / 2, g_fb_h / 2 + 4, 0x9fd0d8, 0x0a1020);
    } else {
        print_at("It is now safe to turn off your computer.", 24, 0, 15);
    }
    // Emulator ACPI power-off ports (QEMU, Bochs, VirtualBox). On real hardware
    // these do nothing, and we fall through to a permanent halt.
    outw(0x604, 0x2000);
    outw(0xB004, 0x2000);
    outw(0x4004, 0x3400);
    asm("cli");
    while true {
        asm("hlt");
    }
}

// ----- home launcher (the desktop's app grid) -----

// A filled circle, for the power icon.
fn fill_circle(cx: u32, cy: u32, r: u32, color: u32) {
    let dy: u32 = 0;
    while dy <= r + r {
        let oy: i32 = (dy as i32) - (r as i32);
        let dx: u32 = 0;
        while dx <= r + r {
            let ox: i32 = (dx as i32) - (r as i32);
            if ox * ox + oy * oy <= (r * r) as i32 {
                put_pixel(cx - r + dx, cy - r + dy, color);
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

// Draw one app's icon centered at (cx, cy). `bg` is the tile colour (used for
// the cut-outs in the power ring).
fn draw_app_icon(app: u32, cx: u32, cy: u32, bg: u32) {
    if app == 0 {                                   // Terminal
        let x: u32 = cx - 32;
        let y: u32 = cy - 24;
        fill_rect(x, y, 64, 48, 0x0d1117);
        fill_rect(x, y, 64, 11, 0x30363d);
        fill_rect(x + 6, y + 4, 4, 4, 0xff5f57);
        fill_rect(x + 13, y + 4, 4, 4, 0xfebc2e);
        fill_rect(x + 20, y + 4, 4, 4, 0x28c840);
        draw_text_abs(">_", x + 8, y + 22, 0x3fb950, 0x0d1117);
    } else if app == 1 {                            // Files (a folder)
        let x: u32 = cx - 30;
        let y: u32 = cy - 22;
        fill_rect(x, y, 24, 8, 0xd9a441);
        fill_rect(x, y + 6, 60, 40, 0xf0c060);
        fill_rect(x + 3, y + 12, 54, 31, 0xf7d79a);
    } else if app == 2 {                            // Canonical Vex gold diamond + V
        let r: u32 = 26;
        let dy: u32 = 0;
        while dy <= r + r {
            let oy: i32 = (dy as i32) - (r as i32);
            let ay: i32 = oy;
            if ay < 0 { ay = 0 - ay; }
            let hw: i32 = (r as i32) - ay;
            if hw > 0 {
                fill_rect(cx - (hw as u32), cy - r + dy, (hw as u32) * 2, 1, 0x8f704c);
            }
            dy = dy + 1;
        }
        draw_line(cx - 13, cy - 2, cx, cy + 15, 3, 0xffffff);
        draw_line(cx, cy + 15, cx + 13, cy - 2, 3, 0xffffff);
    } else if app == 3 {                            // Settings (sliders)
        let x: u32 = cx - 28;
        fill_rect(x, cy - 18, 56, 4, 0x5a6b73);
        fill_rect(x + 8, cy - 22, 10, 12, 0xdfeef2);
        fill_rect(x, cy - 2, 56, 4, 0x5a6b73);
        fill_rect(x + 34, cy - 6, 10, 12, 0xdfeef2);
        fill_rect(x, cy + 14, 56, 4, 0x5a6b73);
        fill_rect(x + 20, cy + 10, 10, 12, 0xdfeef2);
    } else {                                        // Power (ring + bar)
        fill_circle(cx, cy + 2, 26, 0x877bff);
        fill_circle(cx, cy + 2, 19, bg);
        fill_rect(cx - 8, cy - 24, 16, 20, bg);
        fill_rect(cx - 3, cy - 22, 6, 22, 0x877bff);
    }
}

fn draw_dock_icon(app: u32, cx: u32, cy: u32, active: bool) {
    let tile: u32 = 0x191c28;
    if active { tile = 0x24213f; }
    fill_round_rect(cx - 21, cy - 21, 42, 42, 11, tile);
    if app == 0 {
        outline_round_rect(cx - 13, cy - 10, 26, 20, 4, 0x969cb3, tile);
        draw_text_abs(">_", cx - 9, cy - 7, 0x877bff, tile);
    } else if app == 1 {
        fill_round_rect(cx - 13, cy - 7, 26, 18, 4, 0x969cb3);
        fill_rect(cx - 12, cy - 11, 10, 6, 0x969cb3);
        fill_rect(cx - 10, cy - 4, 22, 12, tile);
    } else if app == 2 {
        let r: u32 = 13;
        let dy: u32 = 0;
        while dy <= r + r {
            let oy: i32 = (dy as i32) - (r as i32);
            let ay: i32 = oy; if ay < 0 { ay = 0 - ay; }
            let hw: i32 = (r as i32) - ay;
            if hw > 0 { fill_rect(cx - (hw as u32), cy - r + dy, (hw as u32) * 2, 1, 0x8f704c); }
            dy = dy + 1;
        }
        draw_line(cx - 6, cy - 1, cx, cy + 7, 2, 0xffffff);
        draw_line(cx, cy + 7, cx + 6, cy - 1, 2, 0xffffff);
    } else if app == 3 {
        fill_rect(cx - 12, cy - 8, 24, 2, 0x969cb3);
        fill_rect(cx - 12, cy, 24, 2, 0x969cb3);
        fill_rect(cx - 12, cy + 8, 24, 2, 0x969cb3);
        fill_round_rect(cx - 7, cy - 11, 6, 8, 2, 0x877bff);
        fill_round_rect(cx + 3, cy - 3, 6, 8, 2, 0x877bff);
        fill_round_rect(cx - 2, cy + 5, 6, 8, 2, 0x877bff);
    } else {
        fill_circle(cx, cy, 11, 0x969cb3);
        fill_circle(cx, cy, 7, tile);
        fill_rect(cx - 4, cy - 13, 8, 8, tile);
        fill_rect(cx - 1, cy - 12, 3, 10, 0x969cb3);
    }
    if active { fill_round_rect(cx - 8, cy + 24, 16, 3, 2, 0x877bff); }
}

fn draw_dock_clock(x: u32, y: u32) {
    let stb: u8 = rtc_reg(0x0B);
    let binmode: bool = (stb & 4) != 0;
    let m: u8 = rtc_conv(rtc_reg(2), binmode);
    let h: u8 = rtc_conv(rtc_reg(4), binmode);
    let shown_h: u8 = h;
    if !g_clock_24h {
        shown_h = h % 12;
        if shown_h == 0 { shown_h = 12; }
    }
    let buf: [u8; 9] = [0; 9];
    let base: u64 = &buf as u64;
    write2(base, 0, shown_h);
    *((base + 2) as *u8) = 58;
    write2(base, 3, m);
    let pos: u32 = 5;
    if !g_clock_24h {
        *((base + 5) as *u8) = 32;
        if h < 12 { *((base + 6) as *u8) = 65; } else { *((base + 6) as *u8) = 80; }
        *((base + 7) as *u8) = 77;
        pos = 8;
    }
    *((base + (pos as u64)) as *u8) = 0;
    draw_text_abs(&buf as *u8, x + 34, y + 10, 0xe9ebf5, 0x191c28);
    draw_text_abs("MortuexOS", x + 28, y + 31, 0x969cb3, 0x191c28);
}

fn draw_dock() {
    if !g_gfx || g_overlay == 2 || g_overlay == 3 { return; }
    let x: u32 = (g_fb_w - 520) / 2;
    let y: u32 = g_fb_h - 72;
    outline_round_rect(x, y, 520, 56, 16, 0x363b4f, 0x191c28);
    draw_brand_mark(x + 28, y + 28);
    outline_round_rect(x + 54, y + 8, 192, 40, 12, 0x363b4f, 0x12141d);
    draw_text_abs("/", x + 67, y + 20, 0x877bff, 0x12141d);
    draw_text_abs("Search apps and files", x + 84, y + 20, 0x969cb3, 0x12141d);
    fill_rect(x + 254, y + 14, 1, 28, 0x363b4f);
    for app: u32 in 0..4 {
        draw_dock_icon(app, x + 278 + app * 50, y + 27, g_overlay == 0 && g_app == app);
    }
    draw_dock_icon(4, x + 482, y + 27, false);

    outline_round_rect(x + 532, y, 148, 56, 16, 0x363b4f, 0x191c28);
    draw_dock_clock(x + 532, y);
}

fn launcher_label(i: u32) -> u64 {
    if i == 0 { return "Terminal" as u64; }
    if i == 1 { return "Files" as u64; }
    if i == 2 { return "Vex" as u64; }
    if i == 3 { return "Settings" as u64; }
    return "Power" as u64;
}

fn draw_launcher() {
    fill_gradient(g_wall_top, g_wall_bottom);
    draw_topbar();
    fill_round_rect(128, 80, 784, 548, 18, 0x05060a);
    outline_round_rect(120, 72, 784, 548, 18, 0x363b4f, 0x12141d);
    fill_rect(121, 116, 782, 1, 0x262a3a);
    draw_brand_mark(150, 94);
    draw_text_abs("Home", 178, 87, 0xe9ebf5, 0x12141d);
    draw_text_abs("-", 836, 87, 0x969cb3, 0x12141d);
    draw_text_abs("x", 876, 87, 0x969cb3, 0x12141d);

    draw_center("Welcome to mortuexOS", g_fb_w / 2, 150, 0xe9ebf5, 0x12141d);
    let wl: [u8; 40] = [0; 40];
    str_copy((&wl as u64) as *u8, "Ready for you, ");
    str_copy(((&wl as u64) + 15) as *u8, (&g_username as u64) as *u8);
    draw_center((&wl as u64) as *u8, g_fb_w / 2, 178, 0x969cb3, 0x12141d);

    outline_round_rect(202, 216, 620, 46, 13, 0x363b4f, 0x0b0d14);
    draw_text_abs("/", 220, 231, 0x877bff, 0x0b0d14);
    draw_text_abs("Search apps, settings, files, or enter a web address", 244, 231, 0x969cb3, 0x0b0d14);
    draw_text_abs("QUICK LAUNCH", 164, 294, 0x969cb3, 0x12141d);

    let startx: u32 = 164;
    let ty: u32 = 322;
    let i: u32 = 0;
    while i < 5 {
        let tx: u32 = startx + i * 140;
        let bg: u32 = 0x191c28;
        if i == g_launch_sel {
            fill_round_rect(tx - 2, ty - 2, 128, 144, 13, 0x877bff);
            bg = 0x24213f;
        }
        fill_round_rect(tx, ty, 124, 140, 12, bg);
        draw_app_icon(i, tx + 62, ty + 52, bg);
        draw_center(launcher_label(i) as *u8, tx + 62, ty + 112, 0xe9ebf5, bg);
        i = i + 1;
    }

    outline_round_rect(164, 492, 684, 74, 12, 0x262a3a, 0x0b0d14);
    draw_text_abs("Mort native", 184, 508, 0x55d6a0, 0x0b0d14);
    draw_text_abs("Filesystem, hardware, settings, and Vex are running in the kernel.", 288, 508, 0x969cb3, 0x0b0d14);
    draw_text_abs("Arrow keys move   Enter opens   Esc returns   F5 opens Home", 184, 534, 0x5d6379, 0x0b0d14);
    draw_dock();
}

fn open_launcher() {
    if !g_gfx {
        return;
    }
    g_launch_sel = 0;
    g_ov_ext = false;
    g_overlay = 4;
    draw_launcher();
}

fn launcher_on_key(sc: u8) {
    if sc == 224 {                                  // extended prefix (arrows)
        g_ov_ext = true;
        return;
    }
    if g_ov_ext {
        g_ov_ext = false;
        if sc == 75 {                               // Left
            if g_launch_sel > 0 { g_launch_sel = g_launch_sel - 1; }
            draw_launcher();
        }
        if sc == 77 {                               // Right
            if g_launch_sel < 4 { g_launch_sel = g_launch_sel + 1; }
            draw_launcher();
        }
        return;
    }
    if sc == 1 {                                    // Esc: back to the current app
        g_overlay = 0;
        restore_desktop();
        return;
    }
    if sc == 28 {                                   // Enter: launch the selected tile
        let sel: u32 = g_launch_sel;
        g_overlay = 0;
        if sel <= 3 {
            g_app = sel;
            restore_desktop();
        } else {
            restore_desktop();
            open_power_menu();
        }
        return;
    }
}

fn power_activate(sel: u32) {
    if sel == 0 { open_lock(); return; }            // full-screen; box stays saved but unused
    if sel == 1 { open_sleep(); return; }
    if sel == 2 { reboot(); return; }
    if sel == 3 { poweroff(); return; }
}

// ---- overlay key routing ----

fn power_on_key(sc: u8) {
    if sc == 224 {                                  // extended prefix (arrows)
        g_ov_ext = true;
        return;
    }
    if g_ov_ext {
        g_ov_ext = false;
        if sc == 72 {                               // Up
            if g_power_sel > 0 { g_power_sel = g_power_sel - 1; }
            draw_power_menu();
        }
        if sc == 80 {                               // Down
            if g_power_sel < 3 { g_power_sel = g_power_sel + 1; }
            draw_power_menu();
        }
        return;
    }
    if sc == 1 {                                    // Esc: cancel, restore what was under it
        restore_box();
        g_overlay = 0;
        return;
    }
    if sc == 28 {                                   // Enter: activate
        power_activate(g_power_sel);
        return;
    }
}

fn lock_on_key(sc: u8) {
    if sc == 42 || sc == 54 { g_shift = true; return; }
    if sc == 170 || sc == 182 { g_shift = false; return; }
    if sc == 224 { return; }
    if sc >= 128 { return; }
    if sc == 28 {                                   // Enter: check password
        if lock_ok() {
            g_overlay = 0;
            restore_desktop();
        } else {
            g_lock_err = true;
            g_lock_len = 0;
            draw_lock();
        }
        return;
    }
    if sc == 14 {                                   // Backspace
        if g_lock_len > 0 {
            g_lock_len = g_lock_len - 1;
            draw_lock();
        }
        return;
    }
    let ch: u8 = scancode_to_ascii(sc, g_shift);
    if ch != 0 && g_lock_len < 16 {
        let d: *u8 = ((&g_lockbuf as u64) + (g_lock_len as u64)) as *u8;
        *d = ch;
        g_lock_len = g_lock_len + 1;
        g_lock_err = false;
        draw_lock();
    }
}

fn overlay_on_key(sc: u8) {
    if g_overlay == 1 { power_on_key(sc); return; }
    if g_overlay == 2 { lock_on_key(sc); return; }
    if g_overlay == 4 { launcher_on_key(sc); return; }
    if g_overlay == 3 {                             // sleep: any key press wakes
        if sc < 128 {
            g_overlay = 0;
            restore_desktop();
        }
        return;
    }
}

fn on_scancode(sc: u8) {
    mouse_hide();
    // App shortcuts remain global while the Home launcher or power menu is
    // visible. Lock and sleep keep exclusive input ownership so they cannot
    // be bypassed with an app-switch key.
    if g_gfx && g_overlay != 2 && g_overlay != 3 {
        if sc == 88 {
            open_power_menu();
            return;
        }
        if sc >= 59 && sc <= 62 {
            g_overlay = 0;
            switch_app((sc as u32) - 59);
            return;
        }
        if sc == 63 { open_launcher(); return; }
    }
    if g_overlay != 0 {              // an overlay owns the keyboard while it's up
        overlay_on_key(sc);
        return;
    }
    if g_app == 1 {                  // route to the active app
        files_on_key(sc);
        return;
    }
    if g_app == 2 {
        browser_on_key(sc);
        return;
    }
    if g_app == 3 { settings_on_key(sc); return; }

    if sc == 224 {                   // 0xE0: extended-scancode prefix
        g_ext = true;
        return;
    }
    if g_ext {                       // second byte of an extended key
        g_ext = false;
        if sc == 72 {                // Up arrow -> older command
            history_up();
        }
        if sc == 80 {                // Down arrow -> newer command
            history_down();
        }
        return;
    }

    if sc == 42 || sc == 54 {        // Shift pressed
        g_shift = true;
        return;
    }
    if sc == 170 || sc == 182 {      // Shift released
        g_shift = false;
        return;
    }
    if sc >= 128 {                   // ignore other key releases
        return;
    }

    if sc == 28 {                    // Enter: run the line
        *((g_buf as u32 + g_len) as *u8) = 0;
        if g_len > 0 {               // remember non-empty commands
            hist_store(g_buf);
        }
        g_hist_nav = 0;
        let cleared: bool = run_command(g_buf);
        if g_overlay != 0 {          // a command opened an overlay — leave the terminal be
            return;
        }
        if !cleared {                // move to a fresh prompt line (scrolls)
            feed();
        }
        g_len = 0;
        draw_prompt(g_row);
        g_col = g_prompt_len;
        move_cursor(g_row, g_col);
        return;
    }
    if sc == 14 {                    // Backspace
        if g_len > 0 {
            g_len = g_len - 1;
            g_col = g_col - 1;
            put_cell_at(g_row, g_col, 32, 7);
            move_cursor(g_row, g_col);
        }
        return;
    }

    let ch: u8 = scancode_to_ascii(sc, g_shift);
    if ch != 0 {
        if g_len < 76 {                // MAXLINE = 76
            g_hist_nav = 0;          // typing starts a fresh line
            *((g_buf as u32 + g_len) as *u8) = ch;
            g_len = g_len + 1;
            put_cell_at(g_row, g_col, ch, 15);
            g_col = g_col + 1;
            move_cursor(g_row, g_col);
        }
    }
}

fn on_key() {
    on_scancode(inb(0x60));
}

fn kmain(mbinfo: u32) {
    g_mbinfo = mbinfo;               // saved by boot.s; lets us find the modules
    heap_init();                     // carve a dynamic-memory heap out of high RAM
    fb_init();                       // detect a linear framebuffer (ISO/Limine path)
    if g_gfx {
        draw_desktop();              // wallpaper + top bar + terminal window frame
    }

    clear_screen();
    enable_cursor();
    print_string("MORT OS -- interrupt-driven. type 'help', Enter", 0, 10);
    fs_init();                       // detect the disk + mount MortFS (safe without either)
    fs_ensure_layout();              // seed /bin /etc /home /var if this is a fresh disk (as root)
    fs_populate_bin();               // move seeded *.bin programs into /bin, executable
    acct_init();                     // load the account table (root + a normal user)
    ensure_home();                   // create /home/mortuex, owned by the user
    login_default();                 // auto-login as the normal user (uid 1)
    cwd_init();                      // start in the user's home directory
    tls_crypto_self_test();          // publish-gated TLS primitive test vectors

    run_script(1);                   // run the startup script loaded from disk

    feed();
    g_len = 0;
    draw_prompt(g_row);
    g_col = g_prompt_len;
    move_cursor(g_row, g_col);

    usb_boot_init();                 // own UHCI and enumerate connected root ports before IRQs
    init_pit();                      // start the ~100 Hz timer (IRQ0)
    if g_gfx {
        open_launcher();             // greet with the home screen (graphics desktop)
    }
    asm("sti");                      // enable interrupts (keyboard IRQ1 + timer IRQ0)
    while true {
        asm("hlt");                  // sleep until the next interrupt
    }
}
