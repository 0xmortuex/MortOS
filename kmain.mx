// MORT OS — an interrupt-driven shell written in Mort.
//
// boot.s installs a GDT/IDT and remaps the PICs (see idt.s), then calls
// mort_kmain, which draws a prompt, enables interrupts, and idles with `hlt`.
// Each keystroke raises IRQ1; the assembly stub calls on_key() below, which
// reads the scancode and drives the shell. Shell state lives in globals so it
// survives between interrupts.

// ----- shared shell state (globals) -----
let g_row: u32 = 2;
let g_col: u32 = 2;
let g_len: u32 = 0;
let g_prompt_len: u32 = 2;                                     // width of the drawn prompt (input starts here)
let g_shift: bool = false;
let g_buf: *u8 = "                                                                                ";   // 80-byte scratch (76 chars + NUL + slack), MAXLINE = 76
let g_ticks: u32 = 0;                                          // PIT ticks (100/s)
let g_numlen: u32 = 0;                                         // digits written by num_to_str
let g_numbuf: *u8 = "            ";                            // 12-byte number scratch
let g_mbinfo: u32 = 0;                                        // multiboot info pointer (from boot.s)
let g_ext: bool = false;                                      // saw the 0xE0 extended-scancode prefix
let g_hist_n: u32 = 0;                                         // total commands entered
let g_hist_nav: u32 = 0;                                       // 0 = live line, k = k-th most recent recalled
let g_disk_ok: bool = false;                                   // ata_init() found a drive
let g_fs_ok: bool = false;                                     // fs_init() verified the MortFS magic
let g_uid: u8 = 0;                                             // current user id (0 = root; set at login)
// ----- user accounts (in-memory table; persistence comes later) -----
let g_username: [u8; 24] = [0; 24];                           // current user's name
let g_acct_count: u32 = 0;                                    // number of accounts
let g_acct_name: [u8; 192] = [0; 192];                        // 8 slots x 24 bytes
let g_acct_uid: [u32; 8] = [0; 8];                            // each account's uid
let g_acct_hash: [u32; 8] = [0; 8];                           // each account's password hash
let g_cwd: u32 = 255;                                         // current working directory (index; 255 = root)
let g_cwdpath: [u8; 128] = [0; 128];                          // cwd as an absolute path string (for pwd)
// ----- environment variables -----
let g_env_count: u32 = 0;                                     // number of custom variables
let g_env_name: [u8; 256] = [0; 256];                         // 8 slots x 32 bytes
let g_env_val: [u8; 512] = [0; 512];                          // 8 slots x 64 bytes
let g_envscratch: [u8; 80] = [0; 80];                         // scratch for computed built-ins
let g_cmdexp: [u8; 256] = [0; 256];                           // a command line after $VAR expansion
let g_run_depth: u32 = 0;                                      // forbids nested `run` (FILEBUF reuse)
let g_pcol: u32 = 0;                                           // program-output cursor column (syscalls)
let g_gfx: bool = false;                                       // a linear framebuffer is available
let g_fb: u32 = 0;                                             // framebuffer base address
let g_fb_pitch: u32 = 0;                                       // bytes per scanline
let g_fb_w: u32 = 0;                                           // width in pixels
let g_fb_h: u32 = 0;                                           // height in pixels
let g_cur_r: u32 = 0;                                          // last drawn cursor cell (graphics)
let g_cur_c: u32 = 0;
let g_mouse_x: u32 = 512;                                      // USB HID pointer position
let g_mouse_y: u32 = 384;
let g_mouse_buttons: u8 = 0;
let g_mouse_present: bool = false;
let g_mouse_visible: bool = false;
let g_mouse_save: [u32; 216] = [0; 216];                       // 12x18 pixels under cursor
let g_app: u32 = 0;                                            // active app: 0 terminal, 1 files, 2 vex
let g_files_sel: u32 = 0;                                      // Files: selected row
let g_files_view: u32 = 0;                                     // Files: 0 = list, 1 = file contents
let g_files_entry: u32 = 0;                                    // Files: entry index being viewed
let g_files_count: u32 = 0;                                    // Files: number of listed files
// ----- session / power state -----
let g_overlay: u32 = 0;                                        // 0 none, 1 power menu, 2 lock, 3 sleep
let g_power_sel: u32 = 0;                                      // highlighted power-menu item (0..3)
let g_launch_sel: u32 = 0;                                     // highlighted home-launcher tile (0..4)
let g_ov_ext: bool = false;                                    // overlay's own extended-scancode flag
let g_lock_len: u32 = 0;                                       // chars typed on the lock screen
let g_lock_err: bool = false;                                  // last unlock attempt was wrong
let g_lockbuf: [u8; 24] = [0; 24];                             // lock-screen password entry
let g_boxsave: [u8; 208000] = [0; 208000];                    // 260x200 RGBA backing store for the power flyout
let g_box_x: u32 = 0;                                          // power flyout top-left
let g_box_y: u32 = 0;
// ----- kernel heap (dynamic memory) -----
let g_heap_ok: bool = false;                                  // heap_init found usable RAM
let g_heap_base: u32 = 0;                                     // first heap byte
let g_heap_end: u32 = 0;                                      // one past the last heap byte
let g_heap_brk: u32 = 0;                                      // high-water mark (bump pointer)
let g_history: *u8 = "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ";                              // 8 slots x 80 bytes (command history ring)

